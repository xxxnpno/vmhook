@PACKAGE_INIT@

if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "VMHook requires a Windows x64 GNU G++ target.")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14)
    message(FATAL_ERROR "VMHook requires Windows x64 and GNU G++ 14 or newer.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vmhookTargets.cmake")
set(vmhook_header_FOUND TRUE)
set(vmhook_java_helper_source "@PACKAGE_CMAKE_INSTALL_DATADIR@/vmhook/java/vmhook/callback_handler.java")
foreach(_vmhook_component IN LISTS vmhook_FIND_COMPONENTS)
    if(_vmhook_component STREQUAL "module")
        include("${CMAKE_CURRENT_LIST_DIR}/vmhookModule.cmake")
        vmhook_enable_module("@PACKAGE_CMAKE_INSTALL_DATADIR@/vmhook")
        set(vmhook_module_FOUND TRUE)
    elseif(NOT _vmhook_component STREQUAL "header")
        set(vmhook_${_vmhook_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(vmhook)
