            } else if(at[5]==0x48&&at[6]==0x8b&&at[7]==0x4d&&at[8]==cache_disp){core=at;break;}
          }
          if(!core)throw std::runtime_error("Interpreter field template entry is not verified");
          for(auto* at=core;at<found.patch;) {
