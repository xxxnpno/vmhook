}
class vm_state_guard final{
 void* thread_{};bool entered_{};
public:
 explicit vm_state_guard(void* thread):thread_(thread){if(rt().current_thread()!=thread)throw std::runtime_error("VM guard does not own native OS thread");if(thread_state(thread)==4){transition_to_vm(thread);entered_=true;}else if(thread_state(thread)!=6)throw std::runtime_error("Unexpected JavaThread state");}
 ~vm_state_guard(){if(entered_)transition_to_native(thread_);}
 vm_state_guard(const vm_state_guard&)=delete;vm_state_guard& operator=(const vm_state_guard&)=delete;
};
}

export namespace vmhook::detail::private_native::detail{
class handle_mark final{
 alignas(8)std::array<std::byte,56> bytes_{};
public:
 explicit handle_mark(void*thread){rt().fn<void(*)(void*,void*)>("handle_mark_initialize")(bytes_.data(),thread);}
 ~handle_mark(){rt().fn<void(*)(void*)>("handle_mark_destroy")(bytes_.data());}
 handle_mark(const handle_mark&)=delete;handle_mark&operator=(const handle_mark&)=delete;
};
inline void**root_oop(void*thread,void*oop){
 if(!oop)return nullptr;
 if(auto callback=root_reuse_callback()){if(auto**slot=callback(thread)){std::memcpy(slot,&oop,sizeof oop);return slot;}}
 auto&vm=rt();void*area=load<void*>(thread,vm.off("JavaThread","_handle_area"));
 auto*top=load<std::byte*>(area,vm.off("Arena","_hwm"));auto*limit=load<std::byte*>(area,vm.off("Arena","_max"));void**slot{};
 if(top&&limit&&top<=limit&&static_cast<std::size_t>(limit-top)>=sizeof(void*)){slot=reinterpret_cast<void**>(top);top+=sizeof(void*);store(area,vm.off("Arena","_hwm"),top);}
 else slot=vm.fn<void**(*)(void*,std::size_t,int)>("arena_grow")(area,sizeof(void*),1);
 if(slot){std::memcpy(slot,&oop,sizeof oop);vmhook::detail::native_backend::note_root_allocation(thread);}
 return slot;
}
inline void*resolve_root(void**root){return root?load<void*>(root,0):nullptr;}
}

export namespace vmhook::detail::private_native{
using progress_callback=void(*)(const char*);
thread_local progress_callback on_progress{};
inline void progress(const char*message)noexcept{if(on_progress){try{on_progress(message);}catch(...){}}}
class scoped_attachment final{
 void*thread_{};const char*error_{"Attachment not attempted"};bool nmt_registered_{},guards_created_{},on_list_{},attached_{};
 void* guards_owner()const{auto&vm=rt();return vm.profile->caps.guards_subobject?static_cast<std::byte*>(thread_)+vm.off("JavaThread","_stack_overflow_state"):thread_;}
 void destroy_thread(){auto&vm=rt();if(vm.profile->caps.delete_flags_arg)vm.fn<void*(*)(void*,unsigned)>("delete_thread")(thread_,1);else vm.fn<void(*)(void*)>("delete_thread")(thread_);thread_=nullptr;}
 void cleanup_failed(){
  if(!thread_)return;
  auto&vm=rt();
  if(on_list_){
   if(vm.profile->caps.cleanup_bool_arg)vm.fn<void(*)(void*,bool)>("cleanup_failed")(thread_,true);
   else vm.fn<void(*)(void*)>("cleanup_failed")(thread_);
   on_list_=false;
   // In HotSpot 8–20 this routine owns destruction. HotSpot 21 moved NMT
   // unregistration and smr_delete to the caller. Never delete the old object
   // twice or consult its fields after the cleanup routine returns.
   if(vm.profile->java_feature<=20){thread_=nullptr;nmt_registered_=false;guards_created_=false;return;}
  }
  else if(guards_created_)vm.fn<void(*)(void*)>("remove_guards")(guards_owner());
  if(nmt_registered_&&vm.has_function("unregister_stack"))vm.fn<void(*)(void*)>("unregister_stack")(thread_);
  nmt_registered_=false;destroy_thread();guards_created_=false;
 }
 void set_monitor_owner(bool java_object){
  auto&vm=rt();if(!vm.profile->caps.monitor_owner)return;
  std::int64_t id{};
  if(!java_object)id=vm.fn<std::int64_t(*)()>("next_thread_identifier")();
  else{auto*object=thread_object();if(vm.has_function("java_thread_id"))id=vm.fn<std::int64_t(*)(void*)>("java_thread_id")(object);else id=load<std::int64_t>(object,load<int>(vm.function("java_thread_tid_offset"),0));}
  store(thread_,vm.off("JavaThread","_monitor_owner_id"),id);
 }
 void* thread_object()const{auto&vm=rt();return vm.has_function("thread_object")?vm.fn<void*(*)(const void*)>("thread_object")(thread_):load<void*>(thread_,vm.off("JavaThread","_threadObj"));}

public:
 explicit scoped_attachment(const char*name=nullptr){
  auto&vm=rt();if(!vm.ready){error_=vm.reason;return;}
  if(vm.has_function("vm_exited")&&load<bool>(vm.function("vm_exited"),0)){error_="VM already exited";return;}
  if(vm.has_function("is_tls_initialized")&&!vm.fn<bool(*)()>("is_tls_initialized")()){error_="VM TLS not initialized";return;}
  if(vm.current_thread()){error_="Calling OS thread already belongs to VM";return;}
  progress("attach: create private JavaThread");
  if(vm.profile->caps.new_attaching_factory)thread_=vm.fn<void*(*)()>("create_attaching_thread")();
  else{
   const char*tag_type=vm.has_type("MemoryType")?"MemoryType":vm.has_type("MEMFLAGS")?"MEMFLAGS":"MemTag";
   const int tag=vm.enum_value(tag_type,"mtThread");
   if(vm.has_function("allocate_thread"))thread_=vm.fn<void*(*)(std::size_t,bool,int)>("allocate_thread")(vm.size("JavaThread"),false,tag);
   else thread_=vm.fn<void*(*)(std::size_t,int)>("malloc")(vm.size("JavaThread"),tag);
   if(thread_)vm.fn<void(*)(void*,bool)>("java_thread_ctor")(thread_,true);
  }
  if(!thread_){error_="Private JavaThread allocation failed";return;}
  store(thread_,vm.off("JavaThread","_thread_state"),6);
  vm.fn<void(*)(void*)>("record_stack")(thread_);
  if(vm.profile->caps.new_attaching_factory)vm.fn<void(*)(void*)>("initialize_tls")(thread_);
  if(vm.has_function("register_stack"))vm.fn<void(*)(void*)>("register_stack")(thread_);
  nmt_registered_=true;
  if(!vm.profile->caps.new_attaching_factory)vm.fn<void(*)(void*)>("initialize_tls")(thread_);
  if(vm.current_thread()!=thread_){error_="Private VM TLS installation failed";cleanup_failed();return;}
  progress("attach: associate Windows thread, guard pages and TLAB");
  if(!vm.fn<bool(*)(void*)>("create_os_thread")(thread_)){error_="OSThread creation failed";cleanup_failed();return;}
  vm.fn<void(*)(void*)>("create_guards")(guards_owner());
  const auto guard_type=vm.profile->caps.guards_subobject?"StackOverflow":"JavaThread";
  const auto guard_enum=vm.profile->caps.guards_subobject?"StackOverflow::StackGuardState":"JavaThread::StackGuardState";
  guards_created_=load<int>(guards_owner(),vm.off(guard_type,"_stack_guard_state"))==vm.enum_value(guard_enum,"stack_guard_enabled");
  if(!guards_created_){error_="Stack guard creation failed";cleanup_failed();return;}
  if(vm.has_function("initialize_tlab"))vm.fn<void(*)(void*)>("initialize_tlab")(thread_);
  else if(load<bool>(vm.function("use_tlab"),0))
   vm.fn<void(*)(void*)>("tlab_initialize")(static_cast<std::byte*>(thread_)+vm.off("Thread","_tlab"));
  vm.fn<void(*)(void*)>("cache_globals")(thread_);set_monitor_owner(false);
  progress("attach: publish daemon JavaThread under Threads_lock");
  auto*lock=load<void*>(vm.function("threads_lock"),0);if(!lock){error_="Threads_lock missing";cleanup_failed();return;}
  // This thread is not yet visible to GC. HotSpot requires the publication
  // lock path to avoid safepoint checks until Threads::add has completed.
  vm.fn<void(*)(void*)>("lock_without_safepoint")(lock);
  if(vm.has_function("vm_exited")&&load<bool>(vm.function("vm_exited"),0)){vm.fn<void(*)(void*)>("unlock")(lock);error_="VM exited before publication";cleanup_failed();return;}
  auto*block=vm.has_function("allocate_handle_block_legacy")
   ?vm.fn<void*(*)(void*)>("allocate_handle_block_legacy")(nullptr)
   :vm.fn<void*(*)(void*,int)>("allocate_handle_block")(nullptr,1);
  if(!block){vm.fn<void(*)(void*)>("unlock")(lock);error_="Active handle block allocation failed";cleanup_failed();return;}
  store(thread_,vm.off("JavaThread","_active_handles"),block);vm.fn<void(*)(void*,bool)>("add_thread")(thread_,true);on_list_=true;vm.fn<void(*)(void*)>("unlock")(lock);
  progress("attach: construct java.lang.Thread on this OS thread");
  {detail::handle_mark roots(thread_);auto*group=vm.has_function("main_thread_group")?vm.fn<void*(*)()>("main_thread_group")():load<void*>(vm.function("main_thread_group_raw"),0);auto**root=detail::root_oop(thread_,group);
   if(!root)error_="ThreadGroup root allocation failed";
   else{vm.fn<void(*)(void*,void**,const char*,bool,void*)>("allocate_thread_object")(thread_,root,name,true,thread_);if(pending_exception(thread_)){clear_pending_exception(thread_);error_="java.lang.Thread constructor threw";}else attached_=true;}}
  if(!attached_){cleanup_failed();return;}
  set_monitor_owner(true);
  if(vm.profile->caps.jfr_before_publish&&vm.has_function("jfr_thread_start"))vm.fn<void(*)(void*)>("jfr_thread_start")(thread_);
  std::atomic_thread_fence(std::memory_order_seq_cst);store(thread_,vm.off("JavaThread","_jni_attach_state"),3);
  auto*object=thread_object();vm.fn<void(*)(void*,int)>("set_thread_status")(object,5);
  if(!vm.profile->caps.jfr_before_publish&&vm.has_function("jfr_thread_start"))vm.fn<void(*)(void*)>("jfr_thread_start")(thread_);
  transition_to_native(thread_);vm.fn<void(*)()>("setup_fpu")();error_="Attached";progress("attach: native thread ready for direct calls");
 }
 ~scoped_attachment(){detach();}
 bool valid()const noexcept{return attached_&&thread_;}void*get()const noexcept{return valid()?thread_:nullptr;}const char*error()const noexcept{return error_;}
 bool detach(){
  if(!thread_)return true;
  if(active_session_count){error_="Detach refused: roots still owned by Java session";return false;}if(!attached_){cleanup_failed();return true;}
  auto&vm=rt();if(vm.current_thread()!=thread_||thread_state(thread_)!=4||load<void*>(thread_,vm.off("JavaThread","_anchor"))){error_="Detach refused: foreign OS thread, VM state or active Java frame";return false;}
  progress("detach: enter VM and retire JavaThread");transition_to_vm(thread_);vm.fn<void(*)(void*,bool,int)>("exit_thread")(thread_,false,1);on_list_=false;guards_created_=false;
  if(nmt_registered_&&vm.has_function("unregister_stack")){vm.fn<void(*)(void*)>("unregister_stack")(thread_);}
  nmt_registered_=false;destroy_thread();attached_=false;
  if(vm.current_thread()){error_="VM TLS survived detach";return false;}error_="Detached";progress("detach: complete");return true;
 }
 scoped_attachment(const scoped_attachment&)=delete;scoped_attachment&operator=(const scoped_attachment&)=delete;
};
}

export namespace vmhook::detail::private_native {
inline std::uint32_t method_access_flags(void*method){
 const auto offset=rt().off("Method","_access_flags");
 return rt().size("AccessFlags")==2?load<std::uint16_t>(method,offset):load<std::uint32_t>(method,offset);
}


enum class basic_type : int {
    boolean=4, char_=5, float_=6, double_=7, byte=8, short_=9,
    int_=10, long_=11, object=12, array=13, void_=14
};

struct argument final {
    basic_type type{basic_type::int_};
    std::uint64_t bits{};
    void** oop_root{};

    static argument i32(std::int32_t value) {
        return {basic_type::int_, static_cast<std::uint32_t>(value), nullptr};
    }
    static argument i64(std::int64_t value) {
        return {basic_type::long_, std::bit_cast<std::uint64_t>(value), nullptr};
    }
    static argument f32(float value) {
        return {basic_type::float_, std::bit_cast<std::uint32_t>(value), nullptr};
    }
    static argument f64(double value) {
        return {basic_type::double_, std::bit_cast<std::uint64_t>(value), nullptr};
    }
    static argument ref(void** root) { return {basic_type::object, 0, root}; }
    static argument null_ref() { return ref(nullptr); }
};

struct call_result final {
    bool invoked{};
    bool threw{};
    std::uint64_t bits{};
    void** oop_root{};
    void** exception_root{};
    const char* error{};

    template<class value_type> value_type as() const {
        static_assert(std::is_trivially_copyable_v<value_type> && sizeof(value_type)<=sizeof(bits));
        value_type value{}; std::memcpy(&value, &bits, sizeof value); return value;
    }
};

namespace detail {

inline std::string_view method_symbol(void* method,bool signature) {
    void* constants_method=load<void*>(method,rt().off("Method","_constMethod"));
    if (!constants_method) return {};
    void* pool=load<void*>(constants_method,rt().off("ConstMethod","_constants"));
    const auto index=load<std::uint16_t>(constants_method,rt().off("ConstMethod",signature ? "_signature_index" : "_name_index"));
    if (!pool || !index || index>=load<std::uint32_t>(pool,rt().off("ConstantPool","_length"))) return {};
    void* symbol=load<void*>(pool,rt().size("ConstantPool")+sizeof(void*)*index);
    if (!symbol) return {};
    const auto length=rt().has_field("Symbol","_length")
        ?load<std::uint16_t>(symbol,rt().off("Symbol","_length"))
        :static_cast<std::uint16_t>(load<std::uint32_t>(symbol,rt().off("Symbol","_length_and_refcount"))>>16);
    return {static_cast<const char*>(symbol)+rt().off("Symbol","_body"),length};
}

inline bool descriptor_type(std::string_view signature,std::size_t& position,basic_type& type,bool allow_void=false) {
    if (position>=signature.size()) return false;
    const char code=signature[position++];
    switch (code) {
        case 'Z': type=basic_type::boolean; return true;
        case 'C': type=basic_type::char_; return true;
        case 'B': type=basic_type::byte; return true;
        case 'S': type=basic_type::short_; return true;
        case 'I': type=basic_type::int_; return true;
        case 'J': type=basic_type::long_; return true;
        case 'F': type=basic_type::float_; return true;
        case 'D': type=basic_type::double_; return true;
        case 'V': type=basic_type::void_; return allow_void;
        case 'L': {
            const auto end=signature.find(';',position);
            if (end==std::string_view::npos || end==position) return false;
            position=end+1; type=basic_type::object; return true;
        }
        case '[': {
            while (position<signature.size() && signature[position]=='[') ++position;
            basic_type element{};
            if (!descriptor_type(signature,position,element,false)) return false;
            type=basic_type::array; return true;
        }
        default: return false;
    }
}

inline bool compatible_argument(basic_type expected,basic_type actual) {
    const auto is_reference=[](basic_type t) {return t==basic_type::object || t==basic_type::array;};
    if (is_reference(expected)) return is_reference(actual);
    if (expected==basic_type::boolean || expected==basic_type::char_ || expected==basic_type::byte || expected==basic_type::short_) {
        return actual==expected || actual==basic_type::int_;
    }
    return actual==expected;
}

inline bool validate_descriptor(std::string_view signature,std::span<const argument> args,basic_type result) {
    if (signature.empty() || signature[0]!='(') return false;
    std::size_t position=1,index=0;
    while (position<signature.size() && signature[position]!=')') {
        basic_type expected{};
        if (index>=args.size() || !descriptor_type(signature,position,expected) || !compatible_argument(expected,args[index++].type)) return false;
    }
    if (index!=args.size() || position>=signature.size() || signature[position++]!=')') return false;
    basic_type expected_result{};
    if (!descriptor_type(signature,position,expected_result,true) || position!=signature.size()) return false;
    if (expected_result==basic_type::object || expected_result==basic_type::array) return result==basic_type::object || result==basic_type::array;
    return expected_result==result;
}

// Accessed offsets come from the exact DLL-matched private PDB profile.
struct java_value_abi final {
    int type{};
    std::uint32_t padding{};
    std::uint64_t value{};
};
static_assert(sizeof(java_value_abi)==16 && std::meta::offset_of(^^java_value_abi::value).bytes==8);

struct method_handle_abi final { void* value{}; void* thread{}; };
static_assert(sizeof(method_handle_abi)==16 && std::meta::offset_of(^^method_handle_abi::thread).bytes==8);

class method_handle final {
    method_handle_abi value_{};
public:
    explicit method_handle(void* method) {
        // The private VM copy constructor registers this metadata in the current
        // JavaThread's metadata_handles list, including its own growth protocol.
        const method_handle_abi source{method,nullptr};
        using construct=void(*)(void*,const void*);
        reinterpret_cast<construct>(rt().function("method_handle_construct"))(&value_,&source);
    }
    ~method_handle() {
        using destroy=void(*)(void*);
        reinterpret_cast<destroy>(rt().function("method_handle_destroy"))(&value_);
    }
    const void* get() const { return &value_; }
    method_handle(const method_handle&)=delete;
    method_handle& operator=(const method_handle&)=delete;
};

struct java_arguments_abi final {
    std::array<std::intptr_t,9> value_buffer{};
    std::array<unsigned char,9> state_buffer{};
    std::array<unsigned char,7> padding{};
    std::intptr_t* values{};
    unsigned char* states{};
    int size{};
    int max_size{};
    bool starts_at_zero{};
    std::array<unsigned char,7> padding2{};
    void** alternative_target{};
};
static_assert(sizeof(java_arguments_abi)==128);
static_assert(std::meta::offset_of(^^java_arguments_abi::state_buffer).bytes==72);
static_assert(std::meta::offset_of(^^java_arguments_abi::values).bytes==88);
static_assert(std::meta::offset_of(^^java_arguments_abi::states).bytes==96);
static_assert(std::meta::offset_of(^^java_arguments_abi::size).bytes==104);
static_assert(std::meta::offset_of(^^java_arguments_abi::max_size).bytes==108);
static_assert(std::meta::offset_of(^^java_arguments_abi::starts_at_zero).bytes==112);
static_assert(std::meta::offset_of(^^java_arguments_abi::alternative_target).bytes==120);

class java_arguments final {
    std::array<std::intptr_t,256> values_{};
    std::array<unsigned char,256> states_{};
    java_arguments_abi value_{};
public:
    java_arguments() {
        value_.values=values_.data()+1;
        value_.states=states_.data()+1;
        value_.max_size=255;
    }
    bool push_root(void** root) {
        if (value_.size>=value_.max_size) return false;
        value_.states[value_.size]=2; // JavaCallArguments::value_state_handle
        value_.values[value_.size++]=reinterpret_cast<std::intptr_t>(root);
        return true;
    }
    bool push(argument arg) {
        if (arg.type==basic_type::object || arg.type==basic_type::array) return push_root(arg.oop_root);
        const bool wide=arg.type==basic_type::long_ || arg.type==basic_type::double_;
        const int width=wide ? 2 : 1;
        if (arg.type==basic_type::void_ || value_.size+width>value_.max_size) return false;
        value_.states[value_.size]=0; // JavaCallArguments::value_state_primitive
        if (wide) {
            value_.states[value_.size+1]=0;
            // The actual AMD64 HotSpot JavaCalls ABI places a 64-bit primitive
            // in the second of two Java parameter slots, even on Windows x64.
            std::memcpy(&value_.values[value_.size+1],&arg.bits,8);
        } else {
            const auto low=static_cast<std::uint32_t>(arg.bits);
            std::memcpy(&value_.values[value_.size],&low,4);
        }
        value_.size+=width;
        return true;
    }
    int size() const { return value_.size; }
    void* get() { return &value_; }
};

} // namespace detail

// This session retains HandleArea roots while the
// caller's OS thread is native between operations. Each operation uses a real
// VM transition and returns to native state. No queue, hook, JNI or JVMTI entry
// is used. Returned root slots are valid until this session is destroyed.
class java_session final {
    void* thread_{};
    std::optional<detail::handle_mark> roots_;

    bool owns_vm_state() const {
        return rt().current_thread()==thread_ && thread_state(thread_)==6;
    }
    call_result exception_result(bool invoked) const {
        call_result result{};
        result.invoked=invoked;
        if (void* exception=pending_exception(thread_)) {
            result.threw=true;
            result.exception_root=detail::root_oop(thread_,exception);
            if (!result.exception_root) result.error="Unable to root pending Java exception";
        }
        return result;
    }
public:
    explicit java_session(void* thread):thread_(thread) {
        vm_state_guard state(thread_);
        roots_.emplace(thread_);
        ++active_session_count;
    }
    ~java_session() {
        vm_state_guard state(thread_);
        roots_.reset();
        --active_session_count;
    }
    java_session(const java_session&)=delete;
    java_session& operator=(const java_session&)=delete;

    call_result invoke(void* method, basic_type return_type,
                       std::span<const argument> arguments={},void** receiver_root=nullptr) {
        vm_state_guard state(thread_);
        call_result result{};
        if (!owns_vm_state()) { result.error="Java session does not own current VM-state thread"; return result; }
        if (pending_exception(thread_)) { result=exception_result(false); result.error="Pending Java exception must be handled before invocation"; return result; }
        if (!method) { result.error="Method pointer is null"; return result; }
        detail::method_handle metadata_root(method);
        if (!detail::validate_descriptor(detail::method_symbol(method,true),arguments,return_type)) {
            result.error="Arguments or return type do not match actual Method descriptor"; return result;
        }
        // Offsets and access flag width are verified against the matching PDB.
        const auto flags=method_access_flags(method);
        const bool is_static=(flags&0x0008u)!=0;
        if ((flags&0x0400u)!=0) { result.error="Cannot directly invoke an abstract Method"; return result; }
        if (is_static ? receiver_root!=nullptr : !detail::resolve_root(receiver_root)) {
            result.error="Receiver does not match Method staticness"; return result;
        }
        detail::java_arguments packed;
        if (!is_static && !packed.push_root(receiver_root)) { result.error="Receiver packing failed"; return result; }
        for (const auto& arg : arguments) {
            if (!packed.push(arg)) { result.error="Argument exceeds supported Java parameter slots"; return result; }
        }
        void* constant_method=load<void*>(method,rt().off("Method","_constMethod"));
        if (!constant_method || load<std::uint16_t>(constant_method,rt().off("ConstMethod","_size_of_parameters"))!=packed.size()) {
            result.error="Packed argument slots do not match actual Method metadata"; return result;
        }
        if (is_static) {
            if (detail::method_symbol(method,false)=="<clinit>") {
                result.error="A class initializer cannot be called as an ordinary static Method"; return result;
            }
            void* pool=load<void*>(constant_method,rt().off("ConstMethod","_constants"));
            void* holder=pool ? load<void*>(pool,rt().off("ConstantPool","_pool_holder")) : nullptr;
            if (!holder) { result.error="Static Method holder metadata is unavailable"; return result; }
            // JavaCalls::call is the VM's low-level entry and deliberately does
            // not initialize the holder. Restore Java static-call semantics with
            // the VM's real class initialization lock/exception protocol first.
            using initialize=void(*)(void*,void*);
            reinterpret_cast<initialize>(rt().function("klass_initialize"))(holder,thread_);
            if (pending_exception(thread_)) return exception_result(false);
        }
        const int ret=static_cast<int>(return_type);
        if (ret<4 || ret>14) { result.error="Invalid Java result BasicType"; return result; }
        detail::java_value_abi value{ret,0,0};
        using call=void(*)(void*,const void*,void*,void*);
        if(rt().profile->caps.java_calls_by_value){
            // Old Windows JavaCalls consumes and destroys its by-value metadata handle.
            // Supply a distinct VM-registered copy; retain the caller root separately.
            alignas(8) std::array<std::byte,16> callee_handle{};
            using copy=void(*)(void*,const void*);
            rt().fn<copy>("method_handle_construct")(callee_handle.data(),metadata_root.get());
            reinterpret_cast<call>(rt().function("java_calls"))(&value,callee_handle.data(),packed.get(),thread_);
        } else reinterpret_cast<call>(rt().function("java_calls"))(&value,metadata_root.get(),packed.get(),thread_);
        result=exception_result(true);
        if (result.threw) return result;
        result.bits=value.value;
        if (return_type==basic_type::object || return_type==basic_type::array) {
            void* oop{}; std::memcpy(&oop,&value.value,sizeof oop);
            result.oop_root=detail::root_oop(thread_,oop);
            if (oop && !result.oop_root) result.error="Unable to root returned Java object";
        }
        return result;
    }

    call_result invoke(void* method,basic_type type,std::initializer_list<argument> args,void** receiver=nullptr) {
        return invoke(method,type,std::span<const argument>{args.begin(),args.size()},receiver);
    }

    void** allocate(void* klass) {
        vm_state_guard state(thread_);
        if (!owns_vm_state() || !klass || pending_exception(thread_)) return nullptr;
        // Use the matching private VM's instantiation checks, initialization,
        // collector-aware allocation and finalizer registration.
        using check=void(*)(void*,bool,void*);
        reinterpret_cast<check>(rt().function("klass_check"))(klass,false,thread_);
        if (pending_exception(thread_)) return nullptr;
        using initialize=void(*)(void*,void*);
        reinterpret_cast<initialize>(rt().function("klass_initialize"))(klass,thread_);
        if (pending_exception(thread_)) return nullptr;
        using allocate=void*(*)(void*,void*);
        void* oop=reinterpret_cast<allocate>(rt().function("klass_allocate"))(klass,thread_);
        if (pending_exception(thread_)) return nullptr;
        return detail::root_oop(thread_,oop);
    }

    void** construct(void* klass,void* constructor,std::span<const argument> arguments={}) {
        vm_state_guard state(thread_);
        if (!owns_vm_state() || !constructor || pending_exception(thread_)) return nullptr;
        detail::method_handle metadata_root(constructor);
        if (detail::method_symbol(constructor,false)!="<init>"
            || !detail::validate_descriptor(detail::method_symbol(constructor,true),arguments,basic_type::void_)
            || (method_access_flags(constructor)&0x0008u)!=0) return nullptr;
        void* constants_method=load<void*>(constructor,rt().off("Method","_constMethod"));
        void* pool=constants_method ? load<void*>(constants_method,rt().off("ConstMethod","_constants")) : nullptr;
        if (!pool || load<void*>(pool,rt().off("ConstantPool","_pool_holder"))!=klass) return nullptr;
        void** object=allocate(klass);
        if (!object) return nullptr;
        const auto result=invoke(constructor,basic_type::void_,arguments,object);
        return result.invoked && !result.threw && !result.error ? object : nullptr;
    }

    void** construct(void* klass,void* constructor,std::initializer_list<argument> args) {
        return construct(klass,constructor,std::span<const argument>{args.begin(),args.size()});
    }

    // A raw oop snapshot can move immediately after this returns to native.
    // Never retain/dereference it, or compare two separately resolved snapshots.
    // Invoke with root slots or use same_object for a guarded identity check.
    void* resolve(void** root) const {
        vm_state_guard state(thread_);
        return owns_vm_state() ? detail::resolve_root(root) : nullptr;
    }
    bool same_object(void** first,void** second) const {
        vm_state_guard state(thread_);
        if (!owns_vm_state()) return false;
        return detail::resolve_root(first)==detail::resolve_root(second);
    }
    void** new_string(std::u16string_view text) {
        vm_state_guard state(thread_);
        if(!owns_vm_state() || pending_exception(thread_) || text.size()>static_cast<std::size_t>(std::numeric_limits<int>::max())) return nullptr;
        // MSVC nontrivial Handle value return uses an explicit hidden output slot.
        void** root=nullptr;
        using create=void*(*)(void*,const char16_t*,int,void*);
        reinterpret_cast<create>(rt().function("new_string_unicode"))(&root,text.data(),static_cast<int>(text.size()),thread_);
        return pending_exception(thread_)?nullptr:root;
    }

    void clear_exception() {
        vm_state_guard state(thread_);
        if (owns_vm_state()) clear_pending_exception(thread_);
    }
};

} // export namespace vmhook::detail::private_native

// VMHOOK_NATIVE_RUNTIME_END

// VMHOOK_JIT_BACKEND_BEGIN
export namespace vmhook::detail::jit_backend
{
    namespace pn = vmhook::detail::private_native;
    using safepoint_callback = void (*)(void*) noexcept;
    struct configuration final
    {
        void (*execute)(void*){};
        void** operation_vtable{};
        void (*operation_doit)(void*){};
        void (*mark_all_plain)(){};
        void (*mark_all_scope)(void*){};
        void (*deoptimize)(void*){};
        void (*scope_construct)(void*){};
        void (*threads_do)(void*){};
        void* compiler_vtable{};
        bool* use_compiler{};
        std::int32_t* compile_jobs{};
        void* set_not_compilable{};
        void* set_not_osr_compilable{};
        bool (*is_not_compilable)(void*, int){};
        bool (*is_not_osr_compilable)(void*, int){};
        void* metadata_do{};
        std::size_t operation_size{}, operation_slots{}, doit_slot{}, scope_size{};
        std::size_t task_offset{}, const_method_offset{}, result_type_offset{}, constants_offset{}, holder_offset{}, name_index_offset{}, signature_index_offset{};
        std::size_t flags_offset{}, flags_width{}, inline_offset{}, inline_width{}, intrinsic_offset{}, intrinsic_width{};
        std::uint32_t inline_mask{};
        int all_levels{}, deopt_mode{};
        bool old_setter_arguments{}, metadata_closure{};
        std::array<void*, 20> return_entries{};
        void* normal_method_entry{};
        void* synchronized_method_entry{};
        std::size_t i2i_offset{}, from_interpreted_offset{}, method_code_offset{};
        void* exception_entry{};
        std::size_t pending_exception_offset{};
        const std::uint8_t* bytecode_lengths{};
        void** class_loader_head{};
        std::size_t cld_klasses{}, cld_next{}, klass_next{}, klass_layout{}, klass_state{}, klass_methods{}, const_method_size{}, code_size_offset{};
        std::size_t cld_deallocate{}, deallocate_length{}, deallocate_data{};
        unsigned fast_linear_switch{}, fast_binary_switch{};
        bool ready{};
        configuration() noexcept
        {
            try
            {
                auto& vm{ pn::rt() };
                if (!vm.ready) { return; }
                this->execute = vm.fn<void(*)(void*)>("vm_execute");
                this->deopt_mode = vm.enum_value("ObservationABI", "deopt_mode");
                const bool legacy{ this->deopt_mode == 0 };
                this->operation_vtable = static_cast<void**>(vm.function(legacy ? "vm_deoptimize_vtable" : "vm_clear_ics_vtable"));
                this->operation_doit = vm.fn<void(*)(void*)>(legacy ? "vm_deoptimize_doit" : "vm_clear_ics_doit");
                this->operation_size = vm.size(legacy ? "VM_Deoptimize" : "VM_ClearICs");
                this->operation_slots = vm.enum_value("VM_Operation", "vtable_count");
                this->doit_slot = vm.enum_value("VM_Operation", "vtable_doit");
                if (this->operation_size > 64 || this->operation_slots > 20 || this->doit_slot >= this->operation_slots
                    || this->operation_vtable[this->doit_slot] != reinterpret_cast<void*>(this->operation_doit)) { return; }
                if (this->deopt_mode == 2)
                {
                    this->scope_construct = vm.fn<void(*)(void*)>("deopt_scope_ctor");
                    this->scope_size = vm.size("DeoptimizationScope");
                    if (this->scope_size > 64) { return; }
                    this->mark_all_scope = vm.fn<void(*)(void*)>("mark_all");
                    this->deoptimize = vm.fn<void(*)(void*)>("deopt_scope_commit");
                }
                else
                {
                    this->mark_all_plain = vm.fn<void(*)()>("mark_all");
                    this->deoptimize = legacy ? this->operation_doit : vm.fn<void(*)(void*)>("deoptimize_all_marked");
                }
                this->threads_do = vm.fn<void(*)(void*)>("threads_do");
                this->compiler_vtable = vm.function("compiler_vtable");
                this->use_compiler = static_cast<bool*>(vm.function("use_compiler"));
                this->compile_jobs = static_cast<std::int32_t*>(vm.function("compile_jobs"));
                if (reinterpret_cast<std::uintptr_t>(this->compile_jobs) % alignof(std::int32_t) != 0) { return; }
                this->task_offset = vm.off("CompilerThread", "_task");
                this->set_not_compilable = vm.function("set_not_compilable");
                this->set_not_osr_compilable = vm.function("set_not_osr_compilable");
                this->is_not_compilable = vm.fn<bool(*)(void*,int)>("is_not_compilable");
                this->is_not_osr_compilable = vm.fn<bool(*)(void*,int)>("is_not_osr_compilable");
                this->old_setter_arguments = vm.enum_value("ObservationABI", "set_not_compilable_old_args") != 0;
                this->all_levels = vm.enum_value("CompLevel", "CompLevel_all");
                this->metadata_do = vm.function("nmethod_metadata_do");
                this->metadata_closure = vm.enum_value("ObservationABI", "nmethod_metadata_closure") != 0;
                this->const_method_offset = vm.off("Method", "_constMethod");
                this->result_type_offset = vm.off("ConstMethod", "_result_type");
                this->constants_offset = vm.off("ConstMethod", "_constants");
                this->holder_offset = vm.off("ConstantPool", "_pool_holder");
                this->name_index_offset = vm.off("ConstMethod", "_name_index");
                this->signature_index_offset = vm.off("ConstMethod", "_signature_index");
                this->intrinsic_offset = vm.off("Method", "_intrinsic_id");
                this->intrinsic_width = vm.enum_value("Method", "storage_size__intrinsic_id");
                if (this->intrinsic_width != 1 && this->intrinsic_width != 2) { return; }
                this->i2i_offset = vm.off("Method", "_i2i_entry");
                this->from_interpreted_offset = vm.off("Method", "_from_interpreted_entry");
                this->method_code_offset = vm.off("Method", "_code");
                auto** const method_entries = static_cast<void**>(vm.function("interpreter_entry_table"));
                const auto normal_kind = vm.enum_value("AbstractInterpreter::MethodKind", "zerolocals");
                const auto synchronized_kind = vm.enum_value("AbstractInterpreter::MethodKind", "zerolocals_synchronized");
                const auto method_entry_count = vm.enum_value("AbstractInterpreter::MethodKind", "number_of_method_entries");
                if (normal_kind < 0 || synchronized_kind < 0 || method_entry_count <= normal_kind
                    || method_entry_count <= synchronized_kind || method_entry_count > 128) { return; }
                this->normal_method_entry = method_entries[normal_kind];
                this->synchronized_method_entry = method_entries[synchronized_kind];
                if (vm.has_type("MethodFlags"))
                {
                    this->flags_offset = vm.off("Method", "_flags") + vm.off("MethodFlags", "_status");
                    this->flags_width = vm.enum_value("MethodFlags", "storage_size__status");
                    this->inline_offset = this->flags_offset;
                    this->inline_width = this->flags_width;
                    this->inline_mask = vm.enum_value("MethodFlags::<unnamed-enum-_misc_has_monitor_bytecodes>", "_misc_dont_inline");
                }
                else
                {
                    this->flags_offset = vm.off("Method", "_access_flags") + vm.off("AccessFlags", "_flags");
                    this->flags_width = vm.enum_value("AccessFlags", "storage_size__flags");
                    if (vm.has_field("Method", "_dont_inline"))
                    {
                        this->inline_offset = vm.off("Method", "_dont_inline");
                        this->inline_width = vm.enum_value("Method", "storage_size__dont_inline");
                        this->inline_mask = 1u << vm.enum_value("Method", "bit_position__dont_inline");
                    }
                    else
                    {
                        this->inline_offset = vm.off("Method", "_flags");
                        this->inline_width = vm.enum_value("Method", "storage_size__flags");
                        this->inline_mask = vm.enum_value("Method::Flags", "_dont_inline");
                    }
                }
                if (this->flags_width != 4 || (this->inline_width != 1 && this->inline_width != 2 && this->inline_width != 4)) { return; }
                if (vm.size("DispatchTable") != 10 * 256 * sizeof(void*) || vm.off("DispatchTable", "_table") != 0) { return; }
                auto** const table{ static_cast<void**>(vm.function("interpreter_normal_table")) };
                const auto entry = [&](const char* state, const unsigned opcode)
                { return table[vm.enum_value("TosState", state) * 256 + opcode]; };
                for (const char* type : {"T_BOOLEAN", "T_BYTE", "T_CHAR", "T_SHORT", "T_INT"})
                { this->return_entries.at(vm.enum_value("BasicType", type)) = entry("itos", 172); }
                this->return_entries.at(vm.enum_value("BasicType", "T_LONG")) = entry("ltos", 173);
                this->return_entries.at(vm.enum_value("BasicType", "T_FLOAT")) = entry("ftos", 174);
                this->return_entries.at(vm.enum_value("BasicType", "T_DOUBLE")) = entry("dtos", 175);
                this->return_entries.at(vm.enum_value("BasicType", "T_OBJECT")) = entry("atos", 176);
                this->return_entries.at(vm.enum_value("BasicType", "T_ARRAY")) = entry("atos", 176);
                this->return_entries.at(vm.enum_value("BasicType", "T_VOID")) = entry("vtos", 177);
                this->exception_entry = pn::load<void*>(vm.function("interpreter_throw_exception"), 0);
                this->pending_exception_offset = vm.off("JavaThread", "_pending_exception");
                this->bytecode_lengths = static_cast<const std::uint8_t*>(vm.function("bytecode_lengths"));
                this->fast_linear_switch = vm.enum_value("Bytecodes::Code", "_fast_linearswitch");
                this->fast_binary_switch = vm.enum_value("Bytecodes::Code", "_fast_binaryswitch");
                this->class_loader_head = static_cast<void**>(vm.function("class_loader_data_head"));
                this->cld_klasses = vm.off("ClassLoaderData", "_klasses"); this->cld_next = vm.off("ClassLoaderData", "_next");
                this->cld_deallocate = vm.off("ClassLoaderData", "_deallocate_list");
                this->deallocate_length = vm.enum_value("ObservationABI", "deallocate_list_length_offset");
                this->deallocate_data = vm.enum_value("ObservationABI", "deallocate_list_data_offset");
                const auto deallocate_size = vm.enum_value("ObservationABI", "deallocate_list_size");
                if (static_cast<std::size_t>(vm.enum_value("ClassLoaderData", "storage_size__deallocate_list")) != sizeof(void*)
                    || static_cast<std::size_t>(vm.enum_value("ObservationABI", "deallocate_list_length_width")) != sizeof(std::int32_t)
                    || static_cast<std::size_t>(vm.enum_value("ObservationABI", "deallocate_list_data_width")) != sizeof(void*)
                    || deallocate_size <= 0 || deallocate_size > 128
                    || this->deallocate_length + sizeof(std::int32_t) > static_cast<std::size_t>(deallocate_size)
                    || this->deallocate_data + sizeof(void*) > static_cast<std::size_t>(deallocate_size)) { return; }
                this->klass_next = vm.off("Klass", "_next_link"); this->klass_layout = vm.off("Klass", "_layout_helper");
                this->klass_state = vm.off("InstanceKlass", "_init_state");
                this->klass_methods = vm.field_offset("InstanceKlass", "_methods");
                this->const_method_size = vm.size("ConstMethod"); this->code_size_offset = vm.off("ConstMethod", "_code_size");
                if (!this->exception_entry) { return; }
                const auto* queue = pn::load<void*>(vm.function("interpreter_code"), 0);
                if (!queue) { return; }
                const auto begin = pn::load<std::uintptr_t>(queue, vm.off("StubQueue", "_stub_buffer"));
                const auto limit = pn::load<std::int32_t>(queue, vm.off("StubQueue", "_buffer_limit"));
                if (!begin || limit <= 0 || limit > 64 * 1024 * 1024) { return; }
                const auto valid_entry = [&](const void* address) noexcept {
                    const auto pc = reinterpret_cast<std::uintptr_t>(address);
                    const auto region = vmhook::os::query_region(address);
                    return pc >= begin && pc - begin < static_cast<std::uintptr_t>(limit)
                        && region.committed && region.executable && !region.guarded;
                };
                if (!valid_entry(this->exception_entry)) { return; }
                if (!valid_entry(this->normal_method_entry) || !valid_entry(this->synchronized_method_entry)) { return; }
                for (const auto code : this->return_entries)
                { if (code && !valid_entry(code)) { return; } }
                this->ready = true;
            }
            catch (...) {}
        }
    };
    auto config() noexcept -> const configuration& { static const configuration value{}; return value; }
    inline auto holder_linked(vmhook::hotspot::klass* klass) noexcept -> bool
    {
        try {
            const auto& c = config();
            return c.ready && klass && pn::load<std::uint8_t>(klass, c.klass_state)
                >= pn::rt().enum_value("InstanceKlass::ClassState", "linked");
        } catch (...) { return false; }
    }
    inline auto with_vm_state(const safepoint_callback callback, void* const opaque) noexcept -> bool
    {
        if (!callback) { return false; }
        try
        {
            auto& vm{ pn::rt() }; if (!vm.ready) { return false; }
            std::unique_ptr<pn::scoped_attachment> attachment{};
            void* thread{ vm.current_thread() };
            if (!thread)
            {
                attachment = std::make_unique<pn::scoped_attachment>("VMHook-hook-metadata");
                if (!attachment->valid()) { return false; }
                thread = attachment->get();
            }
            pn::vm_state_guard guard{ thread }; callback(opaque); return true;
        }
        catch (...) { return false; }
    }
    inline auto return_handler(vmhook::hotspot::method* const method) noexcept -> void*
    {
        const auto& c{ config() };
        if (!c.ready || !method) { return nullptr; }
        const auto* cm{ pn::load<void*>(method, c.const_method_offset) };
        if (!cm) { return nullptr; }
        const unsigned type{ pn::load<std::uint8_t>(cm, c.result_type_offset) };
        return type < c.return_entries.size() ? c.return_entries[type] : nullptr;
    }
    inline auto throw_handler() noexcept -> void* { return config().exception_entry; }
    inline auto pending_exception_slot(void* const thread) noexcept -> void**
    {
        const auto& c{ config() };
        return c.ready && thread ? reinterpret_cast<void**>(static_cast<std::byte*>(thread) + c.pending_exception_offset) : nullptr;
    }
    struct operation_payload final
    {
        safepoint_callback callback{};
        void* opaque{};
        std::array<void*, 21> vtable{};
        alignas(8) std::array<std::byte, 64> operation{};
    };
    inline auto operation_doit(void* const object) noexcept -> void
    {
        auto* const payload{ reinterpret_cast<operation_payload*>(static_cast<std::byte*>(object)
            - std::meta::offset_of(^^operation_payload::operation).bytes) };
        payload->callback(payload->opaque);
    }
    inline auto at_safepoint(const safepoint_callback callback, void* const opaque) noexcept -> bool
    {
        if (!callback) { return false; }
        try
        {
            const auto& c{ config() }; if (!c.ready) { return false; }
            auto& vm{ pn::rt() };
            std::unique_ptr<pn::scoped_attachment> attachment{};
            void* thread{ vm.current_thread() };
            if (!thread)
            {
                attachment = std::make_unique<pn::scoped_attachment>("VMHook-VM-operation");
                if (!attachment->valid()) { return false; }
                thread = attachment->get();
            }
            if (pn::thread_state(thread) != 4 && pn::thread_state(thread) != 6) { return false; }
            operation_payload payload{};
            payload.callback = callback; payload.opaque = opaque;
            std::copy(c.operation_vtable - 1, c.operation_vtable + c.operation_slots, payload.vtable.begin());
            payload.vtable[c.doit_slot + 1] = reinterpret_cast<void*>(&operation_doit);
            pn::store<void*>(payload.operation.data(), 0, payload.vtable.data() + 1);
            pn::vm_state_guard entered{ thread };
            c.execute(payload.operation.data());
            return true;
        }
        catch (...) { return false; }
    }
    template<typename value_type> inline auto atomic_bits(void* const method, const std::size_t offset, const std::uint32_t mask, const bool set) noexcept -> void
    {
        auto& cell{ *reinterpret_cast<value_type*>(static_cast<std::byte*>(method) + offset) };
        if (set) { std::atomic_ref<value_type>{cell}.fetch_or(static_cast<value_type>(mask), std::memory_order_relaxed); }
        else { std::atomic_ref<value_type>{cell}.fetch_and(static_cast<value_type>(~mask), std::memory_order_relaxed); }
    }
    inline auto load_word(const void* const method, const std::size_t offset, const std::size_t width) noexcept -> std::uint32_t
    {
        if (width == 1) { return pn::load<std::uint8_t>(method, offset); }
        if (width == 2) { return pn::load<std::uint16_t>(method, offset); }
        return pn::load<std::uint32_t>(method, offset);
    }
    inline auto inline_bits(void* const method, const std::uint32_t mask, const bool set) noexcept -> void
    {
        const auto& c{ config() };
        if (c.inline_width == 1) { atomic_bits<std::uint8_t>(method, c.inline_offset, mask, set); }
        else if (c.inline_width == 2) { atomic_bits<std::uint16_t>(method, c.inline_offset, mask, set); }
        else { atomic_bits<std::uint32_t>(method, c.inline_offset, mask, set); }
    }
    inline constexpr unsigned method_reason{1}, field_reason{2};
    struct method_policy final
    {
        vmhook::hotspot::method* method{};
        const void* const_method{};
        vmhook::hotspot::klass* field_holder{};
        std::uint16_t name_index{}, signature_index{};
        std::shared_ptr<void> field_metadata_pin{};
        std::uint32_t owned_compile{}, owned_inline{}, original_intrinsic{};
        void* original_i2i{};
        std::atomic<unsigned> reasons{};
        method_policy* next{};
        bool excluded{}, intrinsic_owned{}, entry_owned{};
    };
    // Nodes stay resident so class-definition callbacks need no registry mutex.
    // A zero-reason node owns no live metadata and is ignored by new lookups.
    inline std::atomic<method_policy*> policies{};
    inline std::atomic<bool> field_mode{};
    inline std::atomic<unsigned> active_class_definitions{};
    struct class_definition_guard final
    {
        class_definition_guard() noexcept
        { active_class_definitions.fetch_add(1, std::memory_order_acq_rel); }
        ~class_definition_guard()
        { active_class_definitions.fetch_sub(1, std::memory_order_acq_rel); }
        class_definition_guard(const class_definition_guard&) = delete;
        auto operator=(const class_definition_guard&) -> class_definition_guard& = delete;
    };
    inline auto find_policy(vmhook::hotspot::method* const method) noexcept -> method_policy*
    {
        const auto& c{ config() };
        const auto identity{ pn::load<void*>(method, c.const_method_offset) };
        const auto* const constants{ identity ? pn::load<void*>(identity, c.constants_offset) : nullptr };
        const auto holder{ constants ? pn::load<void*>(constants, c.holder_offset) : nullptr };
        for (auto* entry{ policies.load(std::memory_order_acquire) }; entry; entry = entry->next)
        {
            if (entry->reasons.load(std::memory_order_acquire) == 0) { continue; }
            if (entry->method == method && entry->const_method == identity) { return entry; }
            // Ordinary class linking may replace a JSR method with a shallow
            // clone and retire the original metadata despite the class mirror
            // root. Its immutable constant-pool member identity survives that
            // rewrite. Never dereference the retired Method pointer.
            if (entry->field_holder == holder && identity
                && entry->name_index == pn::load<std::uint16_t>(identity, c.name_index_offset)
                && entry->signature_index == pn::load<std::uint16_t>(identity, c.signature_index_offset))
            { return entry; }
        }
        return nullptr;
    }
    inline auto bind_field_identity(method_policy& policy, vmhook::hotspot::klass* const holder) noexcept -> void
    {
        const auto& c{ config() };
        policy.field_holder = holder;
        policy.name_index = pn::load<std::uint16_t>(policy.const_method, c.name_index_offset);
        policy.signature_index = pn::load<std::uint16_t>(policy.const_method, c.signature_index_offset);
    }
    inline auto current_policy_method(const method_policy& policy) noexcept -> vmhook::hotspot::method*
    {
        if (!policy.field_holder) { return policy.method; }
        const auto& c{ config() };
        auto* const array{ pn::load<void*>(policy.field_holder, c.klass_methods) };
        if (!array) { return nullptr; }
        const auto count{ pn::load<std::int32_t>(array, 0) };
        if (count < 0 || count > 65535) { return nullptr; }
        for (std::int32_t index{}; index < count; ++index)
        {
            auto* const method{ pn::load<vmhook::hotspot::method*>(array, 8 + sizeof(void*) * static_cast<std::size_t>(index)) };
            if (!method) { continue; }
            const auto* const cm{ pn::load<void*>(method, c.const_method_offset) };
            if (cm && pn::load<std::uint16_t>(cm, c.name_index_offset) == policy.name_index
                && pn::load<std::uint16_t>(cm, c.signature_index_offset) == policy.signature_index)
            { return method; }
        }
        return nullptr;
    }
    inline auto publish_policy(method_policy* const policy) noexcept -> void
    {
        auto* previous{ policies.load(std::memory_order_relaxed) };
        do { policy->next = previous; }
        while (!policies.compare_exchange_weak(previous, policy, std::memory_order_release, std::memory_order_relaxed));
    }
    inline auto suppress_accessor_intrinsic(method_policy& policy) noexcept -> void
    {
        if (policy.intrinsic_owned) { return; }
        const auto& c{ config() };
        auto* const method{ current_policy_method(policy) };
        if (!method) { return; }
        const auto original{ load_word(method, c.intrinsic_offset, c.intrinsic_width) };
        if (original == 0) { return; }
        policy.original_intrinsic = original;
        if (c.intrinsic_width == 1)
        { std::atomic_ref<std::uint8_t>{*reinterpret_cast<std::uint8_t*>(reinterpret_cast<std::byte*>(method) + c.intrinsic_offset)}.store(0, std::memory_order_release); }
        else
        { std::atomic_ref<std::uint16_t>{*reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::byte*>(method) + c.intrinsic_offset)}.store(0, std::memory_order_release); }
        policy.intrinsic_owned = true;
    }
    inline auto normalize_accessor_entry(method_policy& policy) noexcept -> void
    {
        if (!policy.intrinsic_owned || policy.entry_owned) { return; }
        const auto& c = config();
        auto* const method = current_policy_method(policy);
        if (!method) { return; }
        auto* const original = pn::load<void*>(method, c.i2i_offset);
        // An unlinked method must retain its null entry: the VM's link_method
        // still has to create its adapters and select the interpreter entry.
        if (!original) { return; }
        auto* const normal = (pn::method_access_flags(method) & 0x0020u)
            ? c.synchronized_method_entry : c.normal_method_entry;
        if (original == normal) { return; }
        policy.original_i2i = original;
        pn::store(method, c.i2i_offset, normal);
        if (!pn::load<void*>(method, c.method_code_offset)) {
            pn::store(method, c.from_interpreted_offset, normal);
        }
        // For a compiled method, the real deoptimization/clear_code protocol
        // refreshes its interpreted caller entry from this actual i2i entry.
        policy.entry_owned = true;
    }
    inline auto exclude(method_policy& policy, const bool field_accessor = false) noexcept -> bool
    {
        const auto& c{ config() };
        auto* const method{ current_policy_method(policy) };
        if (!method) { return false; }
        const auto before{ load_word(method, c.flags_offset, c.flags_width) };
        const auto inline_before{ load_word(method, c.inline_offset, c.inline_width) };
        // Do this first: compiled lambda-form intrinsics can otherwise make
        // Method::set_not_compilable return early as "always compilable".
        if (field_accessor) { suppress_accessor_intrinsic(policy); }
        const auto setter = [&](void* function)
        {
            if (c.old_setter_arguments) { reinterpret_cast<void(*)(void*,int,bool,const char*)>(function)(method, c.all_levels, false, "vmhook observer"); }
            else { reinterpret_cast<void(*)(void*,const char*,int,bool)>(function)(method, "vmhook observer", c.all_levels, false); }
        };
        setter(c.set_not_compilable); setter(c.set_not_osr_compilable);
        policy.owned_compile |= load_word(method, c.flags_offset, c.flags_width) ^ before;
        inline_bits(method, c.inline_mask, true);
        policy.owned_inline |= (load_word(method, c.inline_offset, c.inline_width) ^ inline_before) & c.inline_mask;
        // C2 expands library intrinsics before ordinary inlining policy and can
        // ignore dont_inline/not-compilable. Every static-field accessor must
        // execute its bytecodes, including e.g. StringUTF16.getChar/putChar.
        policy.excluded = true;
        return c.is_not_compilable(method, c.all_levels) && c.is_not_osr_compilable(method, c.all_levels);
    }
    inline auto restore(method_policy& policy) noexcept -> void
    {
        if (!policy.excluded) { return; }
        const auto& c{ config() };
        auto* const method{ current_policy_method(policy) };
        if (!method) { policy.excluded = false; policy.intrinsic_owned = false; policy.entry_owned = false; return; }
        inline_bits(method, policy.owned_inline, false);
        atomic_bits<std::uint32_t>(method, c.flags_offset, policy.owned_compile, false);
        if (policy.intrinsic_owned)
        {
            if (c.intrinsic_width == 1)
            {
                std::uint8_t expected{};
                (void)std::atomic_ref<std::uint8_t>{*reinterpret_cast<std::uint8_t*>(reinterpret_cast<std::byte*>(method) + c.intrinsic_offset)}.compare_exchange_strong(
                    expected, static_cast<std::uint8_t>(policy.original_intrinsic), std::memory_order_acq_rel);
            }
            else
            {
                std::uint16_t expected{};
                (void)std::atomic_ref<std::uint16_t>{*reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::byte*>(method) + c.intrinsic_offset)}.compare_exchange_strong(
                    expected, static_cast<std::uint16_t>(policy.original_intrinsic), std::memory_order_acq_rel);
            }
            policy.intrinsic_owned = false;
        }
        if (policy.entry_owned)
        {
            auto* const normal = (pn::method_access_flags(method) & 0x0020u)
                ? c.synchronized_method_entry : c.normal_method_entry;
            if (pn::load<void*>(method, c.i2i_offset) == normal)
            {
                pn::store(method, c.i2i_offset, policy.original_i2i);
                if (!pn::load<void*>(method, c.method_code_offset)) {
                    pn::store(method, c.from_interpreted_offset, policy.original_i2i);
                }
            }
            policy.entry_owned = false;
        }
        policy.excluded = false;
    }
    inline auto method_is_excluded(vmhook::hotspot::method* const method) noexcept -> bool
    {
        const auto& c{ config() };
        return c.ready && method && c.is_not_compilable(method, c.all_levels) && c.is_not_osr_compilable(method, c.all_levels)
            && (load_word(method, c.inline_offset, c.inline_width) & c.inline_mask) != 0;
    }
    struct compiler_scan final { unsigned active{}, count{}; };
    inline auto scan_compiler_thread(void* const closure, void* const thread) noexcept -> void
    {
        const auto& c{ config() };
        if (pn::load<void*>(thread, 0) != c.compiler_vtable) { return; }
        auto& result{ *static_cast<compiler_scan*>(pn::load<void*>(closure, sizeof(void*))) };
        ++result.count;
        if (pn::load<void*>(thread, c.task_offset)) { ++result.active; }
    }
    inline auto scan_compilers(void* const opaque) noexcept -> void
    {
        auto& result{ *static_cast<compiler_scan*>(opaque) }; result = {};
        void* table[]{ reinterpret_cast<void*>(&scan_compiler_thread) };
        void* closure[]{ table, &result };
        config().threads_do(closure);
    }
    inline auto deoptimize_all() noexcept -> void
    {
        const auto& c{ config() };
        if (c.deopt_mode == 2)
        {
            alignas(8) std::array<std::byte, 64> scope{};
            c.scope_construct(scope.data()); c.mark_all_scope(scope.data()); c.deoptimize(scope.data());
        }
        else
        {
            c.mark_all_plain();
            // The original VM_Deoptimize::doit does not consult object fields.
            // Supply the actual operation layout and original real vtable.
            alignas(8) std::array<std::byte, 64> operation{};
            pn::store<void*>(operation.data(), 0, c.operation_vtable);
            c.deoptimize(c.deopt_mode == 0 ? operation.data() : nullptr);
        }
    }
    struct metadata_scan final { void* wanted{}; bool found{}; };
    inline thread_local metadata_scan* plain_metadata_scan{};
    inline auto metadata_plain(void* const value) noexcept -> void
    { if (plain_metadata_scan && value == plain_metadata_scan->wanted) { plain_metadata_scan->found = true; } }
    inline auto metadata_closure(void* const closure, void* const value) noexcept -> void
    {
        auto* const scan{ static_cast<metadata_scan*>(pn::load<void*>(closure, sizeof(void*))) };
        if (value == scan->wanted) { scan->found = true; }
    }
    inline auto metadata_contains(void* const nmethod, vmhook::hotspot::method* const method) noexcept -> bool
    {
        const auto& c{ config() }; if (!c.ready || !nmethod || !method) { return false; }
        metadata_scan result{ method };
        if (c.metadata_closure)
        {
            void* table[]{ reinterpret_cast<void*>(&metadata_closure) }; void* closure[]{ table, &result };
            reinterpret_cast<void(*)(void*,void*)>(c.metadata_do)(nmethod, closure);
        }
        else
        {
            auto* const previous{ plain_metadata_scan }; plain_metadata_scan = &result;
            reinterpret_cast<void(*)(void*,void(*)(void*))>(c.metadata_do)(nmethod, &metadata_plain);
            plain_metadata_scan = previous;
        }
        return result.found;
    }
    inline std::mutex administration_mutex{};
    struct vm_state_restore final
    {
        void* thread{};
        bool restore{};
        ~vm_state_restore() { if (this->restore) { pn::transition_to_vm(this->thread); } }
    };
    // These jint states are audited in the exact private data profile, including
    // the anonymous source enum in Java 8: stop=0, run=1, shutdown=2.
    inline constexpr std::int32_t compile_jobs_stop{0}, compile_jobs_run{1}, compile_jobs_shutdown{2};
    struct compilation_pause final
    {
        bool original_compiler{}, compiler_owned{}, jobs_owned{}, paused{};
        std::int32_t original_jobs{};
    };
    inline auto stop_new_compile_jobs() noexcept -> void
    {
        auto jobs{ std::atomic_ref<std::int32_t>{*config().compile_jobs} };
        auto state{ jobs.load(std::memory_order_acquire) };
        // A VM or another owner may have permanently shut the compiler down.
        // Never replace that state with our temporary stop.
        while (state == compile_jobs_run
            && !jobs.compare_exchange_weak(state, compile_jobs_stop,
                std::memory_order_acq_rel, std::memory_order_acquire)) {}
    }
    inline auto pause_compilation(compilation_pause& pause) noexcept -> bool
    {
        auto jobs{ std::atomic_ref<std::int32_t>{*config().compile_jobs} };
        auto state{ jobs.load(std::memory_order_acquire) };
        if (state < compile_jobs_stop || state > compile_jobs_shutdown) { return false; }
        while (state == compile_jobs_run)
        {
            if (jobs.compare_exchange_weak(state, compile_jobs_stop,
                std::memory_order_acq_rel, std::memory_order_acquire))
            { pause.jobs_owned = true; break; }
        }
        pause.original_jobs = state;
        auto compiler{ std::atomic_ref<bool>{*config().use_compiler} };
        pause.original_compiler = compiler.exchange(false, std::memory_order_acq_rel);
        pause.compiler_owned = pause.original_compiler;
        pause.paused = true;
        return true;
    }
    inline auto resume_compilation(compilation_pause& pause) noexcept -> void
    {
        if (!pause.paused) { return; }
        auto jobs{ std::atomic_ref<std::int32_t>{*config().compile_jobs} };
        if (pause.jobs_owned)
        {
            auto expected{ compile_jobs_stop };
            (void)jobs.compare_exchange_strong(expected, pause.original_jobs,
                std::memory_order_acq_rel, std::memory_order_acquire);
        }
        if (pause.compiler_owned && !(jobs.load(std::memory_order_acquire) == compile_jobs_shutdown
            && pause.original_jobs != compile_jobs_shutdown))
        {
            bool expected{false};
            (void)std::atomic_ref<bool>{*config().use_compiler}.compare_exchange_strong(
                expected, pause.original_compiler, std::memory_order_acq_rel, std::memory_order_acquire);
        }
        pause.paused = false;
    }
    inline auto scan_paused_compilers(void* const opaque) noexcept -> void
    { stop_new_compile_jobs(); scan_compilers(opaque); }
    struct install_transaction final
    {
        method_policy* policy{};
        bool (*commit)(void*) noexcept{};
        void* opaque{};
        compilation_pause pause{};
        bool okay{};
    };
    inline auto pause_and_exclude(void* const opaque) noexcept -> void
    {
        auto& transaction{ *static_cast<install_transaction*>(opaque) };
        if (!pause_compilation(transaction.pause)) { return; }
        transaction.okay = transaction.policy->excluded || exclude(*transaction.policy);
    }
    inline auto commit_install(void* const opaque) noexcept -> void
    {
        auto& transaction{ *static_cast<install_transaction*>(opaque) };
        deoptimize_all(); transaction.okay = transaction.commit(transaction.opaque);
        if (!transaction.okay && (transaction.policy->reasons.fetch_and(~method_reason) & ~method_reason) == 0) { restore(*transaction.policy); }
        resume_compilation(transaction.pause);
    }
    inline auto rollback_install(void* const opaque) noexcept -> void
    {
        auto& transaction{ *static_cast<install_transaction*>(opaque) };
        if ((transaction.policy->reasons.fetch_and(~method_reason) & ~method_reason) == 0) { restore(*transaction.policy); }
        resume_compilation(transaction.pause);
    }
    inline auto install_method_policy(vmhook::hotspot::method* const method,
        bool (*commit)(void*) noexcept, void* const opaque, std::shared_ptr<void>& retained_policy) noexcept -> bool
    {
        try
        {
            const auto& c{ config() };
            if (!c.ready || !method || !commit || !return_handler(method)
                || !vmhook::detail::borrowed_callback_supported()) { return false; }
            // Intrinsic entry suppression is enabled only after its independent
            // compiler protocol proof. Ordinary bytecode methods are supported.
            if (load_word(method, c.intrinsic_offset, c.intrinsic_width) != 0) { return false; }
            auto& vm{ pn::rt() };
            const auto thread{ vm.current_thread() };
            const bool began_in_vm{ thread && pn::thread_state(thread) == 6 };
            if (began_in_vm) { pn::transition_to_native(thread); }
            const vm_state_restore state{ thread, began_in_vm };
            // A cancellation enters HotSpot's real return template at BCI0.
            // Its polls must scan the additional, synthetic reference TOS.
            if (!vmhook::detail::prepare_callback_return_roots()) { return false; }
            std::lock_guard admin{ administration_mutex };
            method_policy* policy{ find_policy(method) };
            const bool existing{ policy != nullptr };
            std::unique_ptr<method_policy> prepared_policy{};
            if (!policy)
            {
                prepared_policy = std::make_unique<method_policy>();
                policy = prepared_policy.get();
                policy->method = method; policy->const_method = pn::load<void*>(method, c.const_method_offset);
            }
            // Allocate the shared control block before any policy is published
            // or flags are changed. An allocation failure cannot leave a live
            // reason pointing at metadata whose installer root is about to end.
            retained_policy = std::shared_ptr<void>{policy, [](void*) noexcept {}};
            policy->reasons.fetch_or(method_reason, std::memory_order_release);
            if (!existing) { publish_policy(prepared_policy.release()); }
            install_transaction transaction{ policy, commit, opaque };
            bool okay{ at_safepoint(&pause_and_exclude, &transaction) && transaction.okay };
            compiler_scan scan{};
            if (okay)
            {
                for (unsigned attempt{}; attempt < 3000; ++attempt)
                {
                    if (!at_safepoint(&scan_paused_compilers, &scan)) { okay = false; break; }
                    if (scan.active == 0) { break; }
                    std::this_thread::sleep_for(std::chrono::milliseconds{10});
                    if (attempt == 2999) { okay = false; }
                }
            }
            if (okay) { okay = at_safepoint(&commit_install, &transaction) && transaction.okay; }
            if (!okay)
            {
                if (!at_safepoint(&rollback_install, &transaction))
                {
                    // Never leave an internal temporary VM compiler pause behind
                    // if a VM operation fails before entering its callback.
                    resume_compilation(transaction.pause);
                }
                retained_policy.reset(); return false;
            }
            return true;
        }
        catch (...) { return false; }
    }
    inline auto release_method_policy_at_safepoint(const std::shared_ptr<void>& opaque) noexcept -> void
    {
        if (!opaque) { return; }
        auto& policy{ *static_cast<method_policy*>(opaque.get()) };
        if ((policy.reasons.fetch_and(~method_reason) & ~method_reason) == 0) { restore(policy); }
    }

    inline auto has_static_field_bytecodes(vmhook::hotspot::method* const method) noexcept -> bool
    {
        const auto& c{ config() };
        const auto* cm{ pn::load<void*>(method, c.const_method_offset) };
        if (!cm) { return false; }
        const std::size_t size{ pn::load<std::uint16_t>(cm, c.code_size_offset) };
        const auto* code{ static_cast<const std::uint8_t*>(cm) + c.const_method_size };
        const auto signed_word = [&](const std::size_t at) noexcept -> std::int32_t
        {
            const std::uint32_t bits{ (std::uint32_t{code[at]} << 24) | (std::uint32_t{code[at+1]} << 16)
                | (std::uint32_t{code[at+2]} << 8) | std::uint32_t{code[at+3]} };
            return std::bit_cast<std::int32_t>(bits);
        };
        for (std::size_t bci{}; bci < size;)
        {
            const unsigned opcode{ code[bci] };
            if (opcode == 178 || opcode == 179) { return true; }
            std::size_t length{ c.bytecode_lengths[opcode] & 15u };
            if (opcode == 196)
            {
                if (bci + 1 >= size) { return true; }
                length = c.bytecode_lengths[code[bci+1]] >> 4;
            }
            else if (opcode == 170 || opcode == 171 || opcode == c.fast_linear_switch || opcode == c.fast_binary_switch)
            {
                const std::size_t aligned{ (bci + 4) & ~std::size_t{3} };
                if (aligned > size || size - aligned < 8) { return true; }
                if (opcode == 170)
                {
                    if (size - aligned < 12) { return true; }
                    const std::int64_t count{ std::int64_t{signed_word(aligned+8)} - signed_word(aligned+4) + 1 };
                    if (count < 0 || static_cast<std::uint64_t>(count) > (size - aligned - 12) / 4) { return true; }
                    length = aligned - bci + 12 + static_cast<std::size_t>(count) * 4;
                }
                else
                {
                    const auto count{ signed_word(aligned+4) };
                    if (count < 0 || static_cast<std::size_t>(count) > (size - aligned - 8) / 8) { return true; }
                    length = aligned - bci + 8 + static_cast<std::size_t>(count) * 8;
                }
            }
            // Unknown, breakpoint or malformed bytecodes are conservatively
            // interpreted. No operand byte can be mistaken for a field opcode.
            if (length == 0 || length > size - bci) { return true; }
            bci += length;
        }
        return false;
    }
    inline auto include_field_policy(method_policy* const policy) noexcept -> void
    {
        if (auto* const existing{ find_policy(policy->method) })
        {
            existing->owned_compile |= policy->owned_compile;
            existing->owned_inline |= policy->owned_inline;
            if (policy->intrinsic_owned && !existing->intrinsic_owned)
            {
                existing->original_intrinsic = policy->original_intrinsic;
                existing->intrinsic_owned = true;
            }
            if (policy->entry_owned && !existing->entry_owned)
            {
                existing->original_i2i = policy->original_i2i;
                existing->entry_owned = true;
            }
            if (!existing->field_holder && policy->field_holder)
            {
                existing->field_holder = policy->field_holder;
                existing->name_index = policy->name_index;
                existing->signature_index = policy->signature_index;
            }
            if (!existing->field_metadata_pin) { existing->field_metadata_pin = std::move(policy->field_metadata_pin); }
            existing->reasons.fetch_or(field_reason, std::memory_order_release);
            delete policy;
        }
        else
        {
            policy->reasons.store(field_reason, std::memory_order_release); publish_policy(policy);
        }
    }
    struct class_lifetime_flags final
    {
        struct field final { std::size_t offset{}, width{}; std::uint32_t mask{}; };
        field anonymous{}, hidden{};
        std::uint8_t loaded{}, linked{};
        bool ready{};
        class_lifetime_flags() noexcept
        {
            try
            {
                auto& vm{ pn::rt() };
                const auto read = [&](const char* offset, const char* width, const char* mask)
                {
                    field value{ static_cast<std::size_t>(vm.enum_value("ObservationABI", offset)),
                        static_cast<std::size_t>(vm.enum_value("ObservationABI", width)),
                        static_cast<std::uint32_t>(vm.enum_value("ObservationABI", mask)) };
                    if ((value.width != 0 && value.width != 1 && value.width != 2 && value.width != 4)
                        || ((value.width == 0) != (value.mask == 0))) { throw std::runtime_error("Unsupported class lifetime flags"); }
                    return value;
                };
                anonymous = read("anonymous_klass_offset", "anonymous_klass_width", "anonymous_klass_mask");
                hidden = read("hidden_klass_offset", "hidden_klass_width", "hidden_klass_mask");
                const auto loaded_state = vm.enum_value("InstanceKlass::ClassState", "loaded");
                const auto linked_state = vm.enum_value("InstanceKlass::ClassState", "linked");
                const auto initializing_state = vm.enum_value("InstanceKlass::ClassState", "being_initialized");
                if (loaded_state <= 0 || linked_state <= loaded_state
                    || initializing_state <= linked_state
                    || initializing_state > std::numeric_limits<std::uint8_t>::max())
                { throw std::runtime_error("Unsupported class state ordering"); }
                loaded = static_cast<std::uint8_t>(loaded_state);
                linked = static_cast<std::uint8_t>(linked_state);
                ready = vm.ready && (anonymous.mask || hidden.mask);
            }
            catch (...) {}
        }
    };
    auto lifetime_flags() noexcept -> const class_lifetime_flags&
    { static const class_lifetime_flags value{}; return value; }
    inline auto transient_class_metadata(const void* const klass) noexcept -> bool
    {
        const auto state{ pn::load<std::uint8_t>(klass, config().klass_state) };
        if (state == 0) { return true; }
        const auto& flags{ lifetime_flags() };
        if (state >= flags.linked) { return false; }
        // Java20 and Java22 insert being_linked between loaded and linked.
        // Defer those in-progress rewrites before retaining Method metadata.
        if (state > flags.loaded) { return true; }
        const auto matches = [&](const class_lifetime_flags::field& field)
        { return field.mask && (load_word(klass, field.offset, field.width) & field.mask) != 0; };
        // Hidden/anonymous classes enter the hierarchy in loaded state before
        // mandatory linking. A failed link can explicitly free their metadata
        // even while their mirror is rooted. Ordinary accepted lazy classes
        // can stay loaded indefinitely and must remain eligible.
        return matches(flags.anonymous) || matches(flags.hidden);
    }
    inline auto collect_field_policies(void* const opaque) noexcept -> void
    {
        auto& okay{ *static_cast<bool*>(opaque) };
        try
        {
            const auto& c{ config() };
            for (auto* cld{ *c.class_loader_head }; cld; cld = pn::load<void*>(cld, c.cld_next))
            {
                for (auto* klass{ static_cast<vmhook::hotspot::klass*>(pn::load<void*>(cld, c.cld_klasses)) };
                    klass; klass = static_cast<vmhook::hotspot::klass*>(pn::load<void*>(klass, c.klass_next)))
                {
                    if (pn::load<std::int32_t>(klass, c.klass_layout) < 0 || transient_class_metadata(klass)) { continue; }
                    vmhook::hotspot::method** methods{}; std::int32_t count{};
                    if (!vmhook::hotspot::safe_klass_methods(klass, methods, count)) { continue; }
                    std::shared_ptr<void> pin{};
                    for (std::int32_t index{}; index < count; ++index)
                    {
                        auto* const method{ methods[index] };
                        if (!method || !has_static_field_bytecodes(method)) { continue; }
                        if (auto* const existing{ find_policy(method) })
                        {
                            if (!existing->field_metadata_pin)
                            {
                                if (!pin) { pin = vmhook::detail::retain_hook_klass(klass); }
                                if (!pin) { okay = false; return; }
                                existing->field_metadata_pin = pin;
                            }
                            if (!method_is_excluded(method))
                            {
                                if (!exclude(*existing, true)) { okay = false; return; }
                            }
                            else { suppress_accessor_intrinsic(*existing); }
                            existing->reasons.fetch_or(field_reason, std::memory_order_release); continue;
                        }
                        if (!pin) { pin = vmhook::detail::retain_hook_klass(klass); }
                        if (!pin) { okay = false; return; }
                        auto policy{ std::make_unique<method_policy>() };
                        policy->method = method; policy->const_method = pn::load<void*>(method, c.const_method_offset);
                        policy->field_metadata_pin = pin;
                        bind_field_identity(*policy, klass);
                        if (!exclude(*policy, true)) { restore(*policy); okay = false; return; }
                        include_field_policy(policy.release());
                    }
                }
            }
        }
        catch (...) { okay = false; }
    }
    struct field_transaction final
    {
        compilation_pause pause{};
        bool paused{}, complete{};
    };
    inline auto pause_for_fields(void* const opaque) noexcept -> void
    {
        auto& transaction{ *static_cast<field_transaction*>(opaque) };
        transaction.paused = pause_compilation(transaction.pause);
        if (!transaction.paused) { return; }
        field_mode.store(true, std::memory_order_release);
    }
    // Called at the final real safepoint, without C++ allocation, root creation
    // or registry locks. The graph cannot change between this verification and
    // deoptimization/compiler resumption. Definitions that entered the original
    // function before our detour existed are covered by this graph scan too.
    inline auto field_graph_ready() noexcept -> bool
    {
        if (active_class_definitions.load(std::memory_order_acquire) != 0) { return false; }
        const auto& c{ config() };
        for (auto* cld{ *c.class_loader_head }; cld; cld = pn::load<void*>(cld, c.cld_next))
        {
            for (auto* klass{ pn::load<void*>(cld, c.cld_klasses) }; klass; klass = pn::load<void*>(klass, c.klass_next))
            {
                if (pn::load<std::int32_t>(klass, c.klass_layout) < 0) { continue; }
                // A scratch or still-linking hidden class can be explicitly
                // freed after a failed definition despite its mirror root.
                if (transient_class_metadata(klass))
                {
                    // JFR's initial schema transformation leaves its discarded
                    // allocated InstanceKlass on this CLD until a later cleanup
                    // safepoint. Only a queued Klass is known to be retired;
                    // never skip an in-progress definition based on state alone.
                    const auto* retired = pn::load<void*>(cld, c.cld_deallocate);
                    bool queued{};
                    if (retired)
                    {
                        const auto count = pn::load<std::int32_t>(retired, c.deallocate_length);
                        const auto* data = pn::load<void**>(retired, c.deallocate_data);
                        if (count < 0 || count > 1048576 || (count && !data)) { return false; }
                        for (std::int32_t index{}; index < count; ++index)
                        { if (data[index] == klass) { queued = true; break; } }
                    }
                    if (queued) { continue; }
                    return false;
                }
                auto* const array{ pn::load<void*>(klass, c.klass_methods) };
                if (!array) { return false; }
                const auto count{ pn::load<std::int32_t>(array, 0) };
                if (count < 0 || count > 65535) { return false; }
                for (std::int32_t index{}; index < count; ++index)
                {
                    auto* const method{ pn::load<vmhook::hotspot::method*>(array, 8 + sizeof(void*) * static_cast<std::size_t>(index)) };
                    if (method && has_static_field_bytecodes(method)
                        && (!method_is_excluded(method) || load_word(method, c.intrinsic_offset, c.intrinsic_width) != 0))
                    { return false; }
                }
            }
        }
        return true;
    }
    inline auto finish_fields(void* const opaque) noexcept -> void
    {
        auto& transaction{ *static_cast<field_transaction*>(opaque) };
        stop_new_compile_jobs();
        compiler_scan scan{}; scan_compilers(&scan);
        if (scan.active != 0 || !field_graph_ready()) { return; }
        for (auto* policy = policies.load(std::memory_order_acquire); policy; policy = policy->next)
        {
            if ((policy->reasons.load(std::memory_order_acquire) & field_reason) != 0) {
                normalize_accessor_entry(*policy);
            }
        }
        deoptimize_all();
        resume_compilation(transaction.pause);
        transaction.paused = false; transaction.complete = true;
    }
    inline auto restore_fields_at_safepoint(void*) noexcept -> void
    {
        field_mode.store(false, std::memory_order_release);
        for (auto* policy{ policies.load(std::memory_order_acquire) }; policy; policy = policy->next)
        {
            const auto reasons{ policy->reasons.load() };
            if ((reasons & field_reason) != 0 && (policy->reasons.fetch_and(~field_reason) & ~field_reason) == 0) { restore(*policy); }
        }
    }
    inline auto release_field_pins() noexcept -> void
    {
        for (auto* policy{ policies.load(std::memory_order_acquire) }; policy; policy = policy->next)
        { if ((policy->reasons.load() & field_reason) == 0) { policy->field_metadata_pin.reset(); } }
    }
    inline auto acquire_field_interpretation() noexcept -> bool
    {
        try
        {
            const auto& c{ config() };
            if (!c.ready || !lifetime_flags().ready || !vmhook::detail::borrowed_callback_supported() || !vmhook::detail::prepare_hook_roots()
                || !vmhook::detail::ensure_class_events_installed()) { return false; }
            auto& vm{ pn::rt() }; const auto thread{ vm.current_thread() };
            const bool began_in_vm{ thread && pn::thread_state(thread) == 6 };
            if (began_in_vm) { pn::transition_to_native(thread); }
            const vm_state_restore state{thread,began_in_vm};
            std::lock_guard admin{ administration_mutex };
            if (field_mode.load()) { return true; }
            field_transaction transaction{};
            bool okay{ at_safepoint(&pause_for_fields, &transaction) && transaction.paused };
            const auto deadline{ std::chrono::steady_clock::now() + std::chrono::seconds{30} };
            while (okay && !transaction.complete && std::chrono::steady_clock::now() < deadline)
            {
                // Root tokens, containers and new policy nodes are prepared on
                // this mutator outside the safepoint while compiler jobs stay
                // paused. Class-definition guards prepare their own new nodes.
                okay = with_vm_state(&collect_field_policies, &okay) && okay;
                compiler_scan scan{};
                while (okay)
                {
                    if (!at_safepoint(&scan_paused_compilers, &scan)) { okay = false; break; }
                    if (scan.active == 0) { break; }
                    if (std::chrono::steady_clock::now() >= deadline) { okay = false; break; }
                    std::this_thread::sleep_for(std::chrono::milliseconds{10});
                }
                if (okay) { okay = at_safepoint(&finish_fields, &transaction); }
                if (okay && !transaction.complete) { std::this_thread::sleep_for(std::chrono::milliseconds{10}); }
            }
            okay = okay && transaction.complete;
            if (!okay)
            {
                (void)at_safepoint(&restore_fields_at_safepoint, nullptr);
                resume_compilation(transaction.pause);
                release_field_pins();
            }
            return okay;
        }
        catch (...) { return false; }
    }
    inline auto release_field_interpretation() noexcept -> void
    {
        try
        {
            {
                std::lock_guard admin{ administration_mutex };
                if (field_mode.load() && at_safepoint(&restore_fields_at_safepoint, nullptr)) { release_field_pins(); }
            }
            vmhook::detail::flush_hook_roots();
        }
        catch (...) {}
    }
    struct provisional_class final
    {
        vmhook::hotspot::klass* klass{};
        std::vector<std::unique_ptr<method_policy>> methods{};
    };
    auto pending_class_records() -> std::vector<provisional_class>&
    {
        static thread_local std::vector<provisional_class> value{};
        return value;
    }
}
export namespace vmhook::detail
{
    inline auto prepare_class_hooks(vmhook::hotspot::klass* const klass) noexcept -> bool
    {
        using namespace jit_backend;
        if (!klass || !field_mode.load(std::memory_order_acquire)) { return true; }
        provisional_class pending{}; pending.klass = klass;
        try
        {
            vmhook::hotspot::method** methods{}; std::int32_t count{};
            if (!vmhook::hotspot::safe_klass_methods(klass, methods, count)) { return true; }
            auto& records{ pending_class_records() };
            records.reserve(records.size() + 1);
            pending.methods.reserve(static_cast<std::size_t>(count));
            std::shared_ptr<void> pin{};
            for (std::int32_t index{}; index < count; ++index)
            {
                auto* const method{ methods[index] }; if (!method || !has_static_field_bytecodes(method)) { continue; }
                if (!pin) { pin = retain_hook_klass(klass); }
                if (!pin) { return false; }
                auto policy{ std::make_unique<method_policy>() };
                policy->method = method; policy->const_method = pn::load<void*>(method, config().const_method_offset);
                policy->field_metadata_pin = pin;
                bind_field_identity(*policy, klass);
                pending.methods.push_back(std::move(policy));
            }
            // Everything that can allocate is ready before the first flag or
            // intrinsic ID changes. Publication below uses reserved storage.
            for (auto& policy : pending.methods)
            {
                if (!exclude(*policy, true))
                {
                    for (auto& rollback : pending.methods) { restore(*rollback); }
                    return false;
                }
                normalize_accessor_entry(*policy);
            }
            records.push_back(std::move(pending));
            return true;
        }
        catch (...)
        {
            for (auto& policy : pending.methods) { restore(*policy); }
            return false;
        }
    }
    inline auto finish_class_hooks(vmhook::hotspot::klass* const klass, const bool success) noexcept -> void
    {
        using namespace jit_backend;
        auto& pending_classes{ pending_class_records() };
        for (std::size_t index{pending_classes.size()}; index > 0; --index)
        {
            if (pending_classes[index-1].klass != klass) { continue; }
            auto pending{ std::move(pending_classes[index-1]) };
            pending_classes.erase(pending_classes.begin() + static_cast<std::ptrdiff_t>(index-1));
            if (!success)
            {
                // The caller can immediately free rejected scratch metadata.
                // Release its mirror roots in this VM-state critical section.
                for (auto& policy : pending.methods) { restore(*policy); }
                return;
            }
            for (auto& policy : pending.methods)
            {
                if (field_mode.load(std::memory_order_acquire)) { include_field_policy(policy.release()); }
                else { restore(*policy); }
            }
            return;
        }
        // Definition can have begun before activation of the field policy.
        if (success && field_mode.load(std::memory_order_acquire))
        {
            if (!prepare_class_hooks(klass))
            { fail_class_hook_preparation(pn::rt().current_thread()); return; }
            if (!pending_classes.empty() && pending_classes.back().klass == klass) { finish_class_hooks(klass, true); }
        }
    }
}
// VMHOOK_JIT_BACKEND_END


// VMHOOK_NATIVE_FACADE_BEGIN
export namespace vmhook::detail::native_backend
{
    struct context_lifetime final
    {
        std::atomic<bool> alive{ false };
        vmhook::windows::DWORD owner_id{};
        void* thread{};
        std::unique_ptr<vmhook::detail::private_native::scoped_attachment> attachment{};
        std::unique_ptr<vmhook::detail::private_native::java_session> session{};
        std::shared_ptr<context_lifetime> self_keepalive{};
        std::mutex releases_mutex{};
        std::vector<void**> releases{};
        std::vector<void**> reusable{};
        std::unordered_map<void**, std::weak_ptr<root_ticket>> tickets{};
        std::size_t allocated_slots{};
        std::size_t operation_depth{};
        std::size_t temporary_depth{};
        vmhook::detail::private_native::root_slot_provider previous_provider{};

        auto drain_releases() noexcept -> void
        {
            std::vector<void**> pending{};
            {
                std::lock_guard lock{ this->releases_mutex };
                pending.swap(this->releases);
            }
            for (void** const slot : pending)
            {
                const auto found{ this->tickets.find(slot) };
                if (found != this->tickets.end() && !found->second.expired()) { continue; }
                if (found != this->tickets.end()) { this->tickets.erase(found); }
                void* null{};
                std::memcpy(slot, &null, sizeof(null));
                try { this->reusable.push_back(slot); }
                catch (...) { /* A cleared slot remains safe if recycling cannot allocate. */ }
            }
        }
    };

    // The module owns this TLS slot. It carries no destructor and never detaches
    // under the Windows loader lock. The public context closes on its owner thread.
    auto current_context_lifetime() noexcept -> context_lifetime*&
    {
        static thread_local context_lifetime* current{};
        return current;
    }

    inline auto active_context_lifetime() noexcept -> std::shared_ptr<context_lifetime>
    {
        auto* const current{ current_context_lifetime() };
        if (!current || current->owner_id != vmhook::windows::GetCurrentThreadId()
            || !current->alive.load(std::memory_order_acquire)) { return {}; }
        return current->self_keepalive;
    }

    inline auto note_root_allocation(void* const thread) noexcept -> void
    {
        auto* const context{current_context_lifetime()};
        if (context && context->thread == thread && context->temporary_depth == 0
            && context->owner_id == vmhook::windows::GetCurrentThreadId()
            && context->alive.load(std::memory_order_acquire))
        { ++context->allocated_slots; }
    }

    inline auto active() noexcept -> bool
    {
        const auto current{ active_context_lifetime() };
        if (!current || current->temporary_depth != 0) { return false; }
        try
        {
            if (vmhook::detail::private_native::rt().current_thread() != current->thread) { return false; }
            const int state{ vmhook::detail::private_native::thread_state(current->thread) };
            return state == 4 || state == 6;
        }
        catch (...) { return false; }
    }

    inline operation::operation() noexcept
        {
            this->context_ = active_context_lifetime();
            if (!this->context_ || this->context_->temporary_depth != 0) { return; }
            try
            {
                this->thread_ = this->context_->thread;
                if (vmhook::detail::private_native::rt().current_thread() != this->thread_) { return; }
                const int state{ vmhook::detail::private_native::thread_state(this->thread_) };
                if (state == 4)
                {
                    vmhook::detail::private_native::transition_to_vm(this->thread_);
                    this->entered_ = true;
                }
                else if (state != 6) { return; }
                if (this->context_->operation_depth == 0) { this->context_->drain_releases(); }
                ++this->context_->operation_depth;
                this->valid_ = true;
            }
            catch (...)
            {
                if (this->entered_)
                {
                    vmhook::detail::private_native::transition_to_native(this->thread_);
                    this->entered_ = false;
                }
                this->context_.reset();
            }
        }
    inline operation::~operation()
        {
            if (this->valid_) { --this->context_->operation_depth; }
            if (this->entered_) { vmhook::detail::private_native::transition_to_native(this->thread_); }
        }

    struct root_ticket final
    {
        std::weak_ptr<context_lifetime> owner{};
        void** slot{};

        ~root_ticket()
        {
            const auto context{ this->owner.lock() };
            if (!context || !this->slot || !context->alive.load(std::memory_order_acquire)) { return; }
            // Destruction may occur on a different OS thread. Queue C++ bookkeeping
            // only; mutate the scanned VM root on the owner's next VM operation.
            try
            {
                std::lock_guard lock{ context->releases_mutex };
                if (context->alive.load(std::memory_order_acquire)) { context->releases.push_back(this->slot); }
            }
            catch (...) { /* Retain until context closure if the queue cannot grow. */ }
        }

        [[nodiscard]] auto valid() const noexcept -> bool
        {
            const auto context{ this->owner.lock() };
            return this->slot && context && context->alive.load(std::memory_order_acquire)
                && context->owner_id == vmhook::windows::GetCurrentThreadId()
                && current_context_lifetime() == context.get();
        }

        [[nodiscard]] auto resolve_under_vm() const noexcept -> void*
        {
            if (!this->valid()) { return nullptr; }
            try
            {
                const auto context{ this->owner.lock() };
                if (vmhook::detail::private_native::rt().current_thread() != context->thread) { return nullptr; }
                const int state{ vmhook::detail::private_native::thread_state(context->thread) };
                if (state != 6 && !(state == 8 && vmhook::hotspot::in_java_detour())) { return nullptr; }
                return vmhook::detail::private_native::detail::resolve_root(this->slot);
            }
            catch (...) { return nullptr; }
        }

        [[nodiscard]] auto resolve() const noexcept -> void*
        {
            if (!this->valid()) { return nullptr; }
            operation access{};
            return this->resolve_under_vm();
        }
    };

    inline auto reuse_root_slot(void* const thread) noexcept -> void**
    {
        auto* const context{ current_context_lifetime() };
        if (!context || !context->alive.load(std::memory_order_acquire)
            || context->owner_id != vmhook::windows::GetCurrentThreadId()
            || context->thread != thread || context->reusable.empty()) { return nullptr; }
        try
        {
            if (vmhook::detail::private_native::thread_state(thread) != 6) { return nullptr; }
            void** const slot{ context->reusable.back() };
            context->reusable.pop_back();
            return slot;
        }
        catch (...) { return nullptr; }
    }

    inline auto retain_root_slot(void** const slot) -> root
    {
        const auto context{ active_context_lifetime() };
        if (!context || !slot || context->temporary_depth != 0) { return {}; }
        try
        {
            if (vmhook::detail::private_native::thread_state(context->thread) != 6) { return {}; }
            const auto found{ context->tickets.find(slot) };
            if (found != context->tickets.end())
            {
                if (auto existing{ found->second.lock() }) { return existing; }
            }
            auto ticket{ std::make_shared<root_ticket>() };
            ticket->owner = context;
            context->tickets[slot] = ticket;
            ticket->slot = slot;
            return ticket;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (...) { return {}; }
    }

    inline auto retain_oop(void* const oop) -> root
    {
        if (!oop) { return {}; }
        const auto context{ active_context_lifetime() };
        if (!context || context->temporary_depth != 0) { return {}; }
        try
        {
            if (vmhook::detail::private_native::thread_state(context->thread) != 6) { return {}; }
            void** const slot{ vmhook::detail::private_native::detail::root_oop(context->thread, oop) };
            root ticket{};
            try { ticket = retain_root_slot(slot); }
            catch (...)
            {
                if (slot) { void* null{}; std::memcpy(slot, &null, sizeof(null)); }
                throw;
            }
            if (slot && !ticket)
            {
                void* null{};
                std::memcpy(slot, &null, sizeof(null));
                try { context->reusable.push_back(slot); } catch (...) {}
            }
            return ticket;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (...) { return {}; }
    }

    inline auto retain_class(vmhook::hotspot::klass* const klass) -> root
    {
        return klass ? retain_oop(klass->get_java_mirror()) : root{};
    }

    inline auto reserve_result_root(vmhook::hotspot::klass* const klass) -> root
    {
        auto result{ retain_class(klass) };
        if (result)
        {
            void* null{};
            std::memcpy(result->slot, &null, sizeof(null));
        }
        return result;
    }

    inline auto promote_root(root destination, void** const temporary_slot) noexcept -> root
    {
        if (!destination || !destination->valid()) { return {}; }
        void* const oop{ vmhook::detail::private_native::detail::resolve_root(temporary_slot) };
        std::memcpy(destination->slot, &oop, sizeof(oop));
        return oop ? std::move(destination) : root{};
    }

    class temporary_vm_scope final
    {
        std::shared_ptr<context_lifetime> context_;
        vmhook::detail::private_native::root_slot_provider provider_;
        vmhook::detail::private_native::detail::handle_mark mark_;
    public:
        explicit temporary_vm_scope(std::shared_ptr<context_lifetime> context)
            : context_{ std::move(context) },
              provider_{ vmhook::detail::private_native::root_reuse_callback() },
              mark_{ this->context_->thread }
        {
            ++this->context_->temporary_depth;
            vmhook::detail::private_native::root_reuse_callback() = nullptr;
        }
        ~temporary_vm_scope()
        {
            vmhook::detail::private_native::root_reuse_callback() = this->provider_;
            --this->context_->temporary_depth;
        }
        temporary_vm_scope(const temporary_vm_scope&) = delete;
        auto operator=(const temporary_vm_scope&) -> temporary_vm_scope& = delete;
    };

    inline auto loaded_class(const std::string_view name,
                            vmhook::hotspot::klass* const preferred) -> vmhook::hotspot::klass*
    {
        operation access{};
        if (!access || name.empty()) { return nullptr; }
        try
        {
            if (name.front() == '[') { return vmhook::resolve_array_klass(name); }
            vmhook::hotspot::klass* result{};
            bool found_preferred{};
            bool ambiguous{};
            const vmhook::hotspot::class_loader_data_graph graph{};
            graph.for_each_klass([&](const std::string_view observed_name, vmhook::hotspot::klass* const klass)
            {
                if (observed_name != name) { return; }
                if (klass == preferred) { result = klass; found_preferred = true; }
                else if (!found_preferred)
                {
                    if (result && result != klass) { ambiguous = true; }
                    else { result = klass; }
                }
            });
            return found_preferred || !ambiguous ? result : nullptr;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (...) { return nullptr; }
    }

    inline auto refresh(void** const owner, const root& ticket) noexcept -> void*
    {
        void* const current{ ticket ? ticket->resolve_under_vm() : owner ? *owner : nullptr };
        if (owner) { *owner = current; }
        return current;
    }

    inline auto raise_pending_exception(const std::shared_ptr<context_lifetime>& context,
                                        const root& reserved,
                                        const std::string_view message) -> void
    {
        void* const pending{ vmhook::detail::private_native::pending_exception(context->thread) };
        if (!pending) { return; }
        if (reserved && reserved->valid()) { std::memcpy(reserved->slot, &pending, sizeof(pending)); }
        // Copying diagnostics may allocate. Consume the thread slot before that
        // work while the Throwable remains retained by the reserved VM root.
        context->session->clear_exception();
        std::string class_name;
        if (auto* const klass{ vmhook::klass_from_oop(pending) })
        { if (auto* const name{ klass->get_name() }) { class_name = name->to_string(); } }
        throw vmhook::exception{ message, vmhook::error_code::java_exception, std::move(class_name), reserved };
    }

    inline auto allocate(vmhook::hotspot::klass* const klass) -> root
    {
        operation access{};
        const auto context{ active_context_lifetime() };
        if (!access || !context || !klass) { return {}; }
        try
        {
            const auto metadata{ retain_class(klass) };
            if (!metadata) { return {}; }
            auto result{ reserve_result_root(klass) };
            if (!result) { return {}; }
            const auto reserved_exception{ reserve_result_root(klass) };
            if (!reserved_exception) { return {}; }
            temporary_vm_scope temporary{ context };
            result = promote_root(std::move(result), context->session->allocate(klass));
            raise_pending_exception(context, reserved_exception, "Java allocation threw an exception");
            return result;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (const vmhook::exception&) { throw; }
        catch (...) { return {}; }
    }

    inline auto make_string_utf16(const std::u16string_view text) -> root
    {
        operation access{};
        const auto context{ active_context_lifetime() };
        if (!access || !context) { return {}; }
        try
        {
            auto* const klass{ vmhook::find_class("java/lang/String") };
            auto result{ reserve_result_root(klass) };
            if (!result) { return {}; }
            const auto reserved_exception{ reserve_result_root(klass) };
            if (!reserved_exception) { return {}; }
            temporary_vm_scope temporary{ context };
            result = promote_root(std::move(result), context->session->new_string(text));
            raise_pending_exception(context, reserved_exception, "Java allocation threw an exception");
            return result;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (const vmhook::exception&) { throw; }
        catch (...) { return {}; }
    }

    inline auto make_string(const std::string_view value) -> root
    {
        const auto units{ vmhook::detail::utf8_to_utf16(value) };
        std::u16string text;
        text.reserve(units.size());
        for (const auto unit : units) { text.push_back(static_cast<char16_t>(unit)); }
        return make_string_utf16(text);
    }

    struct native_call_result final
    {
        bool invoked{};
        bool threw{};
        std::uint64_t bits{};
        root object{};
        root receiver{};
        root exception{};
        std::string exception_class{};
        std::string error{};
    };

inline auto invoke_packed(vmhook::hotspot::method* const method,
                          const std::string_view signature,
                          std::intptr_t* const parameters, const std::size_t slot_count,
                          void** const receiver_owner,
                          void** const* const argument_owners) -> native_call_result
{
    native_call_result result{};
    operation access{};
    const auto context{ active_context_lifetime() };
    if (!access || !context || !context->thread || !context->session
        || !method || slot_count > 255 || (slot_count && !parameters))
    { result.error = "A current native context and valid Java parameters are required"; return result; }
    try
    {
        if (method->get_signature() != signature)
        { result.error = "Packed descriptor does not identify the selected Method"; return result; }
        bool readable{};
        const bool static_kind{ method->safe_access_flags_test(0x0008u, readable) };
        if (!readable || method->safe_access_flags_test(0x0400u, readable) || !readable)
        { result.error = "Selected Method is unreadable or abstract"; return result; }
        if (signature.empty() || signature.front() != '(')
        { result.error = "Java descriptor is malformed"; return result; }

        std::array<private_native::argument, 255> arguments{};
        std::array<root, 255> argument_roots{};
        std::array<std::size_t, 255> reference_slots{};
        std::size_t argument_count{}, reference_count{};
        std::size_t descriptor_position{ 1 }, slot{ static_kind ? 0u : 1u };
        root receiver{};
        if (!static_kind)
        {
            if (!slot_count || !parameters[0])
            { result.error = "Instance Method requires a receiver"; return result; }
            receiver = retain_oop(reinterpret_cast<void*>(parameters[0]));
            if (!receiver)
            { result.error = "Instance receiver could not be rooted"; return result; }
        }
        while (descriptor_position < signature.size() && signature[descriptor_position] != ')')
        {
            private_native::basic_type type{};
            if (argument_count == arguments.size()
                || !private_native::detail::descriptor_type(signature, descriptor_position, type)
                || slot >= slot_count)
            { result.error = "Argument descriptor or slot count is invalid"; return result; }
            auto& argument{ arguments[argument_count++] };
            argument.type = type;
            if (type == private_native::basic_type::object || type == private_native::basic_type::array)
            {
                auto& rooted{ argument_roots[reference_count] };
                if (parameters[slot])
                {
                    rooted = retain_oop(reinterpret_cast<void*>(parameters[slot]));
                    if (!rooted)
                    { result.error = "Reference argument could not be rooted"; return result; }
                    argument.oop_root = rooted->slot;
                }
                reference_slots[reference_count++] = slot;
            }
            else
            {
                const bool wide{ type == private_native::basic_type::long_
                    || type == private_native::basic_type::double_ };
                if (wide && slot + 1 >= slot_count)
                { result.error = "Wide primitive argument is missing its value slot"; return result; }
                argument.bits = static_cast<std::uint64_t>(parameters[slot + (wide ? 1u : 0u)]);
            }
            slot += type == private_native::basic_type::long_
                || type == private_native::basic_type::double_ ? 2u : 1u;
        }
        private_native::basic_type return_type{};
        if (slot != slot_count || descriptor_position >= signature.size()
            || signature[descriptor_position++] != ')'
            || !private_native::detail::descriptor_type(signature, descriptor_position, return_type, true)
            || descriptor_position != signature.size())
        { result.error = "Java return descriptor or packed slot count is invalid"; return result; }

        const auto& runtime{ private_native::rt() };
        void* const const_method{ private_native::load<void*>(method, runtime.off("Method", "_constMethod")) };
        void* const constants{ const_method
            ? private_native::load<void*>(const_method, runtime.off("ConstMethod", "_constants")) : nullptr };
        auto* const holder{ constants ? private_native::load<vmhook::hotspot::klass*>(constants,
            runtime.off("ConstantPool", "_pool_holder")) : nullptr };
        if (!holder) { result.error = "Selected Method has no declaring class"; return result; }
        const bool reference_result{ return_type == private_native::basic_type::object
            || return_type == private_native::basic_type::array };
        root reserved_result{ reference_result ? reserve_result_root(holder) : root{} };
        root reserved_exception{ reserve_result_root(holder) };
        if ((reference_result && !reserved_result) || !reserved_exception)
        { result.error = "Call result roots could not be reserved"; return result; }
        {
            // VM routines allocate internal Handles even when their public
            // result is primitive. Roll back those temporary handles after
            // promoting result/exception into the outer context's roots.
            temporary_vm_scope temporary{ context };
            const auto called{ context->session->invoke(method, return_type,
                std::span<const private_native::argument>{ arguments.data(), argument_count },
                receiver ? receiver->slot : nullptr) };
            result.invoked = called.invoked;
            result.threw = called.threw;
            result.bits = called.bits;
            if (called.error) { result.error = called.error; }
            if (called.oop_root)
            { result.object = promote_root(std::move(reserved_result), called.oop_root); }
            if (called.exception_root)
            {
                result.exception = promote_root(std::move(reserved_exception), called.exception_root);
                void* const exception{ result.exception ? result.exception->resolve_under_vm() : nullptr };
                if (called.threw) { context->session->clear_exception(); }
                if (auto* const klass{ vmhook::klass_from_oop(exception) })
                {
                    if (auto* const name{ klass->get_name() }) { result.exception_class = name->to_string(); }
                }
            }
            if (called.threw) { context->session->clear_exception(); }
        }
        result.receiver = std::move(receiver);

        if (result.receiver)
        {
            void* const relocated{ result.receiver->resolve_under_vm() };
            parameters[0] = reinterpret_cast<std::intptr_t>(relocated);
            if (receiver_owner) { *receiver_owner = relocated; }
        }
        for (std::size_t index{ 0 }; index < reference_count; ++index)
        {
            const auto parameter_index{ reference_slots[index] };
            void* const relocated{ argument_roots[index]
                ? argument_roots[index]->resolve_under_vm() : nullptr };
            parameters[parameter_index] = reinterpret_cast<std::intptr_t>(relocated);
            if (argument_owners && argument_owners[parameter_index])
            { *argument_owners[parameter_index] = relocated; }
        }
        // The public method API reports and consumes Java exceptions. Leave the
        // native context ready for a subsequent call on the same OS thread.
        if (result.threw) { context->session->clear_exception(); }
        return result;
    }
    catch (const std::bad_alloc&)
    {
        if (result.threw && context->session) { context->session->clear_exception(); }
        throw;
    }
    catch (...)
    {
        // Retain invocation status if decoding or C++ root bookkeeping failed
        // after execution, and never strand a pending exception on this thread.
        result.error = "Native Java invocation bookkeeping failed";
        if (result.threw && context->session) { context->session->clear_exception(); }
        return result;
    }
}

}

export namespace vmhook
{
    /*
        @brief Registers this DLL's current OS thread in HotSpot without JNI/JVMTI.
        @details Construct and close on the same thread, outside DllMain. Calls and
        allocations execute on this OS thread immediately. Between operations the
        thread remains native, and VM-scanned root tickets track relocated objects.
        Ticket use requires this context and thread; closure invalidates all tickets.
    */
    class native_thread_context final
    {
        std::shared_ptr<vmhook::detail::native_backend::context_lifetime> lifetime_{};
        std::string error_{ "Context not attached" };
        bool closed_{};
    public:
        explicit native_thread_context(const std::string_view requested_name = {})
        {
            using namespace vmhook::detail;
            if (native_backend::current_context_lifetime())
            { this->error_ = "This OS thread already has a VMHook native context"; return; }
            try
            {
                auto& runtime{ private_native::rt() };
                if (!runtime.ready) { this->error_ = runtime.reason; return; }
                if (!vmhook::detail::java_execution_supported())
                { this->error_ = "Detected collector or VM metadata cannot support direct native access"; return; }
                std::string name{ requested_name };
                if (name.empty())
                { name = "VMHook-native-" + std::to_string(vmhook::windows::GetCurrentThreadId()); }
                if (name.find('\0') != std::string::npos)
                { this->error_ = "Native thread name contains an interior NUL"; return; }
                auto context{ std::make_shared<native_backend::context_lifetime>() };
                context->owner_id = vmhook::windows::GetCurrentThreadId();
                context->attachment = std::make_unique<private_native::scoped_attachment>(name.c_str());
                if (!context->attachment->valid())
                { this->error_ = context->attachment->error(); return; }
                context->thread = context->attachment->get();
                context->session = std::make_unique<private_native::java_session>(context->thread);
                context->previous_provider = private_native::root_reuse_callback();
                context->self_keepalive = context;
                context->alive.store(true, std::memory_order_release);
                this->lifetime_ = context;
                native_backend::current_context_lifetime() = context.get();
                private_native::root_reuse_callback() = &native_backend::reuse_root_slot;
                this->error_ = "Attached";
            }
            catch (const std::exception& failure) { this->error_ = failure.what(); }
            catch (...) { this->error_ = "Native context initialization failed"; }
        }

        ~native_thread_context() { (void)this->close(); }
        native_thread_context(const native_thread_context&) = delete;
        native_thread_context(native_thread_context&&) = delete;
        auto operator=(const native_thread_context&) -> native_thread_context& = delete;
        auto operator=(native_thread_context&&) -> native_thread_context& = delete;

        [[nodiscard]] auto valid() const noexcept -> bool
        {
            return this->lifetime_ && this->lifetime_->alive.load(std::memory_order_acquire)
                && this->lifetime_->owner_id == vmhook::windows::GetCurrentThreadId()
                && vmhook::detail::native_backend::current_context_lifetime() == this->lifetime_.get();
        }
        explicit operator bool() const noexcept { return this->valid(); }
        [[nodiscard]] auto error() const noexcept -> const char* { return this->error_.c_str(); }
        template<typename loader_type>
        auto set_context_class_loader(const std::unique_ptr<loader_type>& loader) -> void;

        auto close() noexcept -> bool
        {
            using namespace vmhook::detail;
            if (this->closed_ || !this->lifetime_) { return true; }
            auto context{ this->lifetime_ };
            try
            {
                if (context->owner_id != vmhook::windows::GetCurrentThreadId()
                    || native_backend::current_context_lifetime() != context.get()
                    || context->operation_depth != 0
                    || private_native::thread_state(context->thread) != 4)
                { this->error_ = "Close requires the owner OS thread in native state with no active operation"; return false; }
                context->alive.store(false, std::memory_order_release);
                private_native::root_reuse_callback() = context->previous_provider;
                context->session.reset();
                context->tickets.clear();
                context->reusable.clear();
                {
                    std::lock_guard lock{ context->releases_mutex };
                    context->releases.clear();
                }
                if (!context->attachment->detach())
                { this->error_ = context->attachment->error(); return false; }
                context->attachment.reset();
                native_backend::current_context_lifetime() = nullptr;
                context->thread = nullptr;
                context->self_keepalive.reset();
                this->lifetime_.reset();
                this->closed_ = true;
                this->error_ = "Closed";
                return true;
            }
            catch (...) { return false; }
        }
    };
}

// VMHOOK_NATIVE_FACADE_END

// VMHOOK_BORROWED_CALLBACK_BEGIN
export namespace vmhook::detail::callback_backend
{
    namespace pn = vmhook::detail::private_native;
    namespace nb = vmhook::detail::native_backend;

    struct platform_callback_layout final
    {
        std::size_t platform_offset{}, mounted_offset{}, handle_slot_offset{};
        bool ready{}, virtual_threads{};
        platform_callback_layout() noexcept
        {
            try
            {
                auto& runtime{ pn::rt() };
                if (!runtime.ready || runtime.uses_external_symbols()) { return; }
                this->virtual_threads = runtime.profile->java_feature >= 19;
                if (!this->virtual_threads) { this->ready = true; return; }
                this->platform_offset = runtime.off("JavaThread", "_threadObj");
                this->mounted_offset = runtime.off("JavaThread", "_vthread");
                this->handle_slot_offset = runtime.off("OopHandle", "_obj");
                const auto thread_size{ runtime.size("JavaThread") };
                if (thread_size < sizeof(void*) || runtime.size("OopHandle") != sizeof(void*) || this->handle_slot_offset != 0
                    || runtime.enum_value("JavaThread", "storage_size__threadObj") != sizeof(void*)
                    || runtime.enum_value("JavaThread", "storage_size__vthread") != sizeof(void*)
                    || this->platform_offset == this->mounted_offset
                    || this->platform_offset > thread_size - sizeof(void*)
                    || this->mounted_offset > thread_size - sizeof(void*)) { return; }
                this->ready = true;
            }
            catch (...) {}
        }
        static auto get() noexcept -> const platform_callback_layout&
        { static const platform_callback_layout value{}; return value; }
    };
    inline std::atomic<std::uint64_t> unsupported_callback_frames{};
    inline auto is_platform_frame(void* const thread) noexcept -> bool
    {
        const auto& layout{ platform_callback_layout::get() };
        if (!thread || !layout.ready) { return false; }
        if (!layout.virtual_threads) { return true; }
        void** carrier_slot{}; void** mounted_slot{}; void* carrier{}; void* mounted{};
        // In this running Java state no safepoint or mount/unmount can occur
        // between these reads. Resolve the two calibrated OopHandles without
        // borrowing a Java context, allocating, polling or walking a stack.
        return vmhook::os::safe_read(&carrier_slot, static_cast<std::byte*>(thread) + layout.platform_offset, sizeof(carrier_slot))
            && vmhook::os::safe_read(&mounted_slot, static_cast<std::byte*>(thread) + layout.mounted_offset, sizeof(mounted_slot))
            && carrier_slot && mounted_slot
            && vmhook::os::safe_read(&carrier, carrier_slot, sizeof(carrier))
            && vmhook::os::safe_read(&mounted, mounted_slot, sizeof(mounted))
            && carrier && mounted && carrier == mounted;
    }

    inline auto supported() noexcept -> bool
    {
        try
        {
            auto& runtime{ pn::rt() };
            if (!runtime.ready || runtime.uses_external_symbols() || !platform_callback_layout::get().ready
                || !vmhook::detail::java_execution_supported()) { return false; }
            bool exact{};
            for (const auto* profile : pn::all_profiles)
            { if (profile == runtime.profile) { exact = true; break; } }
            const auto anchor_size{ runtime.size("JavaFrameAnchor") };
            const bool saved_rbp{ runtime.has_field("JavaFrameAnchor", "_saved_rbp_address") };
            if (!exact || (anchor_size != 24 && anchor_size != 32)
                || runtime.off("JavaFrameAnchor", "_last_Java_sp") != 0
                || runtime.off("JavaFrameAnchor", "_last_Java_pc") != 8
                || runtime.off("JavaFrameAnchor", "_last_Java_fp") != 16
                || runtime.off("ThreadInVMfromJava", "_thread") != 0
                || runtime.size("ThreadInVMfromJava") > 16) { return false; }
            if (saved_rbp != (anchor_size == 32)
                || (saved_rbp && (runtime.off("JavaFrameAnchor", "_saved_rbp_address") != 24
                    || runtime.enum_value("JavaFrameAnchor", "storage_size__saved_rbp_address") != 8)))
            { return false; }
            if (runtime.has_field("ThreadInVMfromJava", "_check_asyncs")
                && runtime.off("ThreadInVMfromJava", "_check_asyncs") != 8) { return false; }
            if (!runtime.has_field("JavaThread", "_vm_result")
                && !runtime.has_field("JavaThread", "_vm_result_oop")) { return false; }
            if (runtime.profile->java_feature <= 11)
            {
                (void)runtime.off("JavaThread", "_special_runtime_exit_condition");
                (void)runtime.off("JavaThread", "_suspend_flags");
                (void)runtime.enum_value("Thread::SuspendFlags", "_external_suspend");
                (void)runtime.enum_value("Thread::SuspendFlags", runtime.profile->java_feature <= 9
                    ? "_deopt_suspend" : "_trace_flag");
                if (runtime.profile->java_feature >= 9)
                {
                    (void)runtime.off("JavaThread", "_stack_guard_state");
                    (void)runtime.enum_value("JavaThread::StackGuardState", "stack_guard_yellow_reserved_disabled");
                    if (runtime.enum_value("JavaThread", "storage_size__stack_guard_state") != 4
                        || !runtime.has_function("field_enable_guards10")) { return false; }
                }
                return runtime.enum_value("JavaThread", "storage_size__special_runtime_exit_condition") == 4
                    && runtime.enum_value("JavaThread", "storage_size__suspend_flags") == 4
                    && runtime.has_function("vm_to_native")
                    && runtime.has_function("field_special_exit10");
            }
            if (runtime.has_function("field_vm_to_java_destroy")) { return true; }
            if (runtime.has_function("field_vm_to_java_transition10"))
            {
                (void)runtime.off("JavaThread", "_stack_guard_state");
                (void)runtime.off("JavaThread", "_special_runtime_exit_condition");
                (void)runtime.off("JavaThread", "_suspend_flags");
                (void)runtime.enum_value("JavaThread::StackGuardState", "stack_guard_yellow_reserved_disabled");
                (void)runtime.enum_value("Thread::SuspendFlags", "_external_suspend");
                (void)runtime.enum_value("Thread::SuspendFlags", "_trace_flag");
                return runtime.has_function("field_enable_guards10")
                    && runtime.has_function("field_special_exit10");
            }
            (void)runtime.off("JavaThread", "_stack_overflow_state");
            (void)runtime.off("StackOverflow", "_stack_guard_state");
            (void)runtime.enum_value("StackOverflow::StackGuardState", "stack_guard_yellow_reserved_disabled");
            if (runtime.has_function("field_process_safepoint_exit19"))
            { return runtime.has_function("field_enable_guards19"); }
            (void)runtime.off("JavaThread", "_poll_data");
            (void)runtime.off("SafepointMechanism::ThreadData", "_polling_word");
            (void)runtime.off("JavaThread", "_suspend_flags");
            (void)runtime.enum_value("JavaThread::SuspendFlags", "_trace_flag");
            (void)runtime.enum_value("JavaThread::SuspendFlags", "_obj_deopt");
            (void)runtime.enum_value("ObservationABI", "callback_poll_bit");
            return runtime.has_function("field_enable_guards20")
                && runtime.has_function("field_safepoint_process20")
                && runtime.has_function("field_special_exit20");
        }
        catch (...) { return false; }
    }

    class vm_to_java_protocol final
    {
        void* thread_{};
        alignas(8) std::array<std::byte, 16> transition_{};
    public:
        explicit vm_to_java_protocol(void* const thread) : thread_{ thread }
        {
            auto& runtime{ pn::rt() };
            if (!supported() || runtime.current_thread() != thread || pn::thread_state(thread) != 8)
            { throw vmhook::exception{ "Callback requires its own JavaThread and an audited transition profile" }; }
            pn::store<void*>(this->transition_.data(), runtime.off("ThreadInVMfromJava", "_thread"), thread);
            if (runtime.has_field("ThreadInVMfromJava", "_check_asyncs"))
            { pn::store<bool>(this->transition_.data(), runtime.off("ThreadInVMfromJava", "_check_asyncs"), true); }
        }

        auto return_to_java() -> void
        {
            auto& runtime{ pn::rt() };
            if (runtime.profile->java_feature <= 11)
            {
                if (runtime.profile->java_feature >= 9
                    && pn::load<std::int32_t>(this->thread_, runtime.off("JavaThread", "_stack_guard_state"))
                        == runtime.enum_value("JavaThread::StackGuardState", "stack_guard_yellow_reserved_disabled"))
                { runtime.fn<void(*)(void*)>("field_enable_guards10")(this->thread_); }
                // These exact legacy images use transition_and_fence when a
                // call-stub exception handler cannot be reached reliably. The
                // generic transition retains their real safepoint protocol.
                runtime.fn<void(*)(void*, int, int)>("vm_to_native")(this->thread_, 6, 8);
                // Preserve the original ThreadInVMfromJava destructor's exit
                // check: external/deopt suspend in 8/9, external/trace in 10/11.
                if (pn::load<std::int32_t>(this->thread_, runtime.off("JavaThread", "_special_runtime_exit_condition")) != 0
                    || (pn::load<std::uint32_t>(this->thread_, runtime.off("JavaThread", "_suspend_flags"))
                        & static_cast<std::uint32_t>(runtime.enum_value("Thread::SuspendFlags", "_external_suspend")
                            | runtime.enum_value("Thread::SuspendFlags", runtime.profile->java_feature <= 9
                                ? "_deopt_suspend" : "_trace_flag"))))
                { runtime.fn<void(*)(void*, bool)>("field_special_exit10")(this->thread_, true); }
                return;
            }
            if (runtime.has_function("field_vm_to_java_destroy"))
            {
                runtime.fn<void(*)(void*)>("field_vm_to_java_destroy")(this->transition_.data());
                return;
            }
            if (runtime.has_function("field_vm_to_java_transition10"))
            {
                if (pn::load<int>(this->thread_, runtime.off("JavaThread", "_stack_guard_state"))
                    == runtime.enum_value("JavaThread::StackGuardState", "stack_guard_yellow_reserved_disabled"))
                { runtime.fn<void(*)(void*)>("field_enable_guards10")(this->thread_); }
                runtime.fn<void(*)(void*, int, int)>("field_vm_to_java_transition10")(this->thread_, 6, 8);
                // Exact JDK10 private destructor constituents, audited in the
                // built-in image: async exception or trace/suspend exit request.
                if (pn::load<int>(this->thread_, runtime.off("JavaThread", "_special_runtime_exit_condition")) != 0
                    || (pn::load<unsigned>(this->thread_, runtime.off("JavaThread", "_suspend_flags"))
                        & static_cast<unsigned>(runtime.enum_value("Thread::SuspendFlags", "_external_suspend")
                            | runtime.enum_value("Thread::SuspendFlags", "_trace_flag"))))
                { runtime.fn<void(*)(void*, bool)>("field_special_exit10")(this->thread_, true); }
                return;
            }
            auto* const overflow{ static_cast<std::byte*>(this->thread_)
                + runtime.off("JavaThread", "_stack_overflow_state") };
            if (pn::load<int>(overflow, runtime.off("StackOverflow", "_stack_guard_state"))
                == runtime.enum_value("StackOverflow::StackGuardState", "stack_guard_yellow_reserved_disabled"))
            {
                runtime.fn<void(*)(void*)>(runtime.has_function("field_process_safepoint_exit19")
                    ? "field_enable_guards19" : "field_enable_guards20")(overflow);
            }
            if (runtime.has_function("field_process_safepoint_exit19"))
            { runtime.fn<void(*)(void*, bool)>("field_process_safepoint_exit19")(this->thread_, true); }
            else
            {
                const auto poll{ runtime.off("JavaThread", "_poll_data")
                    + runtime.off("SafepointMechanism::ThreadData", "_polling_word") };
                if (pn::load<std::uint64_t>(this->thread_, poll)
                    & static_cast<std::uint64_t>(runtime.enum_value("ObservationABI", "callback_poll_bit")))
                { runtime.fn<void(*)(void*, bool, bool)>("field_safepoint_process20")(this->thread_, true, true); }
                if (pn::load<unsigned>(this->thread_, runtime.off("JavaThread", "_suspend_flags"))
                    & static_cast<unsigned>(runtime.enum_value("JavaThread::SuspendFlags", "_trace_flag")
                        | runtime.enum_value("JavaThread::SuspendFlags", "_obj_deopt")))
                { runtime.fn<void(*)(void*)>("field_special_exit20")(this->thread_); }
            }
            pn::store<int>(this->thread_, runtime.off("JavaThread", "_thread_state"), 8);
        }
    };

    class borrowed_context;
    inline thread_local borrowed_context* current{};

    class borrowed_context final
    {
        void* thread_{};
        vm_to_java_protocol protocol_;
        std::byte* anchor_{};
        std::array<std::byte, 32> old_anchor_{};
        std::size_t anchor_size_{};
        std::size_t result_offset_{};
        std::optional<pn::detail::handle_mark> auxiliary_roots_{};
        void** old_result_{};
        std::shared_ptr<nb::context_lifetime> context_{};
        nb::context_lifetime* previous_context_{};
        pn::root_slot_provider previous_provider_{};
        borrowed_context* previous_callback_{};
        nb::root outgoing_{};
        vmhook::hotspot::return_slot* outgoing_slot_{};
        void* outgoing_reference_slot_{};
        std::vector<std::pair<void*, nb::root>> snapshots_{};
        bool entered_{};
        bool published_{};

        auto close() noexcept -> void
        {
            if (!this->entered_) { return; }
            try
            {
                if (pn::thread_state(this->thread_) == 4) { pn::transition_to_vm(this->thread_); }
                if (pn::thread_state(this->thread_) != 6) { std::terminate(); }
                // This thread root remains scanned during the VM-to-Java
                // transition after the callback session's roots are retired.
                void* const result{ (this->outgoing_slot_ || this->outgoing_reference_slot_)
                    ? this->outgoing_ ? this->outgoing_->resolve_under_vm() : nullptr
                    : this->old_result_ ? pn::detail::resolve_root(this->old_result_)
                        : pn::load<void*>(this->thread_, this->result_offset_) };
                pn::store<void*>(this->thread_, this->result_offset_, result);
                if (this->context_)
                {
                    this->context_->alive.store(false, std::memory_order_release);
                    this->context_->session.reset();
                    this->context_->self_keepalive.reset();
                }
                if (this->published_)
                {
                    nb::current_context_lifetime() = this->previous_context_;
                    pn::root_reuse_callback() = this->previous_provider_;
                    current = this->previous_callback_;
                }
                this->snapshots_.clear();
                this->context_.reset();
                this->protocol_.return_to_java();
                if (this->outgoing_slot_)
                {
                    void* const relocated{ pn::load<void*>(this->thread_, this->result_offset_) };
                    std::memcpy(&this->outgoing_slot_->retval, &relocated, sizeof(relocated));
                    pn::store<void*>(this->thread_, this->result_offset_, pn::detail::resolve_root(this->old_result_));
                }
                else if (this->outgoing_reference_slot_)
                {
                    // Field continuations perform no safepoint-capable call
                    // between this transfer and pushing the real Java operand
                    // slot. The next dispatch uses the original bytecode map.
                    void* const relocated{ pn::load<void*>(this->thread_, this->result_offset_) };
                    std::memcpy(this->outgoing_reference_slot_, &relocated, sizeof relocated);
                    pn::store<void*>(this->thread_, this->result_offset_, pn::detail::resolve_root(this->old_result_));
                }
                // HandleMark performs arena rollback and unlinks itself. The
                // session already retired later chunks while still in VM state.
                // No safepoint-capable VM operation occurs before interpreter
                // execution resumes with the relocated return in its TOS state.
                this->auxiliary_roots_.reset();
                pn::store<void*>(this->anchor_, 0, nullptr);
                std::atomic_thread_fence(std::memory_order_release);
                std::memcpy(this->anchor_ + 8, this->old_anchor_.data() + 8, this->anchor_size_ - 8);
                std::atomic_thread_fence(std::memory_order_release);
                std::memcpy(this->anchor_, this->old_anchor_.data(), 8);
                this->entered_ = false;
            }
            catch (...) { std::terminate(); }
        }
    public:
        borrowed_context(void* const thread, const vmhook::hotspot::detour_java_anchor_t anchor)
            : thread_{ thread }, protocol_{ thread }
        {
            if (!anchor.valid || !anchor.last_java_sp || !anchor.last_java_fp || !anchor.last_java_pc)
            { throw vmhook::exception{ "No complete interrupted interpreter anchor" }; }
            auto& runtime{ pn::rt() };
            this->anchor_ = static_cast<std::byte*>(thread) + runtime.off("JavaThread", "_anchor");
            this->anchor_size_ = runtime.size("JavaFrameAnchor");
            this->result_offset_ = runtime.off("JavaThread", runtime.has_field("JavaThread", "_vm_result")
                ? "_vm_result" : "_vm_result_oop");
            std::memcpy(this->old_anchor_.data(), this->anchor_, this->anchor_size_);
            this->previous_context_ = nb::current_context_lifetime();
            this->previous_provider_ = pn::root_reuse_callback();
            this->previous_callback_ = current;
            pn::store<void*>(this->anchor_, 0, nullptr);
            pn::store<void*>(this->anchor_, 8, anchor.last_java_pc);
            pn::store<void*>(this->anchor_, 16, anchor.last_java_fp);
            // JDK16 alone also records a saved RBP register location. Its VM
            // walker must use our interpreter frame's FP, not a saved location
            // from the interrupted anchor. Preserve it for the final restore.
            if (this->anchor_size_ == 32) { pn::store<void*>(this->anchor_, 24, nullptr); }
            std::atomic_thread_fence(std::memory_order_release);
            pn::store<void*>(this->anchor_, 0, anchor.last_java_sp);
            // Exact transition_from_java constituent: Java state never waits
            // before entering VM. The published interpreter frame is walkable.
            pn::store<int>(thread, runtime.off("JavaThread", "_thread_state"), 6);
            this->entered_ = true;
            try
            {
                this->auxiliary_roots_.emplace(thread);
                this->old_result_ = pn::detail::root_oop(thread, pn::load<void*>(thread, this->result_offset_));
                if (pn::load<void*>(thread, this->result_offset_) && !this->old_result_)
                { throw vmhook::exception{ "Cannot retain interrupted VM result" }; }
                this->context_ = std::make_shared<nb::context_lifetime>();
                this->context_->thread = thread;
                this->context_->owner_id = vmhook::windows::GetCurrentThreadId();
                this->context_->session = std::make_unique<pn::java_session>(thread);
                this->context_->previous_provider = this->previous_provider_;
                this->context_->self_keepalive = this->context_;
                this->context_->alive.store(true, std::memory_order_release);
                nb::current_context_lifetime() = this->context_.get();
                pn::root_reuse_callback() = &nb::reuse_root_slot;
                current = this;
                this->published_ = true;
                pn::transition_to_native(thread);
            }
            catch (...) { this->close(); throw; }
        }
        ~borrowed_context() { this->close(); }
        borrowed_context(const borrowed_context&) = delete;
        auto operator=(const borrowed_context&) -> borrowed_context& = delete;

        auto track_snapshot(void* const snapshot, const nb::root& root) -> void
        {
            if (!snapshot || !root || !root->valid()) { return; }
            for (const auto& entry : this->snapshots_)
            { if (entry.first == snapshot && entry.second == root) { return; } }
            this->snapshots_.emplace_back(snapshot, root);
        }
        auto root_from_snapshot(void* const snapshot) noexcept -> nb::root
        {
            nb::operation access{};
            if (!access) { return {}; }
            nb::root result{};
            void* identity{};
            for (const auto& entry : this->snapshots_)
            {
                if (entry.first != snapshot || !entry.second || !entry.second->valid()) { continue; }
                void* const resolved{ entry.second->resolve_under_vm() };
                if (!resolved || (result && resolved != identity))
                {
                    // Moving GC may reuse an old address for another object.
                    // A raw snapshot with two live identities is ambiguous.
                    return {};
                }
                result = entry.second;
                identity = resolved;
            }
            return result;
        }
        auto reference_return(nb::root outgoing, vmhook::hotspot::return_slot* const slot) noexcept -> bool
        {
            if (!slot || (outgoing && !outgoing->valid())) { return false; }
            auto* const frame{ vmhook::hotspot::current_interpreter_frame };
            auto* const method{ frame ? frame->get_method() : nullptr };
            if (!method) { return false; }
            try
            {
                const auto signature{ method->get_signature() };
                const auto end{ signature.find(')') };
                if (end == std::string::npos || end + 1 == signature.size()
                    || (signature[end + 1] != 'L' && signature[end + 1] != '[')) { return false; }
                if (!vmhook::detail::mark_callback_return_root(frame, method)) { return false; }
                this->outgoing_ = std::move(outgoing);
                this->outgoing_slot_ = slot;
                slot->cancel = true;
                slot->retval = 0;
                return true;
            }
            catch (...) { return false; }
        }
        auto reference_transport(nb::root outgoing, void* const slot) noexcept -> bool
        {
            if (!slot || this->outgoing_slot_ || (outgoing && !outgoing->valid())) { return false; }
            this->outgoing_ = std::move(outgoing);
            this->outgoing_reference_slot_ = slot;
            return true;
        }
    };
}

export namespace vmhook::detail
{
    inline auto borrowed_callback_supported() noexcept -> bool
    { return callback_backend::supported(); }
    inline auto platform_callback_supported(void* const thread) noexcept -> bool
    {
        if (callback_backend::is_platform_frame(thread)) { return true; }
        callback_backend::unsupported_callback_frames.fetch_add(1, std::memory_order_relaxed);
        return false;
    }

    inline auto execute_borrowed_callback(hotspot::java_thread* const thread,
        const hotspot::detour_java_anchor_t anchor, const borrowed_callback invoke,
        void* const opaque) noexcept -> bool
    {
        if (!invoke || !platform_callback_supported(thread)) { return false; }
        try
        {
            const hotspot::current_thread_guard thread_guard{ thread };
            const hotspot::detour_anchor_guard anchor_guard{ anchor };
            const bool method_frame{ hotspot::current_interpreter_frame == anchor.last_java_fp };
            const hotspot::interpreter_locals_guard locals_guard{
                method_frame ? hotspot::current_interpreter_frame : nullptr,
                method_frame ? hotspot::current_interpreter_locals : nullptr };
            callback_backend::borrowed_context context{ thread, anchor };
            try { invoke(opaque); return true; }
            catch (...) { return false; }
        }
        catch (...) { return false; }
    }

    inline auto track_callback_oop_snapshot(void* const snapshot,
        const native_backend::root& root) noexcept -> void
    {
        if (!callback_backend::current) { return; }
        try { callback_backend::current->track_snapshot(snapshot, root); } catch (...) {}
    }
    inline auto resolve_callback_oop_snapshot(void* const snapshot) noexcept -> void*
    {
        if (!snapshot) { return nullptr; }
        if (!callback_backend::current) { return nullptr; }
        const auto root{ callback_backend::current->root_from_snapshot(snapshot) };
        return root ? root->resolve_under_vm() : nullptr;
    }
    inline auto set_callback_reference(hotspot::return_slot* const slot,
        const native_backend::root& root) noexcept -> bool
    {
        native_backend::operation access{};
        return access && callback_backend::current
            && callback_backend::current->reference_return(root, slot);
    }
    inline auto set_callback_reference_snapshot(hotspot::return_slot* const slot,
        void* const snapshot) noexcept -> bool
    {
        if (!callback_backend::current || !snapshot) { return false; }
        const auto root{ callback_backend::current->root_from_snapshot(snapshot) };
        return root && set_callback_reference(slot, root);
    }
}
export namespace vmhook
{
    [[nodiscard]] inline auto rejected_hook_callback_frames() noexcept -> std::uint64_t
    { return detail::callback_backend::unsupported_callback_frames.load(std::memory_order_relaxed); }
}

// VMHOOK_BORROWED_CALLBACK_END


export namespace vmhook
{
    /* Resolve an already-loaded class defined by the anchor object's loader.
       Requires a native/callback context. The anchor must be live and rooted.
       This does not invoke loadClass, initialize a class or choose an arbitrary
       same-named class from another loader. Bootstrap definitions are fallback. */
    inline auto find_class_via_oop(void* const anchor_oop,
        const std::string_view class_name) noexcept -> vmhook::hotspot::klass*
    {
        vmhook::detail::native_backend::operation access{};
        if (!access || !anchor_oop || class_name.empty()) { return nullptr; }
        try
        {
            auto* const anchor_class{ vmhook::klass_from_oop(anchor_oop) };
            const auto* offset{vmhook::hotspot::iterate_struct_entries("Klass", "_class_loader_data")};
            if (!offset) { offset = vmhook::hotspot::iterate_struct_entries("InstanceKlass", "_class_loader_data"); }
            if (!anchor_class || !offset) { return nullptr; }
            void* const selected{vmhook::detail::private_native::load<void*>(anchor_class, offset->offset)};
            if (!selected) { return nullptr; }
            vmhook::hotspot::klass* result{};
            vmhook::hotspot::klass* bootstrap{};
            const vmhook::hotspot::class_loader_data_graph graph{};
            graph.for_each_klass([&](std::string_view name, vmhook::hotspot::klass* candidate)
            {
                if (name != class_name) { return; }
                auto* const data{vmhook::detail::private_native::load<vmhook::hotspot::class_loader_data*>(candidate, offset->offset)};
                if (data == selected) { result = candidate; }
                else if (data && !data->get_class_loader_oop()) { bootstrap = candidate; }
            });
            return result ? result : bootstrap;
        }
        catch (...) { return nullptr; }
    }

    /*
        @brief Installs / replaces the find_class cache entry for `class_name`.
        @details
        After this call, every subsequent vmhook::find_class(class_name) returns
        `k` when a fresh loaded-class graph walk observes the same pointer/name.
        This is an advanced global preference, not a class-lifetime guarantee.
        Registered wrappers use their own retained mirror and are independent
        of this global name preference.  The cache is a single
        process-global map (last writer wins; no scoping or refcount), so an
        override is visible to every caller until evicted or overwritten.

        Passing a null `k` does NOT seed a durable negative ("known-absent")
        entry: find_class's cache-hit guard rejects a null value and erases it,
        so the very next find_class re-walks the graph (the null heals away).
        Use evict_class_lookup() to forget an entry — there is currently no
        durable negative-cache semantics.

        Complexity: O(1).  Exception safety: noexcept.
    */
    inline auto override_class_lookup(const std::string_view class_name, vmhook::hotspot::klass* const k) noexcept
        -> void
    {
        try
        {
            std::lock_guard<std::mutex> lock{ vmhook::klass_lookup_cache_mutex };
            vmhook::klass_lookup_cache[std::string{ class_name }] = k;
        }
        catch (...)
        {
        }
    }

    /*
        @brief Forgets any cached find_class resolution for `class_name`.
        @details Next find_class(class_name) re-walks the graph (or re-resolves).
        Complexity: O(1).  Exception safety: noexcept.
    */
    inline auto evict_class_lookup(const std::string_view class_name) noexcept
        -> void
    {
        try
        {
            std::lock_guard<std::mutex> lock{ vmhook::klass_lookup_cache_mutex };
            vmhook::klass_lookup_cache.erase(std::string{ class_name });
        }
        catch (...)
        {
        }
    }

    /*
        @brief Convenience: resolve a set of classes once and cache each result.
        @details
        For each name, find_class_via_oop(anchor_oop, name) then
        override_class_lookup(name, resolved), so every later find_class() short-
        circuits to the cached Klass*.  Returns true only if EVERY name resolved —
        callers that anchor against an object which only becomes available later
        (e.g. once a world/context is loaded) can poll until it returns true.
        Names that don't resolve are left un-overridden.

        @note This advanced helper changes a global name preference. Prefer
        register_class<W>(name, anchor) for independent per-wrapper bindings
        whose class mirror is retained; a raw cache preference is not a root.

        Complexity: O(N · ClassLoaderDataGraph walk).  Exception safety: noexcept.
    */
    inline auto reanchor_classes_via_oop(void* const anchor_oop,
                                         std::initializer_list<std::string_view> class_names) noexcept
        -> bool
    {
        if (!anchor_oop)
        {
            return false;
        }
        bool all_resolved{ true };
        for (const std::string_view class_name : class_names)
        {
            vmhook::hotspot::klass* const resolved{ vmhook::find_class_via_oop(anchor_oop, class_name) };
            if (resolved)
            {
                vmhook::override_class_lookup(class_name, resolved);
            }
            else
            {
                all_resolved = false;
            }
        }
        return all_resolved;
    }

    // Forward declaration of the direct own-TLAB allocation primitive.
    // make_unique tries it before the Java allocation backend when supported.
    auto make_java_object(vmhook::hotspot::klass* klass, std::size_t requested_size) noexcept -> void*;

    /*
        @brief Allocates a Java object and attempts its selected Java constructor.
        @details Requires a registered wrapper, a loaded concrete class, and an
        active native_thread_context or validated VMHook Java detour. Native
        construction uses HotSpot class initialization and collector-aware
        InstanceKlass allocation, retaining receiver and argument roots. A detour
        requires an initialized class and tries its own TLAB before the existing
        Java allocation backend. Metadata and backend checks precede allocation.

        The constructor overload is chosen from the C++ argument types. Some
        refusals, including an unmatched overload or a late call-frame refusal,
        are discovered after allocation. Refusal or a thrown Java constructor
        abandons that allocation and throws vmhook::exception. C++ allocation
        failure throws std::bad_alloc.

        An optional wrapper construct(args...) runs after the Java constructor.
        A native-context result retains a GC root until that context ends.
        A detour result remains a non-owning wrapper.
        Defined after the invocation machinery.
    */
    template<typename wrapper_type, typename... args_t>
        requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
            && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
            && (vmhook::detail::supported_java_argument_v<args_t> && ...))
    [[nodiscard]] inline auto make_unique(args_t&&... args)
        -> std::unique_ptr<wrapper_type>;

    template<typename wrapper_type, typename... args_t>
        requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
            && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
            && (vmhook::detail::supported_java_argument_v<args_t> && ...))
    [[nodiscard]] inline auto make_unique_with_descriptor(const std::string_view constructor_signature,
                                                         args_t&&... args)
        -> std::unique_ptr<wrapper_type>;


    // --- Field access ---------------------------------------------------------

    /*
        @brief Caches field metadata by observed Klass pointer and field name.
        @note Class unloading can invalidate a cached pointer. Readability checks
        do not acquire a class-lifetime guard or prove that the same class still owns it.
    */
    inline std::unordered_map<vmhook::hotspot::klass*, std::unordered_map<std::string, vmhook::hotspot::field_entry_t>> g_field_cache{};
    inline std::mutex g_field_cache_mutex{};
    inline std::unordered_map<vmhook::hotspot::klass*, std::weak_ptr<vmhook::detail::class_binding>>
        g_field_cache_lifetimes{};

    /*
        @brief Looks up a named field through a class's superclass chain.
        @param target_klass Starting class, including inherited fields.
        @param name Exact Java field name.
        @return Field offset, descriptor, static flag, and declaring class;
                nullopt when no readable match is found.
        @details Runtime cache entries are tied to one live retained class-binding
        generation. Unregistered runtime classes are parsed afresh; C++ locks and
        readable raw pointers are not treated as class-lifetime guarantees.
    */
    inline auto find_field(vmhook::hotspot::klass* const target_klass, const std::string_view name)
        -> std::optional<vmhook::hotspot::field_entry_t>
    {
        if (!target_klass || !vmhook::hotspot::is_valid_pointer(target_klass))
        {
            ::vmhook::detail::log_line("{} vmhook::find_field() for '{}': klass pointer is null.", vmhook::error_tag, name);
            return std::nullopt;
        }

        const std::string name_str{ name };
        std::shared_ptr<vmhook::detail::class_binding> lifetime{};
        {
            std::lock_guard lock{vmhook::registration_mutex};
            for (const auto& [type, binding] : vmhook::detail::class_bindings)
            {
                if (binding && binding->identity == target_klass && binding->mirror)
                { lifetime = binding; break; }
            }
        }
        // Runtime cache hits require the same live class-binding generation.
        // Unregistered runtime classes are parsed afresh under the caller's VM
        // operation. A readable raw pointer is never a cache lifetime proof.
        {
            std::lock_guard<std::mutex> lock{ vmhook::g_field_cache_mutex };
            const auto epoch{vmhook::g_field_cache_lifetimes.find(target_klass)};
            const bool same_generation{lifetime && epoch != vmhook::g_field_cache_lifetimes.end()
                && epoch->second.lock() == lifetime};
            if (!same_generation)
            {
                vmhook::g_field_cache.erase(target_klass);
                vmhook::g_field_cache_lifetimes.erase(target_klass);
            }
            if (const auto klass_entry{ vmhook::g_field_cache.find(target_klass) };
                klass_entry != vmhook::g_field_cache.end())
            {
                if (const auto field_cache_entry{ klass_entry->second.find(name_str) };
                    field_cache_entry != klass_entry->second.end())
                {
                    return field_cache_entry->second;
                }
            }
        }

        // Walk the superclass chain outside the C++ cache lock. The lock
        // protects the cache, not HotSpot metadata lifetime or redefinition.
        for (vmhook::hotspot::klass* k{ target_klass }; k != nullptr; k = k->get_super())
        {
            auto entry{ k->find_field(name) };
            if (entry)
            {
                // Record WHICH klass in the chain declared the field.  This is
                // load-bearing for inherited STATIC fields: their offset is
                // relative to the declaring class's own mirror, so the static
                // accessors below resolve `declaring_klass->get_java_mirror()`
                // rather than the start klass's (smaller, different) mirror —
                // reading the latter returned garbage and could run off the end
                // of the subclass mirror oop into adjacent heap (a fatal AV).
                entry->declaring_klass = k;
                if (lifetime)
                {
                    std::lock_guard<std::mutex> lock{ vmhook::g_field_cache_mutex };
                    const auto existing{vmhook::g_field_cache_lifetimes.find(target_klass)};
                    if (existing == vmhook::g_field_cache_lifetimes.end() || existing->second.lock() != lifetime)
                    { vmhook::g_field_cache.erase(target_klass); }
                    vmhook::g_field_cache_lifetimes.insert_or_assign(target_klass, lifetime);
                    vmhook::g_field_cache[target_klass].emplace(name_str, *entry);
                }
                return entry;
            }
        }

        ::vmhook::detail::log_line("{} vmhook::find_field() for '{}': field not found in class hierarchy.", vmhook::error_tag, name);
        return std::nullopt;
    }

    /*
        @brief Reads a named instance or static field using its verified storage width.
        @tparam value_type Trivially copyable C++ type matching the field slot width.
        @param object Full Java object address for instance access. Interpreter
                      reference locals already contain full-width oop addresses;
                      frame->get_arguments<void*>() performs no narrow-oop decode.
        @param target_klass Starting class for field lookup, including inherited fields.
        @param name Exact Java field name.
        @return Field bits, or a default value on failure.
        @note Narrow reference slots require a uint32_t read followed by explicit
              decode_oop_pointer(). Verified wide slots require a full-width type.
              Readability checks do not register a Java root or prevent GC.
    */
    namespace detail
    {
        template<typename value_type>
        inline auto read_vm_constant(const char* const name, const char* const table_symbol,
            const char* const stride_symbol, const char* const name_offset_symbol,
            const char* const value_offset_symbol) noexcept -> std::optional<value_type>
        {
            const auto module{ vmhook::hotspot::get_jvm_module() };
            if (!module || !name) { return std::nullopt; }
            const auto coordinate{ [&](const char* symbol) -> std::optional<std::uint64_t>
            {
                const void* const address{ vmhook::os::get_proc_address(module, symbol) };
                std::uint64_t value{};
                return address && vmhook::os::safe_read(&value, address, sizeof(value))
                    ? std::optional{value} : std::nullopt;
            } };
            const auto stride{ coordinate(stride_symbol) };
            const auto name_offset{ coordinate(name_offset_symbol) };
            const auto value_offset{ coordinate(value_offset_symbol) };
            if (!stride || !name_offset || !value_offset || *stride < sizeof(void*)
                || *stride < sizeof(value_type)
                || *stride > 128 || *name_offset > *stride - sizeof(void*)
                || *value_offset > *stride - sizeof(value_type)) { return std::nullopt; }
            const auto* base{ static_cast<const std::uint8_t*>(vmhook::hotspot::safe_read_pointer(
                vmhook::os::get_proc_address(module, table_symbol))) };
            if (!base) { return std::nullopt; }
            for (std::size_t index{}; index < 8192; ++index)
            {
                const auto* const record{ base + index * *stride };
                const char* entry_name{};
                if (!vmhook::os::safe_read(&entry_name, record + *name_offset, sizeof(entry_name))
                    || !entry_name) { return std::nullopt; }
                for (std::size_t character{}; character < 128; ++character)
                {
                    char value{};
                    if (!vmhook::os::safe_read(&value, entry_name + character, sizeof(value)))
                    { break; }
                    if (value != name[character]) { break; }
                    if (value == '\0')
                    {
                        value_type result{};
                        return vmhook::os::safe_read(&result, record + *value_offset, sizeof(result))
                            ? std::optional{result} : std::nullopt;
                    }
                }
            }
            return std::nullopt;
        }

        inline auto vm_int_constant(const char* const name) noexcept -> std::optional<std::int32_t>
        {
            return read_vm_constant<std::int32_t>(name, "gHotSpotVMIntConstants",
                "gHotSpotVMIntConstantEntryArrayStride", "gHotSpotVMIntConstantEntryNameOffset",
                "gHotSpotVMIntConstantEntryValueOffset");
        }

        // HotSpot exports every markWord constant in the LONG table, including
        // the small shifts and lock-state values, for consistency with its masks.
        inline auto vm_long_constant(const char* const name) noexcept -> std::optional<std::uint64_t>
        {
            return read_vm_constant<std::uint64_t>(name, "gHotSpotVMLongConstants",
                "gHotSpotVMLongConstantEntryArrayStride", "gHotSpotVMLongConstantEntryNameOffset",
                "gHotSpotVMLongConstantEntryValueOffset");
        }

        auto class_initialized(vmhook::hotspot::klass* const klass) noexcept -> bool
        {
            static const auto* const state_slot{
                vmhook::hotspot::iterate_struct_entries("InstanceKlass", "_init_state") };
            static const auto* const state_type{
                state_slot && state_slot->type_string
                    ? vmhook::hotspot::iterate_type_entries(state_slot->type_string) : nullptr };
            static const auto initialized{ vmhook::detail::vm_int_constant("InstanceKlass::fully_initialized") };
            if (!klass || !state_slot || !state_type || !initialized
                || (state_type->size != 1 && state_type->size != 4)) { return false; }
            std::uint32_t state{ 0 };
            return vmhook::os::safe_read(&state,
                reinterpret_cast<const std::uint8_t*>(klass) + state_slot->offset,
                static_cast<std::size_t>(state_type->size))
                && state == static_cast<std::uint32_t>(*initialized);
        }

        auto array_layout(vmhook::hotspot::klass* const klass) noexcept
            -> std::optional<array_layout_t>
        {
            const auto compact{ vmhook::detail::compact_object_header_mode() };
            const auto compressed{ vmhook::detail::compressed_klass_mode() };
            if (!klass || !compact || !compressed) { return std::nullopt; }
            struct coordinates_t
            {
                std::optional<std::int32_t> header_shift, header_mask, element_shift, element_mask;
                const vmhook::hotspot::vm_struct_entry_t* layout;
            };
            static const coordinates_t coordinates{
                vmhook::detail::vm_int_constant("Klass::_lh_header_size_shift"),
                vmhook::detail::vm_int_constant("Klass::_lh_header_size_mask"),
                vmhook::detail::vm_int_constant("Klass::_lh_log2_element_size_shift"),
                vmhook::detail::vm_int_constant("Klass::_lh_log2_element_size_mask"),
                vmhook::hotspot::iterate_struct_entries("Klass", "_layout_helper") };
            if (!coordinates.layout || !coordinates.header_shift || !coordinates.header_mask
                || !coordinates.element_shift || !coordinates.element_mask
                || *coordinates.header_shift < 0 || *coordinates.header_shift > 31
                || *coordinates.element_shift < 0 || *coordinates.element_shift > 31)
            { return std::nullopt; }
            std::int32_t layout{};
            if (!vmhook::os::safe_read(&layout, reinterpret_cast<const std::uint8_t*>(klass)
                + coordinates.layout->offset, sizeof(layout)) || layout >= 0) { return std::nullopt; }
            const auto bits{ static_cast<std::uint32_t>(layout) };
            const std::size_t header{ (bits >> *coordinates.header_shift)
                & static_cast<std::uint32_t>(*coordinates.header_mask) };
            const auto log_width{ (bits >> *coordinates.element_shift)
                & static_cast<std::uint32_t>(*coordinates.element_mask) };
            // Compact arrays place length immediately after the mark word.
            // Klass::_layout_helper independently provides the true element
            // offset, including the extra alignment of long/double arrays.
            const std::size_t length_offset{ *compact ? 8u : (*compressed ? 12u : 16u) };
            if (log_width > 3 || header < length_offset + sizeof(std::int32_t) || header > 64)
            { return std::nullopt; }
            const auto* const symbol{ klass->get_name() };
            if (!symbol) { return std::nullopt; }
            const auto prefix{ symbol->first_bytes<2>() };
            if (!prefix || (*prefix)[0] != '['
                || std::string_view{"ZBCSIJFDL["}.find(static_cast<char>((*prefix)[1])) == std::string_view::npos)
            { return std::nullopt; }
            return array_layout_t{ length_offset, header, std::size_t{1} << log_width,
                (*prefix)[1] == 'L' || (*prefix)[1] == '[' };
        }
    }

    template<typename value_type>
    inline auto get_field(void* const object, vmhook::hotspot::klass* const target_klass, const std::string_view name)
        -> value_type
    {
        static_assert(std::is_trivially_copyable_v<value_type>, "get_field<value_type>: value_type must be trivially copyable.");

        try
        {
            const auto entry{ vmhook::find_field(target_klass, name) };

            if (!entry)
            {
                throw vmhook::exception{ std::format("Field '{}' not found.", name) };
            }

            const bool reference{ !entry->signature.empty()
                && (entry->signature.front() == 'L' || entry->signature.front() == '[') };
            const std::size_t width{ reference
                ? vmhook::detail::reference_storage_width()
                : vmhook::detail::jvm_primitive_byte_width(entry->signature) };
            if (width == 0 || sizeof(value_type) != width)
            {
                throw vmhook::exception{ "Field access uses an unsupported or mismatched storage width." };
            }

            if (entry->is_static)
            {
                // A static field's offset is relative to the DECLARING class's
                // mirror, not target_klass's — they differ for an inherited
                // static (different, differently-sized mirror oops).  Fall back
                // to target_klass only when the declaring klass is unknown.
                vmhook::hotspot::klass* const mirror_klass{ entry->declaring_klass ? entry->declaring_klass : target_klass };
                void* const mirror{ mirror_klass->get_java_mirror() };
                if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
                {
                    throw vmhook::exception{ "Failed to retrieve java.lang.Class mirror." };
                }

                value_type result{};
                if (!vmhook::os::safe_read(&result, reinterpret_cast<const std::uint8_t*>(mirror) + entry->offset, sizeof(value_type)))
                {
                    return value_type{};
                }
                return result;
            }

            if (!object || !vmhook::hotspot::is_valid_pointer(object))
            {
                throw vmhook::exception{ "Object pointer is null or invalid." };
            }

            value_type result{};
            if (!vmhook::os::safe_read(&result, reinterpret_cast<const std::uint8_t*>(object) + entry->offset, sizeof(value_type)))
            {
                return value_type{};
            }
            return result;
        }
        catch (const std::bad_alloc&) { throw; }
        catch (const std::exception& exception)
        {
            ::vmhook::detail::log_line("{} vmhook::get_field<{}>('{}') {}", vmhook::error_tag, vmhook::detail::type_name<value_type>(), name, exception.what());
            return value_type{};
        }
    }

    /*
        @brief Writes a named field using its verified storage width.
        @tparam value_type Trivially copyable type matching the field slot width.
        @param object Full Java object address for instance access.
        @param target_klass Starting class, including inherited fields.
        @param name Exact Java field name.
        @param value Field bits to store.
        @note Reference writes require the supported collector barrier policy
              and the correct narrow or wide slot representation. Primitive
              writes follow their own width checks. A raw address is not rooted.
    */
    template<typename value_type>
    inline auto set_field(void* const object, vmhook::hotspot::klass* const target_klass, const std::string_view name, const value_type value)
        -> void
    {
        static_assert(std::is_trivially_copyable_v<value_type>, "set_field<value_type>: value_type must be trivially copyable.");

        try
        {
            const auto entry{ vmhook::find_field(target_klass, name) };

            if (!entry)
            {
                throw vmhook::exception{ std::format("Field '{}' not found.", name) };
            }

            const bool reference{ !entry->signature.empty()
                && (entry->signature.front() == 'L' || entry->signature.front() == '[') };
            const std::size_t width{ reference
                ? vmhook::detail::reference_storage_width()
                : vmhook::detail::jvm_primitive_byte_width(entry->signature) };
            if (width == 0 || sizeof(value_type) != width)
            {
                throw vmhook::exception{ "Field access uses an unsupported or mismatched storage width." };
            }
            if ((entry->access_flags & 0x0010u) != 0)
            { throw vmhook::exception{ "Raw field writes cannot mutate a final Java field" }; }
            if ((entry->access_flags & 0x0040u) != 0)
            { throw vmhook::exception{ "Volatile field writes require the rooted field_proxy accessor" }; }
            if (reference && !vmhook::detail::reference_stores_supported())
            {
                throw vmhook::exception{ "Reference stores require a verified collector write-barrier backend." };
            }

            if (entry->is_static)
            {
                // Static offset is relative to the DECLARING class's mirror; see
                // the matching note in get_field<value_type>.  Inherited statics
                // would otherwise be written into the wrong (subclass) mirror.
                vmhook::hotspot::klass* const mirror_klass{ entry->declaring_klass ? entry->declaring_klass : target_klass };
                void* const mirror{ mirror_klass->get_java_mirror() };
                if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
                {
                    throw vmhook::exception{ "Failed to retrieve java.lang.Class mirror." };
                }

                (void)vmhook::os::safe_write(reinterpret_cast<std::uint8_t*>(mirror) + entry->offset, &value, sizeof(value_type));
                return;
            }

            if (!object || !vmhook::hotspot::is_valid_pointer(object))
            {
                throw vmhook::exception{ "Object pointer is null or invalid." };
            }

            (void)vmhook::os::safe_write(reinterpret_cast<std::uint8_t*>(object) + entry->offset, &value, sizeof(value_type));
        }
        catch (const std::bad_alloc&) { throw; }
        catch (const std::exception& exception)
        {
            ::vmhook::detail::log_line("{} vmhook::set_field<{}>('{}') {}", vmhook::error_tag, vmhook::detail::type_name<value_type>(), name, exception.what());
        }
    }

    // --- Java object / array / string allocation helpers ---------------------

    /*
        Allocates from the executing detour's own TLAB without a VM slow path.
        No other thread's allocation buffer is touched. Unsupported collector,
        unknown header/alignment geometry and insufficient TLAB space fail before
        reservation. The result is unrooted and does not run a constructor.
    */
    auto make_java_object(vmhook::hotspot::klass* const klass, const std::size_t requested_size) noexcept
        -> void*
    {
        if (!klass || requested_size == 0 || !vmhook::hotspot::in_java_detour()
            || !vmhook::detail::java_heap_mutation_supported())
        {
            ::vmhook::detail::log_line("{} make_java_object(): allocation requires a validated Java detour "
                       "and a supported ordinary object layout.", vmhook::error_tag);
            return nullptr;
        }
        static const auto* const layout_slot{
            vmhook::hotspot::iterate_struct_entries("Klass", "_layout_helper") };
        std::int32_t layout_value{};
        if (!layout_slot || !vmhook::os::safe_read(&layout_value,
                reinterpret_cast<const std::uint8_t*>(klass) + layout_slot->offset,
                sizeof(layout_value)) || layout_value == 0) { return nullptr; }
        std::optional<vmhook::detail::array_layout_t> array_geometry{};
        std::int32_t inferred_length{};
        if (layout_value > 0)
        {
            // Bit zero requests VM allocation work (e.g. finalizer registration).
            // Bypassing it would create an object with incomplete VM lifecycle.
            if ((layout_value & 1) != 0 || requested_size != static_cast<std::size_t>(layout_value)
                || !vmhook::detail::class_initialized(klass)) { return nullptr; }
            static const auto* const flags_slot{
                vmhook::hotspot::iterate_struct_entries("Klass", "_access_flags") };
            std::uint16_t flags{};
            if (!flags_slot || !vmhook::os::safe_read(&flags,
                    reinterpret_cast<const std::uint8_t*>(klass) + flags_slot->offset, sizeof(flags))
                || (flags & (0x0200u | 0x0400u)) != 0) { return nullptr; }
        }
        else
        {
            array_geometry = vmhook::detail::array_layout(klass);
            if (!array_geometry || requested_size < array_geometry->body_offset) { return nullptr; }
            const auto payload{ requested_size - array_geometry->body_offset };
            const auto count{ payload / array_geometry->element_width };
            if (payload % array_geometry->element_width != 0
                || count > static_cast<std::size_t>((std::numeric_limits<std::int32_t>::max)()))
            { return nullptr; }
            inferred_length = static_cast<std::int32_t>(count);
        }
        const auto compressed{ vmhook::detail::compressed_klass_mode() };
        const std::size_t alignment{ vmhook::detail::java_object_alignment() };
        if (!compressed || alignment == 0
            || requested_size > (std::numeric_limits<std::size_t>::max)() - (alignment - 1))
        {
            return nullptr;
        }
        static const auto* const mark_entry{ []()
        {
            if (auto* const entry{ vmhook::hotspot::iterate_struct_entries("oopDesc", "_mark") })
            {
                return entry;
            }
            return vmhook::hotspot::iterate_struct_entries("oopDesc", "_markWord");
        }() };
        static const auto* const narrow_slot{
            vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._compressed_klass") };
        static const auto* const wide_slot{
            vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._klass") };
        const auto* const klass_slot{ *compressed ? narrow_slot : wide_slot };
        const std::size_t klass_width{ *compressed ? sizeof(std::uint32_t) : sizeof(void*) };
        const std::size_t object_size{ (requested_size + alignment - 1) & ~(alignment - 1) };
        if (!mark_entry || !klass_slot || mark_entry->offset > object_size
            || klass_slot->offset > object_size
            || sizeof(std::uintptr_t) > object_size - mark_entry->offset
            || klass_width > object_size - klass_slot->offset)
        {
            return nullptr;
        }
        const std::uint32_t narrow_klass{ *compressed ? vmhook::hotspot::encode_klass_pointer(klass) : 0u };
        if (*compressed && (narrow_klass == 0
            || vmhook::hotspot::decode_klass_pointer(narrow_klass) != klass))
        {
            return nullptr;
        }
        auto* const thread{ vmhook::hotspot::find_allocation_thread() };
        void* const object{ thread ? thread->allocate_tlab(object_size) : nullptr };
        if (!object)
        {
            ::vmhook::detail::log_line("{} make_java_object(): current thread TLAB cannot provide {} bytes.",
                       vmhook::warning_tag, object_size);
            return nullptr;
        }
        // No safepoint-capable operation occurs between reservation and headers.
        std::memset(object, 0, object_size);
        const auto mark{ klass->get_prototype_header() };
        std::memcpy(static_cast<std::uint8_t*>(object) + mark_entry->offset, &mark, sizeof(mark));
        if (*compressed)
        {
            std::memcpy(static_cast<std::uint8_t*>(object) + klass_slot->offset,
                        &narrow_klass, sizeof(narrow_klass));
        }
        else
        {
            std::memcpy(static_cast<std::uint8_t*>(object) + klass_slot->offset, &klass, sizeof(klass));
        }
        if (array_geometry)
        {
            std::memcpy(static_cast<std::uint8_t*>(object) + array_geometry->length_offset,
                        &inferred_length, sizeof(inferred_length));
        }
        return object;
    }

    /*
        Allocates a loaded array class from the executing detour's own TLAB.
        HotSpot's Klass::_layout_helper supplies header and element widths; the
        element_size argument must agree with that live descriptor. No VM slow
        path or class/array-class initialization is attempted.
    */
    inline auto make_java_array(const std::string_view class_name, const std::int32_t length,
                               const std::size_t element_size,
                               [[maybe_unused]] const bool retained_for_abi = true) -> void*
    {
        if (length < 0 || !vmhook::hotspot::in_java_detour()) { return nullptr; }
        auto* const array_klass{ vmhook::find_class(class_name) };
        const auto layout{ vmhook::detail::array_layout(array_klass) };
        if (!layout || element_size != layout->element_width
            || static_cast<std::size_t>(length)
                > ((std::numeric_limits<std::size_t>::max)() - layout->body_offset) / element_size)
        {
            return nullptr;
        }
        const std::size_t size{ layout->body_offset + static_cast<std::size_t>(length) * element_size };
        void* const array{ vmhook::make_java_object(array_klass, size) };
        if (!array) { return nullptr; }
        std::memcpy(static_cast<std::uint8_t*>(array) + layout->length_offset, &length, sizeof(length));
        return array;
    }

    /*
        Allocates a Java String through the active native allocator or the
        executing detour's TLAB. UTF-16 accepts every Java code unit, including
        isolated surrogates. UTF-8 uses standard scalar decoding with one U+FFFD
        per malformed input byte. Inputs are never silently truncated.
        VM allocation refusal returns nullptr; C++ bad_alloc propagates.
        Raw addresses require an existing VM lifetime context; public new_string
        returns the owning wrapper instead.
    */
    namespace detail
    {
        inline auto initialize_unpublished_reference(void* const object,
            vmhook::hotspot::klass* const klass, const std::string_view name,
            void* const value) -> bool
        {
            if (!object || !klass || !vmhook::hotspot::ensure_current_java_thread())
            {
                return false;
            }
            const auto entry{ vmhook::find_field(klass, name) };
            if (!entry || entry->is_static || entry->signature.empty()
                || (entry->signature.front() != 'L' && entry->signature.front() != '['))
            {
                return false;
            }
            void* const slot{ static_cast<std::uint8_t*>(object) + entry->offset };
            const std::size_t width{ vmhook::detail::reference_storage_width() };
            if (width == sizeof(void*))
            {
                return vmhook::os::safe_write(slot, &value, sizeof(value));
            }
            if (width != sizeof(std::uint32_t))
            {
                return false;
            }
            const std::uint32_t narrow{ vmhook::hotspot::encode_oop_pointer(value) };
            return (!value || narrow != 0) && vmhook::os::safe_write(slot, &narrow, sizeof(narrow));
        }
    }

    inline auto make_java_string_utf16(const std::u16string_view value)
        -> void*
    {
        vmhook::detail::native_backend::operation native_operation{};
        if (vmhook::detail::native_backend::active())
        {
            if (!native_operation) { return nullptr; }
            const auto rooted{ vmhook::detail::native_backend::make_string_utf16(value) };
            return rooted ? rooted->resolve_under_vm() : nullptr;
        }
        vmhook::hotspot::klass* const string_klass{ vmhook::find_class("java/lang/String") };
        if (!string_klass)
        {
            ::vmhook::detail::log_line("{} vmhook::make_java_string(): find_class('java/lang/String') returned null. "
                       "This indicates a very early bootstrap state or a broken VMStructs lookup.",
                       vmhook::error_tag);
            return nullptr;
        }

        const bool compact_string{ string_klass->find_field("coder").has_value() };
        const auto backing_layout{ vmhook::detail::array_layout(
            vmhook::find_class(compact_string ? "[B" : "[C")) };
        if (!backing_layout || !vmhook::hotspot::in_java_detour()) { return nullptr; }
        const std::size_t backing_body{ backing_layout->body_offset };

        // Decode the UTF-8 input into UTF-16 code units (astral code points
        // become a surrogate pair).  The previous implementation copied the raw
        // UTF-8 BYTES straight into a LATIN1 byte[] / char[], which conflated
        // byte count with char count and corrupted every non-ASCII string —
        // e.g. "é" (0xC3 0xA9) turned into the two chars U+00C3 U+00A9.
        const std::u16string_view units{ value };
        const auto maximum_units{ static_cast<std::size_t>((std::numeric_limits<std::int32_t>::max)())
            / (compact_string ? 2u : 1u) };
        if (units.size() > maximum_units) { return nullptr; }
        const std::int32_t char_count{ static_cast<std::int32_t>(units.size()) };


        // A compact (JDK 9+) String may use the LATIN1 coder only when every
        // code unit fits in one byte; otherwise it must use the UTF16 coder.
        bool all_latin1{ true };
        for (const std::uint16_t unit : units)
        {
            if (unit > 0xFFu) { all_latin1 = false; break; }
        }

        // Build the String + its backing array from the TLAB.  Ordering matters:
        // string_oop is an UNROOTED raw oop for as long as the backing array
        // allocation is in flight, so any allocation here that could trigger a GC
        // would risk relocating it and corrupting the subsequent field write.  The
        // TLAB path never triggers a GC — it fails and returns null instead —
        // which is what makes this window safe.
        const auto build_via_tlab{ [&]() -> void*
        {
            void* const string_oop{ vmhook::make_java_object(string_klass, string_klass->get_instance_size()) };
            if (!string_oop)
            {
                ::vmhook::detail::log_line("{} vmhook::make_java_string(): make_java_object for java.lang.String failed "
                           "(instance_size={} bytes).",
                           vmhook::error_tag, string_klass->get_instance_size());
                return nullptr;
            }

            if (compact_string && all_latin1)
            {
                void* const value_array{ vmhook::make_java_array("[B", char_count, sizeof(std::uint8_t)) };
                if (!value_array)
                {
                    ::vmhook::detail::log_line("{} vmhook::make_java_string(): failed to allocate the byte[] backing "
                               "array (compact LATIN1 path, chars={}).",
                               vmhook::error_tag, char_count);
                    return nullptr;
                }

                auto* const bytes{ reinterpret_cast<std::uint8_t*>(value_array) + backing_body };
                for (std::int32_t index{ 0 }; index < char_count; ++index)
                {
                    bytes[index] = static_cast<std::uint8_t>(units[static_cast<std::size_t>(index)]);
                }
                if (!vmhook::detail::initialize_unpublished_reference(string_oop, string_klass, "value", value_array))
                {
                    return nullptr;
                }
                vmhook::set_field<std::uint8_t>(string_oop, string_klass, "coder", 0u);
            }
            else if (compact_string)
            {
                // UTF16 coder: byte[] holding 2 bytes per code unit, native-endian
                // (HotSpot StringUTF16 stores chars in platform byte order; on the
                // x64 CI that is little-endian, matching the units' in-memory bytes).
                void* const value_array{ vmhook::make_java_array("[B", char_count * 2, sizeof(std::uint8_t)) };
                if (!value_array)
                {
                    ::vmhook::detail::log_line("{} vmhook::make_java_string(): failed to allocate the byte[] backing "
                               "array (compact UTF16 path, chars={}).",
                               vmhook::error_tag, char_count);
                    return nullptr;
                }

                std::memcpy(reinterpret_cast<std::uint8_t*>(value_array) + backing_body,
                            units.data(), static_cast<std::size_t>(char_count) * 2u);
                if (!vmhook::detail::initialize_unpublished_reference(string_oop, string_klass, "value", value_array))
                {
                    return nullptr;
                }
                vmhook::set_field<std::uint8_t>(string_oop, string_klass, "coder", 1u);
            }
            else
            {
                void* const value_array{ vmhook::make_java_array("[C", char_count, sizeof(std::uint16_t)) };
                if (!value_array)
                {
                    ::vmhook::detail::log_line("{} vmhook::make_java_string(): failed to allocate the char[] backing "
                               "array (classic string path, chars={}).",
                               vmhook::error_tag, char_count);
                    return nullptr;
                }

                auto* const chars{ reinterpret_cast<std::uint16_t*>(reinterpret_cast<std::uint8_t*>(value_array) + backing_body) };
                for (std::int32_t index{ 0 }; index < char_count; ++index)
                {
                    chars[index] = units[static_cast<std::size_t>(index)];
                }

                if (!vmhook::detail::initialize_unpublished_reference(string_oop, string_klass, "value", value_array))
                {
                    return nullptr;
                }

                if (string_klass->find_field("offset").has_value())
                {
                    vmhook::set_field<std::int32_t>(string_oop, string_klass, "offset", 0);
                }

                if (string_klass->find_field("count").has_value())
                {
                    vmhook::set_field<std::int32_t>(string_oop, string_klass, "count", char_count);
                }
            }

            if (string_klass->find_field("hash").has_value())
            {
                vmhook::set_field<std::int32_t>(string_oop, string_klass, "hash", 0);
            }

            return string_oop;
        } };

        // Build via the TLAB path at ANY length.  The former
        // k_tlab_string_max_units cap existed only to divert longer inputs to a
        // second, GC-aware allocation tier; with that tier gone there is nothing
        // to divert to, and build_via_tlab() constructs the complete String for
        // the full input regardless of size.
        if (void* const tlab_string_oop{ build_via_tlab() })
        {
            return tlab_string_oop;
        }

        // No second allocation tier: if build_via_tlab() could not allocate
        // (heap/TLAB exhausted, or a GC would be required), the answer is null.
        ::vmhook::detail::log_line("{} vmhook::make_java_string(): TLAB build failed ({} code units); "
                   "no further allocation path is available.",
                   vmhook::info_tag, char_count);
        return nullptr;
    }

    inline auto make_java_string(const std::string_view value) -> void*
    {
        const auto units{ vmhook::detail::utf8_to_utf16(value) };
        std::u16string text;
        text.reserve(units.size());
        for (const auto unit : units) { text.push_back(static_cast<char16_t>(unit)); }
        return vmhook::make_java_string_utf16(text);
    }

    // --- Array element access -------------------------------------------------

    /*
        @brief Defensive upper bound on any element count derived from a live oop.
        @details
        array_length() and the Java `size`/`size()` fields it sits beside read a
        raw int32 straight out of heap memory.  For a stale / GC-relocated /
        partially-corrupted oop that slot can hold an arbitrary large positive
        value.  Several readers below feed that value UNVALIDATED into both
        `result.reserve(count)` and a `count`-iteration element loop:

          * a `reserve()` of `count * sizeof(element)` can throw std::length_error
            or std::bad_alloc — and several readers are `noexcept`, so the throw
            would cross the noexcept boundary and call std::terminate, taking the
            whole host JVM down (a HARD rule violation), and
          * even when reserve succeeds the loop can spin billions of times,
            reading far past the real allocation (a hang / massive over-read).

        Clamping every oop-derived count to `min(count, k_max_safe_container_elems)`
        (and treating <0 as 0) before BOTH the reserve and the loop fixes both:
        the loop is bounded and reservations cannot overflow. Bounded allocations
        can still throw std::bad_alloc; a size cap does not make allocation noexcept.  16,777,216 is far above any realistic
        introspected container, so an honest container of N <= cap elements reads
        EXACTLY as before — only a degenerate/corrupted count is ever truncated.

        NOTE: this cap is deliberately NOT applied inside array_length() itself,
        because array_length() is also the bounds oracle for get/set_array_element
        (a valid array genuinely longer than the cap must still report its true
        length so high-but-valid indices are not wrongly rejected).  The clamp
        lives at each count-driven reserve/iteration site instead.
    */
    inline constexpr std::size_t k_max_safe_container_elems{ 1ull << 24 };

    /*
        @brief Clamps a raw, possibly-corrupt oop-derived element count to a safe
               iteration/reservation bound.
        @param raw  A length/size read straight from heap memory (may be negative
                    or absurdly large under a stale/corrupted oop).
        @return  raw clamped to [0, k_max_safe_container_elems].
        @details
        Negative counts (e.g. a torn read of the _length slot) collapse to 0;
        counts above the cap are truncated to the cap.  The result is the count
        used for BOTH the pre-reservation (`reserve(static_cast<std::size_t>(...))`,
        unchanged in form) AND the read-loop bound (`for (int32_t i; i < safe; ++i)`)
        at every reader fed by such a count, so a single honest call site
        (raw <= cap) reads byte-identically while a corrupt one degrades to a
        bounded, non-terminating partial read.  The return type is std::int32_t so
        existing int32 loop counters and the existing reserve cast are reused
        verbatim; the cap (1<<24) fits int32 with room to spare, so the clamp
        itself can never overflow.
    */
    inline constexpr auto clamp_safe_container_count(const std::int32_t raw) noexcept
        -> std::int32_t
    {
        if (raw <= 0)
        {
            return 0;
        }
        static_assert(vmhook::k_max_safe_container_elems
                          <= static_cast<std::size_t>((std::numeric_limits<std::int32_t>::max)()),
                      "k_max_safe_container_elems must fit in std::int32_t so the clamp cannot overflow.");
        constexpr std::int32_t cap{ static_cast<std::int32_t>(vmhook::k_max_safe_container_elems) };
        return (raw < cap) ? raw : cap;
    }

    /*
        @brief Reads the length of a Java primitive array.
        @param array_oop Decoded pointer to the Java array object (not compressed).
        @return Element count, or 0 if the pointer is invalid.
        @details
        HotSpot Array object layout (x64, compressed OOPs):
          +0  mark word (8 B)
          +8  klass pointer (4 B)
          +12 _length   (int)
          +16 _data[0]
    */
    inline auto array_length(void* const array_oop) noexcept
        -> std::int32_t
    {
        const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array_oop)) };
        if (!layout) { return 0; }
        std::int32_t length{};
        if (!vmhook::os::safe_read(&length, static_cast<const std::uint8_t*>(array_oop)
            + layout->length_offset, sizeof(length)) || length < 0) { return 0; }
        return length;
    }

    /*
        @brief Reads the element at the given index from a Java primitive array.
        @tparam T    The C++ element type (int32_t, double, int8_t, bool, etc.).
        @param array_oop Decoded pointer to the Java array object.
        @param index Zero-based element index.
        @return The element value, or T{} if the pointer/index is invalid.
        @details
        Data starts at offset +16 from the array oop.  Element stride is sizeof(T).
        Bounds checking is performed against the array length.
    */
    template<typename element_type>
    inline auto get_array_element(void* const array_oop, const std::int32_t index)
        -> element_type
    {
        static_assert(std::is_trivially_copyable_v<element_type>);
        const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array_oop)) };
        if (!layout || sizeof(element_type) != layout->element_width) { return element_type{}; }
        const std::int32_t length{ vmhook::array_length(array_oop) };
        if (index < 0 || index >= length) { return element_type{}; }
        element_type result{};
        (void)vmhook::os::safe_read(&result, static_cast<const std::uint8_t*>(array_oop)
            + layout->body_offset + static_cast<std::size_t>(index) * layout->element_width,
            sizeof(result));
        return result;
    }

    /*
        @brief Writes a value into a Java primitive array at the given index.
        @tparam T    The C++ element type.
        @param array_oop Decoded pointer to the Java array object.
        @param index Zero-based element index.
        @param value The value to write.
    */
    template<typename element_type>
    inline auto set_array_element(void* const array_oop, const std::int32_t index, const element_type value)
        -> void
    {
        static_assert(std::is_trivially_copyable_v<element_type>);
        const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array_oop)) };
        if (!layout || sizeof(element_type) != layout->element_width
            || (layout->reference_elements && !vmhook::detail::reference_stores_supported())) { return; }
        const std::int32_t length{ vmhook::array_length(array_oop) };
        if (index < 0 || index >= length) { return; }
        (void)vmhook::os::safe_write(static_cast<std::uint8_t*>(array_oop) + layout->body_offset
            + static_cast<std::size_t>(index) * layout->element_width, &value, sizeof(value));
    }

    // --- Collector-aware field access ----------------------------------------
    namespace detail::field_memory_backend
    {
        inline auto bootstrap_class(const std::string_view name) -> vmhook::hotspot::klass*
        {
            const auto* data_entry{ vmhook::hotspot::iterate_struct_entries("Klass", "_class_loader_data") };
            if (!data_entry)
            { data_entry = vmhook::hotspot::iterate_struct_entries("InstanceKlass", "_class_loader_data"); }
            const auto* const loader_entry{ vmhook::hotspot::iterate_struct_entries("ClassLoaderData", "_class_loader") };
            if (!data_entry || !loader_entry || !loader_entry->type_string) { return nullptr; }
            vmhook::hotspot::klass* result{};
            const vmhook::hotspot::class_loader_data_graph graph{};
            graph.for_each_klass([&](const std::string_view observed, vmhook::hotspot::klass* const klass)
            {
                if (result || observed != name) { return; }
                void* data{};
                void* loader{};
                if (!vmhook::os::safe_read(&data, reinterpret_cast<const std::byte*>(klass)
                        + data_entry->offset, sizeof(data)) || !data
                    || !vmhook::os::safe_read(&loader, static_cast<const std::byte*>(data)
                        + loader_entry->offset, sizeof(loader))) { return; }
                const std::string_view storage{ loader_entry->type_string };
                if (storage == "OopHandle")
                {
                    if (loader && !vmhook::os::safe_read(&loader, loader, sizeof(loader))) { return; }
                }
                else if (storage != "oop") { return; }
                if (!loader) { result = klass; }
            });
            return result;
        }

        /* Unsafe is an already-loaded Java class. Calling its Java methods
           through JavaCalls executes HotSpot's real Access<...> collector and
           volatile barriers. No native interface table or Unsafe native symbol
           is called by VMHook. The singleton, holder and arguments are retained
           before the call; none of their addresses survives a safepoint. */
        inline auto invoke(const native_backend::root& holder, const std::size_t offset,
                           const std::string_view method_name,
                           const std::string_view fallback_name,
                           const std::string_view descriptor,
                           const std::uint64_t value_bits = 0,
                           const native_backend::root& object = {},
                           const bool write = false,
                           const bool compare = false,
                           const std::uint64_t expected_bits = 0,
                           const native_backend::root& expected_object = {})
            -> native_backend::native_call_result
        {
            native_backend::operation access{};
            if (!access || !holder || !holder->valid()
                || !vmhook::detail::java_execution_supported())
            { throw vmhook::exception{ "Field barriers require a rooted field and a supported native or callback context" }; }
            for (const std::string_view class_name : { "jdk/internal/misc/Unsafe", "sun/misc/Unsafe" })
            {
                // A user class-lookup override or a same-named application
                // class cannot substitute for the VM's bootstrap accessor.
                auto* const unsafe_class{ bootstrap_class(class_name) };
                if (!unsafe_class || !vmhook::detail::class_initialized(unsafe_class)) { continue; }
                const auto metadata{ native_backend::retain_class(unsafe_class) };
                const auto singleton_field{ vmhook::find_field(unsafe_class, "theUnsafe") };
                if (!metadata || !singleton_field || !singleton_field->is_static) { continue; }
                void* const mirror{ metadata->resolve_under_vm() };
                if (!mirror) { continue; }
                std::uint32_t encoded{};
                if (vmhook::detail::reference_storage_width() != sizeof(encoded)
                    || !vmhook::os::safe_read(&encoded,
                        reinterpret_cast<const std::byte*>(mirror) + singleton_field->offset, sizeof(encoded)))
                { continue; }
                void* const singleton{ vmhook::hotspot::decode_oop_pointer(encoded) };
                if (!singleton || vmhook::klass_from_oop(singleton) != unsafe_class) { continue; }
                const auto receiver{ native_backend::retain_oop(singleton) };
                if (!receiver) { throw vmhook::exception{ "Java field accessor receiver could not be retained" }; }
                vmhook::hotspot::method** methods{};
                std::int32_t count{};
                if (!vmhook::hotspot::safe_klass_methods(unsafe_class, methods, count)) { continue; }
                vmhook::hotspot::method* selected{};
                for (std::int32_t index{}; index < count; ++index)
                {
                    auto* const method{ methods[index] };
                    if (!method || method->get_signature() != descriptor) { continue; }
                    const auto name{ method->get_name() };
                    if (name == method_name) { selected = method; break; }
                    if (!selected && ((!fallback_name.empty() && name == fallback_name)
                        || (method_name == "compareAndSetReference" && name == "compareAndSetObject")))
                    { selected = method; }
                }
                if (!selected) { continue; }
                std::array<std::intptr_t, 8> parameters{};
                parameters[0] = reinterpret_cast<std::intptr_t>(receiver->resolve_under_vm());
                parameters[1] = reinterpret_cast<std::intptr_t>(holder->resolve_under_vm());
                // A Java long occupies two interpreter slots: padding, value.
                parameters[3] = static_cast<std::intptr_t>(offset);
                std::size_t slots{4};
                if (write)
                {
                    const auto value_kind{ descriptor.size() > 20 ? descriptor[20] : '\0' };
                    if (value_kind == 'L' || value_kind == '[')
                    {
                        parameters[compare ? 5 : 4] = reinterpret_cast<std::intptr_t>(object ? object->resolve_under_vm() : nullptr);
                        if (object && !parameters[compare ? 5 : 4])
                        { throw vmhook::exception{ "Field reference argument lost its owning context" }; }
                        if (compare)
                        {
                            parameters[4] = reinterpret_cast<std::intptr_t>(expected_object
                                ? expected_object->resolve_under_vm() : nullptr);
                            if (expected_object && !parameters[4])
                            { throw vmhook::exception{ "Expected field reference lost its owning context" }; }
                        }
                        slots = compare ? 6 : 5;
                    }
                    else if (value_kind == 'J' || value_kind == 'D')
                    {
                        parameters[compare ? 7 : 5] = static_cast<std::intptr_t>(value_bits);
                        if (compare) { parameters[5] = static_cast<std::intptr_t>(expected_bits); }
                        slots = compare ? 8 : 6;
                    }
                    else
                    {
                        parameters[compare ? 5 : 4] = static_cast<std::intptr_t>(value_bits);
                        if (compare) { parameters[4] = static_cast<std::intptr_t>(expected_bits); }
                        slots = compare ? 6 : 5;
                    }
                }
                const auto called{ native_backend::invoke_packed(selected, descriptor,
                    parameters.data(), slots, nullptr, nullptr) };
                if (!called.invoked || called.threw || !called.error.empty())
                { throw vmhook::exception{ called.threw ? "Java field accessor threw an exception"
                    : !called.error.empty() ? called.error : "Java field accessor refused invocation",
                    called.threw ? vmhook::error_code::java_exception : vmhook::error_code::refused,
                    called.exception_class, called.exception }; }
                return called;
            }
            throw vmhook::exception{ "No already-initialized Java Unsafe field accessor matches this JVM" };
        }
    }

    // --- Field proxy ----------------------------------------------------------

        /*
            @brief Lightweight proxy to a single Java field value in memory.
        */
    class field_proxy final
    {
    public:
        /*
            @brief A typed copy of the field's value.
        */
        struct value_t
        {
            std::variant<
                bool,
                std::int8_t,
                std::int16_t,
                std::int32_t,
                std::int64_t,
                float,
                double,
                std::uint16_t,
                std::uint32_t   // reference / array (compressed OOP)
            > data;
            std::string signature{};
            vmhook::detail::native_backend::root native_root{};
            bool read_succeeded{};
            std::optional<vmhook::exception> failure{};

            value_t() = default;
            template<typename stored_type>
            value_t(stored_type&& value, std::string signature,
                    vmhook::detail::native_backend::root root = {})
                : data{ std::forward<stored_type>(value) }, signature{ std::move(signature) },
                  native_root{ std::move(root) }, read_succeeded{ true } {}

            static auto failed(std::string signature) -> value_t
            { value_t result; result.signature = std::move(signature); return result; }
            static auto failed(vmhook::exception error) -> value_t
            { value_t result; result.failure = std::move(error); return result; }
            [[nodiscard]] auto status() const noexcept -> vmhook::error_code
            { return failure ? failure->code() : read_succeeded ? vmhook::error_code::none : vmhook::error_code::refused; }
            auto require_success() const -> void
            {
                if (failure) { throw *failure; }
                if (!read_succeeded) { throw vmhook::exception{ "Java field read refused or failed" }; }
            }
            [[nodiscard]] auto error() const -> std::optional<vmhook::exception>
            {
                if (failure) { return failure; }
                if (!read_succeeded) { return vmhook::exception{ "Java field read refused or failed" }; }
                return {};
            }


            auto reference_address(const std::uint32_t compressed) const -> void*
            {
                if (!this->native_root) { return vmhook::hotspot::decode_oop_pointer(compressed); }
                if (!this->native_root->valid())
                { throw vmhook::exception{ "Java result belongs to an expired or different native context" }; }
                void* const address{ this->native_root->resolve_under_vm() };
                if (!address)
                { throw vmhook::exception{ "Retained Java result could not be resolved", vmhook::error_code::result_unavailable }; }
                return address;
            }

            /*
                @brief Appends one boolean element from a Java boolean[] to result.
                @details
                Reads the element as uint8_t and converts non-zero to true.
                Complexity: O(1). Exception safety: allocation and checked conversion failures propagate.
            */
            static auto append_array_value(std::vector<bool>& result, void* const array_oop, const std::int32_t index, std::string_view)
                -> void
            {
                result.push_back(vmhook::get_array_element<std::uint8_t>(array_oop, index) != 0);
            }

            /*
                @brief Appends one Java String element from a String[] to result.
                @details
                Reads the compressed OOP at index, decodes it, then calls read_java_string().
                Complexity: O(S) where S = string length. Exception safety: allocation and checked conversion failures propagate.
            */
            static auto append_array_value(std::vector<std::string>& result, void* const array_oop, const std::int32_t index, std::string_view)
                -> void
            {
                const std::uint32_t element_compressed{ vmhook::get_array_element<std::uint32_t>(array_oop, index) };
                result.push_back(vmhook::read_java_string(vmhook::hotspot::decode_oop_pointer(element_compressed)));
            }

            /*
                @brief Appends one element from a Java char[] or byte[] to a std::vector<char>.
                @details
                For "[C" arrays reads a uint16 and narrows to char; for all other arrays
                reads directly as char.
                Complexity: O(1). Exception safety: allocation and checked conversion failures propagate.
            */
            static auto append_array_value(std::vector<char>& result, void* const array_oop, const std::int32_t index, const std::string_view signature)
                -> void
            {
                if (signature == "[C")
                {
                    result.push_back(static_cast<char>(vmhook::get_array_element<std::uint16_t>(array_oop, index)));
                }
                else
                {
                    result.push_back(vmhook::get_array_element<char>(array_oop, index));
                }
            }

            /*
                @brief Generic overload: appends one element_type element from a Java array to result.
                @details
                Used for numeric types (int, float, double, etc.) and any other trivially
                copyable element_type.
                Complexity: O(1). Exception safety: allocation and checked conversion failures propagate.
            */
            template<typename element_type>
            static auto append_array_value(std::vector<element_type>& result, void* const array_oop, const std::int32_t index, std::string_view)
                -> void
            {
                result.push_back(vmhook::get_array_element<element_type>(array_oop, index));
            }

            /*
                @brief Decodes a compressed array OOP and reads all elements into a std::vector<target_type>.
                @details
                Decodes compressed (the compressed array OOP) via decode_array_oop(), reads
                the Java array length, reserves the result vector, then calls append_array_value()
                for each element.  The correct append_array_value overload is selected based on
                target_type's element type at compile time.

                Complexity: O(N) where N = array length.
                Exception safety: noexcept — returns an empty vector on any failure.

                @param compressed  Compressed OOP of the Java array.
                @param signature   JVM array type descriptor (e.g. "[I", "[Ljava/lang/String;").
                @return  Vector containing all decoded elements, or an empty vector on failure.
            */
            template<typename target_type>
            static auto read_array_value(const std::uint32_t compressed, const std::string_view signature)
                -> target_type
            {
                target_type result{};
                void* const array_oop{ vmhook::decode_array_oop(compressed) };
                if (!array_oop)
                {
                    return result;
                }

                // ELEMENT-WIDTH GUARD (mirrors field_proxy::set's size-mismatch
                // refusal at the read side).  The per-element read strides the
                // array data by sizeof(the REQUESTED C++ element) via
                // get_array_element<T>, but the array's ACTUAL element width is
                // fixed by its JVM descriptor ([Z/[B = 1, [S/[C = 2, [I/[F = 4,
                // [J/[D = 8).  A width mismatch is memory-unsafe in BOTH directions:
                //   - requested WIDER than actual (e.g. [I -> vector<int64_t>):
                //     strides length*8 bytes across a length*4-byte array, reading
                //     PAST the data area = OUT-OF-BOUNDS.  get_array_element's
                //     bounds check is index-only (index < length) and cannot catch
                //     a too-large per-element stride.
                //   - requested NARROWER than actual (e.g. [J -> vector<int32_t>):
                //     walks the wider data with a short stride, yielding interleaved
                //     low/high words = silently WRONG values.
                // Refuse the read (return the empty result) on any mismatch, exactly
                // as field_proxy::set refuses a width-mismatched write, instead of
                // mis-decoding or reading past the array.  Matching-width reads
                // ([I -> vector<int32_t>, [J -> vector<int64_t>, ...) are unaffected
                // and take the byte-identical fast path below.
                //
                // Carve-outs: the std::vector<bool> / <char> / <string> overloads
                // DELIBERATELY decode at a width that differs from sizeof(element)
                // (bool <- uint8 of [Z, char <- uint16 of [C, string <- compressed
                // OOP of an object array) and are validated by their own overloads,
                // so the numeric width comparison must not gate them.  The helper
                // also returns 0 for object / unknown element descriptors, which
                // skips the guard for those.
                if constexpr (vmhook::detail::is_vector_v<target_type>)
                {
                    using element_type =
                        typename vmhook::detail::is_vector<std::remove_cvref_t<target_type>>::value_type_t;
                    if constexpr (!std::is_same_v<element_type, bool>
                               && !std::is_same_v<element_type, char>
                               && !std::is_same_v<element_type, std::string>)
                    {
                        if (signature.size() >= 2 && signature.front() == '[')
                        {
                            const std::size_t field_element_width{
                                vmhook::detail::jvm_primitive_byte_width(signature.substr(1)) };
                            if (field_element_width != 0
                                && sizeof(element_type) != field_element_width)
                            {
                                ::vmhook::detail::log_line("{} field_proxy::value_t::read_array_value: element-width "
                                           "mismatch (requested C++ element = {}B, JVM array element "
                                           "= {}B, sig='{}') - refusing the read to avoid {} the "
                                           "array data.  Read the field into a std::vector whose "
                                           "element matches the array's primitive width.",
                                           vmhook::error_tag, sizeof(element_type),
                                           field_element_width, signature,
                                           sizeof(element_type) > field_element_width
                                               ? "reading PAST"
                                               : "mis-striding");
                                return result;
                            }
                        }
                    }
                }

                const std::int32_t length{ vmhook::array_length(array_oop) };
                if (length <= 0)
                {
                    return result;
                }

                // length is read straight from the array header (+12) and is
                // UNVALIDATED: a stale/corrupted array_oop can report an absurd
                // count.  This function is noexcept, so an uncapped reserve that
                // threw length_error/bad_alloc would std::terminate the host JVM.
                // Clamp to a generous safe bound for BOTH the reserve and the
                // loop; an honest array (length <= cap) is unaffected.
                const std::int32_t safe_length{ vmhook::clamp_safe_container_count(length) };
                result.reserve(static_cast<std::size_t>(safe_length));
                for (std::int32_t index{ 0 }; index < safe_length; ++index)
                {
                    append_array_value(result, array_oop, index, signature);
                }

                return result;
            }

            /*
                @brief Converts a variant alternative source_type to target_type with semantic dispatch.
                @details
                Called by operator target_type() via std::visit.  Applies the correct
                conversion strategy based on the target:
                  - std::string          <- decodes compressed OOP via read_java_string()
                  - std::vector<T>       <- decodes array OOP and reads all elements
                  - std::unique_ptr<T>   <- decodes compressed OOP and constructs wrapper
                  - void*                <- decodes compressed OOP to raw pointer
                  - numeric / bool types <- static_cast from the variant alternative

                Complexity: O(1) for scalars; O(N) for strings/arrays.
                Owning object conversion throws for failed reads, invalid
                contexts, unknown wrapper classes, and incompatible objects.
                Only a genuine Java null creates a wrapper on nullptr.

                @tparam target_type  Desired output type.
                @tparam source_type  The variant alternative actually stored.
                @param value         The stored alternative value.
                @return              Converted value; object refusals throw.
            */
            template<typename target_type, typename source_type>
            auto cast_for_variant(source_type value) const
                -> target_type
            {
                vmhook::detail::native_backend::operation access{};
                using clean_target_type = std::remove_cvref_t<target_type>;
                using clean_source_type = std::remove_cvref_t<source_type>;

                if constexpr (std::is_same_v<clean_source_type, std::uint32_t>)
                {
                    if (this->native_root)
                    {
                        value = vmhook::hotspot::encode_oop_pointer(this->native_root->resolve_under_vm());
                    }
                }

                if constexpr (std::is_same_v<clean_target_type, std::string>)
                {
                    if constexpr (std::is_same_v<clean_source_type, std::uint32_t>)
                    {
                        return vmhook::read_java_string(this->reference_address(value));
                    }
                    else
                    {
                        throw vmhook::exception{ "Java field value cannot be converted to the requested C++ type", vmhook::error_code::type_mismatch };
                    }
                }
                else if constexpr (vmhook::detail::is_vector_v<clean_target_type>)
                {
                    if constexpr (std::is_same_v<clean_source_type, std::uint32_t>)
                    {
                        return read_array_value<clean_target_type>(value, this->signature);
                    }
                    else
                    {
                        throw vmhook::exception{ "Java field value cannot be converted to the requested C++ type", vmhook::error_code::type_mismatch };
                    }
                }
                else if constexpr (vmhook::detail::is_unique_ptr_v<clean_target_type>)
                {
                    using wrapper_type = typename clean_target_type::element_type;
                    if (this->signature.empty())
                    { throw vmhook::exception{ "Object conversion requires a Java reference field" }; }
                    if (this->signature.front() != 'L')
                    {
                        if constexpr (requires { wrapper_type::java_array_wrapper; })
                        {
                            if (this->signature.front() != '[' || !wrapper_type::java_array_wrapper)
                            { throw vmhook::exception{ "Typed array conversion requires a Java array field" }; }
                        }
                        else { throw vmhook::exception{ "Object conversion requires a Java object field" }; }
                    }
                    if constexpr (std::is_same_v<clean_source_type, std::uint32_t>)
                    { return vmhook::detail::materialize_object<wrapper_type>(value, this->native_root); }
                    else
                    { throw vmhook::exception{ "Java object field could not be read or retained" }; }
                }
                else if constexpr (requires { static_cast<target_type>(value); })
                {
                    if constexpr (std::is_same_v<clean_source_type, std::uint32_t>)
                    { throw vmhook::exception{ "A Java reference cannot be converted to a C++ primitive", vmhook::error_code::type_mismatch }; }
                    return static_cast<target_type>(value);
                }
                else
                {
                    throw vmhook::exception{ "Java field value cannot be converted to the requested C++ type", vmhook::error_code::type_mismatch };
                }
            }

            /*
                @brief Implicit conversion operator from value_t to any supported target type.
                @tparam target_type  The type the value is being converted to.
            */
            template<typename target_type>
                requires vmhook::detail::value_t_convertible_target_v<target_type>
            operator target_type() const
            {
                this->require_success();
                return std::visit([this](auto value)
                    -> target_type
                    {
                        return this->cast_for_variant<target_type>(value);
                    }, data);
            }

            /*
                @brief The field value as a std::string, unambiguously.
            */
            auto as_string() const -> std::string
            {
                this->require_success();
                if (this->signature != "Ljava/lang/String;")
                { throw vmhook::exception{ "String conversion requires a Java String field", vmhook::error_code::type_mismatch }; }
                vmhook::detail::native_backend::operation access{};
                return std::visit([this](const auto& v)
                    -> std::string
                    {
                        using stored_type = std::remove_cvref_t<decltype(v)>;
                        if constexpr (std::is_same_v<stored_type, std::uint32_t>)
                        {
                            return vmhook::read_java_string(this->reference_address(v));
                        }
                        else
                        {
                            return std::string{};
                        }
                    }, data);
            }

            auto as_utf16() const -> std::u16string
            {
                this->require_success();
                if (this->signature != "Ljava/lang/String;" || !std::holds_alternative<std::uint32_t>(this->data))
                { throw vmhook::exception{ "UTF-16 conversion requires a Java String field", vmhook::error_code::type_mismatch }; }
                vmhook::detail::native_backend::operation access{};
                return vmhook::read_java_string_utf16(this->reference_address(std::get<std::uint32_t>(this->data)));
            }

            /*
                @brief True when this value holds a reference/String field (compressed OOP).
                Parity with method_proxy::value_t::is_string()/is_void() introspection.
            */
            auto is_reference() const noexcept -> bool
            {
                return std::holds_alternative<std::uint32_t>(data);
            }

            /* The destination of a deferred conversion supplies the wrapper
               types. Explicit template arguments materialize eagerly for auto
               locals. Non-null sources require their originating VM root. */
            auto to_vector() const -> vmhook::detail::vector_conversion<value_t>;
            auto to_entries() const -> vmhook::detail::vector_conversion<value_t, true>;
            template<vmhook::detail::container_wrapper element_type>
            auto to_vector() const -> std::vector<std::unique_ptr<element_type>>;
            template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
            auto to_vector() const
                -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>;
            template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
            auto to_entries() const
                -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>;

            /* Checked untyped navigation materializes an owning wrapper. */
            auto operator->() const -> std::unique_ptr<vmhook::any_object>;
        };

        /*
            @param field_pointer Direct pointer to the field's bytes in JVM memory
                                 (decoded object address + offset for instance fields;
                                  java.lang.Class mirror + offset for static fields).
            @param signature     JVM type descriptor, e.g. "I", "Z", "Ljava/lang/String;"
            @param is_static     true when JVM_ACC_STATIC is set on the field.
        */
        field_proxy(void* field_pointer, std::string sig, const bool is_static_flag)
            : field_pointer{ field_pointer }
            , signature_text{ std::move(sig) }
            , static_field{ is_static_flag }
        {
        }

        /*
            @param field_pointer Previously observed field address.
            @param signature JVM field descriptor.
            @param is_static True for static access.
            @param mirror_klass Declaring Klass used to read the mirror again.
            @param field_offset Field byte offset in the mirror.
            @note Re-reading a mirror can detect relocation but does not protect the
            subsequent access from GC or class unloading.
        */
        field_proxy(void* field_pointer, std::string sig, const bool is_static_flag,
                    vmhook::hotspot::klass* mirror_klass, const std::size_t field_offset,
                    const std::uint16_t access_flags = 0)
            : field_pointer{ field_pointer }
            , signature_text{ std::move(sig) }
            , static_field{ is_static_flag }
            , mirror_klass{ mirror_klass }
            , field_offset{ field_offset }
            , field_flags{ access_flags }
        {
            this->reference_declaring_class = mirror_klass;
            vmhook::detail::native_backend::operation access{};
            if (access)
            {
                this->native_bound = true;
                this->holder_root = vmhook::detail::native_backend::retain_class(mirror_klass);
            }
        }

        field_proxy(void* field_pointer, std::string sig, const bool is_static_flag,
                    vmhook::detail::native_backend::root holder, const std::size_t offset,
                    vmhook::hotspot::klass* const declaring_class = nullptr,
                    const std::uint16_t access_flags = 0)
            : field_pointer{ field_pointer }, signature_text{ std::move(sig) }, static_field{ is_static_flag },
              field_offset{ offset }, holder_root{ std::move(holder) }, reference_declaring_class{ declaring_class },
              field_flags{ access_flags }
        {
            this->native_bound = this->holder_root != nullptr || vmhook::detail::native_backend::active();
        }

        /*
            @brief Reads a field using its JVM descriptor and returns a copied value.
            @details Primitive alternatives own their C++ value. In a native-thread
            context, reference results hold a VM-scanned root ticket until released
            or the context closes. Legacy detour results remain non-owning snapshots.
            Typed heap-field decoding requires verified narrow-oop support.
        */
    private:
        auto get_unchecked() const
            -> value_t
        {
            vmhook::detail::native_backend::operation access{};
            if (this->is_volatile()) { return this->read_volatile(); }
            if (this->is_reference()
                && (vmhook::detail::reference_storage_width() != sizeof(std::uint32_t)
                    || !vmhook::detail::reference_reads_supported()))
            {
                ::vmhook::detail::log_line("{} field_proxy::get(): typed reference reads require verified narrow oops.",
                                          vmhook::error_tag);
                return value_t::failed(this->signature_text);
            }
            // Read the static mirror again instead of retaining its previously observed address.
            // This narrows staleness but does not synchronize with GC or class unloading.
            void* read_pointer{ this->resolved_address_under_vm() };
            if (!this->native_bound && !this->holder_root && this->mirror_klass)
            {
                void* const live_mirror{ this->mirror_klass->get_java_mirror() };
                if (!live_mirror || !vmhook::hotspot::is_valid_pointer(live_mirror))
                {
                    return value_t::failed(this->signature_text);
                }
                read_pointer = reinterpret_cast<std::uint8_t*>(live_mirror) + this->field_offset;
            }

            if (!read_pointer)
            {
                return value_t::failed(this->signature_text);
            }

            // Read JVM memory through the Windows memory API and stop on unreadable data.
            // A successful read does not establish object lifetime or a coherent VM snapshot.
            if (!vmhook::hotspot::is_valid_pointer(read_pointer)
                && !vmhook::hotspot::is_valid_pointer(reinterpret_cast<const void*>(
                       reinterpret_cast<std::uintptr_t>(read_pointer) & ~std::uintptr_t{ 1 })))
            {
                return value_t::failed(this->signature_text);
            }

            // Read JVM memory through the Windows memory API and stop on unreadable data.
            // A successful read does not establish object lifetime or a coherent VM snapshot.
            if (this->signature_text == "Z")
            {
                bool value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "B")
            {
                std::int8_t value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "S")
            {
                std::int16_t value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "I")
            {
                std::int32_t value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "J")
            {
                std::int64_t value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "F")
            {
                float value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "D")
            {
                double value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }
            if (this->signature_text == "C")
            {
                std::uint16_t value{};
                if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
                { return value_t::failed(this->signature_text); }
                return value_t{ value, this->signature_text };
            }

            if (!this->is_reference())
            { return value_t::failed(vmhook::exception{ "Java field descriptor is malformed", vmhook::error_code::type_mismatch }); }
            // Reference or array type - store compressed OOP
            std::uint32_t value{};
            if (!vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value)))
            { return value_t::failed(this->signature_text); }
            value_t result{ value, this->signature_text };
            if (access)
            {
                result.native_root = vmhook::detail::native_backend::retain_oop(
                    vmhook::hotspot::decode_oop_pointer(value));
                if (value != 0 && !result.native_root) { return value_t::failed(this->signature_text); }
            }
            return result;
        }

    public:
        auto try_get() const -> value_t
        {
            try { return this->get_unchecked(); }
            catch (const vmhook::exception& error) { return value_t::failed(error); }
        }

        auto get() const -> value_t
        {
            auto result{ this->try_get() };
            result.require_success();
            return result;
        }

        /*
            @brief Writes value into the field's storage.
            @details
            This is the only field setter exposed by field_proxy. It accepts JVM
            primitives, std::string for java.lang.String, and std::vector<T> for
            Java arrays.

            A std::string / string_view / const char* write to a java.lang.String
            field REBINDS the field to a freshly-built java.lang.String (an
            object-reference store, like a Java `field = value;`): it constructs a
            new, correctly-encoded String of any length and stores a reference to
            it, so the written value equals the input exactly (library bug #30).
            It does NOT mutate the previous String's backing array, so a shared /
            interned String referenced elsewhere is never corrupted.

            Array writes still update the existing Java array object in place
            (element-by-element, capped at the existing length) because this layer
            never reallocates a Java array — array length is fixed at creation.
        */
        template<typename value_type>
            requires vmhook::detail::supported_field_value_v<value_type>
        auto set(const value_type& value) const
            -> void
        {
            vmhook::detail::require_object_argument(value);
            vmhook::detail::native_backend::operation access{};
            if constexpr (std::is_arithmetic_v<std::remove_cvref_t<value_type>>)
            {
                constexpr auto descriptor{ vmhook::detail::descriptor_of_v<value_type> };
                const bool widened_character{ std::is_integral_v<std::remove_cvref_t<value_type>>
                    && !std::is_same_v<std::remove_cvref_t<value_type>, bool>
                    && sizeof(value_type) == 1 && this->signature_text == "C" };
                if (descriptor != this->signature_text && !widened_character)
                { throw vmhook::exception{ "Java primitive field write requires its matching C++ type", vmhook::error_code::type_mismatch }; }
            }
            if (this->is_final())
            { throw vmhook::exception{ "Final Java fields cannot be mutated through a VMHook field setter" }; }

            if constexpr (std::is_arithmetic_v<std::remove_cvref_t<value_type>>)
            {
                if (this->is_volatile())
                {
                    const auto width{ vmhook::detail::jvm_primitive_byte_width(this->signature_text) };
                    if (width != sizeof(value_type))
                    { throw vmhook::exception{ "Volatile field write requires the matching JVM primitive width" }; }
                    std::uint64_t bits{};
                    std::memcpy(&bits, &value, sizeof(value));
                    this->write_volatile(bits);
                    return;
                }
            }

            if constexpr (vmhook::detail::is_java_object_pointer_v<value_type>)
            {
                if (!this->store_object(value))
                {
                    throw vmhook::exception{
                        "Java reference field store refused: check the field type, "
                        "owning context and supported collector write barrier." };
                }
            }
            else
            {
                this->set_non_object(value);
            }
        }

        /*
            @brief The primitive / string / array write.  @see set().
        */
    private:
        template<typename value_type>
            requires (vmhook::detail::supported_field_value_v<value_type>
                      && !vmhook::detail::is_java_object_pointer_v<value_type>)
        auto set_non_object(const value_type& value) const
            -> void
        {
            using clean_value_type = std::remove_cvref_t<value_type>;
            if (this->is_final())
            { throw vmhook::exception{ "Final Java fields cannot be mutated through a VMHook field setter" }; }
            if constexpr (std::is_arithmetic_v<clean_value_type>)
            {
                if (this->is_volatile())
                {
                    if (vmhook::detail::jvm_primitive_byte_width(this->signature_text) != sizeof(value_type))
                    { throw vmhook::exception{ "Volatile field write requires the matching JVM primitive width" }; }
                    std::uint64_t bits{};
                    std::memcpy(&bits, &value, sizeof(value));
                    this->write_volatile(bits);
                    return;
                }
            }
            if constexpr (vmhook::detail::is_vector_v<clean_value_type>
                          && !std::is_same_v<clean_value_type, std::vector<std::string>>)
            {
                // Reuse an existing primitive array; its reference is unchanged.
                if (!vmhook::detail::reference_reads_supported()) { throw vmhook::exception{ "Java array write requires a verified reference layout" }; }
            }
            else
            {
                if (this->is_reference() && !this->holder_root
                    && !vmhook::detail::reference_stores_supported())
                {
                    ::vmhook::detail::log_line("{} reference store refused: collector write barriers are unavailable.", vmhook::error_tag);
                    throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                }
            }


            // Reject string / vector / unique_ptr writes when the field is a primitive.
            // Without this guard, `set(std::string{"42"})` on an "I" field would walk
            // through set_str_field -> field_oop -> decode_array_oop, reinterpreting
            // the int's bytes as a compressed OOP and writing into wherever that
            // decoded address points.  The trivially-copyable branch below has its
            // own size guard; this is the symmetric one for the non-primitive arms.
            //
            // Helper returns 0 for L / [ / V / unknown / empty signatures (i.e.
            // reference / array / void), so this fires only for genuine primitive
            // descriptors (Z B C S I J F D).
            if constexpr (std::is_same_v<clean_value_type, std::string>
                       || (std::is_convertible_v<value_type, std::string_view> && !std::is_same_v<clean_value_type, std::string>)
                       || vmhook::detail::is_vector_v<clean_value_type>
                       || vmhook::detail::is_unique_ptr_v<clean_value_type>)
            {
                if (vmhook::detail::jvm_primitive_byte_width(this->signature_text) != 0)
                {
                    ::vmhook::detail::log_line("{} field_proxy::set: refusing to write a non-primitive "
                               "C++ value (string / vector / unique_ptr) into a primitive "
                               "JVM field (sig='{}') at {:p} ({} field) - the legacy code "
                               "path would have reinterpreted the field's bytes as a "
                               "compressed OOP and written to a wild heap address.  Pass "
                               "the matching primitive type instead.",
                               vmhook::error_tag, this->signature_text,
                               this->field_pointer,
                               this->static_field ? "static" : "instance");
                    throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                }
            }

            if constexpr (std::is_same_v<clean_value_type, std::string>)
            {
                // Build an independent Java String and attempt a reference-field store.
                // The public store path enforces the supported collector gate.
                if (!this->store_string(std::string_view{ value }))
                { throw vmhook::exception{ "Java String field allocation or reference store failed" }; }
            }
            else if constexpr (std::is_convertible_v<value_type, std::string_view> && !std::is_same_v<clean_value_type, std::string>)
            {
                // string_view / const char* / std::string-like: same real-String
                // construction + reference store as the std::string arm above.
                if (!this->store_string(std::string_view{ value }))
                { throw vmhook::exception{ "Java String field allocation or reference store failed" }; }
            }
            else if constexpr (vmhook::detail::is_vector_v<clean_value_type>)
            {
                if constexpr (std::is_same_v<clean_value_type, std::vector<bool>>)
                {
                    vmhook::set_bool_array(*this, value);
                }
                else if constexpr (std::is_same_v<clean_value_type, std::vector<std::string>>)
                {
                    vmhook::set_str_array(*this, value);
                }
                else
                {
                    vmhook::set_prim_array(*this, value);
                }
            }
            else if constexpr (std::is_trivially_copyable_v<clean_value_type>)
            {
                if (!this->field_pointer)
                {
                    throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                }

                // Special case: passing a 1-byte C++ `char` to a Java `char` field
                // (descriptor "C", 2 bytes wide).  We widen via uint16 so the
                // field's full 2 bytes are written rather than only the low byte.
                //
                // Guarded with `if constexpr`: the body's
                // `static_cast<unsigned char>(value)` is only well-formed for
                // arithmetic / enum value types.  As a plain runtime `if` it was
                // still INSTANTIATED for every trivially-copyable value_type that
                // reaches this branch, so `set(void*)`, `set(std::array<char,N>)`,
                // or `set(some_struct)` on ANY field failed to COMPILE (a hard
                // error, not even SFINAE-detectable) even though signature_text was
                // not "C".  `if constexpr` drops the widening for non-arithmetic /
                // non-enum types, which then fall through to the size guard below
                // and are written (or rejected) by width like any other blob.
                // (is_arithmetic || is_enum, not is_convertible: it must still cover
                // every realistic 1-byte target of a "C" field, including std::byte,
                // which is static_cast-able but NOT implicitly convertible.)
                if constexpr (std::is_arithmetic_v<clean_value_type>
                              || std::is_enum_v<clean_value_type>)
                {
                    if (this->signature_text == "C" && sizeof(clean_value_type) == sizeof(char))
                    {
                        const std::uint16_t wide_value{ static_cast<std::uint16_t>(static_cast<unsigned char>(value)) };
                        void* write_pointer{ this->resolved_address_under_vm() };
                        if (!this->native_bound && !this->holder_root && this->mirror_klass)
                        {
                            void* const live_mirror{ this->mirror_klass->get_java_mirror() };
                            if (!live_mirror || !vmhook::hotspot::is_valid_pointer(live_mirror))
                            { throw vmhook::exception{ "Java field write requires a live declaring class mirror" }; }
                            write_pointer = reinterpret_cast<std::uint8_t*>(live_mirror) + this->field_offset;
                        }
                        if (!vmhook::os::safe_write(write_pointer, &wide_value, sizeof(wide_value)))
                        { throw vmhook::exception{ "Java field write failed: destination is unreadable or unwritable", vmhook::error_code::invalid_memory }; }
                        return;
                    }
                }

                // Size mismatch guard.  Previously the write was an unconditional
                // memcpy of sizeof(value_type) bytes into the field's storage,
                // which silently clobbered adjacent fields when the C++ type was
                // larger than the JVM type (e.g. set(int64_t{...}) on an "I"
                // field wrote 8 bytes into a 4-byte slot, corrupting whatever
                // came after it in the object layout).  Reject the write with a
                // diagnostic instead - users who hit this had a type bug, and
                // failing loudly is far better than overwriting the next field.
                //
                // Raw reference writes must match the VM's verified slot width
                // as well; an eight-byte C++ value must not overwrite a narrow
                // four-byte oop and the neighboring field.
                const std::size_t value_size{ sizeof(clean_value_type) };
                const std::size_t field_size{
                    this->is_reference() ? vmhook::detail::reference_storage_width()
                                         : vmhook::detail::jvm_primitive_byte_width(this->signature_text) };
                if (field_size == 0 || value_size != field_size)
                {
                    ::vmhook::detail::log_line("{} field_proxy::set: size mismatch at {:p} ({} field, "
                               "value={}B, field={}B, sig='{}') - refusing the write to "
                               "avoid clobbering adjacent fields.  Convert the value to "
                               "the matching primitive type.",
                               vmhook::error_tag, this->field_pointer,
                               this->static_field ? "static" : "instance",
                               value_size, field_size, this->signature_text);
                    throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                }


                void* write_pointer{ this->resolved_address_under_vm() };
                if (!this->native_bound && !this->holder_root && this->mirror_klass)
                {
                    void* const live_mirror{ this->mirror_klass->get_java_mirror() };
                    if (!live_mirror || !vmhook::hotspot::is_valid_pointer(live_mirror))
                    {
                        throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                    }
                    write_pointer = reinterpret_cast<std::uint8_t*>(live_mirror) + this->field_offset;
                }
                if (!write_pointer)
                {
                    throw vmhook::exception{ "Java field write refused: incompatible type, collector, or unresolved storage" };
                }
                if (!vmhook::os::safe_write(write_pointer, &value, value_size))
                { throw vmhook::exception{ "Java field write failed: destination is unreadable or unwritable", vmhook::error_code::invalid_memory }; }
            }
            else
            {
                static_assert(vmhook::detail::dependent_false_v<clean_value_type>,
                              "field_proxy::set: unsupported value type.  Previously, types that "
                              "weren't string / string_view / const char* / std::vector / "
                              "unique_ptr<wrapper> / trivially_copyable silently no-op'd - the "
                              "set call returned and the field was unchanged with no compile-time "
                              "error or runtime warning.  Convert the value to one of those, or "
                              "extend the if-constexpr chain above with a specific branch.");
            }
        }

    public:
        template<typename value_type>
            requires vmhook::detail::supported_field_value_v<value_type>
        auto try_set(const value_type& value) const -> std::expected<void, vmhook::exception>
        {
            try { this->set(value); return {}; }
            catch (const vmhook::exception& error) { return std::unexpected{ error }; }
        }

        auto set_metadata_lifetime(std::shared_ptr<void> lifetime) noexcept -> void
        { this->metadata_lifetime_ = std::move(lifetime); }

        /*
            @brief Returns the JVM type descriptor of this field (e.g. "I", "Z", "J").
        */
        auto signature() const noexcept
            -> std::string_view
        {
            return this->signature_text;
        }

        /*
            @brief Returns the raw memory address backing this field.
            @details
            For instance fields this is `decoded_object + field_offset`; for
            static fields it is `java.lang.Class mirror + field_offset`.
            This transient heap address is for diagnostics and can move at the
            next collection. Use get()/set() for rooted field access.
        */
        auto raw_address() const noexcept -> void*
        {
            vmhook::detail::native_backend::operation access{};
            return this->resolved_address_under_vm();
        }

        /*
            @brief Returns true if this field has JVM_ACC_STATIC set.
            @details
            Static fields are read from / written to the java.lang.Class mirror
            of the declaring class rather than from an object instance.

            Complexity: O(1).
            Exception safety: noexcept.
        */
        auto is_static() const noexcept
            -> bool
        {
            return this->static_field;
        }

        /* Field modifiers are obtained from the declaring class metadata.
           A volatile access executes the VM's Java Memory Model barriers.
           Final fields are readable; mutation is refused even on Epsilon. */
        auto is_volatile() const noexcept -> bool { return (this->field_flags & 0x0040u) != 0; }
        auto is_final() const noexcept -> bool { return (this->field_flags & 0x0010u) != 0; }

        /* Strong CAS uses HotSpot's atomic accessor, with volatile ordering and
           collector barriers for references. It does not mutate the C++
           expected value. Java null uses an allocated wrapper as elsewhere. */
        template<typename value_type>
            requires (std::is_same_v<std::remove_cvref_t<value_type>, std::int32_t>
                || std::is_same_v<std::remove_cvref_t<value_type>, std::int64_t>
                || vmhook::detail::is_java_object_pointer_v<value_type>)
        auto compare_exchange(const value_type& expected, const value_type& desired) const -> bool
        {
            vmhook::detail::native_backend::operation access{};
            if (this->is_final())
            { throw vmhook::exception{ "Final Java fields cannot be mutated through compare_exchange" }; }
            if constexpr (vmhook::detail::is_java_object_pointer_v<value_type>)
            {
                if (!this->is_reference())
                { throw vmhook::exception{ "Atomic reference access requires a Java object field" }; }
                vmhook::detail::require_object_argument(expected);
                vmhook::detail::require_object_argument(desired);
                void* const expected_oop{ expected->vmhook::object_base::get_instance() };
                void* const desired_oop{ desired->vmhook::object_base::get_instance() };
                using wrapper_type = typename value_type::element_type;
                if (expected_oop) { vmhook::detail::require_object_wrapper_type<wrapper_type>(expected_oop); }
                if (desired_oop) { vmhook::detail::require_object_wrapper_type<wrapper_type>(desired_oop); }
                vmhook::detail::require_reference_argument(expected_oop, this->signature_text, this->reference_declaring_class);
                // The first type check can run Java and relocate both roots.
                vmhook::detail::require_reference_argument(desired->vmhook::object_base::get_instance(),
                    this->signature_text, this->reference_declaring_class);
                auto expected_root{ vmhook::detail::native_backend::retain_oop(expected->vmhook::object_base::get_instance()) };
                auto desired_root{ vmhook::detail::native_backend::retain_oop(desired->vmhook::object_base::get_instance()) };
                if ((expected->vmhook::object_base::get_instance() && !expected_root)
                    || (desired->vmhook::object_base::get_instance() && !desired_root))
                { throw vmhook::exception{ "Atomic field reference arguments could not be retained" }; }
                const auto called{ vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                    "compareAndSetReference", "compareAndSwapObject",
                    "(Ljava/lang/Object;JLjava/lang/Object;Ljava/lang/Object;)Z",
                    0, desired_root, true, true, 0, expected_root) };
                return called.bits != 0;
            }
            else
            {
                const bool wide{ sizeof(value_type) == sizeof(std::int64_t) };
                if (this->signature_text != (wide ? "J" : "I"))
                { throw vmhook::exception{ "Atomic field access requires its exact Java int or long type" }; }
                std::uint64_t expected_bits{}, desired_bits{};
                std::memcpy(&expected_bits, &expected, sizeof(expected));
                std::memcpy(&desired_bits, &desired, sizeof(desired));
                const auto called{ vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                    wide ? "compareAndSetLong" : "compareAndSetInt",
                    wide ? "compareAndSwapLong" : "compareAndSwapInt",
                    wide ? "(Ljava/lang/Object;JJJ)Z" : "(Ljava/lang/Object;JII)Z",
                    desired_bits, {}, true, true, expected_bits) };
                return called.bits != 0;
            }
        }

        /*
            @brief Returns true if this field's JVM descriptor is a reference / array (L or [).
            @details
            Provided so callers can branch on "is this a reference field?" without
            inspecting signature()[0] by hand.  get_compressed_oop() only makes sense
            for reference / array fields; calling it on a primitive field reads the
            first 4 bytes of the primitive's storage as if they were a compressed
            OOP, which decodes to garbage.

            Complexity: O(1).
            Exception safety: noexcept — returns false on empty signature.
        */
        auto is_reference() const noexcept
            -> bool
        {
            if (this->signature_text.empty())
            {
                return false;
            }
            const char first{ this->signature_text.front() };
            return first == 'L' || first == '[';
        }

        /*
            @brief Returns the compressed OOP stored in this field (for reference/array types).
            @return The compressed OOP as uint32_t, or 0 if field_pointer is null.
        */
        auto get_compressed_oop() const noexcept
            -> std::uint32_t
        {
            vmhook::detail::native_backend::operation access{};
            // FLAW C fix: only reference/array fields hold a compressed OOP.  On a
            // PRIMITIVE field, memcpy'ing the first 4 bytes returns the primitive's
            // raw value bytes as a bogus "OOP" that later decodes to a wild pointer
            // (the docstring above warns of exactly this).  Guard on is_reference()
            // so a misused proxy yields null, not garbage.  Valid callers only ask
            // for the compressed OOP of reference/array fields, so this is a no-op
            // for them.
            if (!this->is_reference()
                || vmhook::detail::reference_storage_width() != sizeof(std::uint32_t))
            {
                return 0;
            }

            // Read JVM memory through the Windows memory API and stop on unreadable data.
            // A successful read does not establish object lifetime or a coherent VM snapshot.
            void* read_pointer{ this->resolved_address_under_vm() };
            if (!this->native_bound && !this->holder_root && this->mirror_klass)
            {
                void* const live_mirror{ this->mirror_klass->get_java_mirror() };
                if (!live_mirror || !vmhook::hotspot::is_valid_pointer(live_mirror))
                {
                    return 0;
                }
                read_pointer = reinterpret_cast<std::uint8_t*>(live_mirror) + this->field_offset;
            }

            if (!read_pointer)
            {
                return 0;
            }
            // RAW-ECHO SAFETY (robustness #1), mirrored from get(): the resolved
            // static/instance paths reach here with a validated mirror/oop + offset
            // and always pass; only a field_proxy built from a caller-supplied raw
            // pointer (the 3-arg escape-hatch ctor) can present a bogus address.
            // Gate the deref through is_valid_pointer (pure range/alignment/poison)
            // and return 0 (the documented null/empty default) instead of reading a
            // wild address.  As in get(), accept an odd-but-otherwise-valid base so
            // the byte-aligned-interior case is never wrongly defaulted (a compressed
            // OOP slot is in practice at least 2-byte aligned, so this only ever
            // loosens a theoretical edge); a genuinely wild pointer fails both checks.
            if (!vmhook::hotspot::is_valid_pointer(read_pointer)
                && !vmhook::hotspot::is_valid_pointer(reinterpret_cast<const void*>(
                       reinterpret_cast<std::uintptr_t>(read_pointer) & ~std::uintptr_t{ 1 })))
            {
                return 0;
            }
            std::uint32_t value{};
            vmhook::os::safe_read_fast(&value, read_pointer, sizeof(value));
            return value;
        }

    private:
        auto primitive_accessor_name() const -> std::string_view
        {
            if (this->signature_text == "Z") { return "Boolean"; }
            if (this->signature_text == "B") { return "Byte"; }
            if (this->signature_text == "C") { return "Char"; }
            if (this->signature_text == "S") { return "Short"; }
            if (this->signature_text == "I") { return "Int"; }
            if (this->signature_text == "J") { return "Long"; }
            if (this->signature_text == "F") { return "Float"; }
            if (this->signature_text == "D") { return "Double"; }
            throw vmhook::exception{ "Volatile primitive field descriptor is invalid" };
        }

        auto read_volatile() const -> value_t
        {
            if (this->is_reference())
            {
                const auto result{ vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                    "getReferenceVolatile", "getObjectVolatile", "(Ljava/lang/Object;J)Ljava/lang/Object;") };
                void* const object{ result.object ? result.object->resolve_under_vm() : nullptr };
                return value_t{ vmhook::hotspot::encode_oop_pointer(object), this->signature_text, result.object };
            }
            const auto name{ std::string{"get"} + std::string{this->primitive_accessor_name()} + "Volatile" };
            const auto descriptor{ std::string{"(Ljava/lang/Object;J)"} + this->signature_text };
            const auto result{ vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                name, {}, descriptor) };
            if (this->signature_text == "Z") { return value_t{ result.bits != 0, this->signature_text }; }
            if (this->signature_text == "B") { return value_t{ static_cast<std::int8_t>(result.bits), this->signature_text }; }
            if (this->signature_text == "C") { return value_t{ static_cast<std::uint16_t>(result.bits), this->signature_text }; }
            if (this->signature_text == "S") { return value_t{ static_cast<std::int16_t>(result.bits), this->signature_text }; }
            if (this->signature_text == "I") { return value_t{ static_cast<std::int32_t>(result.bits), this->signature_text }; }
            if (this->signature_text == "J") { return value_t{ std::bit_cast<std::int64_t>(result.bits), this->signature_text }; }
            if (this->signature_text == "F")
            { return value_t{ std::bit_cast<float>(static_cast<std::uint32_t>(result.bits)), this->signature_text }; }
            return value_t{ std::bit_cast<double>(result.bits), this->signature_text };
        }

        auto write_volatile(const std::uint64_t bits) const -> void
        {
            const auto name{ std::string{"put"} + std::string{this->primitive_accessor_name()} + "Volatile" };
            const auto descriptor{ std::string{"(Ljava/lang/Object;J"} + this->signature_text + ")V" };
            (void)vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                name, {}, descriptor, bits, {}, true);
        }

        /*
            @brief Publishes a Java object reference with the VM's collector barriers.
            @details Rooted fields call an existing Java Unsafe accessor, including
            its volatile variant when applicable. The raw-address escape hatch
            retains its Epsilon-only direct-store policy.
            A heap field is a Java reachability edge, not an independently registered GC root.
            @return False on unsupported collector, descriptor, slot, width, or encoding.
        */
        auto store_object_oop(void* const decoded_oop) const
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            if (!this->is_reference() || this->is_final()) { return false; }
            if (access && this->holder_root)
            {
                auto argument{ vmhook::detail::native_backend::retain_oop(decoded_oop) };
                if (decoded_oop && !argument)
                { throw vmhook::exception{ "Field reference argument could not be retained" }; }
                (void)vmhook::detail::field_memory_backend::invoke(this->holder_root, this->field_offset,
                    this->is_volatile() ? "putReferenceVolatile" : "putReference",
                    this->is_volatile() ? "putObjectVolatile" : "putObject",
                    "(Ljava/lang/Object;JLjava/lang/Object;)V", 0, argument, true);
                return true;
            }
            if (!vmhook::detail::reference_stores_supported())
            {
                ::vmhook::detail::log_line("{} reference store refused: collector write barriers are unavailable.", vmhook::error_tag);
                return false;
            }

            // Only reference / array fields hold a compressed OOP; refuse a
            // primitive slot so a misused proxy can never reinterpret/overwrite a
            // primitive's bytes as a narrow reference (symmetric with
            // get_compressed_oop()'s is_reference() guard).
            if (!this->is_reference())
            {
                return false;
            }

            // Read the static mirror again before calculating the destination.
            // The collector gate, not this address refresh, determines whether reference stores are available.
            void* write_pointer{ this->resolved_address_under_vm() };
            if (!this->native_bound && !this->holder_root && this->mirror_klass)
            {
                void* const live_mirror{ this->mirror_klass->get_java_mirror() };
                if (!live_mirror || !vmhook::hotspot::is_valid_pointer(live_mirror))
                {
                    return false;
                }
                write_pointer = reinterpret_cast<std::uint8_t*>(live_mirror) + this->field_offset;
            }

            if (!write_pointer || !vmhook::hotspot::is_valid_pointer(write_pointer))
            {
                return false;
            }

            // narrow-encode the oop (encode_oop_pointer maps nullptr -> 0, the
            // correct representation of a null reference) and store the 4-byte
            // compressed OOP through the fault-safe path.
            const std::size_t width{ vmhook::detail::reference_storage_width() };
            if (width == sizeof(void*))
            {
                return vmhook::os::safe_write(write_pointer, &decoded_oop, sizeof(decoded_oop));
            }
            if (width != sizeof(std::uint32_t))
            {
                return false;
            }
            const std::uint32_t compressed{ vmhook::hotspot::encode_oop_pointer(decoded_oop) };
            if (decoded_oop && compressed == 0)
            {
                return false;
            }
            return vmhook::os::safe_write(write_pointer, &compressed, sizeof(compressed));
        }

        /*
            @brief Stores a Java reference from an allocated C++ wrapper.
            @details Rejects empty C++ pointers, expired roots, and incompatible
            Java classes. The wrapper and field owner are resolved again after
            type checking, which can run Java code and trigger collection.
            A wrapper whose get_instance() is nullptr writes Java null.
            Reference publication still requires the supported collector store
            policy; set() reports a refused publication with vmhook::exception.
            @return true when the reference was written, false when the store
            backend refuses publication. Invalid inputs throw.
        */
        template<typename wrapper_type>
            requires vmhook::detail::is_java_wrapper_v<wrapper_type>
        auto store_object(const std::unique_ptr<wrapper_type>& value) const
            -> bool
        {
            vmhook::detail::require_object_argument(value);
            vmhook::detail::native_backend::operation access{};
            void* const address{ value->vmhook::object_base::get_instance() };
            if (address) { vmhook::detail::require_object_wrapper_type<wrapper_type>(address); }
            vmhook::detail::require_reference_argument(address, this->signature_text, this->reference_declaring_class);
            // Type resolution can call Java and move the object. Resolve the
            // owner's root again immediately before publishing the field slot.
            return this->store_object_oop(value->vmhook::object_base::get_instance());
        }

        /*
            @brief Constructs a Java String from UTF-8 and attempts a reference field store.
            @details The new string is rooted before a collector-aware publication.
            @return True only when construction and the reference store succeed.
        */
        auto store_string(const std::string_view value) const
            -> bool
        {
            // Length-counted UTF-16: a std::string is standard UTF-8, so an
            // interior NUL is a real U+0000 and astral bytes must decode to
            // surrogate pairs — a NUL-terminated modified-UTF-8 encoding would
            // truncate / mangle both.  make_java_string builds the oop directly
            // (TLAB allocation + UTF-16 value/coder encode).
            auto root{ vmhook::detail::native_backend::active()
                ? vmhook::detail::native_backend::make_string(value) : vmhook::detail::native_backend::root{} };
            if (vmhook::detail::native_backend::active() && !root)
            { throw vmhook::exception{ "Java String allocation failed before field publication" }; }
            void* const string_oop{ root ? root->resolve_under_vm() : vmhook::make_java_string(value) };
            if (!string_oop)
            {
                ::vmhook::detail::log_line("{} field_proxy::set: failed to build a java.lang.String for a "
                           "String-field write (sig='{}') at {:p} ({} field) - make_java_string "
                           "returned null; the field is left unchanged.",
                           vmhook::error_tag, this->signature_text, this->field_pointer,
                           this->static_field ? "static" : "instance");
                return false;
            }

            vmhook::detail::require_reference_argument(string_oop, this->signature_text, this->reference_declaring_class);
            // Type resolution may safepoint; fetch the retained String again.
            const bool stored{ this->store_object_oop(root ? root->resolve_under_vm() : string_oop) };
            if (!stored)
            {
                ::vmhook::detail::log_line("{} field_proxy::set: built a java.lang.String but could not store "
                           "the reference into the field (sig='{}') at {:p} ({} field) - the "
                           "slot was unresolvable / unmapped; the field is left unchanged.",
                           vmhook::error_tag, this->signature_text, this->field_pointer,
                           this->static_field ? "static" : "instance");
            }
            return stored;
        }

        auto resolved_address_under_vm() const noexcept -> void*
        {
            void* holder{};
            if (this->native_bound && !this->holder_root) { return nullptr; }
            if (this->holder_root)
            {
                holder = this->holder_root->resolve_under_vm();
                if (!holder) { return nullptr; }
            }
            else if (this->mirror_klass)
            {
                holder = this->mirror_klass->get_java_mirror();
                if (!holder) { return nullptr; }
            }
            else { return this->field_pointer; }
            const auto base{ reinterpret_cast<std::uintptr_t>(holder) };
            if (this->field_offset > std::numeric_limits<std::uintptr_t>::max() - base) { return nullptr; }
            return reinterpret_cast<void*>(base + this->field_offset);
        }

        void* field_pointer;
        std::string signature_text;
        bool        static_field;

        // Static-field coordinates allow a fresh mirror read rather than caching its heap address.
        // The Klass must still be live, and later heap access can race with collection.
        vmhook::hotspot::klass* mirror_klass{ nullptr };
        std::size_t             field_offset{ 0 };
        vmhook::detail::native_backend::root holder_root{};
        bool native_bound{ false };
        // The field descriptor resolves in this declaring class's loader.
        // It supplies type identity only; it never selects the storage holder.
        vmhook::hotspot::klass* reference_declaring_class{ nullptr };
        std::uint16_t field_flags{};
        std::shared_ptr<void> metadata_lifetime_{};
    };

    // --- detail helpers that depend on hotspot types -------------------------
    // (reopened here because find_call_stub_entry references hotspot types
    //  that are not yet defined at the earlier detail block position)
    namespace detail
    {
        /*
            @brief Runtime-resolved [low, high) address range of the HotSpot code cache.
            @details
            Every call-stub candidate is bounded by this range before a single
            byte of it is read: the call stub is generated code, so a candidate
            outside the code cache is provably not it.

            Complexity: O(1) after the cached VMStructs lookups.
            Exception safety: noexcept — a zeroed (never-containing) range on failure.
        */
        struct code_cache_bounds_t
        {
            std::uintptr_t low{ 0 };
            std::uintptr_t high{ 0 };

            /*
                @brief True when the range resolved AND address lies inside it.
            */
            auto contains(const std::uintptr_t address) const noexcept
                -> bool
            {
                return this->low != 0 && this->high > this->low
                    && address >= this->low && address < this->high;
            }
        };

        /*
            @brief Resolves the code-cache bounds through VMStructs.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        auto resolve_code_cache_bounds() noexcept
            -> vmhook::detail::code_cache_bounds_t
        {
            vmhook::detail::code_cache_bounds_t bounds{};

            // --- JDK 21 / 26: the bounds are published as plain statics.
            static const vmhook::hotspot::vm_struct_entry_t* const low_bound_entry{
                vmhook::hotspot::iterate_struct_entries("CodeCache", "_low_bound") };
            static const vmhook::hotspot::vm_struct_entry_t* const high_bound_entry{
                vmhook::hotspot::iterate_struct_entries("CodeCache", "_high_bound") };
            if (low_bound_entry && low_bound_entry->address
                && high_bound_entry && high_bound_entry->address)
            {
                void* low{ nullptr };
                void* high{ nullptr };
                if (vmhook::os::safe_read(&low, low_bound_entry->address, sizeof(low))
                    && vmhook::os::safe_read(&high, high_bound_entry->address, sizeof(high)))
                {
                    bounds.low  = reinterpret_cast<std::uintptr_t>(low);
                    bounds.high = reinterpret_cast<std::uintptr_t>(high);
                    if (bounds.high > bounds.low)
                    {
                        return bounds;
                    }
                    bounds = vmhook::detail::code_cache_bounds_t{};
                }
            }

            // --- JDK 8: CodeCache::_heap -> CodeHeap::_memory (VirtualSpace)
            //     -> VirtualSpace::_low / _high.
            static const vmhook::hotspot::vm_struct_entry_t* const heap_entry{
                vmhook::hotspot::iterate_struct_entries("CodeCache", "_heap") };
            static const vmhook::hotspot::vm_struct_entry_t* const memory_entry{
                vmhook::hotspot::iterate_struct_entries("CodeHeap", "_memory") };
            static const vmhook::hotspot::vm_struct_entry_t* const vs_low_entry{
                vmhook::hotspot::iterate_struct_entries("VirtualSpace", "_low") };
            static const vmhook::hotspot::vm_struct_entry_t* const vs_high_entry{
                vmhook::hotspot::iterate_struct_entries("VirtualSpace", "_high") };
            if (!heap_entry || !heap_entry->address || !memory_entry
                || !vs_low_entry || !vs_high_entry)
            {
                return bounds;
            }

            void* heap{ nullptr };
            if (!vmhook::os::safe_read(&heap, heap_entry->address, sizeof(heap))
                || !vmhook::hotspot::is_valid_pointer(heap))
            {
                return bounds;
            }

            const std::uint8_t* const virtual_space{
                static_cast<const std::uint8_t*>(heap) + memory_entry->offset };
            void* low{ nullptr };
            void* high{ nullptr };
            if (!vmhook::os::safe_read(&low, virtual_space + vs_low_entry->offset, sizeof(low))
                || !vmhook::os::safe_read(&high, virtual_space + vs_high_entry->offset, sizeof(high)))
            {
                return bounds;
            }

            const std::uintptr_t low_address{ reinterpret_cast<std::uintptr_t>(low) };
            const std::uintptr_t high_address{ reinterpret_cast<std::uintptr_t>(high) };
            if (high_address > low_address)
            {
                bounds.low  = low_address;
                bounds.high = high_address;
            }
            return bounds;
        }

        /*
            @brief Checks a possible call-stub entry against expected code patterns and bounds.
            @details This is a restricted HotSpot x64 heuristic, not a proof for arbitrary
            instruction sequences or JVM builds. Unsupported candidates are refused.
        */
        inline auto call_stub_entry_is_valid(const std::uintptr_t candidate,
                                             const std::uintptr_t return_address,
                                             const vmhook::detail::code_cache_bounds_t& bounds) noexcept
            -> bool
        {
            if (candidate == 0 || return_address == 0 || candidate >= return_address)
            {
                return false;
            }
            if (return_address - candidate < 8 || return_address - candidate >= 4096)
            {
                return false;
            }
            if (bounds.low != 0 && !bounds.contains(candidate))
            {
                return false;
            }

            std::uint8_t prologue[4]{};
            if (!vmhook::os::safe_read(prologue,
                                       reinterpret_cast<const void*>(candidate),
                                       sizeof(prologue)))
            {
                return false;
            }
            const bool is_enter{
                prologue[0] == 0x55u && prologue[1] == 0x48u
                && ((prologue[2] == 0x8Bu && prologue[3] == 0xECu)      // mov rbp, rsp
                    || (prologue[2] == 0x89u && prologue[3] == 0xE5u)) };
            if (!is_enter)
            {
                return false;
            }

            std::uint8_t dispatch[2]{};
            if (!vmhook::os::safe_read(dispatch,
                                       reinterpret_cast<const void*>(return_address - 2),
                                       sizeof(dispatch)))
            {
                return false;
            }
            return dispatch[0] == 0xFFu && dispatch[1] == 0xD2u;        // call rdx
        }

        /*
            @brief Attempts to derive the call-stub entry from published HotSpot coordinates.
            @details Uses bounded code/data probes and candidate checks. Availability is
            determined at runtime; no JDK-wide successful derivation is assumed.
        */
        auto derive_call_stub_entry() noexcept
            -> void*
        {
            static const vmhook::hotspot::vm_struct_entry_t* const return_address_entry{
                vmhook::hotspot::iterate_struct_entries("StubRoutines", "_call_stub_return_address") };
            if (!return_address_entry || !return_address_entry->address)
            {
                return nullptr;
            }

            void* raw_return_address{ nullptr };
            if (!vmhook::os::safe_read(&raw_return_address,
                                       return_address_entry->address,
                                       sizeof(raw_return_address)))
            {
                return nullptr;
            }
            const std::uintptr_t return_address{ reinterpret_cast<std::uintptr_t>(raw_return_address) };
            if (return_address == 0)
            {
                // StubRoutines::initialize() has not run yet — the caller retries.
                return nullptr;
            }

            const vmhook::detail::code_cache_bounds_t bounds{ vmhook::detail::resolve_code_cache_bounds() };
            const std::uintptr_t slot_address{ reinterpret_cast<std::uintptr_t>(return_address_entry->address) };

            // --- tier 1: adjacency, both directions.
            for (const std::intptr_t delta : { static_cast<std::intptr_t>(sizeof(void*)),
                                               -static_cast<std::intptr_t>(sizeof(void*)) })
            {
                void* neighbour{ nullptr };
                if (!vmhook::os::safe_read(&neighbour,
                                           reinterpret_cast<const void*>(static_cast<std::intptr_t>(slot_address) + delta),
                                           sizeof(neighbour)))
                {
                    continue;
                }
                const std::uintptr_t candidate{ reinterpret_cast<std::uintptr_t>(neighbour) };
                if (vmhook::detail::call_stub_entry_is_valid(candidate, return_address, bounds))
                {
                    return reinterpret_cast<void*>(candidate);
                }
            }

            // --- tier 2: greatest code-cache pointer below the return address,
            //     anywhere in the writable region that holds the published slot.
            {
                const vmhook::os::region_info region{
                    vmhook::os::query_region(return_address_entry->address) };
                constexpr std::size_t max_scanned_bytes{ 8u * 1024u * 1024u };
                if (region.base && region.committed && region.readable && !region.guarded
                    && region.size >= sizeof(void*) && region.size <= max_scanned_bytes)
                {
                    // Keep the best few candidates in one pass so a rejected
                    // rank-0 does not force a re-scan.
                    constexpr std::size_t ranked_slots{ 8 };
                    std::uintptr_t ranked[ranked_slots]{};

                    std::uint8_t chunk[4096];
                    const std::uintptr_t region_start{ reinterpret_cast<std::uintptr_t>(region.base) };
                    for (std::size_t offset{ 0 }; offset + sizeof(void*) <= region.size; offset += sizeof(chunk))
                    {
                        const std::size_t remaining{ region.size - offset };
                        const std::size_t to_read{ remaining < sizeof(chunk) ? remaining : sizeof(chunk) };
                        if (!vmhook::os::safe_read(chunk,
                                                   reinterpret_cast<const void*>(region_start + offset),
                                                   to_read))
                        {
                            continue;
                        }
                        for (std::size_t index{ 0 }; index + sizeof(void*) <= to_read; index += sizeof(void*))
                        {
                            std::uintptr_t value{ 0 };
                            std::memcpy(&value, chunk + index, sizeof(value));
                            if (value >= return_address || !bounds.contains(value))
                            {
                                continue;
                            }
                            if (return_address - value >= 4096)
                            {
                                continue;
                            }
                            // Insertion into a descending top-N list.
                            for (std::size_t rank{ 0 }; rank < ranked_slots; ++rank)
                            {
                                if (value == ranked[rank])
                                {
                                    break;
                                }
                                if (value > ranked[rank])
                                {
                                    for (std::size_t shift{ ranked_slots - 1 }; shift > rank; --shift)
                                    {
                                        ranked[shift] = ranked[shift - 1];
                                    }
                                    ranked[rank] = value;
                                    break;
                                }
                            }
                        }
                    }

                    for (const std::uintptr_t candidate : ranked)
                    {
                        if (candidate != 0
                            && vmhook::detail::call_stub_entry_is_valid(candidate, return_address, bounds))
                        {
                            return reinterpret_cast<void*>(candidate);
                        }
                    }
                }
            }

            // --- tier 3: nearest enter() prologue below the return address.
            {
                constexpr std::size_t window{ 4096 };
                std::uintptr_t window_start{ return_address > window ? return_address - window : 0 };
                if (bounds.low != 0 && window_start < bounds.low)
                {
                    window_start = bounds.low;
                }
                if (window_start != 0 && window_start + 4 <= return_address)
                {
                    const std::size_t length{ static_cast<std::size_t>(return_address - window_start) };
                    std::uint8_t code[window];
                    if (vmhook::os::safe_read(code, reinterpret_cast<const void*>(window_start), length))
                    {
                        for (std::size_t index{ length - 4 }; ; --index)
                        {
                            const std::uintptr_t candidate{ window_start + index };
                            if (code[index] == 0x55u && code[index + 1] == 0x48u
                                && ((code[index + 2] == 0x8Bu && code[index + 3] == 0xECu)
                                    || (code[index + 2] == 0x89u && code[index + 3] == 0xE5u))
                                && vmhook::detail::call_stub_entry_is_valid(candidate, return_address, bounds))
                            {
                                return reinterpret_cast<void*>(candidate);
                            }
                            if (index == 0)
                            {
                                break;
                            }
                        }
                    }
                }
            }

            return nullptr;
        }

        /*
            @brief Finds a published or heuristically derived HotSpot call-stub entry.
            @details A failed probe returns null. A candidate address alone does not
            establish support for thread state, frames, handles, or GC behavior.
        */
        auto find_call_stub_entry() noexcept
            -> void*
        {
            static std::atomic<void*> cached_stub{ nullptr };
            if (void* const already{ cached_stub.load(std::memory_order_relaxed) })
            {
                return already;
            }

            void* resolved{ nullptr };

            static const vmhook::hotspot::vm_struct_entry_t* const entry{
                vmhook::hotspot::iterate_struct_entries("StubRoutines", "_call_stub_entry") };
            if (entry && entry->address)
            {
                void* published{ nullptr };
                if (vmhook::os::safe_read(&published, entry->address, sizeof(published))
                    && vmhook::hotspot::is_valid_pointer(published))
                {
                    resolved = published;
                }
            }

            if (!resolved)
            {
                resolved = vmhook::detail::derive_call_stub_entry();
            }

            if (resolved)
            {
                cached_stub.store(resolved, std::memory_order_relaxed);
            }
            return resolved;
        }

        /*
            @brief Maps a JVM type-descriptor character to a HotSpot BasicType int.
            Values are stable across all supported JDK versions.
        */
        inline auto sig_char_to_basic_type(const char c) noexcept -> int
        {
            switch (c)
            {
            case 'Z': return 4;   // T_BOOLEAN
            case 'C': return 5;   // T_CHAR
            case 'F': return 6;   // T_FLOAT
            case 'D': return 7;   // T_DOUBLE
            case 'B': return 8;   // T_BYTE
            case 'S': return 9;   // T_SHORT
            case 'I': return 10;  // T_INT
            case 'J': return 11;  // T_LONG
            case 'L': return 12;  // T_OBJECT
            case '[': return 13;  // T_ARRAY
            case 'V': return 14;  // T_VOID
            default:  return 12;  // T_OBJECT (fallback)
            }
        }

        /*
            @brief Returns the in-heap byte width of a JVM primitive field given its
                   type-descriptor signature.
            @details
            Used by field_proxy::set() to size-check the user's value against the
            actual field width before memcpy'ing.  Returns 0 for reference and
            array types (where the in-heap width depends on UseCompressedOops and
            is handled by the wrapper / set_str_field paths), and for any unknown
            signature - in both cases the caller skips the size validation.

            Width table (JVM spec § 4.3.2):
              Z (boolean) = 1, B (byte) = 1
              S (short)   = 2, C (char) = 2
              I (int)     = 4, F (float) = 4
              J (long)    = 8, D (double) = 8
        */
        inline auto jvm_primitive_byte_width(const std::string_view signature) noexcept
            -> std::size_t
        {
            if (signature.size() != 1)
            {
                return 0;
            }
            switch (signature[0])
            {
            case 'Z': case 'B': return 1;
            case 'S': case 'C': return 2;
            case 'I': case 'F': return 4;
            case 'J': case 'D': return 8;
            default:            return 0;
            }
        }

        /*
            @brief Splits a JVM method descriptor into its parameter type letters.
            @details
            Writes one character per declared parameter: the primitive letter for
            a primitive, 'L' for a class reference, '[' for an array.  The letters
            are what decides the interpreter SLOT layout of the argument block —
            'J' and 'D' occupy two slots, everything else one — so the packer
            drives itself off the callee's real descriptor rather than off the
            C++ argument type, which is the only way to get a `long` passed as an
            int (or a `double` passed as a float) into the right slot.

            @param signature  A JVM method descriptor, e.g. "(IJLjava/lang/String;)V".
            @param out        Destination buffer for the parameter letters.
            @param capacity   Number of characters `out` can hold.
            @return The number of parameter letters written (0 on a malformed or
                    empty descriptor, which makes the caller fall back to
                    C++-type-based slot sizing).

            Complexity: O(len(signature)).
            Exception safety: noexcept.
        */
        inline auto parse_parameter_descriptors(const std::string_view signature,
                                                char* const out,
                                                const std::size_t capacity) noexcept
            -> std::size_t
        {
            if (!out || capacity == 0)
            {
                return 0;
            }
            const std::size_t open{ signature.find('(') };
            if (open == std::string_view::npos)
            {
                return 0;
            }

            std::size_t count{ 0 };
            for (std::size_t index{ open + 1 }; index < signature.size(); ++index)
            {
                const char c{ signature[index] };
                if (c == ')')
                {
                    break;
                }
                if (count >= capacity)
                {
                    break;
                }
                if (c == '[')
                {
                    out[count++] = '[';
                    // Skip the remaining '[' of a multi-dimensional array and,
                    // for an object element type, the whole "Lpkg/Cls;" body.
                    while (index + 1 < signature.size() && signature[index + 1] == '[')
                    {
                        ++index;
                    }
                    if (index + 1 < signature.size() && signature[index + 1] == 'L')
                    {
                        const std::size_t semicolon{ signature.find(';', index + 1) };
                        if (semicolon == std::string_view::npos)
                        {
                            return count;
                        }
                        index = semicolon;
                    }
                    else
                    {
                        ++index;
                    }
                    continue;
                }
                if (c == 'L')
                {
                    out[count++] = 'L';
                    const std::size_t semicolon{ signature.find(';', index) };
                    if (semicolon == std::string_view::npos)
                    {
                        return count;
                    }
                    index = semicolon;
                    continue;
                }
                out[count++] = c;
            }
            return count;
        }

        /*
            @brief The VMStructs-resolved layout every pure-VM Java call depends on.
        */
        /*
            @brief Bounds native handle extension storage used by invocation.
            @details The detected block size must fit this bound; unsupported layouts refuse invocation.
            The numeric bound does not imply tested compatibility with any JDK release.
        */
        inline constexpr std::size_t max_handle_block_bytes{ 512 };

        struct java_call_layout_t
        {
            bool        usable{ false };

            std::size_t wrapper_size{ 0 };
            std::size_t wrapper_thread_offset{ 0 };
            std::size_t wrapper_handles_offset{ 0 };
            std::size_t wrapper_callee_offset{ 0 };
            std::size_t wrapper_receiver_offset{ 0 };
            std::size_t wrapper_anchor_offset{ 0 };
            std::size_t wrapper_result_offset{ 0 };

            std::size_t thread_anchor_offset{ 0 };
            std::size_t anchor_sp_offset{ 0 };
            std::size_t anchor_pc_offset{ 0 };
            bool        has_anchor_fp{ false };
            std::size_t anchor_fp_offset{ 0 };

            bool        has_active_handles{ false };
            std::size_t active_handles_offset{ 0 };
            bool        has_handle_block_top{ false };
            std::size_t handle_block_top_offset{ 0 };
            bool        has_handle_block_next{ false };
            std::size_t handle_block_next_offset{ 0 };
            std::size_t handle_slots_offset{ 0 };
            std::size_t handle_slots_count{ 0 };
            bool        has_handle_block{ false };
            std::size_t handle_block_size{ 0 };

            bool        has_pending_exception{ false };
            std::size_t pending_exception_offset{ 0 };
        };

        /*
            @brief Resolves (once) and returns the pure-VM Java-call layout.

            Complexity: O(VMStructs entries) on the first call, O(1) after.
            Exception safety: noexcept.
        */
        auto java_call_layout() noexcept
            -> const vmhook::detail::java_call_layout_t&
        {
            static const vmhook::detail::java_call_layout_t layout{ []() noexcept
                -> vmhook::detail::java_call_layout_t
                {
                    vmhook::detail::java_call_layout_t resolved{};

                    const auto* const wrapper_type{ vmhook::hotspot::iterate_type_entries("JavaCallWrapper") };
                    const auto* const wrapper_anchor{ vmhook::hotspot::iterate_struct_entries("JavaCallWrapper", "_anchor") };
                    const auto* const thread_anchor{ vmhook::hotspot::iterate_struct_entries("JavaThread", "_anchor") };
                    const auto* const anchor_sp{ vmhook::hotspot::iterate_struct_entries("JavaFrameAnchor", "_last_Java_sp") };
                    const auto* const anchor_pc{ vmhook::hotspot::iterate_struct_entries("JavaFrameAnchor", "_last_Java_pc") };
                    const auto* const anchor_fp{ vmhook::hotspot::iterate_struct_entries("JavaFrameAnchor", "_last_Java_fp") };
                    // _active_handles moved from Thread to JavaThread after JDK 8.
                    const auto* active_handles{ vmhook::hotspot::iterate_struct_entries("JavaThread", "_active_handles") };
                    if (!active_handles)
                    {
                        active_handles = vmhook::hotspot::iterate_struct_entries("Thread", "_active_handles");
                    }
                    const auto* const handle_block_top{ vmhook::hotspot::iterate_struct_entries("JNIHandleBlock", "_top") };
                    const auto* const handle_block_next{ vmhook::hotspot::iterate_struct_entries("JNIHandleBlock", "_next") };
                    const auto* const handle_slots{ vmhook::hotspot::iterate_struct_entries("JNIHandleBlock", "_handles") };
                    const auto handle_capacity{ vmhook::detail::vm_int_constant("JNIHandleBlock::block_size_in_oops") };
                    // The TYPE SIZE of JNIHandleBlock is what lets method_proxy::call
                    // hand the callee a FRESH handle block instead of letting it reset
                    // the caller's one (see the JNI-handle-block section of call()).
                    const auto* const handle_block_type{ vmhook::hotspot::iterate_type_entries("JNIHandleBlock") };

                    const auto* const pending_exception{ vmhook::hotspot::iterate_struct_entries("ThreadShadow", "_pending_exception") };

                    if (!wrapper_type || !wrapper_anchor || !thread_anchor || !anchor_sp || !anchor_pc)
                    {
                        return resolved;
                    }

                    resolved.wrapper_size          = static_cast<std::size_t>(wrapper_type->size);
                    resolved.wrapper_anchor_offset = static_cast<std::size_t>(wrapper_anchor->offset);
                    resolved.thread_anchor_offset  = static_cast<std::size_t>(thread_anchor->offset);
                    resolved.anchor_sp_offset      = static_cast<std::size_t>(anchor_sp->offset);
                    resolved.anchor_pc_offset      = static_cast<std::size_t>(anchor_pc->offset);
                    if (anchor_fp)
                    {
                        resolved.has_anchor_fp    = true;
                        resolved.anchor_fp_offset = static_cast<std::size_t>(anchor_fp->offset);
                    }
                    if (active_handles)
                    {
                        resolved.has_active_handles    = true;
                        resolved.active_handles_offset = static_cast<std::size_t>(active_handles->offset);
                    }
                    if (handle_block_top)
                    {
                        resolved.has_handle_block_top    = true;
                        resolved.handle_block_top_offset = static_cast<std::size_t>(handle_block_top->offset);
                    }
                    if (handle_block_next)
                    {
                        resolved.has_handle_block_next = true;
                        resolved.handle_block_next_offset = static_cast<std::size_t>(handle_block_next->offset);
                    }
                    if (handle_slots && handle_capacity && *handle_capacity > 0
                        && *handle_capacity <= 64)
                    {
                        resolved.handle_slots_offset = static_cast<std::size_t>(handle_slots->offset);
                        resolved.handle_slots_count = static_cast<std::size_t>(*handle_capacity);
                    }
                    if (handle_block_type && handle_block_type->size > 0
                        && static_cast<std::size_t>(handle_block_type->size)
                               <= vmhook::detail::max_handle_block_bytes)
                    {
                        resolved.has_handle_block  = true;
                        resolved.handle_block_size = static_cast<std::size_t>(handle_block_type->size);
                    }
                    if (pending_exception)
                    {
                        resolved.has_pending_exception    = true;
                        resolved.pending_exception_offset = static_cast<std::size_t>(pending_exception->offset);
                    }

                    // The derived sibling offsets are only trusted when the two
                    // published facts corroborate the documented layout.
                    if (resolved.wrapper_size != 64 || resolved.wrapper_anchor_offset != 32)
                    {
                        ::vmhook::detail::log_line("{} java_call_layout(): unexpected JavaCallWrapper layout "
                                   "(size={}, _anchor={}); pure-VM invocation disabled on this JDK.",
                                   vmhook::warning_tag, resolved.wrapper_size, resolved.wrapper_anchor_offset);
                        return resolved;
                    }
                    resolved.wrapper_thread_offset   = 0;
                    resolved.wrapper_handles_offset  = 8;
                    resolved.wrapper_callee_offset   = 16;
                    resolved.wrapper_receiver_offset = 24;
                    resolved.wrapper_result_offset   = 56;

                    // The anchor sub-fields must fit inside the wrapper's anchor.
                    const std::size_t anchor_span{ resolved.wrapper_anchor_offset + 24 };
                    if (resolved.anchor_sp_offset >= 24 || resolved.anchor_pc_offset >= 24
                        || (resolved.has_anchor_fp && resolved.anchor_fp_offset >= 24)
                        || anchor_span > resolved.wrapper_size)
                    {
                        return resolved;
                    }

                    // has_handle_block is a HARD requirement, not a nicety: without
                    // a fresh JNIHandleBlock to hand the callee, a `native` callee's
                    // interpreter entry resets the CALLER's block (_top = 0) and the
                    // caller's live JNI locals stop being GC roots for the duration
                    // of the call.  Papering over that by restoring the watermark
                    // afterwards resurrects oops the collector no longer tracked --
                    // a stale root that kills a LATER GC.  See call().
                    resolved.usable = resolved.has_active_handles && resolved.has_handle_block
                        && resolved.has_handle_block_top && resolved.has_handle_block_next
                        && resolved.has_pending_exception
                        && resolved.handle_slots_count >= 8
                        && resolved.handle_slots_offset <= resolved.handle_block_size
                        && resolved.handle_slots_count * sizeof(void*)
                            <= resolved.handle_block_size - resolved.handle_slots_offset
                        && resolved.handle_block_top_offset + sizeof(std::int32_t) <= resolved.handle_block_size
                        && resolved.handle_block_next_offset + sizeof(void*) <= resolved.handle_block_size;
                    return resolved;
                }()
            };
            return layout;
        }
        /*
            Native methods may expand a handle block's _next chain. Keeping one
            reusable base per nesting depth avoids losing that chain on every
            call. The VM resets/reuses its chain when the head _top is zero.

            HotSpot's allocator owns extension blocks. Its release routine and
            per-thread free list are not exported, so we retain that high-water
            chain instead of freeing it with a foreign allocator. Those extension
            blocks remain allocated after the OS thread exits. This is a known
            limit until a version-specific VM block-release backend is available.
        */
        struct alignas(16) reusable_call_handles
        {
            std::array<std::uint8_t, vmhook::detail::max_handle_block_bytes> bytes{};
        };
        auto call_handle_pool() noexcept
            -> std::vector<std::unique_ptr<reusable_call_handles>>&
        {
            static thread_local std::vector<std::unique_ptr<reusable_call_handles>> pool{};
            return pool;
        }
        thread_local std::size_t call_handle_depth{ 0 };

        class call_handles_guard
        {
        public:
            call_handles_guard()
            {
                if (call_handle_depth >= 64) { return; }
                try
                {
                    auto& pool{ vmhook::detail::call_handle_pool() };
                    if (pool.size() <= call_handle_depth)
                    {
                        auto entry{ std::make_unique<reusable_call_handles>() };
                        if (!entry) { return; }
                        pool.push_back(std::move(entry));
                    }
                    this->handles_ = pool[call_handle_depth++]->bytes.data();
                }
                catch (const std::bad_alloc&) { throw; }
                catch (...) { this->handles_ = nullptr; }
            }
            ~call_handles_guard()
            {
                if (this->handles_) { --call_handle_depth; }
            }
            call_handles_guard(const call_handles_guard&) = delete;
            auto operator=(const call_handles_guard&) -> call_handles_guard& = delete;
            [[nodiscard]] auto get() const noexcept -> void* { return this->handles_; }
        private:
            void* handles_{ nullptr };
        };

        /*
            Keep the original object arguments in GC-updated root slots after
            the interpreter has discarded its locals. Append a temporary block
            to the caller's first handle chain, preserving its head and all
            pop-frame links. The callee uses a separate block and cannot reset
            these slots when entering a native Java method.
        */
        class argument_roots_guard final
        {
        public:
            argument_roots_guard(const java_call_layout_t& layout, void* const caller_handles,
                                 const std::span<void* const> arguments) noexcept
                : layout_{ &layout }
            {
                if (arguments.empty()) { this->valid_ = true; return; }
                if (!layout.usable || arguments.size() > 255 || layout.handle_slots_count < 8) { return; }
                auto* current{ static_cast<std::uint8_t*>(caller_handles) };
                std::int32_t top{};
                void* next{};
                for (std::size_t block{ 0 }; block < 65536; ++block)
                {
                    if (!current || !vmhook::os::safe_read(&top,
                            current + layout.handle_block_top_offset, sizeof(top))
                        || top < 0 || static_cast<std::size_t>(top) > layout.handle_slots_count
                        || !vmhook::os::safe_read(&next,
                            current + layout.handle_block_next_offset, sizeof(next))) { return; }
                    if (static_cast<std::size_t>(top) < layout.handle_slots_count || !next)
                    {
                        this->tail_ = current;
                        this->saved_top_ = top;
                        this->saved_next_ = next;
                        break;
                    }
                    current = static_cast<std::uint8_t*>(next);
                }
                if (!this->tail_) { return; }
                const std::size_t padding_offset{ layout.handle_slots_offset
                    + static_cast<std::size_t>(top) * sizeof(void*) };
                this->padding_bytes_ = (layout.handle_slots_count - static_cast<std::size_t>(top))
                    * sizeof(void*);
                if (this->padding_bytes_ != 0 && !vmhook::os::safe_read(this->saved_padding_.data(),
                        this->tail_ + padding_offset, this->padding_bytes_))
                { this->tail_ = nullptr; return; }
                if (!is_writable_span(this->tail_, layout.handle_block_size))
                { this->tail_ = nullptr; return; }
                // A JVM method may carry more references than one handle block.
                // Link full blocks followed by one partial tail, matching
                // JNIHandleBlock::oops_do's stop-at-first-partial-block rule.
                for (std::size_t first{}, block_index{}; first < arguments.size(); ++block_index)
                {
                    auto* const block{ this->roots_[block_index].data() };
                    const auto count{ (std::min)(layout.handle_slots_count, arguments.size() - first) };
                    std::memcpy(block + layout.handle_slots_offset, arguments.data() + first, count * sizeof(void*));
                    const auto top_count{ static_cast<std::int32_t>(count) };
                    std::memcpy(block + layout.handle_block_top_offset, &top_count, sizeof(top_count));
                    first += count;
                    if (first < arguments.size())
                    {
                        void* const next_block{ this->roots_[block_index + 1].data() };
                        std::memcpy(block + layout.handle_block_next_offset, &next_block, sizeof(next_block));
                    }
                }
                // Publish the full tail last: until then its unused slots and
                // successor are outside the caller's valid root chain.
                std::memset(this->tail_ + padding_offset, 0, this->padding_bytes_);
                void* const root_block{ this->roots_[0].data() };
                std::memcpy(this->tail_ + layout.handle_block_next_offset,
                            &root_block, sizeof(root_block));
                const auto full{ static_cast<std::int32_t>(layout.handle_slots_count) };
                std::memcpy(this->tail_ + layout.handle_block_top_offset, &full, sizeof(full));
                this->valid_ = true;
            }
            ~argument_roots_guard()
            {
                if (!this->tail_) { return; }
                const auto& layout{ *this->layout_ };
                std::memcpy(this->tail_ + layout.handle_block_top_offset,
                            &this->saved_top_, sizeof(this->saved_top_));
                std::memcpy(this->tail_ + layout.handle_block_next_offset,
                            &this->saved_next_, sizeof(this->saved_next_));
                const auto padding_offset{ layout.handle_slots_offset
                    + static_cast<std::size_t>(this->saved_top_) * sizeof(void*) };
                std::memcpy(this->tail_ + padding_offset,
                            this->saved_padding_.data(), this->padding_bytes_);
            }
            argument_roots_guard(const argument_roots_guard&) = delete;
            auto operator=(const argument_roots_guard&) -> argument_roots_guard& = delete;
            [[nodiscard]] auto valid() const noexcept -> bool { return this->valid_; }
            [[nodiscard]] auto at(const std::size_t index) const noexcept -> void*
            {
                void* value{};
                if (index >= 255 || !this->layout_ || this->layout_->handle_slots_count == 0) { return nullptr; }
                std::memcpy(&value, this->roots_[index / this->layout_->handle_slots_count].data()
                    + this->layout_->handle_slots_offset
                    + (index % this->layout_->handle_slots_count) * sizeof(void*), sizeof(value));
                return value;
            }
        private:
            static auto is_writable_span(const void* const address, const std::size_t size) noexcept -> bool
            {
                auto cursor{ reinterpret_cast<std::uintptr_t>(address) };
                if (cursor < vmhook::os::user_address_floor || cursor > vmhook::os::user_address_ceiling
                    || size > vmhook::os::user_address_ceiling - cursor) { return false; }
                const auto limit{ cursor + size };
                while (cursor < limit)
                {
                    vmhook::windows::MEMORY_BASIC_INFORMATION region{};
                    if (vmhook::windows::VirtualQuery(reinterpret_cast<const void*>(cursor),
                            &region, sizeof(region)) != sizeof(region)
                        || region.State != vmhook::windows::mem_commit
                        || (region.Protect & vmhook::windows::page_guard) != 0
                        || (region.Protect & (vmhook::windows::page_readwrite
                            | vmhook::windows::page_writecopy | vmhook::windows::page_execute_readwrite
                            | vmhook::windows::page_execute_writecopy)) == 0) { return false; }
                    const auto base{ reinterpret_cast<std::uintptr_t>(region.BaseAddress) };
                    if (base > cursor || region.RegionSize == 0
                        || region.RegionSize > (std::numeric_limits<std::uintptr_t>::max)() - base)
                    { return false; }
                    const auto end{ base + region.RegionSize };
                    if (end <= cursor) { return false; }
                    cursor = (std::min)(limit, end);
                }
                return true;
            }
            const java_call_layout_t* layout_{};
            std::uint8_t* tail_{};
            std::int32_t saved_top_{};
            void* saved_next_{};
            std::size_t padding_bytes_{};
            bool valid_{};
            alignas(16) std::array<std::array<std::uint8_t, max_handle_block_bytes>, 32> roots_{};
            std::array<std::uint8_t, max_handle_block_bytes> saved_padding_{};
        };
    }

    // --- Method proxy ------------------------------------------------------

    /*
        @brief Proxy for a Java method with descriptor-checked argument conversion.
        @details Typed get_method lookups provide checked access to this proxy;
        legacy get_method lookups return an optional that must be checked.
        Invocation uses the active native_thread_context on the calling OS
        thread, or the validated Java detour backend, and returns value_t.

        Usage inside a wrapper class:
            auto say_hi() -> void { get_method("sayHi")->call(); }
            auto say_string(const std::string& value) -> void {
                get_method("sayString")->call(value);
            }

        call() checks refusal, Java exceptions and result bookkeeping even for
        void wrappers. try_call() preserves structured status for explicit handling;
        conversions are always checked. C++ allocation failures propagate.
    */
    class method_proxy final
    {
    public:
        /*
            @brief Return type from method_proxy::call().
            @details
            Holds the result value as a variant, supporting implicit conversion
            to common C++ types via the conversion operator.
        */
        struct value_t
        {
            std::variant<
                std::monostate,
                bool,
                std::int8_t,
                std::int16_t,
                std::int32_t,
                std::int64_t,
                float,
                double,
                std::uint16_t,
                std::uint32_t,   // reference / array (compressed OOP)
                std::string      // for String objects
            > data;

            /*
                @brief True when the invoked Java method threw.
                @details
                A callee that throws leaves the exception PENDING on the
                JavaThread and leaves the stub's result slot holding garbage.
                call() detects that, clears the pending exception (a pure-VM
                write to ThreadShadow::_pending_exception — no JNI involved),
                returns a status-bearing result with this flag set. call() raises
                vmhook::exception; try_call() lets callers inspect the result.
                Conversions reject failure, including primitive and void calls.
            */
            vmhook::detail::native_backend::root native_root{};
            vmhook::detail::native_backend::root native_receiver_root{};
            vmhook::detail::native_backend::root native_exception_root{};
            std::string failure_message{};
            std::optional<vmhook::exception> failure{};

            auto reference_address(const std::uint32_t compressed) const -> void*
            {
                if (!this->native_root) { return vmhook::hotspot::decode_oop_pointer(compressed); }
                if (!this->native_root->valid())
                { throw vmhook::exception{ "Java result belongs to an expired or different native context" }; }
                void* const address{ this->native_root->resolve_under_vm() };
                if (!address)
                { throw vmhook::exception{ "Retained Java result could not be resolved", vmhook::error_code::result_unavailable }; }
                return address;
            }

            bool invoked{ false };
            // Distinguishes an actual null reference result from void or failure.
            bool reference_result{ false };
            bool reference_array_result{ false };
            bool string_result{ false };
            bool primitive_array_result{ false };
            // A callee may run successfully while result-root bookkeeping fails.
            bool result_failed{ false };
            // Internal constructor handoff; borrowed immediately, never a GC root.
            void* receiver_address{ nullptr };

            [[nodiscard]] auto was_invoked() const noexcept -> bool { return this->invoked; }

            [[nodiscard]] auto status() const noexcept -> vmhook::error_code
            {
                if (this->failure) { return this->failure->code(); }
                if (this->exception_thrown) { return vmhook::error_code::java_exception; }
                if (!this->invoked) { return vmhook::error_code::refused; }
                return this->result_failed ? vmhook::error_code::result_unavailable : vmhook::error_code::none;
            }
            [[nodiscard]] auto error() const -> std::optional<vmhook::exception>
            {
                if (this->failure) { return this->failure; }
                if (this->status() == vmhook::error_code::none) { return {}; }
                const std::string_view message{ !this->failure_message.empty() ? std::string_view{this->failure_message}
                    : this->threw() ? std::string_view{"Java method threw an exception"}
                    : this->result_failed ? std::string_view{"Java method result could not be retained or decoded"}
                    : std::string_view{"Java method invocation refused"} };
                return vmhook::exception{ message, this->status(), this->exception_class, this->native_exception_root };
            }
            auto require_success() const -> void
            { if (auto failed{ this->error() }) { throw std::move(*failed); } }
            [[nodiscard]] auto get_throwable() const -> std::unique_ptr<vmhook::any_object>;
            static auto failed(vmhook::exception error) -> value_t
            { value_t result; result.failure = std::move(error); return result; }

            template<typename stored_type>
            static auto completed(stored_type&& value, void* const receiver = nullptr) -> value_t
            {
                value_t result{ std::forward<stored_type>(value) };
                result.invoked = true;
                result.reference_result = std::is_same_v<std::remove_cvref_t<stored_type>, std::uint32_t>
                    || std::is_same_v<std::remove_cvref_t<stored_type>, std::string>;
                result.receiver_address = receiver;
                return result;
            }

            static auto completed_reference(vmhook::detail::native_backend::root object,
                                            vmhook::detail::native_backend::root receiver = {}) -> value_t
            {
                vmhook::detail::native_backend::operation access{};
                value_t result{ std::uint32_t{} };
                result.invoked = true;
                result.reference_result = true;
                result.native_root = std::move(object);
                result.native_receiver_root = std::move(receiver);
                return result;
            }

            // Native reference handoff preserves invocation and bookkeeping
            // status even when no object ticket could be promoted.
            static auto completed_native_reference(
                const vmhook::detail::native_backend::native_call_result& called) -> value_t
            {
                auto result{ completed_reference(called.object, called.receiver) };
                result.invoked = called.invoked;
                result.exception_thrown = called.threw;
                result.exception_class = called.exception_class;
                result.native_exception_root = called.exception;
                result.failure_message = called.error;
                result.result_failed = !called.error.empty()
                    || (!called.threw && called.bits != 0 && !called.object);
                return result;
            }

            bool exception_thrown{ false };

            /*
                @brief Internal (slash-separated) class name of the thrown exception.
                Empty when nothing was thrown, or when the class name could not be
                read back from the exception oop.
            */
            std::string exception_class{};

            /*
                @brief True when the invoked Java method threw. @see exception_thrown.
            */
            auto threw() const noexcept
                -> bool
            {
                return this->exception_thrown;
            }

            /*
                @brief Checked conversion: failed invocation and incompatible alternatives throw.
                Successful primitive zero and false are preserved.
            */
            template<typename target_type>
                requires vmhook::detail::value_t_convertible_target_v<target_type>
            operator target_type() const
            {
                this->require_success();
                vmhook::detail::native_backend::operation access{};
                if constexpr (vmhook::detail::is_unique_ptr_v<target_type>)
                {
                    using wrapper_type = typename target_type::element_type;
                    if (!this->was_invoked() || this->threw() || this->result_failed || !this->reference_result)
                    { throw vmhook::exception{ "Object conversion requires a successful Java reference result" }; }
                    if (this->reference_array_result)
                    {
                        if constexpr (!(requires { wrapper_type::java_array_wrapper; }))
                        { throw vmhook::exception{ "Array results require a typed array wrapper or to_vector" }; }
                    }
                    if (this->native_root)
                    { return vmhook::detail::materialize_object<wrapper_type>(0, this->native_root); }
                    if (std::holds_alternative<std::uint32_t>(this->data))
                    { return vmhook::detail::materialize_object<wrapper_type>(std::get<std::uint32_t>(this->data), {}); }
                    if (std::holds_alternative<std::monostate>(this->data))
                    { return vmhook::detail::wrap_object<wrapper_type>(nullptr); }
                    throw vmhook::exception{ "Java reference result could not be retained" };
                }
                else
                {
                    return std::visit([this](auto value) -> target_type
                    {
                        using stored_type = std::remove_cvref_t<decltype(value)>;
                        if constexpr (std::is_same_v<target_type, std::string>)
                        {
                            if constexpr (std::is_same_v<stored_type, std::string>) { return value; }
                            else if constexpr (std::is_same_v<stored_type, std::uint32_t>)
                            { return vmhook::read_java_string(this->reference_address(value)); }
                            else { throw vmhook::exception{ "Java method result cannot be converted to a C++ string", vmhook::error_code::type_mismatch }; }
                        }
                        else if constexpr (requires { static_cast<target_type>(value); })
                        {
                            if (this->reference_result)
                            { throw vmhook::exception{ "A Java reference cannot be converted to a C++ primitive", vmhook::error_code::type_mismatch }; }
                            return static_cast<target_type>(value);
                        }
                        else { throw vmhook::exception{ "Java method result cannot be converted to the requested C++ type", vmhook::error_code::type_mismatch }; }
                    }, this->data);
                }
            }

            /*
                @brief True only for a successful void result. Failure has a separate status.
            */
            auto is_void() const noexcept -> bool
            {
                return this->status() == vmhook::error_code::none && std::holds_alternative<std::monostate>(data);
            }

            /*
                @brief True when the call produced a java.lang.String (decoded eagerly).
            */
            auto is_string() const noexcept -> bool
            {
                return this->status() == vmhook::error_code::none
                    && (this->string_result || std::holds_alternative<std::string>(data));
            }

            /*
                @brief The result as a std::string, unambiguously.
            */
            auto as_string() const -> std::string
            {
                this->require_success();
                vmhook::detail::native_backend::operation access{};
                return std::visit([this](const auto& v)
                    -> std::string
                    {
                        using stored_type = std::remove_cvref_t<decltype(v)>;
                        if constexpr (std::is_same_v<stored_type, std::string>)
                        {
                            return v;
                        }
                        else if constexpr (std::is_same_v<stored_type, std::uint32_t>)
                        {
                            return vmhook::read_java_string(this->reference_address(v));
                        }
                        else
                        {
                            throw vmhook::exception{ "String conversion requires a Java String result", vmhook::error_code::type_mismatch };
                        }
                    }
                , data);
            }

            auto as_utf16() const -> std::u16string
            {
                this->require_success();
                if (!this->reference_result || this->reference_array_result)
                { throw vmhook::exception{ "UTF-16 conversion requires a Java String result", vmhook::error_code::type_mismatch }; }
                vmhook::detail::native_backend::operation access{};
                // Eager UTF-8 is intentionally bypassed: the root retains exact
                // Java code units, including isolated surrogates and interior NUL.
                const auto narrow{ std::holds_alternative<std::uint32_t>(this->data)
                    ? std::get<std::uint32_t>(this->data) : std::uint32_t{} };
                return vmhook::read_java_string_utf16(this->reference_address(narrow));
            }

            /* The destination of a deferred conversion supplies the wrapper
               types. Explicit template arguments materialize eagerly for auto
               locals. Non-null sources require their originating VM root. */
            auto to_vector() const -> vmhook::detail::vector_conversion<value_t>;
            auto to_entries() const -> vmhook::detail::vector_conversion<value_t, true>;
            template<vmhook::detail::container_wrapper element_type>
            auto to_vector() const -> std::vector<std::unique_ptr<element_type>>;
            template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
            auto to_vector() const
                -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>;
            template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
            auto to_entries() const
                -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>;

            /* Checked untyped navigation materializes an owning wrapper. */
            auto operator->() const -> std::unique_ptr<vmhook::any_object>;
        };

        /*
            @param owning_object The object whose method will be called (may be null for static).
            @param method_pointer Pointer to the HotSpot Method object.
            @param signature     JVM method descriptor, e.g. "(I)Ljava/lang/String;"
        */
        method_proxy(void* owning_object, vmhook::hotspot::method* method_ptr, std::string sig,
                     const bool pinned = false, void** const receiver_slot = nullptr,
                     vmhook::detail::native_backend::root receiver_root = {})
            : object{ owning_object }
            , method{ method_ptr }
            , signature_text{ std::move(sig) }
            , signature_pinned{ pinned }
            , receiver_slot{ receiver_slot }
            , native_receiver_root{ std::move(receiver_root) }
        {
            try
            {
                vmhook::detail::native_backend::operation operation{};
                if (!method_ptr || !vmhook::hotspot::is_valid_pointer(method_ptr)) { return; }
                this->method_name = method_ptr->get_name();
                if (!vmhook::detail::native_backend::active() || !operation) { return; }
                if (owning_object && !this->native_receiver_root)
                { this->native_receiver_root = vmhook::detail::native_backend::retain_oop(owning_object); }
                const auto* const const_method{ method_ptr->get_const_method() };
                const auto* const constants{ const_method ? const_method->get_constants() : nullptr };
                const auto* const holder_slot{
                    vmhook::hotspot::iterate_struct_entries("ConstantPool", "_pool_holder") };
                this->native_declaring_class = constants && holder_slot
                    ? const_cast<vmhook::hotspot::klass*>(static_cast<const vmhook::hotspot::klass*>(
                        vmhook::hotspot::safe_read_pointer(reinterpret_cast<const std::uint8_t*>(constants)
                            + holder_slot->offset))) : nullptr;
                if (this->native_declaring_class)
                {
                    this->native_class_root = vmhook::detail::native_backend::retain_class(
                        this->native_declaring_class);
                }
            }
            catch (const std::bad_alloc&) { throw; }
            catch (...) {}
        }

        /*
            @brief One argument whose TYPE is known only at runtime.
            @details
            call() selects its overload from C++ argument types, which works
            beautifully when the call site is C++ and hopelessly when it is not.
            A script, a debugger UI, or an RPC that arrived carrying a descriptor
            and a list of strings knows every argument as DATA -- there is no
            pack to expand and no type to deduce.

            java_arg is that data: a value plus, for reference arguments, the
            distinction between "here is an object I already have" and "here is
            text, make me a String".  The alternatives deliberately mirror the
            JVM's own slot classes rather than C++'s type zoo, because the slot
            layout is what the interpreter actually cares about.
        */
        struct java_arg
        {
            /* @brief Which JVM slot class this argument occupies. */
            enum class kind : std::uint8_t
            {
                boolean_,   // Z - one slot
                byte_,      // B - one slot
                char_,      // C - one slot
                short_,     // S - one slot
                int_,       // I - one slot
                long_,      // J - TWO slots, value in the high one
                float_,     // F - one slot
                double_,    // D - TWO slots, value in the high one
                object_,    // L/[ - one slot, a decoded oop (may be null)
                string_,    // L/[ - one slot, TEXT to be allocated as a String
            };

            kind             type{ kind::int_ };
            std::int64_t     integral{ 0 };       // Z B C S I J
            double           floating{ 0.0 };     // F D
            // vmhook::oop_t is not declared until the object-base section far
            // below, so spell its underlying type; they are the same thing.
            void*            oop{ nullptr };       // object_
            std::string      text{};              // string_

            /* @brief Builders, so call sites read as data rather than as setup. */
            static auto of_bool(const bool v) noexcept -> java_arg
            { java_arg a; a.type = kind::boolean_; a.integral = v ? 1 : 0; return a; }
            static auto of_byte(const std::int8_t v) noexcept -> java_arg
            { java_arg a; a.type = kind::byte_; a.integral = v; return a; }
            static auto of_char(const std::uint16_t v) noexcept -> java_arg
            { java_arg a; a.type = kind::char_; a.integral = v; return a; }
            static auto of_short(const std::int16_t v) noexcept -> java_arg
            { java_arg a; a.type = kind::short_; a.integral = v; return a; }
            static auto of_int(const std::int32_t v) noexcept -> java_arg
            { java_arg a; a.type = kind::int_; a.integral = v; return a; }
            static auto of_long(const std::int64_t v) noexcept -> java_arg
            { java_arg a; a.type = kind::long_; a.integral = v; return a; }
            static auto of_float(const float v) noexcept -> java_arg
            { java_arg a; a.type = kind::float_; a.floating = static_cast<double>(v); return a; }
            static auto of_double(const double v) noexcept -> java_arg
            { java_arg a; a.type = kind::double_; a.floating = v; return a; }
            static auto of_object(void* const v) noexcept -> java_arg
            { java_arg a; a.type = kind::object_; a.oop = v; return a; }
            static auto of_string(std::string v) -> java_arg
            { java_arg a; a.type = kind::string_; a.text = std::move(v); return a; }

            /*
                @brief Builds an argument of the kind a JVM descriptor letter names.
                @details
                The bridge from "I parsed a descriptor" to a packed argument.
                `literal` is read per the letter: a numeric literal for a
                primitive, the text of a String for L/[.  Returns nullopt for a
                letter this cannot represent, so a malformed descriptor is a
                refusal rather than a silently wrong slot.

                Integers are parsed DECIMAL unless explicitly 0x-prefixed.  Base-0
                auto-detection would read a leading-zero decimal as OCTAL, so a
                user typing "09" would get 0 -- a real footgun for a field editor
                or a scripted call.
            */
            static auto from_descriptor(const char letter, const std::string_view literal)
                -> std::optional<java_arg>
            {
                const auto as_int{ [&]() -> std::int64_t
                {
                    const std::string owned{ literal };
                    const char* text{ owned.c_str() };
                    bool negative{ false };
                    if (*text == '+') { ++text; }
                    else if (*text == '-') { negative = true; ++text; }
                    int base{ 10 };
                    if (text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) { base = 16; text += 2; }
                    const auto magnitude{ std::strtoull(text, nullptr, base) };
                    const auto value{ static_cast<std::int64_t>(magnitude) };
                    return negative ? -value : value;
                } };

                switch (letter)
                {
                case 'Z': return of_bool(literal == "true" || literal == "TRUE" || literal == "1");
                case 'B': return of_byte(static_cast<std::int8_t>(as_int()));
                case 'S': return of_short(static_cast<std::int16_t>(as_int()));
                case 'C': return literal.size() == 1
                                 ? of_char(static_cast<std::uint16_t>(static_cast<unsigned char>(literal[0])))
                                 : of_char(static_cast<std::uint16_t>(as_int()));
                case 'I': return of_int(static_cast<std::int32_t>(as_int()));
                case 'J': return of_long(as_int());
                case 'F': return of_float(std::strtof(std::string{ literal }.c_str(), nullptr));
                case 'D': return of_double(std::strtod(std::string{ literal }.c_str(), nullptr));
                case 'L':
                case '[': return of_string(std::string{ literal });
                default:  return std::nullopt;
                }
            }
        };

        /*
            @brief Invokes a selected method from runtime-typed packed arguments.
            @details Uses the same direct-native or detour backend and status result as call().
            Arguments follow the JVM descriptor and long/double consume two slots.
            Native-context references are rooted before String allocation; results
            remain rooted until the owning context ends. Raw incoming addresses
            must be valid when handed to the library.
        */
        auto try_call_packed(vmhook::hotspot::method* const requested_method,
                             const std::span<const java_arg> args) const -> value_t
        {
            try { return this->call_packed_unchecked(requested_method, args); }
            catch (const vmhook::exception& error) { return value_t::failed(error); }
        }
        auto call_packed(vmhook::hotspot::method* const requested_method,
                         const std::span<const java_arg> args) const -> value_t
        {
            auto result{ this->try_call_packed(requested_method, args) };
            result.require_success();
            return result;
        }

    private:
        auto call_packed_unchecked(vmhook::hotspot::method* const requested_method,
                                  const std::span<const java_arg> args) const
            -> value_t
        {
            vmhook::detail::native_backend::operation native_operation{};
            const bool native_call{ vmhook::detail::native_backend::active() };
            if ((this->native_class_root && !this->native_class_root->valid())
                || (this->native_receiver_root && !this->native_receiver_root->valid()))
            { return value_t{ std::monostate{} }; }
            auto* const previous_method{ this->method };
            if (native_call && (!native_operation || !this->refresh_native_method()))
            { return value_t{ std::monostate{} }; }
            auto* const selected_method{ native_call && requested_method == previous_method
                ? this->method : requested_method };
            if (native_call && !this->current_native_method(selected_method))
            { return value_t{ std::monostate{} }; }
            if (this->receiver_slot) { this->object = *this->receiver_slot; }
            if (native_call && this->native_receiver_root)
            { this->object = this->native_receiver_root->resolve_under_vm(); }
            if (!this->callable_candidate(selected_method))
            {
                ::vmhook::detail::log_line("{} method_proxy::call_packed(): method pointer is null or invalid.",
                           vmhook::error_tag);
                return value_t{ std::monostate{} };
            }

            if (!native_call && (!vmhook::hotspot::ensure_current_java_thread()
                || !vmhook::hotspot::in_java_detour()))
            {
                ::vmhook::detail::log_line("{} method_proxy::call_packed(): Java calls require a Java-thread detour.",
                                          vmhook::error_tag);
                return value_t{ std::monostate{} };
            }
            bool kind_readable{ false };
            const bool selected_static{
                selected_method->safe_access_flags_test(0x0008u, kind_readable) };
            if (!kind_readable || (!selected_static && !this->object))
            {
                return value_t{ std::monostate{} };
            }
            const bool selected_private{ selected_method->safe_access_flags_test(0x0002u, kind_readable) };
            if (!kind_readable) { return value_t{ std::monostate{} }; }
            auto* const selected_holder{ declaring_class(selected_method) };

            std::string selected_signature{ selected_method->get_signature() };
            const std::string selected_name{ native_call ? selected_method->get_name() : std::string{} };
            if (selected_signature.empty())
            {
                return value_t{ std::monostate{} };
            }

            // Check all argument kinds before allocating a String or packing any
            // slots. The public runtime-value path must obey the same descriptor
            // contract as the typed call path.
            const std::size_t close_paren{ selected_signature.find(')') };
            if (selected_signature.front() != '(' || close_paren == std::string::npos)
            {
                return value_t{ std::monostate{} };
            }
            std::size_t descriptor_position{ 1 };
            for (const java_arg& argument : args)
            {
                const std::string_view descriptor{
                    next_argument_descriptor(selected_signature, descriptor_position, close_paren) };
                bool compatible{ false };
                switch (argument.type)
                {
                case java_arg::kind::boolean_: compatible = descriptor == "Z"; break;
                case java_arg::kind::byte_:    compatible = descriptor == "B"; break;
                case java_arg::kind::char_:    compatible = descriptor == "C"; break;
                case java_arg::kind::short_:   compatible = descriptor == "S"; break;
                case java_arg::kind::int_:     compatible = descriptor == "I"; break;
                case java_arg::kind::long_:    compatible = descriptor == "J"; break;
                case java_arg::kind::float_:   compatible = descriptor == "F"; break;
                case java_arg::kind::double_:  compatible = descriptor == "D"; break;
                case java_arg::kind::object_:
                    compatible = !descriptor.empty()
                        && (descriptor.front() == 'L' || descriptor.front() == '[');
                    break;
                case java_arg::kind::string_:
                    compatible = !descriptor.empty() && descriptor.front() == 'L';
                    break;
                }
                if (!compatible)
                {
                    return value_t{ std::monostate{} };
                }
            }
            if (descriptor_position != close_paren)
            {
                return value_t{ std::monostate{} };
            }

            // JVMS 4.3.3 allows 255 parameter slots, including the receiver.
            // Wide primitives consume two slots; reference arrays consume one.
            constexpr std::size_t max_param_slots{ 255 };
            std::intptr_t params[max_param_slots]{};
            std::size_t   param_idx{ 0 };
            std::array<vmhook::detail::native_backend::root, max_param_slots> native_argument_roots{};

            if (args.size() > max_param_slots)
            {
                ::vmhook::detail::log_line("{} method_proxy::call_packed('{}{}'): {} arguments exceeds the JVM "
                           "parameter-slot limit.",
                           vmhook::error_tag, this->name(), selected_signature, args.size());
                return value_t{ std::monostate{} };
            }

            // Root every existing reference before String construction can
            // enter a safepoint and relocate receivers or preceding arguments.
            if (native_call)
            {
                for (std::size_t index{ 0 }; index < args.size(); ++index)
                {
                    if (args[index].type != java_arg::kind::object_ || !args[index].oop) { continue; }
                    native_argument_roots[index] = vmhook::detail::native_backend::retain_oop(args[index].oop);
                    if (!native_argument_roots[index]) { return value_t{ std::monostate{} }; }
                }
            }

            // Receiver in locals[0] for an instance dispatch ONLY.  A static
            // Method reached through an instance wrapper keeps this->object
            // bound, and prepending it would shift every real argument down one
            // slot and hand the callee the receiver as its first parameter.
            if (!selected_static)
            {
                params[param_idx++] = reinterpret_cast<std::intptr_t>(this->object);
            }

            std::size_t native_argument_index{};
            for (const java_arg& argument : args)
            {
                auto& native_argument_root{ native_argument_roots[native_argument_index++] };
                const bool two_slots{ argument.type == java_arg::kind::long_
                                      || argument.type == java_arg::kind::double_ };
                if (param_idx + (two_slots ? 2u : 1u) > max_param_slots)
                {
                    ::vmhook::detail::log_line("{} method_proxy::call_packed('{}{}'): argument list overflows the "
                               "interpreter locals[] array; refusing rather than truncating.",
                               vmhook::error_tag, this->name(), selected_signature);
                    return value_t{ std::monostate{} };
                }

                switch (argument.type)
                {
                case java_arg::kind::boolean_:
                case java_arg::kind::byte_:
                case java_arg::kind::char_:
                case java_arg::kind::short_:
                case java_arg::kind::int_:
                    params[param_idx++] = static_cast<std::intptr_t>(argument.integral);
                    break;

                case java_arg::kind::long_:
                    params[param_idx++] = 0;   // low slot: ignored by the interpreter
                    params[param_idx++] = static_cast<std::intptr_t>(argument.integral);
                    break;

                case java_arg::kind::float_:
                {
                    const float narrowed{ static_cast<float>(argument.floating) };
                    std::uint32_t bits{ 0 };
                    std::memcpy(&bits, &narrowed, sizeof(bits));
                    params[param_idx++] = static_cast<std::intptr_t>(bits);
                    break;
                }

                case java_arg::kind::double_:
                {
                    std::uint64_t bits{ 0 };
                    std::memcpy(&bits, &argument.floating, sizeof(bits));
                    params[param_idx++] = 0;
                    params[param_idx++] = static_cast<std::intptr_t>(bits);
                    break;
                }

                case java_arg::kind::object_:
                    params[param_idx++] = reinterpret_cast<std::intptr_t>(native_argument_root
                        ? native_argument_root->resolve_under_vm() : argument.oop);
                    break;

                case java_arg::kind::string_:
                {
                    if (native_call)
                    { native_argument_root = vmhook::detail::native_backend::make_string(argument.text); }
                    void* const string_oop{ native_call
                        ? (native_argument_root ? native_argument_root->resolve_under_vm() : nullptr)
                        : vmhook::make_java_string(argument.text) };
                    if (!string_oop)
                    {
                        ::vmhook::detail::log_line("{} method_proxy::call_packed('{}{}'): failed to allocate a Java "
                                   "String argument.",
                                   vmhook::error_tag, this->name(), selected_signature);
                        return value_t{ std::monostate{} };
                    }
                    params[param_idx++] = reinterpret_cast<std::intptr_t>(string_oop);
                    break;
                }
                }
            }

            if (native_call)
            {
                std::size_t slot{ selected_static ? 0u : 1u };
                if (!selected_static) { params[0] = reinterpret_cast<std::intptr_t>(
                    this->native_receiver_root->resolve_under_vm()); }
                for (std::size_t index{ 0 }; index < args.size(); ++index)
                {
                    if (native_argument_roots[index])
                    { params[slot] = reinterpret_cast<std::intptr_t>(native_argument_roots[index]->resolve_under_vm()); }
                    slot += args[index].type == java_arg::kind::long_
                        || args[index].type == java_arg::kind::double_ ? 2u : 1u;
                }
            }

            auto* const invocation_method{ native_call
                ? this->current_native_signature(selected_name, selected_signature, selected_holder,
                    !selected_static && !selected_private && selected_name != "<init>") : selected_method };
            return this->invoke_packed(invocation_method, selected_signature, params, param_idx);
        }

    private:
        /*
            @brief Invokes a validated Method with packed interpreter locals.
            @details Typed call() and runtime call_packed() validate their selected
            method, descriptor, argument kinds, and slot layout before entering
            this shared backend. This function checks the remaining call-frame,
            JavaThread, handle, and return-decoding requirements before invocation.

            @param selected_method Resolved callable Method*.
            @param selected_signature Exact descriptor of that method.
            @param params Interpreter locals: receiver first for an instance call;
                          long/double occupy two slots with the value in the high slot.
            @param param_idx Number of used interpreter slots.
            @param argument_owners Optional wrapper slots refreshed after the call.
            @return Status-bearing decoded result; was_invoked() is false on refusal.
            Exception safety: noexcept.
        */
        auto invoke_packed(vmhook::hotspot::method* const selected_method,
                           const std::string& selected_signature,
                           std::intptr_t* const params,
                           const std::size_t param_idx,
                           void** const* const argument_owners = nullptr) const
            -> value_t
        {
            if (!this->callable_candidate(selected_method) || param_idx > 255
                || (param_idx != 0 && !params)
                || selected_signature != selected_method->get_signature())
            { return value_t{ std::monostate{} }; }

            if (vmhook::detail::native_backend::active())
            {
                return this->invoke_native_packed(selected_method, selected_signature,
                    params, param_idx, argument_owners);
            }

            void* const call_stub{ vmhook::detail::find_call_stub_entry() };
            if (!call_stub)
            {
                // Invocation is simply unavailable on such a build — there is no
                // second dispatch tier to fall back to.
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): StubRoutines::_call_stub_entry could not be "
                           "resolved or derived on this JDK; pure-VM invocation unavailable.",
                           vmhook::error_tag, this->name(), this->signature_text);
                return value_t{ std::monostate{} };
            }

            // The synthetic JavaCallWrapper the stub's first argument MUST point
            // at cannot be built without these offsets, and building it wrong is
            // worse than not calling at all (the GC dereferences it).
            const vmhook::detail::java_call_layout_t& layout{ vmhook::detail::java_call_layout() };
            if (!layout.usable)
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): the JavaCallWrapper / frame-anchor layout "
                           "could not be resolved through VMStructs; pure-VM invocation unavailable.",
                           vmhook::error_tag, this->name(), this->signature_text);
                return value_t{ std::monostate{} };
            }


            if (!vmhook::hotspot::ensure_current_java_thread())
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): no current JavaThread.", vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }

            auto* const thread{ vmhook::hotspot::current_java_thread };
            if (!thread)
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): current JavaThread is unavailable.", vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }

            const auto* const const_method{ selected_method->get_const_method() };
            const auto* const constants{ const_method ? const_method->get_constants() : nullptr };
            static const auto* const holder_slot{
                vmhook::hotspot::iterate_struct_entries("ConstantPool", "_pool_holder") };
            auto* const holder{ constants && holder_slot
                ? const_cast<vmhook::hotspot::klass*>(static_cast<const vmhook::hotspot::klass*>(
                    vmhook::hotspot::safe_read_pointer(reinterpret_cast<const std::uint8_t*>(constants)
                        + holder_slot->offset))) : nullptr };
            if (!vmhook::detail::class_initialized(holder))
            {
                ::vmhook::detail::log_line("{} method_proxy::call(): declaring class is not fully initialized.",
                           vmhook::error_tag);
                return value_t{ std::monostate{} };
            }

            void* const entry{ selected_method->get_from_interpreted_entry() };
            if (!entry || !vmhook::hotspot::is_valid_pointer(entry))
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): interpreted entry is null or invalid.", vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }

            //  Return type
            const std::string_view sig{ selected_signature };
            const std::size_t rparen{ sig.rfind(')') };
            // Guard the return-descriptor read on two fronts.  selected_signature is
            // a resolved Method descriptor on the happy path (always "(...)<ret>"),
            // but it falls back to this->signature_text -- a caller-supplied override
            // -- when no Method resolved, so it may be malformed:
            //   * bounds: a signature ending in ')' (e.g. "()" or "(I)") makes
            //     rparen == size()-1, so sig[rparen + 1] would read sig[size()] --
            //     out of bounds for a string_view (operator[] requires pos < size();
            //     the std::string's NUL-at-size() guarantee does NOT carry through a
            //     string_view).  Treat "ends in ')'" as void.
            //   * validity: an unrecognised return char must not fall through
            //     sig_char_to_basic_type()'s T_OBJECT default, which would make the
            //     call stub decode an arbitrary return register as an oop pointer.
            //     Restrict to the real JVM return descriptors; anything else degrades
            //     to T_VOID (a safe no-op return), consistent with the npos fallback.
            const char ret_char{
                (rparen != std::string_view::npos && rparen + 1 < sig.size())
                    ? sig[rparen + 1]
                    : 'V' };
            const bool valid_ret_char{
                ret_char == 'Z' || ret_char == 'B' || ret_char == 'C'
                || ret_char == 'S' || ret_char == 'I' || ret_char == 'J'
                || ret_char == 'F' || ret_char == 'D' || ret_char == 'L'
                || ret_char == '[' || ret_char == 'V' };
            if ((ret_char == 'L' || ret_char == '[')
                && vmhook::detail::reference_storage_width() != sizeof(std::uint32_t))
            {
                ::vmhook::detail::log_line("{} method_proxy::call(): reference results require compressed oops.",
                           vmhook::error_tag);
                return value_t{ std::monostate{} };
            }
            const int result_type{
                valid_ret_char ? vmhook::detail::sig_char_to_basic_type(ret_char)
                               : 14 /* T_VOID: malformed/unknown return -> safe no-op */ };

            //  Parameter SLOT array

            //  Call the stub
            // Windows x64 calling convention  8 arguments:
            //   rcx = link  (JavaCallWrapper* — see below; NOT a sentinel)
            //   rdx = result* (where the Java return value is written)
            //   r8  = result_type (BasicType enum, read as 32 bits)
            //   r9  = Method*
            //   stk = entry_point, parameters*, param_count, JavaThread*
            using call_stub_fn_t = void (*)(
                void*,          // link
                std::intptr_t*, // result
                int,            // result_type
                void*,          // method
                void*,          // entry_point
                std::intptr_t*, // parameters
                int,            // size_of_parameters
                void*           // thread
                );

            const auto previous_state{ thread->get_thread_state() };
            if (!vmhook::hotspot::in_java_detour()
                || !vmhook::detail::java_execution_supported())
            {
                ::vmhook::detail::log_line("{} method_proxy::call(): a validated detour and supported heap are required.",
                           vmhook::error_tag);
                return value_t{ std::monostate{} };
            }

            std::uint8_t* const thread_bytes{ reinterpret_cast<std::uint8_t*>(thread) };
            std::uint8_t* const thread_anchor{ thread_bytes + layout.thread_anchor_offset };

            // --- the synthetic JavaCallWrapper -------------------------------
            // The stub's first argument is the caller's JavaCallWrapper, and the
            // frame walker DEREFERENCES it: frame::sender_for_entry_frame reads
            // entry_frame_call_wrapper()->anchor(), and frame::oops_entry_do reads
            // ->callee_method() and ->oops_do() (which walks _receiver and the
            // _handles block).  Passing a sentinel there is not "unused" — with
            // the old `-1` a GC walking this thread dereferenced
            // ((JavaCallWrapper*)-1)->_anchor._last_Java_sp and killed the JVM at
            // address 0x1f.  HotSpot stack-allocates this struct itself, so a
            // 64-byte C++ stack object is exactly the right shape; the offsets are
            // validated in java_call_layout().
            alignas(16) std::uint8_t wrapper[64]{};
            static_assert(sizeof(wrapper) == 64,
                          "This backend requires a 64-byte JavaCallWrapper; "
                          "java_call_layout() re-checks this against gHotSpotVMTypes at runtime.");

            bool flags_found{ false };
            const bool selected_static{ selected_method->safe_access_flags_test(0x0008u, flags_found) };
            if (!flags_found || (!selected_static && !this->object))
            {
                return value_t{ std::monostate{} };
            }
            void* const receiver_oop{ selected_static ? nullptr : this->object };

            // Read JVM memory through the Windows memory API and stop on unreadable data.
            // A successful read does not establish object lifetime or a coherent VM snapshot.
            void* saved_last_java_sp{ nullptr };
            void* saved_last_java_pc{ nullptr };
            void* saved_last_java_fp{ nullptr };
            void* active_handles{ nullptr };
            if (!vmhook::os::safe_read(&saved_last_java_sp, thread_anchor + layout.anchor_sp_offset, sizeof(saved_last_java_sp))
                || !vmhook::os::safe_read(&saved_last_java_pc, thread_anchor + layout.anchor_pc_offset, sizeof(saved_last_java_pc))
                || (layout.has_anchor_fp
                    && !vmhook::os::safe_read(&saved_last_java_fp, thread_anchor + layout.anchor_fp_offset, sizeof(saved_last_java_fp)))
                || !vmhook::os::safe_read(&active_handles, thread_bytes + layout.active_handles_offset, sizeof(active_handles)))
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): JavaThread frame-anchor / handle slots are not readable.",
                           vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }
            if (!active_handles || !vmhook::hotspot::is_valid_pointer(active_handles))
            {
                // JavaCallWrapper::oops_do walks _handles unconditionally; a null
                // block would fault inside the GC, not here.
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): JavaThread has no active JNIHandleBlock.",
                           vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }

            std::array<void*, 255> object_arguments{};
            std::array<std::size_t, 255> object_argument_slots{};
            std::size_t object_argument_count{};
            char descriptors[255]{};
            const auto descriptor_count{ vmhook::detail::parse_parameter_descriptors(
                selected_signature, descriptors, std::size(descriptors)) };
            std::size_t slot{ selected_static ? 0u : 1u };
            for (std::size_t index{ 0 }; index < descriptor_count; ++index)
            {
                if (slot >= param_idx) { return value_t{ std::monostate{} }; }
                if (descriptors[index] == 'L' || descriptors[index] == '[')
                {
                    object_arguments[object_argument_count] = reinterpret_cast<void*>(params[slot]);
                    object_argument_slots[object_argument_count++] = slot;
                }
                slot += descriptors[index] == 'J' || descriptors[index] == 'D' ? 2u : 1u;
            }
            if (slot != param_idx) { return value_t{ std::monostate{} }; }
            vmhook::detail::argument_roots_guard argument_roots{
                layout, active_handles, std::span<void* const>{
                    object_arguments.data(), object_argument_count } };
            if (!argument_roots.valid()) { return value_t{ std::monostate{} }; }


            void* entry_anchor_sp{ saved_last_java_sp };
            void* entry_anchor_pc{ saved_last_java_pc };
            void* entry_anchor_fp{ saved_last_java_fp };
            if (!entry_anchor_sp && vmhook::hotspot::current_detour_anchor.valid)
            {
                entry_anchor_sp = vmhook::hotspot::current_detour_anchor.last_java_sp;
                entry_anchor_pc = vmhook::hotspot::current_detour_anchor.last_java_pc;
                entry_anchor_fp = vmhook::hotspot::current_detour_anchor.last_java_fp;
            }

            std::memcpy(wrapper + layout.wrapper_thread_offset,   &thread,          sizeof(void*));
            std::memcpy(wrapper + layout.wrapper_handles_offset,  &active_handles,  sizeof(void*));
            std::memcpy(wrapper + layout.wrapper_callee_offset,   &selected_method, sizeof(void*));
            std::memcpy(wrapper + layout.wrapper_receiver_offset, &receiver_oop,    sizeof(void*));
            std::memcpy(wrapper + layout.wrapper_anchor_offset + layout.anchor_sp_offset, &entry_anchor_sp, sizeof(void*));
            std::memcpy(wrapper + layout.wrapper_anchor_offset + layout.anchor_pc_offset, &entry_anchor_pc, sizeof(void*));
            if (layout.has_anchor_fp)
            {
                std::memcpy(wrapper + layout.wrapper_anchor_offset + layout.anchor_fp_offset, &entry_anchor_fp, sizeof(void*));
            }
            // _result stays null: HotSpot only reads it from the wrapper on the
            // exception-unwind path, and the stub writes our own result_holder.
            const void* const null_result{ nullptr };
            std::memcpy(wrapper + layout.wrapper_result_offset, &null_result, sizeof(void*));

            // Give the callee its own reusable block, keeping the caller's
            // block rooted through JavaCallWrapper::_handles during the call.
            void* pending_before{ nullptr };
            if (!vmhook::os::safe_read(&pending_before,
                    thread_bytes + layout.pending_exception_offset, sizeof(pending_before))
                || pending_before) { return value_t{ std::monostate{} }; }
            vmhook::detail::call_handles_guard handles_guard{};
            void* const fresh_handles{ handles_guard.get() };
            if (!fresh_handles) { return value_t{ std::monostate{} }; }
            const std::int32_t zero_top{ 0 };
            // Retain only the VM-allocated extension chain. All head bookkeeping
            // (_last, free list, pop-frame link) starts empty on each invocation.
            void* retained_next{ nullptr };
            std::memcpy(&retained_next, static_cast<std::uint8_t*>(fresh_handles)
                + layout.handle_block_next_offset, sizeof(retained_next));
            std::memset(fresh_handles, 0, layout.handle_block_size);
            std::memcpy(static_cast<std::uint8_t*>(fresh_handles) + layout.handle_block_next_offset,
                        &retained_next, sizeof(retained_next));
            std::uint8_t* const handles_slot{ thread_bytes + layout.active_handles_offset };
            std::memcpy(handles_slot, &fresh_handles, sizeof(fresh_handles));

            // --- clear the thread's anchor ------------------------------------
            // This is what JavaCallWrapper's constructor does.  The new Java
            // frames belong to the NEW entry frame, so the walker must not
            // attribute them to the anchor we just copied into the wrapper.
            // JavaFrameAnchor::clear() on x86 is
            //     _last_Java_sp = nullptr;   // "clearing _last_Java_sp must be first"
            //     _last_Java_fp = nullptr;
            //     _last_Java_pc = nullptr;
            // and the order is the contract, not a style: _last_Java_sp IS
            // has_last_Java_frame(), so retiring it first is what keeps the anchor
            // legal at every instant for an asynchronous reader (GC worker,
            // profiler, handshake).
            void* const cleared{ nullptr };
            std::memcpy(thread_anchor + layout.anchor_sp_offset, &cleared, sizeof(cleared));
            if (layout.has_anchor_fp)
            {
                std::memcpy(thread_anchor + layout.anchor_fp_offset, &cleared, sizeof(cleared));
            }
            std::memcpy(thread_anchor + layout.anchor_pc_offset, &cleared, sizeof(cleared));

            std::intptr_t result_holder{ 0 };

            // The state gate verifies the existing detour; it writes nothing.
            if (!vmhook::hotspot::enter_java_state(thread))
            {
                // Nothing has run yet, but the wrapper setup above already
                // repointed the handle block and cleared the anchor, so both go
                // back before we leave.
                std::memcpy(thread_bytes + layout.active_handles_offset,
                            &active_handles, sizeof(void*));
                if (layout.has_anchor_fp)
                {
                    std::memcpy(thread_anchor + layout.anchor_fp_offset,
                                &saved_last_java_fp, sizeof(void*));
                }
                std::memcpy(thread_anchor + layout.anchor_pc_offset,
                            &saved_last_java_pc, sizeof(void*));
                std::memcpy(thread_anchor + layout.anchor_sp_offset,
                            &saved_last_java_sp, sizeof(void*));
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): could not enter Java safely.",
                           vmhook::error_tag, this->name(), selected_signature);
                return value_t{ std::monostate{} };
            }

            reinterpret_cast<call_stub_fn_t>(call_stub)(
                wrapper,
                &result_holder,
                result_type,
                reinterpret_cast<void*>(selected_method),
                entry,
                params,
                static_cast<int>(param_idx),
                reinterpret_cast<void*>(thread)
                );

            void* receiver_after{ nullptr };
            std::memcpy(&receiver_after, wrapper + layout.wrapper_receiver_offset, sizeof(receiver_after));
            for (std::size_t index{ 0 }; index < object_argument_count; ++index)
            {
                const auto argument_slot{ object_argument_slots[index] };
                void* const updated{ argument_roots.at(index) };
                params[argument_slot] = reinterpret_cast<std::intptr_t>(updated);
                if (argument_owners && argument_owners[argument_slot])
                {
                    *argument_owners[argument_slot] = updated;
                }
            }
            if (!selected_static)
            {
                this->object = receiver_after;
                if (this->receiver_slot) { *this->receiver_slot = receiver_after; }
            }

            //  Restore everything the call was allowed to disturb
            // ORDER MATTERS, and it is HotSpot's, taken from ~JavaCallWrapper():
            // restore the handle block, then zap the anchor (sp first), then the
            // thread state, then republish the anchor with sp LAST.
            //
            // The caller's block goes back untouched -- nothing wrote to it, so its
            // _top and every handle in it are exactly what they were, and they were
            // GC roots continuously (they never stopped being reachable through
            // JavaThread::_active_handles ... except during the call, where the
            // synthetic JavaCallWrapper's _handles field kept rooting them through
            // frame::oops_entry_do -> JavaCallWrapper::oops_do -> handles()->oops_do).
            std::memcpy(thread_bytes + layout.active_handles_offset, &active_handles, sizeof(void*));
            std::memcpy(static_cast<std::uint8_t*>(fresh_handles) + layout.handle_block_top_offset,
                        &zero_top, sizeof(zero_top));

            // Retire the (now stale) anchor before touching anything else, so no
            // asynchronous walker can pair a live sp with a half-written fp/pc.
            std::memcpy(thread_anchor + layout.anchor_sp_offset, &cleared, sizeof(cleared));

            vmhook::hotspot::leave_java_state(thread, previous_state);

            // JavaFrameAnchor::copy() on x86, verbatim:
            //     if (_last_Java_sp != src->_last_Java_sp) _last_Java_sp = nullptr;
            //     _last_Java_fp = src->_last_Java_fp;
            //     _last_Java_pc = src->_last_Java_pc;
            //     // Must be last so profiler will always see valid frame if
            //     // has_last_frame() is true
            //     _last_Java_sp = src->_last_Java_sp;
            // (jdk21u jdk-21.0.11-ga src/hotspot/cpu/x86/javaFrameAnchor_x86.hpp,
            //  byte-identical in jdk master; jdk8u492-ga the same modulo NULL.)
            // The previous code here wrote sp FIRST, which republished
            // has_last_Java_frame() == true while fp and pc still held the cleared
            // values -- a GC worker sampling in that window builds
            // frame(real_sp, nullptr, nullptr) and walks it.
            if (layout.has_anchor_fp)
            {
                std::memcpy(thread_anchor + layout.anchor_fp_offset, &saved_last_java_fp, sizeof(void*));
            }
            std::memcpy(thread_anchor + layout.anchor_pc_offset, &saved_last_java_pc, sizeof(void*));
            std::memcpy(thread_anchor + layout.anchor_sp_offset, &saved_last_java_sp, sizeof(void*));


            if (layout.has_pending_exception)
            {
                void* pending{ nullptr };
                if (vmhook::os::safe_read(&pending,
                                          thread_bytes + layout.pending_exception_offset,
                                          sizeof(pending))
                    && pending)
                {
                    // Restoration above is complete. Clear the thread slot first,
                    // while pending remains a valid borrowed oop in VM state.
                    std::memcpy(thread_bytes + layout.pending_exception_offset, &cleared, sizeof(cleared));
                    const auto exception_root{ vmhook::detail::native_backend::retain_oop(pending) };
                    std::string exception_class{};
                    if (vmhook::hotspot::klass* const exception_klass{ method_proxy::klass_from_object_header(pending) })
                    {
                        if (vmhook::hotspot::symbol* const class_name{ exception_klass->get_name() })
                        {
                            exception_class = class_name->to_string();
                        }
                    }

                    // Clear it: the slot was just proven readable, and this is the
                    // current thread's own JavaThread.
                    std::memcpy(thread_bytes + layout.pending_exception_offset, &cleared, sizeof(cleared));

                    ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): the callee threw {}; result discarded and the "
                               "pending exception cleared.",
                               vmhook::warning_tag, this->name(), selected_signature,
                               exception_class.empty() ? std::string{ "a Java exception" } : exception_class);

                    value_t thrown{};
                    switch (ret_char)
                    {
                    case 'Z': thrown.data = false;                      break;
                    case 'B': thrown.data = static_cast<std::int8_t>(0); break;
                    case 'S': thrown.data = static_cast<std::int16_t>(0); break;
                    case 'I': thrown.data = static_cast<std::int32_t>(0); break;
                    case 'J': thrown.data = static_cast<std::int64_t>(0); break;
                    case 'C': thrown.data = static_cast<std::uint16_t>(0); break;
                    case 'F': thrown.data = 0.0f;                        break;
                    case 'D': thrown.data = 0.0;                         break;
                    default:  thrown.data = std::monostate{};            break;
                    }
                    thrown.invoked = true;
                    thrown.receiver_address = receiver_after;
                    thrown.exception_thrown = true;
                    thrown.native_exception_root = exception_root;
                    thrown.exception_class  = std::move(exception_class);
                    return thrown;
                }
            }

            //  Decode result
            switch (ret_char)
            {
            case 'Z': return value_t::completed((result_holder & 1) != 0, receiver_after);
            case 'B': return value_t::completed(static_cast<std::int8_t> (result_holder), receiver_after);
            case 'S': return value_t::completed(static_cast<std::int16_t>(result_holder), receiver_after);
            case 'I': return value_t::completed(static_cast<std::int32_t>(result_holder), receiver_after);
            case 'J': return value_t::completed(static_cast<std::int64_t>(result_holder), receiver_after);
            case 'C': return value_t::completed(static_cast<std::uint16_t>(result_holder), receiver_after);
            case 'F':
            {
                // Copy IEEE-754 bits through an unsigned integer to avoid implementation-defined signed conversions.
                float f{};
                const std::uint32_t bits{ static_cast<std::uint32_t>(result_holder) };
                std::memcpy(&f, &bits, sizeof(f));
                return value_t::completed(f, receiver_after);
            }
            case 'D':
            {
                double d{};
                std::memcpy(&d, &result_holder, sizeof(d));
                return value_t::completed(d, receiver_after);
            }
            case 'V': return value_t::completed(std::monostate{}, receiver_after);
            default:
            {
                // Reference / array return ('L' / '[').  The call stub leaves an
                // UNCOMPRESSED oop in result_holder (see the params[] comment
                // above).  The previous `static_cast<std::uint32_t>(result_holder)`
                // both TRUNCATED the 64-bit pointer to 32 bits AND mislabelled an
                // uncompressed oop as the compressed-oop that value_t's uint32_t
                // alternative is documented to hold - so a
                // `Ljava/lang/String;`-returning call() silently produced "".
                // Now: decode java.lang.String straight to UTF-8, and re-encode
                // any other reference to a real compressed oop so value_t
                // round-trips through decode_oop_pointer instead of truncating.
                void* const result_oop{ reinterpret_cast<void*>(result_holder) };
                auto result{ value_t::completed(std::uint32_t{}, receiver_after) };
                result.reference_array_result = ret_char == '[';
                result.primitive_array_result = ret_char == '[' && rparen + 2 < sig.size()
                    && sig[rparen + 2] != 'L' && sig[rparen + 2] != '[';
                result.string_result = rparen != std::string_view::npos
                    && sig.substr(rparen + 1) == "Ljava/lang/String;";
                if (!result_oop) { return result; }
                result.native_root = vmhook::detail::native_backend::retain_oop(result_oop);
                if (!result.native_root) { result.result_failed = true; return result; }
                result.data = vmhook::hotspot::encode_oop_pointer(result_oop);
                result.string_result = rparen != std::string_view::npos
                    && sig.substr(rparen + 1) == "Ljava/lang/String;";
                return result;
            }
            }
        }

        /*
            @brief Invokes Java on the calling OS thread with the active backend.
            @details An explicit native_thread_context uses private HotSpot JavaCalls
            with real VM transitions and GC roots, without hooks or queued work.
            A validated Java detour uses the existing checked call-stub backend.
            Runtime capabilities are verified before either backend executes.
            Arguments follow the Java descriptor: long/double use two slots with the
            value in the high slot; other supported parameters use one slot.
            @return was_invoked distinguishes refusal from an actual void/null/zero
            return. threw and exception_class report a Java exception after invocation.
        */
    public:
        template<typename... args_t>
            requires (vmhook::detail::supported_java_argument_v<args_t> && ...)
        auto try_call(args_t&&... args) const -> value_t
        {
            try { return this->call_unchecked(std::forward<args_t>(args)...); }
            catch (const vmhook::exception& error) { return value_t::failed(error); }
        }
        template<typename... args_t>
            requires (vmhook::detail::supported_java_argument_v<args_t> && ...)
        auto call(args_t&&... args) const -> value_t
        {
            auto result{ this->try_call(std::forward<args_t>(args)...) };
            result.require_success();
            return result;
        }

    private:
        template<typename... args_t>
            requires (vmhook::detail::supported_java_argument_v<args_t> && ...)
        auto call_unchecked(args_t&&... args) const
            -> value_t
        {
            (vmhook::detail::require_object_argument(args), ...);
            vmhook::detail::native_backend::operation native_operation{};
            const bool native_call{ vmhook::detail::native_backend::active() };
            if ((this->native_class_root && !this->native_class_root->valid())
                || (this->native_receiver_root && !this->native_receiver_root->valid()))
            { return value_t{ std::monostate{} }; }
            if (native_call && (!native_operation || !this->refresh_native_method()))
            { return value_t{ std::monostate{} }; }
            if (this->receiver_slot) { this->object = *this->receiver_slot; }
            if (native_call && this->native_receiver_root)
            { this->object = this->native_receiver_root->resolve_under_vm(); }
            if (!this->method || !vmhook::hotspot::is_valid_pointer(this->method))
            {
                ::vmhook::detail::log_line("{} method_proxy::call(): method pointer is null or invalid.", vmhook::error_tag);
                return value_t{ std::monostate{} };
            }

            if (!native_call && (!vmhook::hotspot::ensure_current_java_thread()
                || !vmhook::hotspot::in_java_detour()))
            {
                ::vmhook::detail::log_line("{} method_proxy::call(): Java calls require a Java-thread detour.",
                                          vmhook::error_tag);
                return value_t{ std::monostate{} };
            }

            // Cheap presence probe BEFORE any packing.  Packing a String argument
            // ALLOCATES a Java object; doing that only to discover there is no
            // dispatcher would strand it.  find_call_stub_entry() caches, so the
            // authoritative resolve inside invoke_packed() costs nothing extra.
            if (!native_call && !vmhook::detail::find_call_stub_entry())
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): no call stub could be derived; "
                           "invocation is unavailable on this VM.",
                           vmhook::error_tag, this->name(), this->signature_text);
                return value_t{ std::monostate{} };
            }

            vmhook::hotspot::method* const selected_method{ this->resolve_compatible_method<std::remove_cvref_t<args_t>...>() };
            if (!selected_method || !vmhook::hotspot::is_valid_pointer(selected_method))
            {
                ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): no resolvable Method* for the call.",
                           vmhook::error_tag, this->name(), this->signature_text);
                return value_t{ std::monostate{} };
            }
            bool kind_readable{ false };
            const bool selected_static{
                selected_method->safe_access_flags_test(0x0008u, kind_readable) };
            if (!kind_readable || (!selected_static && !this->object))
            {
                return value_t{ std::monostate{} };
            }
            const bool selected_private{ selected_method->safe_access_flags_test(0x0002u, kind_readable) };
            if (!kind_readable) { return value_t{ std::monostate{} }; }
            auto* const selected_holder{ native_call ? declaring_class(selected_method) : nullptr };
            std::string selected_signature{ selected_method->get_signature() };
            if (!signature_matches_arguments<std::remove_cvref_t<args_t>...>(
                    selected_signature, this->signature_pinned))
            {
                return value_t{ std::monostate{} };
            }
            // parameters contains interpreter slots, not one slot per Java argument.
            // A long or double occupies two slots with the value in the high slot;
            // object arguments use decoded pointers. Pack according to the Java descriptor.
            constexpr std::size_t max_param_slots{ 255 };
            std::intptr_t params[max_param_slots]{};
            std::array<void**, max_param_slots> argument_owners{};
            std::array<vmhook::detail::native_backend::root, sizeof...(args_t)> native_argument_roots{};
            std::size_t   param_idx{ 0 };

            // Existing object arguments must be rooted before allocating any
            // String argument, because the allocation can run the collector.
            if (native_call)
            {
                std::size_t root_index{};
                bool roots_failed{};
                [[maybe_unused]] auto retain_argument = [&](auto&& argument)
                {
                    const std::size_t index{ root_index++ };
                    auto& root{ native_argument_roots[index] };
                    bool required{};
                    if (index < this->native_constructor_arguments.size())
                    { root = this->native_constructor_arguments[index]; }
                    else { root = retain_native_argument(argument, required); }
                    if (required && !root) { roots_failed = true; }
                    if (root && !root->valid()) { roots_failed = true; }
                };
                (retain_argument(args), ...);
                if (roots_failed) { return value_t{ std::monostate{} }; }
            }

            // Per-argument JVM descriptor letters of the CALLEE, which is what
            // decides the slot layout (see parse_parameter_descriptors).  A
            // malformed / unavailable descriptor yields a count of 0 and the
            // packer falls back to sizing slots off the C++ argument type.
            char        param_descriptors[max_param_slots]{};
            const std::size_t param_descriptor_count{
                vmhook::detail::parse_parameter_descriptors(selected_signature,
                                                            param_descriptors,
                                                            max_param_slots) };
            std::size_t argument_index{ 0 };
            std::size_t argument_descriptor_position{ selected_signature.find('(') + 1 };
            const auto argument_descriptor_end{ selected_signature.find(')') };

            // The SELECTED overload controls the receiver slot. Its readable
            // ACC_STATIC bit was checked above; using the proxy's initial method
            // would mis-pack mixed static/instance overloads sharing a name.
            if (!selected_static)
            {
                params[param_idx++] = reinterpret_cast<std::intptr_t>(this->object);
            }

            // [[maybe_unused]]: with zero call arguments the fold below
            // `(pack(args), ...)` expands to nothing, so `pack` is legitimately
            // never invoked — silence -Wunused-but-set-variable on that path.
            [[maybe_unused]] bool packing_failed{ false };
            [[maybe_unused]] auto pack = [&](auto&& a)
                {
                    if (packing_failed) { return; }
                    using clean_t = std::remove_cvref_t<decltype(a)>;

                    // The callee's descriptor letter for THIS argument ('\0' when
                    // the descriptor could not be parsed).
                    const char descriptor{
                        argument_index < param_descriptor_count
                            ? param_descriptors[argument_index]
                            : '\0' };
                    const std::size_t native_root_index{ argument_index++ };
                    const auto full_descriptor{ next_argument_descriptor(selected_signature,
                        argument_descriptor_position, argument_descriptor_end) };

                    // Two slots for J / D, value in the HIGH slot.  With no
                    // descriptor, fall back to the C++ type: an 8-byte arithmetic
                    // argument is a long or a double.
                    const bool two_slots{
                        descriptor == 'J' || descriptor == 'D'
                        || (descriptor == '\0' && std::is_arithmetic_v<clean_t> && sizeof(clean_t) == 8) };

                    if (param_idx + (two_slots ? 2u : 1u) > max_param_slots)
                    {
                        packing_failed = true;
                        return;
                    }
                    if constexpr (std::is_same_v<clean_t, std::string>)
                    {
                        void* const string_oop{ this->pack_string(a, native_call,
                            native_argument_roots[native_root_index]) };
                        if (!string_oop)
                        {
                            ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): failed to allocate Java String argument.", vmhook::error_tag, this->name(), selected_signature);
                            packing_failed = true;
                            return;
                        }
                        params[param_idx++] = reinterpret_cast<std::intptr_t>(string_oop);
                    }
                    else if constexpr (std::is_same_v<clean_t, std::string_view>)
                    {
                        void* const string_oop{ this->pack_string(a, native_call,
                            native_argument_roots[native_root_index]) };
                        if (!string_oop)
                        {
                            ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): failed to allocate Java String argument.", vmhook::error_tag, this->name(), selected_signature);
                            packing_failed = true;
                            return;
                        }
                        params[param_idx++] = reinterpret_cast<std::intptr_t>(string_oop);
                    }
                    else if constexpr (std::is_same_v<clean_t, const char*> || std::is_same_v<clean_t, char*>)
                    {
                        void* const string_oop{ this->pack_string(a ? std::string_view{ a } : std::string_view{},
                            native_call, native_argument_roots[native_root_index]) };
                        if (!string_oop)
                        {
                            ::vmhook::detail::log_line("{} method_proxy::call('{}{}'): failed to allocate Java String argument.", vmhook::error_tag, this->name(), selected_signature);
                            packing_failed = true;
                            return;
                        }
                        params[param_idx++] = reinterpret_cast<std::intptr_t>(string_oop);
                    }
                    else if constexpr (std::is_array_v<clean_t>
                                       && std::is_same_v<std::remove_cv_t<std::remove_extent_t<clean_t>>, char>)
                    {
                        constexpr std::size_t extent{ std::extent_v<clean_t> };
                        const std::size_t length{ extent != 0 && a[extent - 1] == '\0' ? extent - 1 : extent };
                        void* const string_oop{ this->pack_string(std::string_view{ a, length },
                            native_call, native_argument_roots[native_root_index]) };
                        if (!string_oop) { packing_failed = true; return; }
                        params[param_idx++] = reinterpret_cast<std::intptr_t>(string_oop);
                    }
                    else if constexpr (vmhook::detail::is_java_object_pointer_v<clean_t>)
                    {
                        vmhook::detail::require_object_argument(a);
                        using wrapper_type = typename vmhook::detail::is_unique_ptr<clean_t>::value_type_t;
                        void* const address{ a->get_instance() };
                        if (address) { vmhook::detail::require_object_wrapper_type<wrapper_type>(address); }
                        vmhook::detail::require_reference_argument(address, full_descriptor, selected_holder);
                        argument_owners[param_idx] = &a->instance;
                        params[param_idx++] = reinterpret_cast<std::intptr_t>(a->get_instance());
                    }
                    else
                    {
                        static_assert(sizeof(clean_t) <= 8);
                        std::intptr_t v{};
                        if (two_slots)
                        {
                            // Widen to the JVM's 64-bit slot value FIRST, so an
                            // `int` handed to a `J` parameter (or a `float` handed
                            // to a `D`) reaches the interpreter as the value the
                            // descriptor declares rather than as half of one.
                            if (descriptor == 'D')
                            {
                                double d{};
                                if constexpr (std::is_arithmetic_v<clean_t>)
                                {
                                    d = static_cast<double>(a);
                                }
                                else
                                {
                                    std::memcpy(&d, &a, sizeof(clean_t));
                                }
                                std::memcpy(&v, &d, sizeof(v));
                            }
                            else
                            {
                                std::int64_t l{};
                                if constexpr (std::is_integral_v<clean_t>)
                                {
                                    l = static_cast<std::int64_t>(a);
                                }
                                else
                                {
                                    std::memcpy(&l, &a, sizeof(clean_t));
                                }
                                std::memcpy(&v, &l, sizeof(v));
                            }
                            params[param_idx++] = 0;   // low slot: ignored by the interpreter
                            params[param_idx++] = v;   // HIGH slot carries the value
                        }
                        else
                        {
                            if constexpr (std::is_integral_v<clean_t>)
                            {
                                // JVM B/S parameters occupy int slots and must
                                // be sign-extended. A one-byte memcpy of -12
                                // instead supplies +244 to Java bytecode.
                                switch (descriptor)
                                {
                                case 'Z': v = static_cast<bool>(a) ? 1 : 0; break;
                                case 'B': v = static_cast<std::int8_t>(a); break;
                                case 'S': v = static_cast<std::int16_t>(a); break;
                                case 'C': v = static_cast<std::uint16_t>(a); break;
                                case 'I': v = static_cast<std::int32_t>(a); break;
                                default: std::memcpy(&v, &a, sizeof(clean_t)); break;
                                }
                            }
                            else { std::memcpy(&v, &a, sizeof(clean_t)); }
                            params[param_idx++] = v;
                        }
                    }
                };
            // The receiver and Java long/double values count against the JVM's
            // 255-slot descriptor limit. The descriptor-aware pack guard above
            // rejects invalid slot geometry without dropping any argument.
            static_assert(sizeof...(args_t) <= max_param_slots,
                          "method_proxy::call: JVM methods allow at most 255 parameter slots");
            (pack(std::forward<args_t>(args)), ...);
            if (packing_failed) { return value_t{ std::monostate{} }; }

            if (native_call)
            {
                std::size_t slot{ selected_static ? 0u : 1u };
                if (!selected_static) { params[0] = reinterpret_cast<std::intptr_t>(
                    this->native_receiver_root->resolve_under_vm()); }
                for (std::size_t index{ 0 }; index < sizeof...(args_t); ++index)
                {
                    if (native_argument_roots[index])
                    { params[slot] = reinterpret_cast<std::intptr_t>(native_argument_roots[index]->resolve_under_vm()); }
                    slot += param_descriptors[index] == 'J' || param_descriptors[index] == 'D' ? 2u : 1u;
                }
            }

            auto* const invocation_method{ native_call
                ? this->current_native_signature(this->method_name, selected_signature, selected_holder,
                    !selected_static && !selected_private && this->method_name != "<init>") : selected_method };
            return this->invoke_packed(invocation_method, selected_signature, params, param_idx,
                                       argument_owners.data());
        }

    public:
        auto set_metadata_lifetime(std::shared_ptr<void> lifetime) noexcept -> void
        {
            this->metadata_lifetime_ = std::move(lifetime);
            if (this->metadata_lifetime_ && !this->native_declaring_class)
            { this->native_declaring_class = declaring_class(this->method); }
        }

        /*
            @brief Returns the method name.
        */
        auto name() const
            -> std::string
        {
            if (!this->method_name.empty()) { return this->method_name; }
            if (!this->method)
            {
                return {};
            }
            return this->method->get_name();
        }

        /*
            @brief Returns the JVM method signature.
        */
        auto signature() const noexcept
            -> std::string_view
        {
            return this->signature_text;
        }

        /*
            @brief Returns true if this method is a static Java method.
            @details
            Static methods do not receive a 'this' pointer as the first argument.
            Report the JVM truth directly: read JVM_ACC_STATIC (0x0008) from the
            live Method's _access_flags.  The static bit lives in the low byte
            and is stable across every supported JDK, so reading the flags word
            as u4 and masking 0x0008 is width-independent.  Returns false if the
            access-flags slot can't be resolved (no VMStructs / no JVM) — the
            proxy carries no other static signal.

            Native contexts re-resolve the method under a VM guard and refuse
            expired or foreign-context proxies.
            Complexity: O(N) in a native context; O(1) for a legacy proxy.
            Exception safety: metadata strings may propagate std::bad_alloc.
        */
        auto is_static() const
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            if ((this->native_class_root || this->native_receiver_root)
                && (!access || !this->refresh_native_method())) { return false; }
            if (this->method)
            {
                // Read JVM memory through the Windows memory API and stop on unreadable data.
                // A successful read does not establish object lifetime or a coherent VM snapshot.
                bool found{ false };
                return this->method->safe_access_flags_test(0x0008u, found);
            }
            return false;
        }

        /*
            @brief Returns true if this method's return type is a reference / array (L or [).
            @details
            Mirrors field_proxy::is_reference() so callers using the method-vs-field
            parity helpers (raw_method / raw_address / get_compressed_oop) can branch
            on "is this an object?" without parsing the descriptor by hand.  Reads the
            character that follows the closing ')' of the signature.

            Complexity: O(1).
            Exception safety: noexcept — returns false on a malformed/empty signature.
        */
        auto is_reference() const noexcept
            -> bool
        {
            const auto close{ this->signature_text.find(')') };
            if (close == std::string::npos || close + 1 >= this->signature_text.size())
            {
                return false;
            }
            const char ret{ this->signature_text[close + 1] };
            return ret == 'L' || ret == '[';
        }

        /*
            @brief Returns the compressed OOP of the receiver object.
            @details
            Encodes the decoded receiver address using this VM's compression
            base and shift. The object's header contains a mark word, not its
            compressed reference, and must never be read for this operation.

            Complexity: O(1).
            Exception safety: noexcept — returns 0 if object is null.
        */
        auto get_compressed_oop() const noexcept
            -> std::uint32_t
        {
            vmhook::detail::native_backend::operation access{};
            void* const receiver{ this->native_receiver_root
                ? (access && this->native_receiver_root->valid()
                    ? this->native_receiver_root->resolve_under_vm() : nullptr)
                : this->object };
            return vmhook::hotspot::encode_oop_pointer(receiver);
        }

        /*
            @brief Returns the underlying HotSpot Method* (for advanced consumers).
            @details
            Mirror of field_proxy::raw_address for read-only metadata inspection.
            Most code should prefer call() / hook<T>().

            Native contexts return the current metadata snapshot or nullptr for
            an expired/foreign proxy. Hold a native_backend::operation while
            dereferencing it; this accessor does not extend that guard's lifetime.

            Complexity: O(N) in a native context; O(1) for a legacy proxy.
            Exception safety: noexcept.

            @return The HotSpot Method*, or nullptr if the proxy holds no method
                    (e.g. constructed with a null method pointer).
        */
        auto raw_method() const
            -> vmhook::hotspot::method*
        {
            vmhook::detail::native_backend::operation access{};
            if ((this->native_class_root || this->native_receiver_root)
                && (!access || !this->refresh_native_method())) { return nullptr; }
            return this->method;
        }

    private:
        static auto declaring_class(vmhook::hotspot::method* const method) noexcept
            -> vmhook::hotspot::klass*
        {
            const auto* const const_method{ method ? method->get_const_method() : nullptr };
            const auto* const constants{ const_method ? const_method->get_constants() : nullptr };
            const auto* const entry{ vmhook::hotspot::iterate_struct_entries("ConstantPool", "_pool_holder") };
            return constants && entry ? const_cast<vmhook::hotspot::klass*>(
                static_cast<const vmhook::hotspot::klass*>(vmhook::hotspot::safe_read_pointer(
                    reinterpret_cast<const std::uint8_t*>(constants) + entry->offset))) : nullptr;
        }

        auto current_native_signature(const std::string_view name,
                                      const std::string_view signature,
                                      vmhook::hotspot::klass* const holder,
                                      const bool virtual_dispatch) const
            -> vmhook::hotspot::method*
        {
            auto* const receiver_class{ this->native_receiver_root
                ? vmhook::klass_from_oop(this->native_receiver_root->resolve_under_vm()) : nullptr };
            const auto search = [&](vmhook::hotspot::klass* start, const bool inherited)
                -> vmhook::hotspot::method*
            {
                for (auto* klass{ start }; klass; klass = inherited ? klass->get_super() : nullptr)
                {
                    auto** const methods{ klass->get_methods_ptr() };
                    const auto count{ klass->get_methods_count() };
                    if (!methods || count < 1 || count > 65535) { continue; }
                    for (std::int32_t index{ 0 }; index < count; ++index)
                    {
                        auto* const candidate{ methods[index] };
                        if (candidate && candidate->get_name() == name && candidate->get_signature() == signature)
                        { return candidate; }
                    }
                }
                return nullptr;
            };
            if (virtual_dispatch && receiver_class)
            {
                if (auto* const override_method{ search(receiver_class, true) }) { return override_method; }
                for (auto* klass{ receiver_class }; klass; klass = klass->get_super())
                {
                    std::int32_t count{};
                    auto** const defaults{ klass->get_default_methods_ptr(count) };
                    for (std::int32_t index{}; defaults && index < count; ++index)
                    {
                        auto* const candidate{ static_cast<vmhook::hotspot::method*>(const_cast<void*>(
                            vmhook::hotspot::safe_read_pointer(&defaults[index]))) };
                        if (!candidate || !vmhook::hotspot::is_valid_pointer(candidate)
                            || candidate->get_name() != name || candidate->get_signature() != signature)
                        { continue; }
                        bool readable{};
                        const bool excluded{ candidate->safe_access_flags_test(0x040Au, readable) };
                        return readable && !excluded ? candidate : nullptr;
                    }
                }
            }
            // Private methods, static methods and constructors retain their
            // declaring holder; virtual defaults use HotSpot's selected methods.
            return search(holder ? holder : this->native_declaring_class, false);
        }

        auto current_native_method(vmhook::hotspot::method* const candidate) const -> bool
        {
            for (auto* klass{ this->native_declaring_class }; klass; klass = klass->get_super())
            {
                auto** const methods{ klass->get_methods_ptr() };
                const auto count{ klass->get_methods_count() };
                if (!methods || count < 1 || count > 65535) { continue; }
                for (std::int32_t index{ 0 }; index < count; ++index)
                { if (methods[index] == candidate) { return true; } }
            }
            return false;
        }

        // Re-resolve the selected metadata while the declaring class mirror is
        // rooted. A cached Method* may have become obsolete after redefinition.
        auto refresh_native_method() const -> bool
        {
            auto local_root{this->native_class_root};
            if (!local_root && this->metadata_lifetime_ && this->native_declaring_class)
            { local_root = vmhook::detail::native_backend::retain_class(this->native_declaring_class); }
            if (!local_root || !local_root->valid()
                || !local_root->resolve_under_vm() || !this->native_declaring_class)
            { return false; }
            if (this->native_receiver_root)
            {
                if (!this->native_receiver_root->valid()) { return false; }
                this->object = this->native_receiver_root->resolve_under_vm();
                if (this->receiver_slot) { *this->receiver_slot = this->object; }
            }
            for (auto* klass{ this->native_declaring_class }; klass; klass = klass->get_super())
            {
                auto** const methods{ klass->get_methods_ptr() };
                const auto count{ klass->get_methods_count() };
                if (!methods || count < 1 || count > 65535) { continue; }
                for (std::int32_t index{ 0 }; index < count; ++index)
                {
                    auto* const candidate{ methods[index] };
                    if (!candidate || !vmhook::hotspot::is_valid_pointer(candidate)
                        || candidate->get_name() != this->method_name
                        || candidate->get_signature() != this->signature_text) { continue; }
                    bool readable{};
                    const bool static_kind{ candidate->safe_access_flags_test(0x0008u, readable) };
                    if (!readable || (!static_kind && !this->native_receiver_root)) { return false; }
                    this->method = candidate;
                    return this->callable_candidate(candidate);
                }
            }
            return false;
        }

        template<typename argument_type>
        static auto retain_native_argument(argument_type&& argument, bool& required)
            -> vmhook::detail::native_backend::root
        {
            using clean_type = std::remove_cvref_t<argument_type>;
            void* oop{};
            vmhook::detail::native_backend::root existing{};
            if constexpr (vmhook::detail::is_java_object_pointer_v<clean_type>)
            {
                vmhook::detail::require_object_argument(argument);
                existing = argument->get_native_root();
                oop = argument->get_instance();
            }
            if (existing)
            {
                required = true;
                return existing->valid() ? existing : vmhook::detail::native_backend::root{};
            }
            required = oop != nullptr;
            return oop ? vmhook::detail::native_backend::retain_oop(oop)
                       : vmhook::detail::native_backend::root{};
        }

        static auto pack_string(const std::string_view value, const bool native_call,
                                vmhook::detail::native_backend::root& root) -> void*
        {
            if (!native_call) { return vmhook::make_java_string(value); }
            root = vmhook::detail::native_backend::make_string(value);
            return root ? root->resolve_under_vm() : nullptr;
        }

        auto invoke_native_packed(vmhook::hotspot::method* const selected_method,
                                  const std::string_view signature,
                                  std::intptr_t* const params, const std::size_t count,
                                  void** const* const argument_owners) const -> value_t
        {
            const auto result{ vmhook::detail::native_backend::invoke_packed(
                selected_method, signature, params, count, this->receiver_slot, argument_owners) };
            if (!result.invoked && !result.threw)
            {
                value_t refused{};
                refused.failure_message = result.error;
                return refused;
            }
            void* const receiver{ result.receiver ? result.receiver->resolve_under_vm() : nullptr };
            if (result.receiver)
            {
                this->object = receiver;
                if (this->receiver_slot) { *this->receiver_slot = receiver; }
            }
            const auto close{ signature.rfind(')') };
            const char type{ close != std::string_view::npos && close + 1 < signature.size()
                ? signature[close + 1] : 'V' };
            const auto bits{ result.threw ? std::uint64_t{} : result.bits };
            value_t converted{};
            switch (type)
            {
            case 'Z': converted.data = (bits & 1u) != 0; break;
            case 'B': converted.data = static_cast<std::int8_t>(bits); break;
            case 'S': converted.data = static_cast<std::int16_t>(bits); break;
            case 'I': converted.data = static_cast<std::int32_t>(bits); break;
            case 'J': converted.data = static_cast<std::int64_t>(bits); break;
            case 'C': converted.data = static_cast<std::uint16_t>(bits); break;
            case 'F':
            {
                const std::uint32_t narrowed{ static_cast<std::uint32_t>(bits) };
                float value{}; std::memcpy(&value, &narrowed, sizeof(value));
                converted.data = value; break;
            }
            case 'D':
            {
                double value{}; std::memcpy(&value, &bits, sizeof(value));
                converted.data = value; break;
            }
            case 'L':
            case '[':
                converted = value_t::completed_native_reference(result);
                converted.string_result = signature.substr(close + 1) == "Ljava/lang/String;";
                break;
            default: break;
            }
            converted.invoked = result.invoked;
            converted.reference_result = type == 'L' || type == '[';
            converted.reference_array_result = type == '[';
            converted.primitive_array_result = type == '[' && close + 2 < signature.size()
                && signature[close + 2] != 'L' && signature[close + 2] != '[';
            converted.result_failed = converted.result_failed || !result.error.empty();
            converted.receiver_address = receiver;
            converted.native_receiver_root = result.receiver;
            converted.exception_thrown = result.threw;
            converted.exception_class = result.exception_class;
            converted.native_exception_root = result.exception;
            converted.failure_message = result.error;
            return converted;
        }

        /* @brief Rejects abstract/unreadable methods and absent instance receivers. */
        auto callable_candidate(vmhook::hotspot::method* const candidate) const noexcept -> bool
        {
            if (!candidate || !vmhook::hotspot::is_valid_pointer(candidate))
            {
                return false;
            }
            bool readable{ false };
            const bool static_kind{ candidate->safe_access_flags_test(0x0008u, readable) };
            if (!readable || (!static_kind && !this->object))
            {
                return false;
            }
            const bool abstract_kind{ candidate->safe_access_flags_test(0x0400u, readable) };
            return readable && !abstract_kind;
        }

        /*
            @brief Resolves an object's runtime Klass from verified header metadata.
            @details Delegates to klass_from_oop(), which detects ordinary oopDesc
            slots or supported compact mark-word states and the appropriate Klass
            codec. No fixed compressed-slot offset is assumed. Unknown or unreadable
            layouts return nullptr. The read does not root or pin the object.
            @param oop Full-width Java object address.
        */
        static auto klass_from_object_header(void* const oop) noexcept
            -> vmhook::hotspot::klass*
        {
            return vmhook::klass_from_oop(oop);
        }

        /*
            @brief Tests whether a C++ argument type is compatible with a JVM parameter descriptor.
            @details
            Compile-time dispatch based on argument_type:
              - string types         -> descriptor == "Ljava/lang/String;"
              - unique_ptr<T extends object_base> -> 'L' class descriptor matching T's registered name
              - object_base derived  -> same as unique_ptr case
              - bool                 -> "Z"
              - integral 1-byte      -> "B" or "Z"
              - integral 2-byte      -> "S" or "C"
              - integral 4-byte      -> "I"
              - integral 8-byte      -> "J"
              - float                -> "F"
              - double               -> "D"
              - other                -> false

            Used by signature_matches_arguments() to select the correct overloaded method.

            Complexity: O(1) — compile-time trait dispatch.
            Exception safety: metadata strings may propagate std::bad_alloc.

            @tparam argument_type  The C++ argument type to test.
            @param descriptor      One JVM type descriptor token from a method signature.
            @return  true if argument_type is compatible with descriptor.
        */
        template<typename argument_type>
        static auto argument_matches_descriptor(const std::string_view descriptor,
                                                const bool allow_reference_upcasts = false)
            -> bool
        {
            using clean_type = std::remove_cvref_t<argument_type>;

            if constexpr (std::is_same_v<clean_type, std::string> || std::is_same_v<clean_type, std::string_view>
                          || std::is_same_v<clean_type, const char*> || std::is_same_v<clean_type, char*>
                          || (std::is_array_v<clean_type>
                              && std::is_same_v<std::remove_cv_t<std::remove_extent_t<clean_type>>, char>))
            {
                return descriptor == "Ljava/lang/String;"
                    || (allow_reference_upcasts && descriptor.size() >= 3
                        && descriptor.front() == 'L' && descriptor.back() == ';');
            }
            else if constexpr (vmhook::detail::is_borrowed_v<clean_type>
                               || vmhook::detail::is_ref_v<clean_type>)
            {
                using wrapper_type = typename decltype([]
                {
                    if constexpr (vmhook::detail::is_borrowed_v<clean_type>)
                    {
                        return std::type_identity<typename vmhook::detail::is_borrowed<clean_type>::value_type_t>{};
                    }
                    else
                    {
                        return std::type_identity<typename vmhook::detail::is_ref<clean_type>::value_type_t>{};
                    }
                }())::type;
                if (allow_reference_upcasts)
                {
                    return !descriptor.empty() && (descriptor.front() == 'L' || descriptor.front() == '[');
                }
                const std::string registered{ vmhook::detail::registered_class_name<wrapper_type>() };
                return descriptor.size() >= 3 && descriptor.front() == 'L' && descriptor.back() == ';'
                    && (registered.empty()
                        || descriptor.substr(1, descriptor.size() - 2) == registered);
            }
            else if constexpr (std::is_same_v<clean_type, std::nullptr_t>
                               || std::is_same_v<clean_type, void*>)
            {
                return !descriptor.empty() && (descriptor.front() == 'L' || descriptor.front() == '[');
            }
            else if constexpr (vmhook::detail::is_unique_ptr_v<clean_type>)
            {
                using wrapper_type = typename vmhook::detail::is_unique_ptr<clean_type>::value_type_t;
                if constexpr (std::is_base_of_v<vmhook::object_base, wrapper_type>)
                {
                    if (allow_reference_upcasts)
                    {
                        return !descriptor.empty() && (descriptor.front() == 'L' || descriptor.front() == '[');
                    }
                    const std::string registered{ vmhook::detail::registered_class_name<wrapper_type>() };
                    return descriptor.size() >= 3
                        && descriptor.front() == 'L'
                        && descriptor.back() == ';'
                        && (registered.empty() || descriptor.substr(1, descriptor.size() - 2) == registered);
                }
                else
                {
                    return false;
                }
            }
            else if constexpr (std::is_base_of_v<vmhook::object_base, clean_type>)
            {
                if (allow_reference_upcasts)
                {
                    return !descriptor.empty() && (descriptor.front() == 'L' || descriptor.front() == '[');
                }
                const std::string registered{ vmhook::detail::registered_class_name<clean_type>() };
                return descriptor.size() >= 3
                    && descriptor.front() == 'L'
                    && descriptor.back() == ';'
                    && (registered.empty() || descriptor.substr(1, descriptor.size() - 2) == registered);
            }
            else if constexpr (std::is_same_v<clean_type, bool>)
            {
                return descriptor == "Z";
            }
            // Java `char` is always 2 bytes wide and unsigned (UTF-16 code unit);
            // map `char16_t` and `std::uint16_t` to "C" specifically.  This used
            // to be folded into the generic 2-byte branch alongside "S", which
            // meant a `uint16_t` argument matched BOTH the `S` and `C`
            // descriptors — recreating the same first-match-wins overload
            // resolution bug that bit vanilla Minecraft 1.8.9
            // EntityPlayerSP::a() before commit 1a536b7 fixed it on the
            // dispatch side.
            else if constexpr (std::is_same_v<clean_type, char16_t> || std::is_same_v<clean_type, std::uint16_t>)
            {
                return descriptor == "C";
            }
            // Java `byte` is signed 8-bit; map `int8_t` / `uint8_t` /
            // `(un)signed char` to "B" only (NOT "Z" — that's the boolean
            // descriptor and `bool` is the only C++ type allowed to match it).
            else if constexpr (std::is_integral_v<clean_type> && sizeof(clean_type) == 1)
            {
                return descriptor == "B";
            }
            // Java `short` is signed 16-bit; signed 2-byte types map to "S"
            // only (the unsigned 2-byte branch above already claimed "C").
            else if constexpr (std::is_integral_v<clean_type> && sizeof(clean_type) == 2)
            {
                return descriptor == "S";
            }
            else if constexpr (std::is_integral_v<clean_type> && sizeof(clean_type) == 4)
            {
                return descriptor == "I";
            }
            else if constexpr (std::is_integral_v<clean_type> && sizeof(clean_type) == 8)
            {
                return descriptor == "J";
            }
            else if constexpr (std::is_same_v<clean_type, float>)
            {
                return descriptor == "F";
            }
            else if constexpr (std::is_same_v<clean_type, double>)
            {
                return descriptor == "D";
            }
            else
            {
                return false;
            }
        }

        /*
            @brief Extracts the next descriptor token from a JVM method signature.
            @details
            Advances position past any leading array brackets, then past the full
            type descriptor (a single letter for primitives, or 'L...;' for objects).
            Returns the full descriptor including leading '[' array dimensions.
            Returns an empty string_view when the parse is complete or position reaches
            close_paren.

            Complexity: O(D) where D = descriptor token length.
            Exception safety: noexcept.

            @param signature    Full JVM method signature (e.g. "(ILjava/lang/String;)V").
            @param position     Current parse position; advanced in-place past the token.
            @param close_paren  Index of the closing ')' character.
            @return  The next descriptor token, or empty on end-of-parameters.
        */
        static auto next_argument_descriptor(const std::string_view signature, std::size_t& position, const std::size_t close_paren) noexcept
            -> std::string_view
        {
            const std::size_t start{ position };
            while (position < close_paren && signature[position] == '[')
            {
                ++position;
            }

            if (position >= close_paren)
            {
                return {};
            }

            if (signature[position] == 'L')
            {
                const std::size_t semicolon{ signature.find(';', position) };
                if (semicolon == std::string_view::npos || semicolon > close_paren)
                {
                    return {};
                }
                position = semicolon + 1;
                return signature.substr(start, position - start);
            }

            ++position;
            return signature.substr(start, position - start);
        }

        /*
            @brief Returns true if the parameter list of signature is compatible with args_t.
            @details
            Parses the JVM method signature from the opening '(' to the closing ')',
            calling next_argument_descriptor() + argument_matches_descriptor<arg>() for
            each argument in the pack.  Returns true only if all arguments match and there
            are no leftover descriptor tokens.

            Complexity: O(P) where P = number of parameters.
            Exception safety: metadata strings may propagate std::bad_alloc.

            @tparam args_t  C++ argument types to test against the signature.
            @param signature  Full JVM method signature.
            @return  true if args_t are all compatible with signature's parameter list.
        */
        template<typename... args_t>
        static auto signature_matches_arguments(const std::string_view signature,
                                                [[maybe_unused]] const bool allow_reference_upcasts = false)
            -> bool
        {
            const std::size_t open_paren{ signature.find('(') };
            const std::size_t close_paren{ signature.find(')') };
            if (open_paren == std::string_view::npos || close_paren == std::string_view::npos || close_paren < open_paren)
            {
                return false;
            }

            std::size_t position{ open_paren + 1 };
            bool matches{ true };
            ([&]
                {
                    if (!matches)
                    {
                        return;
                    }
                    const std::string_view descriptor{ next_argument_descriptor(signature, position, close_paren) };
                    matches = !descriptor.empty()
                        && argument_matches_descriptor<args_t>(descriptor, allow_reference_upcasts);
                }(), ...);

            return matches && position == close_paren;
        }

        /*
            @brief Finds the Method* whose signature best matches the given C++ argument types.
            @details
            First tests whether this->signature_text already matches args_t using
            signature_matches_arguments().  If so, returns this->method directly.
            Otherwise walks the runtime klass hierarchy (obtained from the object header),
            and checks every method with the same name for a matching signature.  Returns
            the first callable match, or nullptr when no compatible overload exists.

            This allows a single get_method("foo") result to handle overloaded Java methods
            when the call site provides typed arguments.

            Complexity: O(N * M) where N = number of methods in the class hierarchy,
                        M = signature parse cost per method.
            Exception safety: rejects unreadable or incompatible metadata; string allocation may propagate std::bad_alloc.

            @tparam args_t  C++ argument types from the call<>() invocation.
            @return The compatible Method*, or nullptr on failure.
        */
        template<typename... args_t>
        auto resolve_compatible_method() const
            -> vmhook::hotspot::method*
        {
            // Pinned descriptors identify one overload. Validate argument count
            // and primitive slot kinds, while allowing the caller's explicit
            // reference upcast (String -> CharSequence, a wrapper -> an interface).
            // Never replace a pinned descriptor with a different overload.
            if (this->signature_pinned)
            {
                return this->callable_candidate(this->method)
                    && signature_matches_arguments<args_t...>(this->signature_text, true)
                    ? this->method : nullptr;
            }

            if (this->callable_candidate(this->method)
                && signature_matches_arguments<args_t...>(this->signature_text))
            {
                return this->method;
            }

            // Instance overload selection starts from the receiver's runtime class.
            // Static selection uses the selected Method's ConstantPool holder.
            // Both hierarchy walks require a callable candidate whose descriptor
            // matches the supplied argument types; arbitrary fallback is refused.
            vmhook::hotspot::klass* resolved_klass{
                this->object ? klass_from_object_header(this->object) : nullptr };
            if (!resolved_klass && !this->object && this->method)
            {
                if (auto* const cm{ this->method->get_const_method() };
                    cm && vmhook::hotspot::is_valid_pointer(cm))
                {
                    if (auto* const cp{ cm->get_constants() };
                        cp && vmhook::hotspot::is_valid_pointer(cp))
                    {
                        const auto* const pool_holder_entry{
                            vmhook::hotspot::iterate_struct_entries("ConstantPool", "_pool_holder") };
                        if (pool_holder_entry)
                        {
                            // Read JVM memory through the Windows memory API and stop on unreadable data.
                            // A successful read does not establish object lifetime or a coherent VM snapshot.
                            auto* const holder{ reinterpret_cast<vmhook::hotspot::klass*>(
                                vmhook::hotspot::cold_read_metadata_pointer(
                                    reinterpret_cast<const std::uint8_t*>(cp) + pool_holder_entry->offset)) };
                            if (holder && vmhook::hotspot::is_valid_pointer(holder))
                            {
                                resolved_klass = holder;
                            }
                        }
                    }
                }
            }
            if (!resolved_klass)
            {
                return nullptr;
            }

            const std::string method_name{ this->name() };
            for (vmhook::hotspot::klass* k{ resolved_klass }; k != nullptr; k = k->get_super())
            {
                // Constructors belong only to their declaring class. A missing
                // overload must not silently call a superclass constructor on
                // the newly allocated instance.
                if (method_name == "<init>" && k != resolved_klass) { break; }
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };
                if (!methods_array || method_count <= 0)
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    vmhook::hotspot::method* const current_method{ methods_array[method_index] };
                    if (!this->callable_candidate(current_method) || current_method->get_name() != method_name)
                    {
                        continue;
                    }

                    const std::string current_signature{ current_method->get_signature() };
                    if (signature_matches_arguments<args_t...>(current_signature))
                    {
                        return current_method;
                    }
                }
            }

            for (auto* k{ resolved_klass }; k; k = k->get_super())
            {
                std::int32_t count{};
                auto** const defaults{ k->get_default_methods_ptr(count) };
                for (std::int32_t index{}; defaults && index < count; ++index)
                {
                    auto* const candidate{ static_cast<vmhook::hotspot::method*>(const_cast<void*>(
                        vmhook::hotspot::safe_read_pointer(&defaults[index]))) };
                    if (this->callable_candidate(candidate) && candidate->get_name() == method_name
                        && signature_matches_arguments<args_t...>(candidate->get_signature()))
                    { return candidate; }
                }
            }

            // A mismatched fallback can put a primitive in a reference slot or
            // omit a receiver. Refuse rather than invoking an arbitrary overload.
            return nullptr;
        }

        mutable void* object;
        mutable vmhook::hotspot::method* method;
        std::string signature_text;
        std::string method_name{};
        // True when this proxy was created via get_method(name, SIGNATURE) /
        // get_method(name, SIGNATURE): the caller pinned an EXACT overload, so
        // resolve_compatible_method() must NOT re-pick a different overload from
        // the C++ argument types (which would silently dispatch e.g. combo(String)
        // for an explicit combo(CharSequence) request).  Name-only proxies leave
        // it false so their arg-driven overload resolution keeps working.
        bool        signature_pinned{ false };
        // Instance lookup borrows this slot from its C++ wrapper. The proxy must
        // not outlive that wrapper. JavaCallWrapper roots only the active call;
        // updating this slot tracks its receiver's relocation during that call.
        void** receiver_slot{ nullptr };
        vmhook::detail::native_backend::root native_receiver_root{};
        vmhook::detail::native_backend::root native_class_root{};
        vmhook::hotspot::klass* native_declaring_class{};
        std::span<const vmhook::detail::native_backend::root> native_constructor_arguments{};

        template<typename wrapper_type, typename... args_t>
            requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
                && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
                && (vmhook::detail::supported_java_argument_v<args_t> && ...))
        friend auto make_unique(args_t&&... args) -> std::unique_ptr<wrapper_type>;
        std::shared_ptr<void> metadata_lifetime_{};

        template<typename wrapper_type, typename... args_t>
            requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
                && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
                && (vmhook::detail::supported_java_argument_v<args_t> && ...))
        friend auto make_unique_with_descriptor(const std::string_view constructor_signature,
                                                args_t&&... args) -> std::unique_ptr<wrapper_type>;
    };

    // --- Object base class ----------------------------------------------------

    /*
        @brief Alias for a decoded non-owning Java heap object address.
        @details No Java root is registered and relocation is not tracked by this
        pointer. Even inside a callback, later GC or slot mutation can invalidate
        an address unless a separate JVM lifetime context protects its use.
    */
    using oop_type_t = void*;

    /*
        @brief Short alias for oop_type_t, a decoded Java heap pointer.
        @details Used by trusted VM ABI operations and diagnostics. Public Java
        object arguments and hook receivers use std::unique_ptr wrappers.
    */
    using oop_t = oop_type_t;

    /*
        @brief Base of the Java object wrappers.
        @details Typed wrappers derive from object<derived>. get_field() and
        get_method() bind the instance through this specialization. Static
        wrappers use static_members and the registered Java class. Owning C++
        pointers own wrappers, while VM-scanned root tickets retain Java objects
        and refresh their addresses under a VM operation. Context tickets are
        confined to their context and OS thread; using an invalid ticket throws.
    */
    class object_base
    {
        friend class method_proxy;
    public:
        /*
            @brief Wraps a decoded Java object pointer.
            @param instance Decoded OOP from frame->get_arguments<vmhook::oop_type_t>().
                            May be nullptr if the Java reference is null.
        */
        explicit object_base(oop_type_t instance = nullptr) noexcept
            : instance{ instance }
        {
        }

        virtual ~object_base() = default;

        /*
            @brief Copies the address and shares an optional native-context root ticket.
            @details A raw-pointer wrapper remains non-owning. Copies of a rooted
            wrapper refer to the same VM-scanned slot and retain its context limits.
        */
        object_base(const object_base&) = default;

        /*
            @brief Copy assignment — copies the raw OOP pointer.
        */
        auto operator=(const object_base&)
            -> object_base & = default;

        /*
            @brief Move constructor — transfers the OOP pointer and nulls the source.
            @details
            After the move, the source instance is set to nullptr so that
            the moved-from object is safely destructible.
        */
        object_base(object_base&& other) noexcept
            : instance{ other.instance }, native_root_{ std::move(other.native_root_) }
        {
            other.instance = nullptr;
        }

        auto operator=(object_base&& other) noexcept
            -> object_base&
        {
            if (this != &other)
            {
                this->instance = other.instance;
                this->native_root_ = std::move(other.native_root_);
                other.instance = nullptr;
            }
            return *this;
        }

        /*
            @brief Returns the currently observed decoded OOP address.
            @details A rooted wrapper refreshes under a VM operation. The returned
            address is a snapshot and can move after this method returns to native
            state; use wrapper calls and fields to keep operations guarded.
        */
        auto get_instance() const
            -> oop_type_t
        {
            vmhook::detail::native_backend::operation access{};
            if (this->native_root_)
            {
                if (!access || !this->native_root_->valid())
                { throw vmhook::exception{ "Java object belongs to a closed or different thread context" }; }
                this->instance = this->native_root_->resolve_under_vm();
                if (!this->instance)
                { throw vmhook::exception{ "Retained Java object cannot be resolved in the current VM context" }; }
                vmhook::detail::track_callback_oop_snapshot(this->instance, this->native_root_);
            }
            return this->instance;
        }

        auto set_native_root(vmhook::detail::native_backend::root root) noexcept -> void
        {
            // Preserve the observed address. Checked get_instance resolves a
            // non-null ticket; invalid lifetimes never turn into Java null.
            this->native_root_ = std::move(root);
        }

        [[nodiscard]] auto get_native_root() const noexcept -> vmhook::detail::native_backend::root
        {
            return this->native_root_;
        }

        /* Test exact registered class identity, including Java interfaces.
           Checked type queries require a live context-scanned object root. */
        template<typename wrapper_type>
        [[nodiscard]] auto is() const -> bool
        {
            vmhook::detail::native_backend::operation access{};
            auto* const address{get_instance()};
            if (!address) { return false; }
            if (!access || !native_root_ || !native_root_->valid())
            { throw vmhook::exception{"A typed instance test requires a live VM-scanned object reference"}; }
            auto* const expected{vmhook::detail::registered_class_klass<wrapper_type>()};
            if (!expected) { throw vmhook::exception{"Typed instance test wrapper is not bound to a loaded Java class"}; }
            return vmhook::detail::container_class_assignable(vmhook::klass_from_oop(address), expected);
        }

        /*
            @brief Returns a field proxy for any field declared on this class.
            @param name Exact Java field name.
            @return Optional holding the field proxy, or nullopt on failure.
            @details
            Works for both instance and static fields.  The JVM_ACC_STATIC flag is
            read from InstanceKlass._fields so no static/instance distinction is
            needed at the call site.

            Instance fields:  value lives at decoded_object_ptr + field_offset.
            Static fields:    value lives at java.lang.Class mirror + field_offset.

            The klass is resolved from type_to_class_map via typeid(*this) (dynamic type),
            so the derived C++ class must have been registered with register_class<T>()
            before this is called.  Field entries are cached after the first lookup.

            @note Dereferencing a nullopt with -> is undefined behaviour.
                  In production code always check the optional, or assert field names
                  are correct at development time.
        */
        auto get_field(const std::string_view name) const
            -> std::optional<vmhook::field_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::hotspot::klass* const resolved_klass{ this->resolve_klass() };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}'): klass not resolved for this object - "
                           "wrapper type may not be registered, or class not loaded.",
                           vmhook::error_tag, name);
                return std::nullopt;
            }

            const auto entry{ vmhook::find_field(resolved_klass, name) };
            if (!entry)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}'): field not found in class hierarchy.",
                           vmhook::error_tag, name);
                return std::nullopt;
            }

            if (entry->is_static)
            {
                // Inherited static fields live on the DECLARING class's mirror,
                // whose offset basis differs from resolved_klass's mirror; using
                // the latter read/wrote garbage (and could fault past the end of
                // a subclass mirror).  find_field() records the declaring klass.
                vmhook::hotspot::klass* const mirror_klass{ entry->declaring_klass ? entry->declaring_klass : resolved_klass };
                void* const mirror{ mirror_klass->get_java_mirror() };
                if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
                {
                    ::vmhook::detail::log_line("{} object::get_field('{}') failed to get java.lang.Class mirror.", vmhook::error_tag, name);
                    return std::nullopt;
                }
                void* const field_pointer{ reinterpret_cast<std::uint8_t*>(mirror) + entry->offset };
                // Native contexts retain the declaring mirror; access reconstructs
                // the field address under a VM operation. Legacy access is observational.
                return vmhook::field_proxy{ field_pointer, entry->signature, true, mirror_klass, entry->offset, entry->access_flags };
            }

            if (!this->instance)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}') instance pointer is null.", vmhook::error_tag, name);
                return std::nullopt;
            }

            void* const field_pointer{ reinterpret_cast<std::uint8_t*>(this->instance) + entry->offset };
            return vmhook::field_proxy{ field_pointer, entry->signature, false,
                                        this->native_root_, entry->offset,
                                        entry->declaring_klass ? entry->declaring_klass : resolved_klass, entry->access_flags };
        }

        /*
            @brief Returns a field proxy for a static field identified by wrapper_type and name.
            @details
            Unlike the instance overload, this variant does not need a live OOP because
            static fields live on the java.lang.Class mirror rather than on an object.
            Fails with nullopt if the field is not static (caller should use the instance
            overload in that case).

            Complexity: O(F) on first call; O(1) after caching.
            Exception safety: may throw vmhook::exception internally but returns nullopt on failure.

            @param wrapper_type  std::type_index of the registered C++ wrapper class.
            @param name          Exact Java field name.
            @return  Optional field_proxy, or nullopt on failure.
        */
        static auto get_field(const std::type_index wrapper_type, const std::string_view name)
            -> std::optional<vmhook::field_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            const auto binding{vmhook::detail::registered_class_binding(wrapper_type)};
            vmhook::hotspot::klass* const resolved_klass{
                vmhook::detail::registered_class_klass(wrapper_type, binding) };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}') (static): klass not resolved for wrapper "
                           "type - register_class<T>() may be missing or class not loaded.",
                           vmhook::error_tag, name);
                return std::nullopt;
            }

            const auto entry{ vmhook::find_field(resolved_klass, name) };
            if (!entry)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}') (static): field not found in class "
                           "hierarchy.",
                           vmhook::error_tag, name);
                return std::nullopt;
            }

            if (!entry->is_static)
            {
                ::vmhook::detail::log_line("{} object::get_field('{}') needs an object instance.", vmhook::error_tag, name);
                return std::nullopt;
            }

            // Resolve the mirror of the klass that DECLARES the static, not the
            // wrapper's start klass: for an inherited static they are different
            // mirror oops and `entry->offset` only indexes the declaring one.
            vmhook::hotspot::klass* const mirror_klass{ entry->declaring_klass ? entry->declaring_klass : resolved_klass };
            void* const mirror{ mirror_klass->get_java_mirror() };
            if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
            {
                ::vmhook::detail::log_line("{} object::get_field('{}') failed to get java.lang.Class mirror.", vmhook::error_tag, name);
                return std::nullopt;
            }

            void* const field_pointer{ reinterpret_cast<std::uint8_t*>(mirror) + entry->offset };
            // Pass the declaring Klass and offset so access can read the mirror again.
            // The proxy keeps this exact defining class through rebind/unregister.
            auto proxy = vmhook::field_proxy{field_pointer, entry->signature, true, mirror_klass, entry->offset, entry->access_flags};
            proxy.set_metadata_lifetime(binding);
            return proxy;
        }

        /*
            @brief Legacy instance lookup by Java method name.
            @details Walks the runtime class hierarchy and returns an optional
            method proxy. Check the optional before dereferencing it. Wrapper
            methods can use get_method(name) for a checked lookup:
                auto say_hi() -> void { get_method("sayHi")->call(); }
                auto take_values(int a, const std::string& b) -> void {
                    get_method("takeValues")->call(a, b);
                }
        */
        /*
            @brief Rejects unreadable or abstract method candidates.
            @details Abstract methods have no invocable body for this backend.
            Lookup continues through the hierarchy for a callable candidate.
            A readable access-flags word is required; this check does not acquire
            a metadata lifetime guard against unloading or redefinition.
        */
        [[nodiscard]] static auto is_uncallable(vmhook::hotspot::method* const candidate) noexcept
            -> bool
        {
            constexpr std::uint32_t k_acc_abstract{ 0x0400u };
            bool readable{ false };
            const bool abstract{ candidate->safe_access_flags_test(k_acc_abstract, readable) };
            return !readable || abstract;
        }

        auto get_method(const std::string_view method_name) const
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::hotspot::klass* const resolved_klass{ this->resolve_klass() };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_method('{}'): klass not resolved for this object.",
                           vmhook::error_tag, method_name);
                return std::nullopt;
            }

            // Walk the superclass chain so inherited methods are found.
            for (vmhook::hotspot::klass* k{ resolved_klass }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };

                if (!methods_array || method_count <= 0)
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    vmhook::hotspot::method* const current_method{ methods_array[method_index] };
                    if (current_method && vmhook::hotspot::is_valid_pointer(current_method)
                        && current_method->get_name() == method_name
                        && !is_uncallable(current_method))
                    {
                        return vmhook::method_proxy{ this->instance, current_method, current_method->get_signature(),
                                                     false, &this->instance, this->native_root_ };
                    }
                }
            }

            // Superclass-chain miss: fall back to the IMPLEMENTED-INTERFACE chain so
            // an inherited interface DEFAULT method (declared on an interface, not on
            // this class or a superclass) is reachable through the concrete wrapper.
            // Crash-safe by construction (every VMStruct read is os::safe_read-guarded;
            // see find_interface_default_method) and fail-safe to the legacy "not
            // found" result on any JDK that does not export the interface VMStructs.
            if (vmhook::hotspot::method* const default_method{
                    find_interface_default_method(resolved_klass, method_name, std::string_view{}) })
            {
                return vmhook::method_proxy{ this->instance, default_method, default_method->get_signature(),
                                             false, &this->instance, this->native_root_ };
            }

            ::vmhook::detail::log_line("{} object::get_method('{}'): method not found in class hierarchy "
                       "(superclass chain) or implemented-interface default methods.",
                       vmhook::error_tag, method_name);
            return std::nullopt;
        }

        /*
            @brief Returns a method proxy for a method that matches both name and JVM signature.
            @details
            Walks the class hierarchy searching for a method whose name equals method_name
            and whose JVM descriptor equals method_signature.  Use this overload when the
            class has overloaded Java methods with the same name but different signatures.

            Complexity: O(N * M) where N = methods in the hierarchy, M = name comparison cost.
            Exception safety: does not throw; returns nullopt on failure.

            @param method_name       Exact Java method name.
            @param method_signature  JVM descriptor, e.g. "(I)Ljava/lang/String;".
            @return  Optional method_proxy, or nullopt if not found.
        */
        auto get_method(const std::string_view method_name, const std::string_view method_signature) const
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::hotspot::klass* const resolved_klass{ this->resolve_klass() };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_method('{}{}'): klass not resolved for this object.",
                           vmhook::error_tag, method_name, method_signature);
                return std::nullopt;
            }

            // Walk the superclass chain so inherited methods are found.
            for (vmhook::hotspot::klass* k{ resolved_klass }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };

                if (!methods_array || method_count <= 0)
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    vmhook::hotspot::method* const current_method{ methods_array[method_index] };
                    if (!current_method || !vmhook::hotspot::is_valid_pointer(current_method))
                    {
                        continue;
                    }

                    const std::string current_signature{ current_method->get_signature() };
                    if (current_method->get_name() == method_name && current_signature == method_signature
                        && !is_uncallable(current_method))
                    {
                        return vmhook::method_proxy{ this->instance, current_method, current_signature,
                                                     /*signature_pinned=*/true, &this->instance, this->native_root_ };
                    }
                }
            }

            // Superclass-chain miss: fall back to the IMPLEMENTED-INTERFACE chain for
            // an inherited interface DEFAULT method matching this exact name+signature.
            // Crash-safe (os::safe_read-guarded throughout) and fail-safe on JDKs
            // without the interface VMStructs (legacy "not found").
            if (vmhook::hotspot::method* const default_method{
                    find_interface_default_method(resolved_klass, method_name, method_signature) })
            {
                return vmhook::method_proxy{ this->instance, default_method, default_method->get_signature(),
                                             /*signature_pinned=*/true, &this->instance, this->native_root_ };
            }

            ::vmhook::detail::log_line("{} object::get_method('{}{}'): no method with this exact name+signature "
                       "found in class hierarchy (superclass chain) or implemented-interface "
                       "default methods.",
                       vmhook::error_tag, method_name, method_signature);
            return std::nullopt;
        }

        /*
            @brief Returns a method proxy for a static method identified by wrapper_type and name.
            @details
            Like the static get_field() overload but for methods.  The returned proxy has
            a null object pointer so it cannot be used to call instance methods.

            Complexity: O(N * M) where N = methods in the hierarchy, M = name comparison cost.
            Exception safety: does not throw; returns nullopt on failure.

            @param wrapper_type  std::type_index of the registered C++ wrapper class.
            @param method_name   Exact Java method name.
            @return  Optional method_proxy, or nullopt if not found.
        */
        static auto get_method(const std::type_index wrapper_type, const std::string_view method_name)
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            const auto binding{vmhook::detail::registered_class_binding(wrapper_type)};
            vmhook::hotspot::klass* const resolved_klass{
                vmhook::detail::registered_class_klass(wrapper_type, binding) };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_method('{}') (static): klass not resolved for wrapper type.",
                           vmhook::error_tag, method_name);
                return std::nullopt;
            }

            // Walk the superclass chain so inherited methods are found.
            for (vmhook::hotspot::klass* k{ resolved_klass }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };

                if (!methods_array || method_count <= 0)
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    vmhook::hotspot::method* const current_method{ methods_array[method_index] };
                    if (current_method && vmhook::hotspot::is_valid_pointer(current_method)
                        && current_method->get_name() == method_name
                        && static_method_only(current_method))
                    {
                        auto proxy = vmhook::method_proxy{nullptr, current_method, current_method->get_signature()};
                        proxy.set_metadata_lifetime(binding);
                        return proxy;
                    }
                }
            }

            // NOTE: no interface-default fallback here (unlike the two INSTANCE
            // overloads).  Interface DEFAULT methods are by definition NON-static
            // instance methods, so they can never satisfy this STATIC lookup; and a
            // `static` interface method (Java 8+) is not inherited by an implementor,
            // so walking a concrete class's interface chain for one would be wrong.
            // When the wrapper type IS the interface itself, the static interface
            // method lives on that interface's own _methods array and the superclass
            // walk above (which starts AT the interface klass) already finds it.
            ::vmhook::detail::log_line("{} object::get_method('{}') (static): no STATIC method with this name "
                       "found in class hierarchy.",
                       vmhook::error_tag, method_name);
            return std::nullopt;
        }

        /*
            @brief Returns a method proxy for a static method matching both name and JVM signature.
            @details
            Combines the type_index-based lookup from the static name-only overload with the
            signature-matching logic from the instance name+signature overload.  Use when the
            Java class has overloaded static methods.

            Complexity: O(N * M).
            Exception safety: does not throw; returns nullopt on failure.

            @param wrapper_type      std::type_index of the registered C++ wrapper class.
            @param method_name       Exact Java method name.
            @param method_signature  JVM descriptor, e.g. "(I)V".
            @return  Optional method_proxy, or nullopt if not found.
        */
        static auto get_method(const std::type_index wrapper_type, const std::string_view method_name, const std::string_view method_signature)
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            const auto binding{vmhook::detail::registered_class_binding(wrapper_type)};
            vmhook::hotspot::klass* const resolved_klass{
                vmhook::detail::registered_class_klass(wrapper_type, binding) };
            if (!resolved_klass)
            {
                ::vmhook::detail::log_line("{} object::get_method('{}{}') (static): klass not resolved for wrapper type.",
                           vmhook::error_tag, method_name, method_signature);
                return std::nullopt;
            }

            // Walk the superclass chain so inherited methods are found.
            for (vmhook::hotspot::klass* k{ resolved_klass }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };

                if (!methods_array || method_count <= 0)
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    vmhook::hotspot::method* const current_method{ methods_array[method_index] };
                    if (!current_method || !vmhook::hotspot::is_valid_pointer(current_method))
                    {
                        continue;
                    }

                    const std::string current_signature{ current_method->get_signature() };
                    if (current_method->get_name() == method_name && current_signature == method_signature
                        && static_method_only(current_method))
                    {
                        auto proxy = vmhook::method_proxy{nullptr, current_method, current_signature, true};
                        proxy.set_metadata_lifetime(binding);
                        return proxy;
                    }
                }
            }

            // NOTE: no interface-default fallback here — see the name-only static
            // overload above.  Default methods are non-static instance methods and
            // static interface methods are not inherited, so neither belongs on this
            // STATIC resolution path.
            ::vmhook::detail::log_line("{} object::get_method('{}{}') (static): no STATIC method with this exact "
                       "name+signature found in class hierarchy.",
                       vmhook::error_tag, method_name, method_signature);
            return std::nullopt;
        }


    protected:
        /*
            @brief The raw decoded OOP pointer to the wrapped Java object.
        */
        mutable oop_type_t instance{ nullptr };
        vmhook::detail::native_backend::root native_root_{};

    private:
        /*
            @brief Resolves the HotSpot klass for the dynamic type of this object.
            @details
            Uses typeid(*this) to look up the class name in type_to_class_map, then
            calls find_class() which walks the ClassLoaderDataGraph (cached after
            the first call).
            @return Pointer to the klass, or nullptr if the type is not registered.
        */
        auto resolve_klass() const
            -> vmhook::hotspot::klass*
        {
            if (this->native_root_)
            {
                (void)this->get_instance();
            }
            // THE OBJECT IS ASKED WHAT IT IS, not the wrapper.  A wrapper is
            // registered as the type its call site DECLARES -- a parameter typed
            // IChatComponent, a field typed Entity -- and the object that turns up
            // is a subclass of it.  Resolving from the registered name finds the
            // DECLARATION; resolving from the oop's own klass finds the
            // IMPLEMENTATION, which is what Java's own dispatch would pick.
            //
            // That difference has already killed a VM.  A wrapper registered as an
            // INTERFACE resolved getFormattedText to the interface's abstract
            // declaration, whose interpreted entry is HotSpot's
            // AbstractMethodError stub, and invoking it through a synthetic frame
            // took Minecraft down every time.
            //
            // Falls back to the registered class whenever the oop cannot answer:
            // a null instance (a static access, which has no object), or a header
            // that will not decode.
            if (this->instance)
            {
                if (vmhook::hotspot::klass* const concrete{ vmhook::klass_from_oop(this->instance) })
                {
                    if (vmhook::hotspot::is_valid_pointer(concrete))
                    {
                        return concrete;
                    }
                }
            }
            return resolve_klass(std::type_index{ typeid(*this) });
        }

        /*
            @brief Resolves the HotSpot klass for an arbitrary registered C++ wrapper type.
            @details
            Looks up wrapper_type in type_to_class_map and delegates to vmhook::find_class()
            which searches the ClassLoaderDataGraph (cached after the first call).
            Used by the static overloads of get_field() and get_method() that cannot use
            typeid(*this) because there is no object instance.

            Complexity: O(1) after the first call per type (cached in klass_lookup_cache).
            Exception safety: does not throw; returns nullptr and logs on failure.

            @param wrapper_type  std::type_index of the C++ wrapper class.
            @return  klass*, or nullptr if the type is not registered or the class is not found.
        */
        static auto resolve_klass(const std::type_index wrapper_type)
            -> vmhook::hotspot::klass*
        {
            const std::string registered_name{ vmhook::detail::registered_class_name(wrapper_type) };
            if (registered_name.empty())
            {
                ::vmhook::detail::log_line("{} object::resolve_klass() type '{}' not registered via register_class<T>().", vmhook::error_tag, wrapper_type.name());
                return nullptr;
            }

            vmhook::hotspot::klass* const found_klass{ vmhook::detail::registered_class_klass(wrapper_type) };
            if (!found_klass)
            {
                ::vmhook::detail::log_line("{} object::resolve_klass() class '{}' not found in JVM.", vmhook::error_tag, registered_name);
            }

            return found_klass;
        }

        /*
            @brief Static-kind gate for static_members::get_method() resolution.
            @details
            static_members::get_method(name) resolves only a STATIC Java method. Without
            this filter the name (+ optional descriptor) scan over the klass
            _methods array returned the FIRST name match regardless of kind, so
            static_members::get_method("instanceMethod") could otherwise return a proxy aimed at an
            INSTANCE Method with object == nullptr.  call() then dispatches that
            instance method through the STATIC slot with no receiver pushed (slot 0
            becomes the first declared arg instead of 'this'), yielding a wrong
            result or a JVM-tearing access violation as the callee reads garbage as
            its receiver.  The symmetric receiver-push decision in method_proxy
            already keys static-ness on this same bit (see the is_static() disjunct
            at the call site); this is the matching gate at resolution time.

            Reads JVM_ACC_STATIC (0x0008) the same way is_static() does — through
            method::get_access_flags() then masking 0x0008u.  That bit lives in the
            low byte of Method::_access_flags and is stable across every supported
            JDK (8..26), so reading the flags word as u4 and masking 0x0008 is
            width-independent even on JDKs where AccessFlags itself shrank.  Fails
            CLOSED: if the access-flags slot can't be resolved (no VMStructs entry)
            the candidate is treated as NOT static and skipped, so a method whose
            kind cannot be confirmed is never mis-dispatched through the static
            path.  Does NOT touch the Method-flags WIDTH machinery
            (derive_method_flags_layout / set_dont_inline) — only the stable
            low-byte ACC_STATIC bit.

            Complexity: O(1) after the first VMStruct lookup (cached).
            Exception safety: noexcept.

            @param candidate  The HotSpot Method under consideration (must be non-null).
            @return  true iff JVM_ACC_STATIC is set on the candidate.
        */
        static auto static_method_only(vmhook::hotspot::method* const candidate) noexcept
            -> bool
        {
            // Read JVM memory through the Windows memory API and stop on unreadable data.
            // A successful read does not establish object lifetime or a coherent VM snapshot.
            bool found{ false };
            return candidate->safe_access_flags_test(0x0008u, found);
        }

        /*
            @brief Fault-safe accessor for the Array<Klass*>* + length pair behind an interface klass's _methods field, WITHOUT any raw VMStruct deref.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        static auto safe_interface_methods(vmhook::hotspot::klass* const iface,
                                           vmhook::hotspot::method**&    methods_data,
                                           std::int32_t&                 method_count) noexcept
            -> bool
        {
            methods_data = nullptr;
            method_count = 0;

            static const vmhook::hotspot::vm_struct_entry_t* const methods_entry{
                vmhook::hotspot::iterate_struct_entries("InstanceKlass", "_methods") };
            if (!methods_entry || !iface || !vmhook::hotspot::is_valid_pointer(iface))
            {
                return false;
            }

            // Array<Method*>* _methods — fault-safe pointer read (no raw deref).
            const void* const array{ vmhook::hotspot::safe_read_pointer(
                reinterpret_cast<const std::uint8_t*>(iface) + methods_entry->offset) };
            if (!vmhook::hotspot::is_valid_pointer(array))
            {
                return false;
            }

            // Array<Method*>::_length @0 — fault-safe, then sanity-clamp like
            // get_methods_count() (u2 method_count ceiling, reject torn/wrong reads).
            std::int32_t count{ 0 };
            if (!vmhook::os::safe_read(&count, array, sizeof(count)))
            {
                return false;
            }
            if (count <= 0 || count > 65535)
            {
                return false;
            }

            methods_data = reinterpret_cast<vmhook::hotspot::method**>(
                reinterpret_cast<std::uint8_t*>(const_cast<void*>(array)) + 8);
            method_count = count;
            return true;
        }

        /*
            @brief Fault-safe name/signature read for a Method on a COLD interface, WITHOUT any raw VMStruct deref of the Method->ConstMethod-> ConstantPool->Symbol chain.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        static auto safe_method_name_signature(vmhook::hotspot::method* const current_method,
                                               std::string&                  name_out,
                                               std::string&                  signature_out) noexcept
            -> bool
        {
            name_out.clear();
            signature_out.clear();

            static const vmhook::hotspot::vm_struct_entry_t* const constmethod_entry{
                vmhook::hotspot::iterate_struct_entries("Method", "_constMethod") };
            static const vmhook::hotspot::vm_struct_entry_t* const name_index_entry{
                vmhook::hotspot::iterate_struct_entries("ConstMethod", "_name_index") };
            static const vmhook::hotspot::vm_struct_entry_t* const sig_index_entry{
                vmhook::hotspot::iterate_struct_entries("ConstMethod", "_signature_index") };
            static const vmhook::hotspot::vm_struct_entry_t* const constants_entry{
                vmhook::hotspot::iterate_struct_entries("ConstMethod", "_constants") };
            static const vmhook::hotspot::vm_type_entry_t* const cp_type_entry{
                vmhook::hotspot::iterate_type_entries("ConstantPool") };
            // ConstantPool::_length is OPTIONAL: when present we bound the index, when
            // absent we still proceed (the per-slot safe_read_pointer guards the read).
            static const vmhook::hotspot::vm_struct_entry_t* const cp_length_entry{
                vmhook::hotspot::iterate_struct_entries("ConstantPool", "_length") };

            if (!constmethod_entry || !name_index_entry || !sig_index_entry
                || !constants_entry || !cp_type_entry)
            {
                return false;
            }
            if (!current_method || !vmhook::hotspot::is_valid_pointer(current_method))
            {
                return false;
            }

            // Method::_constMethod — fault-safe pointer read.
            const void* const const_method{ vmhook::hotspot::safe_read_pointer(
                reinterpret_cast<const std::uint8_t*>(current_method) + constmethod_entry->offset) };
            if (!vmhook::hotspot::is_valid_pointer(const_method))
            {
                return false;
            }

            // ConstMethod::_constants — fault-safe pointer read.
            const void* const constants{ vmhook::hotspot::safe_read_pointer(
                reinterpret_cast<const std::uint8_t*>(const_method) + constants_entry->offset) };
            if (!vmhook::hotspot::is_valid_pointer(constants))
            {
                return false;
            }

            // ConstantPool entry array base = constants + sizeof(ConstantPool header).
            void** const cp_base{ reinterpret_cast<void**>(
                reinterpret_cast<std::uint8_t*>(const_cast<void*>(constants)) + cp_type_entry->size) };
            if (!vmhook::hotspot::is_valid_pointer(cp_base))
            {
                return false;
            }

            // Optional bound: ConstantPool::_length (fault-safe).  -1 => unbounded.
            std::int32_t cp_length{ -1 };
            if (cp_length_entry)
            {
                std::int32_t probe{ 0 };
                if (vmhook::os::safe_read(&probe,
                                          reinterpret_cast<const std::uint8_t*>(constants) + cp_length_entry->offset,
                                          sizeof(probe)))
                {
                    cp_length = probe;
                }
            }

            // Resolve ONE constant-pool symbol slot by u2 index, fault-safe end to end.
            const auto resolve_symbol{
                [&](const vmhook::hotspot::vm_struct_entry_t* const index_entry) noexcept
                    -> vmhook::hotspot::symbol*
                {
                    std::uint16_t index{ 0 };
                    if (!vmhook::os::safe_read(&index,
                                               reinterpret_cast<const std::uint8_t*>(const_method) + index_entry->offset,
                                               sizeof(index)))
                    {
                        return nullptr;
                    }
                    if (cp_length >= 0 && index >= cp_length)
                    {
                        return nullptr;
                    }
                    // base[index] — fault-safe pointer read of the specific slot.
                    const void* const sym{ vmhook::hotspot::safe_read_pointer(&cp_base[index]) };
                    if (!vmhook::hotspot::is_valid_pointer(sym))
                    {
                        return nullptr;
                    }
                    return reinterpret_cast<vmhook::hotspot::symbol*>(const_cast<void*>(sym));
                } };

            const vmhook::hotspot::symbol* const name_symbol{ resolve_symbol(name_index_entry) };
            const vmhook::hotspot::symbol* const sig_symbol{ resolve_symbol(sig_index_entry) };
            if (!name_symbol || !sig_symbol)
            {
                return false;
            }

            // symbol::to_string() is itself fully os::safe_read-guarded (length via
            // safe_read, body via safe_read into a bounded buffer) — no raw deref.
            name_out = name_symbol->to_string();
            signature_out = sig_symbol->to_string();
            return !name_out.empty() && !signature_out.empty();
        }

        /*
            @brief Fault-safe DEFAULT-method kind gate (NOT static AND NOT abstract),
                   WITHOUT raw-derefing Method::_access_flags.
            @details
            A genuine interface DEFAULT method has a body and is an instance method:
            neither ACC_STATIC (0x0008) nor ACC_ABSTRACT (0x0400).  We must EXCLUDE
              * abstract interface declarations (e.g. `String speak();`) — no body to
                call; the concrete override is already returned by the superclass walk,
                so an abstract interface method must not shadow it, and
              * static / (JDK 8) private interface helpers — a static interface method
                is not inherited by implementors.
            method::get_access_flags() returns a pointer that the caller raw-derefs
            (`*flags`); on the cold interface path that raw read can fault.  Here we
            safe_read the u4 _access_flags into a local instead.  Fails CLOSED: if the
            flags word is unreadable / the VMStruct is absent, returns false (the
            method is NOT treated as a callable default), so we never hand back an
            abstract or static interface method as if it were one.

            @param current_method  Candidate Method* (already is_valid_pointer-checked).
            @return true iff the method is a real default (neither static nor abstract).
        */
        static auto safe_method_is_default(vmhook::hotspot::method* const current_method) noexcept
            -> bool
        {
            static const vmhook::hotspot::vm_struct_entry_t* const flags_entry{
                vmhook::hotspot::iterate_struct_entries("Method", "_access_flags") };
            if (!flags_entry || !current_method || !vmhook::hotspot::is_valid_pointer(current_method))
            {
                return false;
            }

            std::uint32_t flags{ 0 };
            if (!vmhook::os::safe_read(&flags,
                                       reinterpret_cast<const std::uint8_t*>(current_method) + flags_entry->offset,
                                       sizeof(flags)))
            {
                return false;
            }

            constexpr std::uint32_t acc_static{ 0x0008u };
            constexpr std::uint32_t acc_private{ 0x0002u };
            constexpr std::uint32_t acc_abstract{ 0x0400u };
            return (flags & (acc_static | acc_private | acc_abstract)) == 0u;
        }

        /*
            @brief Searches a klass's implemented interfaces for a matching DEFAULT method.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        static auto find_interface_default_method(vmhook::hotspot::klass* const start_klass,
                                                  const std::string_view method_name,
                                                  const std::string_view method_signature) noexcept
            -> vmhook::hotspot::method*
        {
            if (!start_klass || !vmhook::hotspot::is_valid_pointer(start_klass))
            {
                return nullptr;
            }

            // HotSpot has already resolved inherited default overrides and
            // interface diamonds when linking the class. Use that selection
            // before inspecting individual interface declarations.
            for (auto* klass{ start_klass }; klass; klass = klass->get_super())
            {
                std::int32_t count{};
                auto** const defaults{ klass->get_default_methods_ptr(count) };
                for (std::int32_t index{}; defaults && index < count; ++index)
                {
                    auto* const candidate{ static_cast<vmhook::hotspot::method*>(const_cast<void*>(
                        vmhook::hotspot::safe_read_pointer(&defaults[index]))) };
                    std::string name;
                    std::string signature;
                    if (safe_method_is_default(candidate)
                        && safe_method_name_signature(candidate, name, signature)
                        && name == method_name
                        && (method_signature.empty() || signature == method_signature))
                    { return candidate; }
                }
            }

            std::int32_t interface_count{ 0 };
            vmhook::hotspot::klass** const interfaces{ start_klass->get_interfaces_ptr(interface_count) };
            if (!interfaces || interface_count <= 0)
            {
                // No interface array on this JDK (fail-safe) or the class implements
                // none: nothing to add beyond the superclass walk.
                return nullptr;
            }

            for (std::int32_t i{ 0 }; i < interface_count; ++i)
            {
                // Each Klass* entry is in the COLD interface array — read it fault-safe
                // (NO raw `interfaces[i]`).  An unreadable slot is skipped.
                const void* const iface_raw{ vmhook::hotspot::safe_read_pointer(&interfaces[i]) };
                if (!vmhook::hotspot::is_valid_pointer(iface_raw))
                {
                    continue;
                }
                vmhook::hotspot::klass* const iface{
                    reinterpret_cast<vmhook::hotspot::klass*>(const_cast<void*>(iface_raw)) };

                vmhook::hotspot::method** methods_array{ nullptr };
                std::int32_t              method_count{ 0 };
                if (!safe_interface_methods(iface, methods_array, method_count))
                {
                    continue;
                }

                for (std::int32_t method_index{ 0 }; method_index < method_count; ++method_index)
                {
                    // Each Method* entry is in the COLD methods array — fault-safe read.
                    const void* const method_raw{ vmhook::hotspot::safe_read_pointer(&methods_array[method_index]) };
                    if (!vmhook::hotspot::is_valid_pointer(method_raw))
                    {
                        continue;
                    }
                    vmhook::hotspot::method* const current_method{
                        reinterpret_cast<vmhook::hotspot::method*>(const_cast<void*>(method_raw)) };

                    std::string current_name;
                    std::string current_signature;
                    if (!safe_method_name_signature(current_method, current_name, current_signature))
                    {
                        continue;
                    }
                    if (current_name != method_name)
                    {
                        continue;
                    }
                    if (!method_signature.empty() && current_signature != method_signature)
                    {
                        continue;
                    }

                    // DEFAULT-method gate (fault-safe, fails CLOSED): skip abstract
                    // interface declarations (no body; the concrete override is found
                    // by the superclass walk) and static/private interface helpers.
                    if (!safe_method_is_default(current_method))
                    {
                        continue;
                    }

                    // First matching DEFAULT method in transitive-interface order.
                    return current_method;
                }
            }

            return nullptr;
        }
    };

    /*
        @brief Checked result of a Java member lookup.
        @details
        Test with `if (auto member = get_method(...))` when absence is expected.
        The concise `get_method(...)->call()` and `get_field(...)->get()` forms
        throw vmhook::exception on a failed lookup instead of dereferencing an
        empty std::optional. A successful lookup owns its lightweight proxy.
    */
    template<class proxy_type>
    class member_lookup final
    {
    public:
        explicit member_lookup(std::optional<proxy_type> member) noexcept(
            std::is_nothrow_move_constructible_v<proxy_type>)
            : member{ std::move(member) }
        {
        }

        [[nodiscard]] auto has_value() const noexcept -> bool
        {
            return this->member.has_value();
        }

        [[nodiscard]] explicit operator bool() const noexcept
        {
            return this->has_value();
        }

        auto value() & -> proxy_type&
        {
            this->require_member();
            return *this->member;
        }

        auto value() const & -> const proxy_type&
        {
            this->require_member();
            return *this->member;
        }

        auto value() && -> proxy_type&&
        {
            this->require_member();
            return std::move(*this->member);
        }

        auto operator->() -> proxy_type*
        {
            return std::addressof(this->value());
        }

        auto operator->() const -> const proxy_type*
        {
            return std::addressof(this->value());
        }

        auto operator*() & -> proxy_type&
        {
            return this->value();
        }

        auto operator*() const & -> const proxy_type&
        {
            return this->value();
        }

        auto operator*() && -> proxy_type&&
        {
            return std::move(*this).value();
        }

    private:
        auto require_member() const -> void
        {
            if (!this->member)
            {
                throw vmhook::exception{
                    "Java member lookup failed: check registration, class/member "
                    "availability and the receiver; test the lookup before use "
                    "when absence is expected." };
            }
        }

        std::optional<proxy_type> member;
    };

    template<typename wrapper_type>
        requires (std::is_base_of_v<vmhook::object_base, wrapper_type>
                  && !std::is_const_v<wrapper_type> && !std::is_volatile_v<wrapper_type>)
    inline auto return_value::set(const std::unique_ptr<wrapper_type>& value) -> void
    {
        if (!value)
        { throw vmhook::exception{ "A Java hook result requires an allocated C++ wrapper owner." }; }
        vmhook::detail::native_backend::operation access{};
        if (!access)
        { throw vmhook::exception{ "A Java hook object result requires the active callback context." }; }
        const auto root{ value->get_native_root() };
        if (root && !root->valid())
        { throw vmhook::exception{ "The Java hook result belongs to a closed or different thread context." }; }
        void* oop{ value->vmhook::object_base::get_instance() };
        if (oop && !root)
        { throw vmhook::exception{ "A non-null Java hook result requires a retained VM root." }; }
        if (oop) { vmhook::detail::require_object_wrapper_type<wrapper_type>(oop); }
        oop = value->vmhook::object_base::get_instance();
        auto* const method{ this->stack_frame ? this->stack_frame->get_method() : nullptr };
        const auto signature{ method ? method->get_signature() : std::string{} };
        const auto return_position{ signature.find(')') };
        if (return_position == std::string::npos)
        { throw vmhook::exception{ "The Java hook result does not match its declared reference return type." }; }
        vmhook::detail::require_reference_argument(oop,
            std::string_view{ signature }.substr(return_position + 1),
            vmhook::detail::callback_declaring_class(method));
        (void)value->vmhook::object_base::get_instance();
        // Null references follow the checked reference result path too. This
        // validates the Java return descriptor and installs the synthetic root
        // scan metadata before the callback leaves VM state.
        if (!vmhook::detail::set_callback_reference(this->return_slot, root))
        {
            throw vmhook::exception{ "The active Java hook cannot return this object reference." };
        }
    }

    /*
        @brief CRTP base class for typed Java-object wrappers.
        @details
        Derive from vmhook::object<wrapper_type> and register wrapper_type once.
        Instance wrapper methods use get_field(name) and get_method(name), with
        an optional JVM descriptor. The inherited nonstatic getter binds its
        own object, including its native-context root, without a receiver argument.

        Static wrapper methods use static_members::get_field(name) and
        static_members::get_method(name). This inherited facade knows the CRTP
        wrapper type and rejects Java instance members: a static C++ function
        has no object to bind. An instance getter can also access Java statics;
        the member's access flags select the actual storage or invocation kind.

        Both routes return checked member_lookup proxies. No ambient receiver
        or thread-local current object participates in member resolution.
    */
    template<typename derived>
    class object : public object_base
    {
    public:
        using object_base::object_base;

        /* @brief Allocates another C++ wrapper sharing this Java reference root. */
        [[nodiscard]] auto self() const
            -> std::unique_ptr<std::conditional_t<std::is_void_v<derived>, vmhook::any_object, derived>>;

        /* @brief Binds an instance or static field to this wrapper. */
        [[nodiscard]] auto get_field(const std::string_view name) const
            -> member_lookup<vmhook::field_proxy>
        {
            return member_lookup<vmhook::field_proxy>{
                object_base::get_field(name) };
        }

        /* @brief Binds an instance or static method to this wrapper. */
        [[nodiscard]] auto get_method(const std::string_view name) const
            -> member_lookup<vmhook::method_proxy>
        {
            return member_lookup<vmhook::method_proxy>{
                object_base::get_method(name) };
        }

        /* @brief Binds an exact method to this wrapper by JVM descriptor. */
        [[nodiscard]] auto get_method(const std::string_view name,
                                     const std::string_view signature) const
            -> member_lookup<vmhook::method_proxy>
        {
            return member_lookup<vmhook::method_proxy>{
                object_base::get_method(name, signature) };
        }

        /* @brief Class-only lookups using the enclosing CRTP wrapper type. */
        struct static_members final
        {
            [[nodiscard]] static auto get_field(const std::string_view name)
                -> member_lookup<vmhook::field_proxy>
            {
                return member_lookup<vmhook::field_proxy>{
                    object_base::get_field(std::type_index{ typeid(derived) }, name) };
            }

            [[nodiscard]] static auto get_method(const std::string_view name)
                -> member_lookup<vmhook::method_proxy>
            {
                return member_lookup<vmhook::method_proxy>{
                    object_base::get_method(std::type_index{ typeid(derived) }, name) };
            }

            [[nodiscard]] static auto get_method(const std::string_view name,
                                               const std::string_view signature)
                -> member_lookup<vmhook::method_proxy>
            {
                return member_lookup<vmhook::method_proxy>{
                    object_base::get_method(std::type_index{ typeid(derived) }, name, signature) };
            }
        };
    };

    // --- Built-in Java collection wrappers ------------------------------------

    /*
        @brief Resolves the HotSpot klass* directly from a decoded OOP header.

        Header layout follows the verified VMStructs and active header mode:
          ordinary headers: read the metadata-selected wide or narrow klass slot;
          compact headers: extract narrow klass bits from the verified mark word.
        Narrow klass pointers use the klass base/shift codec, separately from
        the oop base/shift; an unavailable layout or codec is refused.

        Returns nullptr if the pointer is invalid or decoding fails.
    */
    [[nodiscard]] auto klass_from_oop(void* const oop) noexcept -> vmhook::hotspot::klass*
    {
        if (!oop || !vmhook::hotspot::is_valid_pointer(oop)) { return nullptr; }
        const auto compact{ vmhook::detail::compact_object_header_mode() };
        const auto compressed{ vmhook::detail::compressed_klass_mode() };
        if (!compact || !compressed) { return nullptr; }
        if (*compact)
        {
            const auto* const mark_entry{ vmhook::hotspot::iterate_struct_entries("oopDesc", "_mark") };
            if (!mark_entry || mark_entry->offset > 16u - sizeof(std::uint64_t)) { return nullptr; }
            std::uint64_t mark{};
            if (!vmhook::os::safe_read(&mark, static_cast<const std::uint8_t*>(oop)
                + mark_entry->offset, sizeof(mark))) { return nullptr; }
            const auto narrow{ vmhook::detail::compact_klass_from_mark(mark) };
            if (!narrow) { return nullptr; }
            void* const decoded{ vmhook::hotspot::decode_klass_pointer(*narrow) };
            return vmhook::hotspot::is_valid_pointer(decoded)
                ? static_cast<vmhook::hotspot::klass*>(decoded) : nullptr;
        }
        static constexpr vmhook::hotspot::struct_entry_candidate_t narrow_candidates[]{
            { "oopDesc", "_metadata._compressed_klass" }, { "oopDesc", "_compressed_klass" } };
        const auto* const entry{ *compressed
            ? vmhook::hotspot::resolve_struct_entry(narrow_candidates, std::size(narrow_candidates))
            : vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._klass") };
        if (!entry || entry->offset > 16u - (*compressed ? sizeof(std::uint32_t) : sizeof(void*)))
        {
            return nullptr;
        }
        const auto* const slot{ static_cast<const std::uint8_t*>(oop) + entry->offset };
        void* decoded{ nullptr };
        if (*compressed)
        {
            std::uint32_t narrow{};
            if (!vmhook::os::safe_read(&narrow, slot, sizeof(narrow))) { return nullptr; }
            decoded = vmhook::hotspot::decode_klass_pointer(narrow);
        }
        else if (!vmhook::os::safe_read(&decoded, slot, sizeof(decoded)))
        {
            return nullptr;
        }
        return vmhook::hotspot::is_valid_pointer(decoded)
            ? static_cast<vmhook::hotspot::klass*>(decoded) : nullptr;
    }

    /*
        @brief Checks assignability to the unique loaded class selected by name.
        @details Uses exact Klass identity, superclass and interface metadata.
        Ambiguous names from different defining loaders are refused by lookup.
        The caller must supply a live oop in the current rooted VM context;
        a readable address alone does not establish object lifetime. This
        metadata-only operation neither calls Java nor creates a durable root.
        Java null and an unavailable target class return false. Context and
        allocation failures remain explicit errors.
    */
    inline auto is_instance_of(void* const object_oop, const std::string_view class_name)
        -> bool
    {
        if (!object_oop || class_name.empty())
        {
            return false;
        }
        vmhook::detail::native_backend::operation access{};
        if (!access) { throw vmhook::exception{ "Instance query requires a rooted VM context" }; }
        return vmhook::detail::container_class_assignable(
            vmhook::klass_from_oop(object_oop), vmhook::find_class(class_name));
    }

    /*
        @brief Shared base for wrappers that resolve fields/methods from the
               LIVE OOP's klass header rather than the C++ type registry.
        @details
        vmhook::collection and vmhook::map both need to look up fields and
        methods through the concrete runtime klass read out of the object
        header (so a single wrapper works for ArrayList / LinkedList / HashSet
        / HashMap / TreeMap / ... without a register_class<T>() call).  The
        three helpers below used to be copy-pasted verbatim into each of those
        classes; they are hoisted here so there is exactly one implementation.

        This adds no data members and inherits object_base's constructors, so
        every wrapper that derives from it has the same object layout, the same
        (defaulted) copy/move semantics, and the same dynamic type under
        typeid(*this) as before.  collection and map derive from this in place
        of object_base; list / set / linked_list / hash_map keep deriving from
        collection / map and inherit these helpers transitively, exactly as
        when the helpers lived directly in collection / map.

        The helpers are protected: they remain an implementation detail of the
        container wrappers and are not part of the public API.
    */
    class oop_reflective_base : public vmhook::object_base
    {
    public:
        using object_base::object_base;

    protected:
        /*
            @brief Returns the klass by reading the narrow klass slot in the OOP header.
            Falls back to nullptr if the OOP is invalid.
        */
        auto oop_klass() const -> vmhook::hotspot::klass*
        {
            return vmhook::klass_from_oop(this->get_instance());
        }

        /*
            @brief get_field variant that uses the live OOP's klass, not the C++ type registry.
        */
        auto get_field_by_oop_klass(const std::string_view name) const
            -> std::optional<vmhook::field_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::hotspot::klass* const k{ oop_klass() };
            if (!k)
            {
                return std::nullopt;
            }
            const auto entry{ vmhook::find_field(k, name) };
            if (!entry)
            {
                return std::nullopt;
            }
            if (entry->is_static)
            {
                // Inherited static: use the declaring klass's mirror (see the
                // note on field_entry_t::declaring_klass).  `k` here is the live
                // OOP's leaf klass; for a static inherited from a super the
                // offset only indexes the super's mirror.
                vmhook::hotspot::klass* const mirror_klass{ entry->declaring_klass ? entry->declaring_klass : k };
                void* const mirror{ mirror_klass->get_java_mirror() };
                if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
                {
                    return std::nullopt;
                }
                void* const field_pointer{ reinterpret_cast<std::uint8_t*>(mirror) + entry->offset };
                // Native contexts retain the declaring mirror; access reconstructs
                // the field address under a VM operation. Legacy access is observational.
                return vmhook::field_proxy{ field_pointer, entry->signature, true, mirror_klass, entry->offset, entry->access_flags };
            }
            if (!this->instance)
            {
                return std::nullopt;
            }
            void* const field_pointer{ reinterpret_cast<std::uint8_t*>(this->instance) + entry->offset };
            return vmhook::field_proxy{ field_pointer, entry->signature, false,
                                        this->get_native_root(), entry->offset,
                                        entry->declaring_klass ? entry->declaring_klass : k, entry->access_flags };
        }

        /*
            @brief get_method variant that searches the live OOP's klass hierarchy.
        */
        auto get_method_by_oop_klass(const std::string_view method_name) const
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            for (vmhook::hotspot::klass* k{ oop_klass() }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };
                if (!methods_array || method_count <= 0)
                {
                    continue;
                }
                for (std::int32_t i{ 0 }; i < method_count; ++i)
                {
                    vmhook::hotspot::method* const m{ methods_array[i] };
                    if (m && vmhook::hotspot::is_valid_pointer(m) && m->get_name() == method_name)
                    {
                        return vmhook::method_proxy{ this->instance, m, m->get_signature(),
                                                     false, &this->instance, this->get_native_root() };
                    }
                }
            }
            return std::nullopt;
        }
    };

    /*
        @brief A Java object with no C++ type attached to it.
    */
    class any_object final : public vmhook::oop_reflective_base
    {
    public:
        using vmhook::oop_reflective_base::oop_reflective_base;

        /*
            @brief Field proxy for any field on the object's real class.
            @details Instance or static, declared or inherited; the JVM_ACC_STATIC
            flag decides which storage is addressed, exactly as object_base does.
        */
        auto get_field(const std::string_view name) const
            -> std::optional<vmhook::field_proxy>
        {
            return this->get_field_by_oop_klass(name);
        }

        /*
            @brief Method proxy for any method on the object's real class.
        */
        auto get_method(const std::string_view method_name) const
            -> std::optional<vmhook::method_proxy>
        {
            return this->get_method_by_oop_klass(method_name);
        }

        /*
            @brief Method proxy pinned to one exact overload by JVM descriptor.
        */
        auto get_method(const std::string_view method_name,
                        const std::string_view method_signature) const
            -> std::optional<vmhook::method_proxy>
        {
            vmhook::detail::native_backend::operation access{};
            for (vmhook::hotspot::klass* k{ this->oop_klass() }; k != nullptr; k = k->get_super())
            {
                const std::int32_t method_count{ k->get_methods_count() };
                vmhook::hotspot::method** const methods_array{ k->get_methods_ptr() };
                if (!methods_array || method_count <= 0)
                {
                    continue;
                }
                for (std::int32_t index{ 0 }; index < method_count; ++index)
                {
                    vmhook::hotspot::method* const m{ methods_array[index] };
                    if (m && vmhook::hotspot::is_valid_pointer(m)
                        && m->get_name() == method_name
                        && m->get_signature() == method_signature)
                    {
                        return vmhook::method_proxy{ this->get_instance(), m, m->get_signature(),
                                                     true, &this->instance, this->get_native_root() };
                    }
                }
            }
            return std::nullopt;
        }

        /*
            @brief The object's real Java class name, or "" when unreadable.
            @details What an untyped handle is usually asked first: `what is
            this?`.  Read from the live header, so it names the CONCRETE class,
            not whatever base a caller happened to expect.
        */
        auto class_name() const
            -> std::string
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::hotspot::klass* const k{ this->oop_klass() };
            if (!k)
            {
                return std::string{};
            }
            const vmhook::hotspot::symbol* const name_symbol{ k->get_name() };
            if (!vmhook::hotspot::is_valid_pointer(name_symbol))
            {
                return std::string{};
            }
            return name_symbol->to_string();
        }

        /* @brief True when the object is an instance of the named Java class. */
        auto instance_of(const std::string_view name) const
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            return this->get_instance() != nullptr
                && vmhook::is_instance_of(this->get_instance(), name);
        }

        /* @brief True when there is an object here at all. */
        explicit operator bool() const
        {
            return this->get_instance() != nullptr;
        }
    };

    namespace detail
    {
        /* The destination supplies the C++ wrapper types. Owning the source
           preserves its root when the field/call temporary has been destroyed. */
        template<typename source_type, bool entries_only>
        class vector_conversion final
        {
            source_type source_;
            bool valid_{ true };
            auto require_source() const -> void
            {
                if (!this->valid_)
                { throw vmhook::exception{ "Cannot materialize a moved-from collection conversion" }; }
            }
        public:
            explicit vector_conversion(source_type source)
                : source_{ std::move(source) } {}
            vector_conversion(const vector_conversion&) = default;
            auto operator=(const vector_conversion&) -> vector_conversion& = default;
            vector_conversion(vector_conversion&& other)
                noexcept(std::is_nothrow_move_constructible_v<source_type>)
                : source_{ std::move(other.source_) }, valid_{ std::exchange(other.valid_, false) } {}
            auto operator=(vector_conversion&& other)
                noexcept(std::is_nothrow_move_assignable_v<source_type>) -> vector_conversion&
            {
                if (this != &other)
                {
                    this->source_ = std::move(other.source_);
                    this->valid_ = std::exchange(other.valid_, false);
                }
                return *this;
            }

            template<container_wrapper element_type>
                requires (!entries_only && requires(const source_type& source)
                {
                    { source.template to_vector<element_type>() }
                        -> std::same_as<std::vector<std::unique_ptr<element_type>>>;
                })
            operator std::vector<std::unique_ptr<element_type>>() const
            { this->require_source(); return this->source_.template to_vector<element_type>(); }

            template<container_wrapper key_type, container_wrapper mapped_type>
                requires requires(const source_type& source)
                {
                    { source.template to_entries<key_type, mapped_type>() }
                        -> std::same_as<std::vector<std::pair<std::unique_ptr<key_type>,
                                                             std::unique_ptr<mapped_type>>>>;
                }
            operator std::vector<std::pair<std::unique_ptr<key_type>,
                                           std::unique_ptr<mapped_type>>>() const
            { this->require_source(); return this->source_.template to_entries<key_type, mapped_type>(); }
        };

        [[nodiscard]] inline auto container_class_assignable(
            vmhook::hotspot::klass* runtime_class, vmhook::hotspot::klass* const expected_class) -> bool
        {
            if (!expected_class || !vmhook::hotspot::is_valid_pointer(expected_class)) { return false; }
            const auto* const layout_entry{
                vmhook::hotspot::iterate_struct_entries("Klass", "_layout_helper") };
            const auto* const secondary_entry{
                vmhook::hotspot::iterate_struct_entries("Klass", "_secondary_supers") };
            for (std::size_t depth{}; runtime_class && depth < 256; ++depth)
            {
                if (!vmhook::hotspot::is_valid_pointer(runtime_class)) { return false; }
                if (runtime_class == expected_class) { return true; }
                // This Klass metadata also covers interfaces and array covariance.
                if (secondary_entry)
                {
                    const auto* const array{ static_cast<const std::byte*>(vmhook::hotspot::safe_read_pointer(
                        reinterpret_cast<const std::byte*>(runtime_class) + secondary_entry->offset)) };
                    std::int32_t count{};
                    if (array)
                    {
                        if (!vmhook::os::safe_read(&count, array, sizeof(count)) || count < 0 || count > 65535)
                        { return false; }
                        for (std::int32_t index{}; index < count; ++index)
                        {
                            vmhook::hotspot::klass* secondary_class{};
                            if (!vmhook::os::safe_read(&secondary_class,
                                    array + 8 + static_cast<std::size_t>(index) * sizeof(secondary_class),
                                    sizeof(secondary_class))) { return false; }
                            if (secondary_class == expected_class) { return true; }
                        }
                    }
                }
                std::int32_t layout{};
                if (!layout_entry || !vmhook::os::safe_read(&layout,
                        reinterpret_cast<const std::byte*>(runtime_class) + layout_entry->offset, sizeof(layout)))
                { return false; }
                // Negative layout is ArrayKlass; zero is an interface InstanceKlass.
                if (layout >= 0)
                {
                    std::int32_t interface_count{};
                    auto* const interfaces{ runtime_class->get_interfaces_ptr(interface_count) };
                    for (std::int32_t index{}; interfaces && index < interface_count; ++index)
                    {
                        vmhook::hotspot::klass* interface_class{};
                        if (!vmhook::os::safe_read(&interface_class, interfaces + index, sizeof(interface_class)))
                        { return false; }
                        if (interface_class == expected_class) { return true; }
                    }
                }
                runtime_class = runtime_class->get_super();
            }
            return false;
        }

        inline auto require_reference_argument(void* const address, const std::string_view descriptor,
            vmhook::hotspot::klass* const declaring_class) -> void
        {
            std::size_t dimensions{};
            while (dimensions < descriptor.size() && descriptor[dimensions] == '[') { ++dimensions; }
            const auto component{ descriptor.substr(dimensions) };
            const bool object_component{ component.size() >= 3 && component.front() == 'L'
                && component.back() == ';'
                && component.find(';') == component.size() - 1
                && component.find_first_of("[.\0", 0, 3) == std::string_view::npos };
            const bool primitive_component{ dimensions != 0 && component.size() == 1
                && std::string_view{"ZBCSIJFD"}.find(component.front()) != std::string_view::npos };
            if (dimensions > 255 || (!object_component && !primitive_component))
            { throw vmhook::exception{ "A Java object argument requires a valid reference descriptor" }; }
            // Java null is assignable to every reference descriptor without
            // loading or initializing the descriptor's class.
            if (!address) { return; }
            native_backend::operation access{};
            if (!access || !declaring_class || !vmhook::hotspot::is_valid_pointer(declaring_class))
            { throw vmhook::exception{ "A Java object argument requires its declaring class and VM context" }; }
            const auto argument_root{ native_backend::retain_oop(address) };
            const auto declaring_root{ native_backend::retain_class(declaring_class) };
            if (!argument_root || !declaring_root)
            { throw vmhook::exception{ "Java argument and declaring class could not be retained" }; }

            const auto loader_of = [](vmhook::hotspot::klass* const klass) -> void*
            {
                const auto* data_entry{ vmhook::hotspot::iterate_struct_entries("Klass", "_class_loader_data") };
                // Java 8/9 export this inherited Klass field under InstanceKlass.
                if (!data_entry)
                { data_entry = vmhook::hotspot::iterate_struct_entries("InstanceKlass", "_class_loader_data"); }
                const auto* const loader_entry{ vmhook::hotspot::iterate_struct_entries("ClassLoaderData", "_class_loader") };
                void* data{};
                void* loader{};
                if (!klass || !data_entry || !loader_entry || !loader_entry->type_string
                    || !vmhook::os::safe_read(&data, reinterpret_cast<const std::byte*>(klass)
                        + data_entry->offset, sizeof(data)) || !vmhook::hotspot::is_valid_pointer(data)
                    || !vmhook::os::safe_read(&loader, static_cast<const std::byte*>(data)
                        + loader_entry->offset, sizeof(loader)))
                { throw vmhook::exception{ "Java declaring-loader metadata could not be read" }; }
                const std::string_view storage{ loader_entry->type_string };
                if (storage == "OopHandle")
                {
                    if (loader && (!vmhook::hotspot::is_valid_pointer(loader)
                        || !vmhook::os::safe_read(&loader, loader, sizeof(loader))))
                    { throw vmhook::exception{ "Java declaring-loader handle could not be read" }; }
                }
                else if (storage != "oop")
                { throw vmhook::exception{ "Java declaring-loader storage is unsupported" }; }
                if (loader && !vmhook::hotspot::is_valid_pointer(loader))
                { throw vmhook::exception{ "Java declaring-loader reference is invalid" }; }
                return loader;
            };
            const auto array_of = [dimensions](vmhook::hotspot::klass* value) -> vmhook::hotspot::klass*
            {
                for (std::size_t dimension{}; value && dimension < dimensions; ++dimension)
                {
                    const auto* const entry{ vmhook::hotspot::iterate_struct_entries(
                        dimension == 0 ? "InstanceKlass" : "ArrayKlass",
                        dimension == 0 ? "_array_klasses" : "_higher_dimension") };
                    vmhook::hotspot::klass* next{};
                    if (!entry || !vmhook::os::safe_read(&next, reinterpret_cast<const std::byte*>(value)
                        + entry->offset, sizeof(next)) || !vmhook::hotspot::is_valid_pointer(next))
                    { return nullptr; }
                    value = next;
                }
                return value;
            };

            const auto internal_name{ object_component ? component.substr(1, component.size() - 2)
                                                       : std::string_view{} };
            vmhook::hotspot::klass* expected{};
            void* const declaring_loader{ loader_of(declaring_class) };
            if (object_component)
            {
                auto* const candidate{ vmhook::find_class(internal_name) };
                // A class already defined by this loader, or an ancestor whose
                // identity Java linking has already constrained, is unambiguous.
                if (candidate && (loader_of(candidate) == declaring_loader
                    || container_class_assignable(declaring_class, candidate)))
                { expected = dimensions == 0 ? candidate : array_of(candidate); }
            }
            else
            {
                expected = vmhook::resolve_array_klass(descriptor);
                if (!expected)
                {
                    // Primitive array identities are unique to the bootstrap
                    // VM. Modern JVMs may omit the old Universe array statics;
                    // exact live descriptors prove identity without a name-only
                    // classloader graph search or an assumed static offset.
                    auto* const actual{ vmhook::klass_from_oop(argument_root->resolve_under_vm()) };
                    if (actual && actual->get_name() && actual->get_name()->to_string() == descriptor
                        && vmhook::detail::array_layout(actual)) { expected = actual; }
                }
            }

            if (!expected)
            {
                // Name-only graph lookup cannot prove parent delegation or
                // distinguish duplicate definitions. Ask Java's actual loader,
                // directly through the private call backend to avoid recursively
                // entering public argument validation. Initialization stays off.
                const auto loader_root{ declaring_loader ? native_backend::retain_oop(declaring_loader)
                                                          : native_backend::root{} };
                if (declaring_loader && !loader_root)
                { throw vmhook::exception{ "Java declaring loader could not be retained" }; }
                auto* const class_class{ vmhook::find_class("java/lang/Class") };
                if (!class_class || loader_of(class_class) != nullptr)
                { throw vmhook::exception{ "Bootstrap java.lang.Class metadata is unavailable" }; }
                const auto class_root{ native_backend::retain_class(class_class) };
                std::string binary_name{ dimensions == 0 ? internal_name : descriptor };
                std::replace(binary_name.begin(), binary_name.end(), '/', '.');
                const auto name_root{ native_backend::make_string(binary_name) };
                if (!class_root || !name_root)
                { throw vmhook::exception{ "Java argument class-resolution inputs could not be retained" }; }
                constexpr std::string_view lookup_signature{
                    "(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;" };
                vmhook::hotspot::method* lookup{};
                std::int32_t count{};
                vmhook::hotspot::method** methods{};
                if (vmhook::hotspot::safe_klass_methods(class_class, methods, count))
                {
                    for (std::int32_t index{}; index < count; ++index)
                    {
                        auto* const method{ methods[index] };
                        if (method && method->get_name() == "forName" && method->get_signature() == lookup_signature)
                        { lookup = method; break; }
                    }
                }
                if (!lookup) { throw vmhook::exception{ "Java declaring-loader class resolution is unavailable" }; }
                std::array<std::intptr_t, 3> parameters{
                    reinterpret_cast<std::intptr_t>(name_root->resolve_under_vm()), 0,
                    reinterpret_cast<std::intptr_t>(loader_root ? loader_root->resolve_under_vm() : nullptr) };
                const auto resolved{ native_backend::invoke_packed(lookup, lookup_signature,
                    parameters.data(), parameters.size(), nullptr, nullptr) };
                if (!resolved.invoked || resolved.threw || !resolved.error.empty()
                    || !resolved.object || !resolved.object->valid())
                { throw vmhook::exception{ "Java argument descriptor could not be resolved by its declaring loader" }; }
                void* const mirror{ resolved.object->resolve_under_vm() };
                if (!mirror) { throw vmhook::exception{ "Resolved Java argument class mirror is invalid" }; }
                const vmhook::hotspot::class_loader_data_graph graph{};
                graph.for_each_klass([&](const std::string_view name, vmhook::hotspot::klass* const klass)
                {
                    if (expected) { return; }
                    auto* const candidate{ name == (dimensions == 0 ? internal_name : descriptor) ? klass
                        : object_component && dimensions != 0 && name == internal_name ? array_of(klass) : nullptr };
                    if (candidate && candidate->get_java_mirror() == mirror) { expected = candidate; }
                });
                if (!expected)
                { throw vmhook::exception{ "Resolved Java argument class identity could not be verified" }; }
            }
            void* const current{ argument_root->resolve_under_vm() };
            if (!current || !container_class_assignable(vmhook::klass_from_oop(current), expected))
            { throw vmhook::exception{ "Java object is incompatible with the declared reference type" }; }
        }

        [[nodiscard]] inline auto container_address(const native_backend::root& root) -> void*
        {
            if (!root || !root->valid())
            { throw vmhook::exception{ "Collection reference belongs to a closed or different thread context" }; }
            void* const address{ root->resolve_under_vm() };
            if (!address || !vmhook::hotspot::is_valid_pointer(address))
            { throw vmhook::exception{ "Collection reference cannot be resolved under the current VM operation" }; }
            return address;
        }

        [[nodiscard]] inline auto retain_container_address(void* const address) -> native_backend::root
        {
            if (!address) { return {}; }
            if (!vmhook::hotspot::is_valid_pointer(address))
            { throw vmhook::exception{ "Invalid Java reference in collection conversion" }; }
            auto root{ native_backend::retain_oop(address) };
            if (!root)
            { throw vmhook::exception{ "Cannot retain a Java reference for collection conversion" }; }
            return root;
        }

        [[nodiscard]] inline auto container_source_root(const vmhook::object_base& source)
            -> native_backend::root
        {
            auto root{ source.get_native_root() };
            if (root) { (void)container_address(root); return root; }
            if (!source.get_instance()) { return {}; }
            throw vmhook::exception{ "Non-null collection conversion requires a retained Java reference" };
        }

        [[nodiscard]] inline auto container_value_root(const std::uint32_t compressed,
            const native_backend::root& existing) -> native_backend::root
        {
            if (existing) { (void)container_address(existing); return existing; }
            if (compressed == 0) { return {}; }
            throw vmhook::exception{ "Non-null collection conversion requires its originating Java root" };
        }

        inline auto require_container_contract(const native_backend::root& root,
            const std::string_view class_name) -> void
        {
            auto* const expected_class{ vmhook::find_class(class_name) };
            if (!expected_class || !container_class_assignable(
                    vmhook::klass_from_oop(container_address(root)), expected_class))
            { throw vmhook::exception{ std::format("Java object is not an instance of '{}'", class_name) }; }
        }

        inline auto raise_callback_exception(hotspot::return_slot* const slot,
            hotspot::frame* const frame, const std::unique_ptr<vmhook::any_object>& throwable) -> void
        {
            if (!slot || !frame || frame != hotspot::current_interpreter_frame
                || !callback_backend::current || !throwable)
            { throw vmhook::exception{ "A Java exception requires the active method callback and an allocated wrapper owner." }; }
            native_backend::operation access{};
            if (!access)
            { throw vmhook::exception{ "The Java exception requires its own rooted callback context." }; }
            const auto root{ throwable->get_native_root() };
            if (!root || !root->valid() || !root->resolve_under_vm())
            { throw vmhook::exception{ "A Java exception requires a retained non-null Throwable reference." }; }
            const auto [throwable_class, class_root]{ ensure_bootstrap_class("java/lang/Throwable", false) };
            if (!throwable_class || !class_root || !container_class_assignable(
                    vmhook::klass_from_oop(root->resolve_under_vm()), throwable_class))
            { throw vmhook::exception{ "The Java exception is not a bootstrap Throwable instance." }; }
            auto* const context{ native_backend::current_context_lifetime() };
            auto& runtime{ private_native::rt() };
            if (!context || runtime.current_thread() != context->thread
                || private_native::thread_state(context->thread) != 6)
            { throw vmhook::exception{ "A Java exception requires this callback's VM state." }; }
            const auto pending_offset{ runtime.off("JavaThread", "_pending_exception") };
            const auto file_offset{ runtime.off("ThreadShadow", "_exception_file") };
            const auto line_offset{ runtime.off("ThreadShadow", "_exception_line") };
            if (private_native::load<void*>(context->thread, pending_offset))
            { throw vmhook::exception{ "The callback already has a pending Java exception." }; }
            // ThreadShadow's pending exception is a VM-scanned oop. Publish it
            // in VM state before session HandleArea roots retire. No Java call
            // or safepoint occurs between resolving this ticket and the store.
            private_native::store(context->thread, pending_offset, root->resolve_under_vm());
            private_native::store(context->thread, file_offset, "VMHook method callback");
            private_native::store(context->thread, line_offset, std::int32_t{ 0 });
            slot->cancel = true;
            slot->retval = 0;
        }

        template<typename... argument_types>
        [[nodiscard]] inline auto call_container_method(const native_backend::root& root,
            const std::string_view name, const std::string_view signature,
            argument_types&&... arguments) -> vmhook::method_proxy::value_t
        {
            vmhook::any_object source{ container_address(root) };
            source.set_native_root(root);
            const auto method{ source.get_method(name, signature) };
            if (!method)
            { throw vmhook::exception{ std::format("Java collection method '{}{}' is unavailable", name, signature) }; }
            auto result{ method->call(std::forward<argument_types>(arguments)...) };
            if (!result.was_invoked() || result.threw() || result.result_failed)
            { throw vmhook::exception{ std::format("Java collection method '{}{}' failed{}{}", name, signature,
                result.threw() ? ": " : "", result.exception_class) }; }
            return result;
        }

        /* Mutators execute ordinary Java methods. Their reference stores use
           the collector's own barriers, including when VMHook cannot yet write
           object fields directly. Null C++ owners are rejected by call(). */
        template<typename... argument_types>
        [[nodiscard]] inline auto invoke_container(const vmhook::object_base& source,
            const std::string_view contract, const std::string_view name,
            const std::string_view signature, argument_types&&... arguments)
            -> vmhook::method_proxy::value_t
        {
            native_backend::operation access{};
            if (!access)
            { throw vmhook::exception{ "Container operation requires a native-thread or rooted callback context" }; }
            const auto root{ container_source_root(source) };
            if (!root) { throw vmhook::exception{ "Cannot invoke a Java method on a null container" }; }
            require_container_contract(root, contract);
            return call_container_method(root, name, signature, std::forward<argument_types>(arguments)...);
        }

        [[nodiscard]] inline auto container_result_root(const vmhook::method_proxy::value_t& value)
            -> native_backend::root
        {
            if (!value.was_invoked() || value.threw() || value.result_failed || !value.reference_result)
            { throw vmhook::exception{ "Collection conversion requires a successful Java reference result" }; }
            if (value.native_root) { (void)container_address(value.native_root); return value.native_root; }
            if (std::holds_alternative<std::uint32_t>(value.data))
            { return container_value_root(std::get<std::uint32_t>(value.data), {}); }
            if (std::holds_alternative<std::monostate>(value.data)) { return {}; }
            { throw vmhook::exception{ "Collection conversion requires an object or reference array" }; }
        }

        [[nodiscard]] inline auto container_array_length(const native_backend::root& root) -> std::int32_t
        {
            void* const array{ container_address(root) };
            const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array)) };
            if (!layout || !layout->reference_elements || layout->element_width != sizeof(std::uint32_t)
                || !vmhook::detail::reference_reads_supported()
                || vmhook::detail::reference_storage_width() != sizeof(std::uint32_t))
            { throw vmhook::exception{ "Collection conversion requires a supported Java reference array" }; }
            std::int32_t count{};
            if (!vmhook::os::safe_read(&count, static_cast<const std::byte*>(array) + layout->length_offset,
                                      sizeof(count)) || count < 0
                || static_cast<std::size_t>(count) > vmhook::k_max_safe_container_elems)
            { throw vmhook::exception{ "Java collection snapshot length is unreadable or exceeds the supported limit" }; }
            return count;
        }

        [[nodiscard]] inline auto container_array_element(const native_backend::root& root,
            const std::int32_t index) -> native_backend::root
        {
            // Re-resolve the snapshot after any previous getKey/getValue call.
            void* const array{ container_address(root) };
            const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array)) };
            const auto count{ container_array_length(root) };
            if (!layout || index < 0 || index >= count)
            { throw vmhook::exception{ "Java collection snapshot index is invalid" }; }
            std::uint32_t compressed{};
            if (!vmhook::os::safe_read(&compressed, static_cast<const std::byte*>(array) + layout->body_offset
                    + static_cast<std::size_t>(index) * layout->element_width, sizeof(compressed)))
            { throw vmhook::exception{ "Java collection snapshot element is unreadable" }; }
            if (compressed == 0) { return {}; }
            void* const decoded{ vmhook::hotspot::decode_oop_pointer(compressed) };
            if (!decoded)
            { throw vmhook::exception{ "Java collection element reference could not be decoded" }; }
            return retain_container_address(decoded);
        }

        template<typename wrapper_type>
        inline auto require_object_wrapper_type(void* const address) -> void
        {
            static_assert(std::is_base_of_v<vmhook::object_base, wrapper_type>);
            auto* const runtime_class{ vmhook::klass_from_oop(address) };
            if (!runtime_class || !vmhook::hotspot::is_valid_pointer(runtime_class))
            { throw vmhook::exception{ "Java object runtime class cannot be resolved" }; }
            if constexpr (requires { wrapper_type::java_array_wrapper; })
            {
                if constexpr (wrapper_type::java_array_wrapper)
                {
                    const auto layout{ vmhook::detail::array_layout(runtime_class) };
                    if (!layout) { throw vmhook::exception{ "Java object is not an array" }; }
                    if (wrapper_type::java_contract.size() == 2)
                    {
                        if (runtime_class->get_name()->to_string() != wrapper_type::java_contract)
                        { throw vmhook::exception{ "Java primitive array does not match the wrapper element type" }; }
                    }
                    else if (!layout->reference_elements)
                    { throw vmhook::exception{ "Reference-array wrapper cannot wrap a primitive array" }; }
                    return;
                }
            }
            if constexpr (!std::is_same_v<wrapper_type, vmhook::any_object>)
            {
                std::string expected_name{ vmhook::detail::registered_class_name<wrapper_type>() };
                if (expected_name.empty())
                {
                    if constexpr (requires { std::string_view{ wrapper_type::java_contract }; })
                    { expected_name = wrapper_type::java_contract; }
                }
                if (expected_name.empty())
                { throw vmhook::exception{ "Object wrapper is not registered with a Java class" }; }
                auto* expected_class{ vmhook::detail::registered_class_klass<wrapper_type>() };
                if (!expected_class) { expected_class = vmhook::find_class(expected_name); }
                if (!expected_class || !container_class_assignable(runtime_class, expected_class))
                { throw vmhook::exception{ std::format("Java object does not match wrapper class '{}'", expected_name) }; }
            }
        }

        template<typename wrapper_type>
        [[nodiscard]] auto materialize_object(const std::uint32_t compressed,
            const native_backend::root& existing) -> std::unique_ptr<wrapper_type>
        {
            // A verified zero reference needs no JVM operation. The C++ object
            // still exists, including for null collection elements and map parts.
            if (!existing && compressed == 0) { return wrap_object<wrapper_type>(nullptr); }
            native_backend::operation access{};
            if (!access)
            { throw vmhook::exception{ "Java object conversion requires its native-thread or callback context" }; }
            auto root{ existing };
            if (!root)
            {
                void* const decoded{ vmhook::hotspot::decode_oop_pointer(compressed) };
                if (!decoded || !vmhook::hotspot::is_valid_pointer(decoded))
                { throw vmhook::exception{ "Java object reference could not be decoded" }; }
                root = retain_container_address(decoded);
            }
            void* const address{ container_address(root) };
            require_object_wrapper_type<wrapper_type>(address);
            auto result{ wrap_object<wrapper_type>(address) };
            result->set_native_root(root);
            return result;
        }

        template<container_wrapper wrapper_type>
        [[nodiscard]] auto wrap_container_element(const native_backend::root& root)
            -> std::unique_ptr<wrapper_type>
        { return materialize_object<wrapper_type>(0, root); }

        template<container_wrapper element_type>
        [[nodiscard]] auto container_array_vector(const native_backend::root& snapshot)
            -> std::vector<std::unique_ptr<element_type>>
        {
            const auto count{ container_array_length(snapshot) };
            std::vector<std::unique_ptr<element_type>> result;
            result.reserve(static_cast<std::size_t>(count));
            for (std::int32_t index{}; index < count; ++index)
            { result.push_back(wrap_container_element<element_type>(container_array_element(snapshot, index))); }
            return result;
        }

        [[nodiscard]] inline auto collection_snapshot(const native_backend::root& source) -> native_backend::root
        {
            require_container_contract(source, "java/util/Collection");
            auto snapshot{ container_result_root(call_container_method(source, "toArray", "()[Ljava/lang/Object;")) };
            if (!snapshot) { throw vmhook::exception{ "Collection.toArray returned null" }; }
            (void)container_array_length(snapshot);
            return snapshot;
        }
    }

    inline auto hotspot::method_args::operator[](const std::size_t index) const
        -> std::unique_ptr<vmhook::any_object>
    { return this->as<vmhook::any_object>(index); }

    inline auto return_value::throw_exception(const std::unique_ptr<vmhook::any_object>& throwable) -> void
    { vmhook::detail::raise_callback_exception(this->return_slot, this->stack_frame, throwable); }

    /* Java Collection wrappers use the public toArray contract. Snapshot order
       and concurrent-mutation semantics are those of the Java implementation.
       Returned unique_ptrs own C++ wrappers; their Java roots belong to the
       current native-thread or validated callback context. */
    class collection : public vmhook::oop_reflective_base
    {
    public:
        inline static constexpr std::string_view java_contract{ "java/util/Collection" };
        explicit collection(vmhook::oop_t oop = nullptr) noexcept : vmhook::oop_reflective_base{ oop } {}
        template<typename wrapper_type>
        explicit collection(const vmhook::borrowed<wrapper_type>& handle) noexcept
            : vmhook::oop_reflective_base{ handle.resolve() }
        { this->set_native_root(handle.get_native_root()); }

        auto size() const -> std::int32_t
        {
            vmhook::detail::native_backend::operation access{};
            const auto source{ vmhook::detail::container_source_root(*this) };
            if (!source) { return 0; }
            if (!access) { throw vmhook::exception{ "Collection access requires a native-thread or rooted callback context" }; }
            vmhook::detail::require_container_contract(source, "java/util/Collection");
            const auto result{ vmhook::detail::call_container_method(source, "size", "()I") };
            if (!std::holds_alternative<std::int32_t>(result.data))
            { throw vmhook::exception{ "Collection.size returned an invalid value" }; }
            return std::get<std::int32_t>(result.data);
        }
        auto is_empty() const -> bool { return this->size() == 0; }

        template<vmhook::detail::container_wrapper element_type>
        auto to_vector() const -> std::vector<std::unique_ptr<element_type>>
        {
            vmhook::detail::native_backend::operation access{};
            const auto source{ vmhook::detail::container_source_root(*this) };
            if (!source) { return {}; }
            if (!access) { throw vmhook::exception{ "Collection conversion requires a native-thread or rooted callback context" }; }
            return vmhook::detail::container_array_vector<element_type>(vmhook::detail::collection_snapshot(source));
        }
        auto to_vector() const -> vmhook::detail::vector_conversion<collection>
        { return vmhook::detail::vector_conversion<collection>{ *this }; }

        template<vmhook::detail::container_wrapper element_type>
        auto contains(const std::unique_ptr<element_type>& element) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "contains", "(Ljava/lang/Object;)Z", element); }
        template<vmhook::detail::container_wrapper element_type>
        auto add(const std::unique_ptr<element_type>& element) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "add", "(Ljava/lang/Object;)Z", element); }
        template<vmhook::detail::container_wrapper element_type>
        auto remove(const std::unique_ptr<element_type>& element) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "remove", "(Ljava/lang/Object;)Z", element); }
        template<vmhook::detail::container_wrapper collection_type>
        auto add_all(const std::unique_ptr<collection_type>& elements) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "addAll", "(Ljava/util/Collection;)Z", elements); }
        template<vmhook::detail::container_wrapper collection_type>
        auto contains_all(const std::unique_ptr<collection_type>& elements) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "containsAll", "(Ljava/util/Collection;)Z", elements); }
        template<vmhook::detail::container_wrapper collection_type>
        auto remove_all(const std::unique_ptr<collection_type>& elements) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "removeAll", "(Ljava/util/Collection;)Z", elements); }
        template<vmhook::detail::container_wrapper collection_type>
        auto retain_all(const std::unique_ptr<collection_type>& elements) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "retainAll", "(Ljava/util/Collection;)Z", elements); }
        auto clear() const -> void
        { (void)vmhook::detail::invoke_container(*this, java_contract, "clear", "()V"); }
        auto iterator() const -> vmhook::method_proxy::value_t
        { return vmhook::detail::invoke_container(*this, java_contract, "iterator", "()Ljava/util/Iterator;"); }
    };

