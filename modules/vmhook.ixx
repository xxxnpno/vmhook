    namespace detail
    {
        [[nodiscard]] inline auto ensure_bootstrap_class(const std::string_view class_name, const bool initialize = false)
            -> std::pair<vmhook::hotspot::klass*, native_backend::root>
        {
            native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Bootstrap class resolution requires a rooted VM context" }; }
            auto* target{ vmhook::find_class(class_name) };
            native_backend::root target_root{};
            if (!target || initialize)
            {
                // Bootstrap loading is ordinary Class.forName with the null
                // bootstrap loader. It runs on this worker through JavaCalls.
                auto* const class_class{ vmhook::find_class("java/lang/Class") };
                if (!class_class) { throw vmhook::exception{ "java.lang.Class is unavailable" }; }
                target_root = native_backend::retain_class(class_class);
                constexpr std::string_view lookup_signature{
                    "(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;" };
                vmhook::hotspot::method* lookup{};
                auto** const methods{ class_class->get_methods_ptr() };
                const auto count{ class_class->get_methods_count() };
                for (std::int32_t index{}; methods && index < count; ++index)
                {
                    auto* const method{ methods[index] };
                    if (method && method->get_name() == "forName" && method->get_signature() == lookup_signature)
                    { lookup = method; break; }
                }
                if (!lookup || !target_root) { throw vmhook::exception{ "Bootstrap class loading is unavailable" }; }
                std::string binary_name{ class_name };
                std::replace(binary_name.begin(), binary_name.end(), '/', '.');
                const auto bootstrap_loader{ wrap_object<vmhook::any_object>(nullptr) };
                const vmhook::method_proxy resolver{ nullptr, lookup, std::string{ lookup_signature }, true };
                target_root = container_result_root(resolver.call(binary_name, initialize, bootstrap_loader));
                target = vmhook::find_class(class_name);
                if (!target_root || !target || target->get_java_mirror() != target_root->resolve_under_vm())
                { throw vmhook::exception{ "Loaded bootstrap class identity could not be verified" }; }
            }
            else { target_root = native_backend::retain_class(target); }
            if (!target_root) { throw vmhook::exception{ "Bootstrap class mirror could not be retained" }; }
            return { target, std::move(target_root) };
        }

        inline auto registered_bootstrap_klass(const std::string_view class_name) -> vmhook::hotspot::klass*
        {
            native_backend::operation access{};
            if (!access || class_name.empty()) { return nullptr; }
            // Builtin contracts resolve through the ordinary bootstrap loader,
            // even if an application has defined a same-named helper class.
            auto* const class_class{vmhook::find_class("java/lang/Class")};
            if (!class_class) { throw vmhook::exception{"java.lang.Class is unavailable"}; }
            const auto class_root{native_backend::retain_class(class_class)};
            if (!class_root) { throw vmhook::exception{"Bootstrap Class mirror could not be retained"}; }
            auto* target{vmhook::find_class_via_oop(container_address(class_root), class_name)};
            if (target)
            {
                if (!native_backend::retain_class(target))
                { throw vmhook::exception{"Bootstrap class identity could not be retained"}; }
                return target;
            }
            constexpr std::string_view signature{"(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;"};
            vmhook::hotspot::method* lookup{};
            auto** const methods{class_class->get_methods_ptr()};
            const auto count{class_class->get_methods_count()};
            for (std::int32_t index{}; methods && index < count; ++index)
            {
                auto* const candidate{methods[index]};
                if (candidate && candidate->get_name() == "forName" && candidate->get_signature() == signature)
                { lookup = candidate; break; }
            }
            if (!lookup || !class_root) { throw vmhook::exception{"Bootstrap class identity lookup is unavailable"}; }
            std::string binary_name{class_name};
            std::replace(binary_name.begin(), binary_name.end(), '/', '.');
            const auto loader{wrap_object<vmhook::any_object>(nullptr)};
            const vmhook::method_proxy resolver{nullptr, lookup, std::string{signature}, true};
            const auto mirror{container_result_root(resolver.call(binary_name, false, loader))};
            const auto oop{container_address(mirror)};
            target = vmhook::find_class_via_oop(container_address(class_root), class_name);
            if (!target || target->get_java_mirror() != oop || !native_backend::retain_class(target))
            { throw vmhook::exception{"Bootstrap class identity could not be retained"}; }
            return target;
        }

        template<typename... argument_types>
        [[nodiscard]] inline auto call_bootstrap_method(const std::string_view class_name,
            const std::string_view name, const std::string_view signature,
            argument_types&&... arguments) -> vmhook::method_proxy::value_t
        {
            native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java bootstrap call requires a rooted VM context" }; }
            auto resolved{ ensure_bootstrap_class(class_name) };
            if (!vmhook::detail::class_initialized(resolved.first))
            { resolved = ensure_bootstrap_class(class_name, true); }
            auto* const target{ resolved.first };
            auto** const methods{ target->get_methods_ptr() };
            const auto count{ target->get_methods_count() };
            for (std::int32_t index{}; methods && index < count; ++index)
            {
                auto* const method{ methods[index] };
                if (!method || method->get_name() != name || method->get_signature() != signature) { continue; }
                const vmhook::method_proxy proxy{ nullptr, method, std::string{ signature }, true };
                auto result{ proxy.call(std::forward<argument_types>(arguments)...) };
                if (!result.was_invoked() || result.threw() || result.result_failed)
                { throw vmhook::exception{ std::format("Java bootstrap method '{}.{}{}' failed", class_name, name, signature) }; }
                return result;
            }
            throw vmhook::exception{ std::format("Java bootstrap method '{}.{}{}' is unavailable", class_name, name, signature) };
        }

        [[nodiscard]] inline auto array_component_mirror(const std::string_view descriptor)
            -> std::unique_ptr<vmhook::any_object>
        {
            if (descriptor.size() < 2 || descriptor.front() != '[')
            { throw vmhook::exception{ "Java array allocation requires an array descriptor" }; }
            const auto component{ descriptor.substr(1) };
            if (component.size() == 1)
            {
                constexpr std::array<std::string_view, 8> wrappers{
                    "java/lang/Boolean", "java/lang/Byte", "java/lang/Character", "java/lang/Short",
                    "java/lang/Integer", "java/lang/Long", "java/lang/Float", "java/lang/Double" };
                const auto index{ std::string_view{ "ZBCSIJFD" }.find(component.front()) };
                if (index == std::string_view::npos)
                { throw vmhook::exception{ "Java array has an invalid primitive component" }; }
                const auto [klass, class_root]{ ensure_bootstrap_class(wrappers[index], true) };
                const auto entry{ vmhook::find_field(klass, "TYPE") };
                auto* const holder{ entry && entry->declaring_klass ? entry->declaring_klass : klass };
                if (!entry || !entry->is_static || entry->signature != "Ljava/lang/Class;")
                { throw vmhook::exception{ "Primitive class mirror metadata is unavailable" }; }
                const vmhook::field_proxy type_field{
                    static_cast<std::byte*>(holder->get_java_mirror()) + entry->offset,
                    entry->signature, true, holder, entry->offset };
                std::unique_ptr<vmhook::any_object> result = type_field.get();
                if (!result->get_instance()) { throw vmhook::exception{ "Primitive component Class is null" }; }
                return result;
            }
            std::string_view name{};
            if (component.front() == '[') { name = component; }
            else if (component.size() > 2 && component.front() == 'L' && component.back() == ';')
            { name = component.substr(1, component.size() - 2); }
            else { throw vmhook::exception{ "Java array has an invalid reference component descriptor" }; }
            if (name.front() == '[' && name.find('L') == std::string_view::npos)
            {
                const auto bootstrap_loader{ wrap_object<vmhook::any_object>(nullptr) };
                auto result{ call_bootstrap_method("java/lang/Class", "forName",
                    "(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;",
                    std::string{name}, false, bootstrap_loader) };
                return materialize_object<vmhook::any_object>(0, container_result_root(result));
            }
            auto* const klass{ vmhook::find_class(name) };
            if (!klass) { throw vmhook::exception{ "Java array component class is not loaded" }; }
            const auto root{ native_backend::retain_class(klass) };
            if (!root) { throw vmhook::exception{ "Java array component mirror could not be retained" }; }
            return materialize_object<vmhook::any_object>(0, root);
        }

        [[nodiscard]] inline auto allocate_array_through_java(const std::string_view descriptor,
            const std::int32_t length, const std::size_t requested_width,
            const native_backend::root& component_override = {}) -> native_backend::root
        {
            native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array allocation requires a rooted VM context" }; }
            if (length < 0) { throw vmhook::exception{ "Java array length must be nonnegative" }; }
            const auto component{ component_override
                ? materialize_object<vmhook::any_object>(0, component_override) : array_component_mirror(descriptor) };
            auto result{ call_bootstrap_method("java/lang/reflect/Array", "newInstance",
                "(Ljava/lang/Class;I)Ljava/lang/Object;", component, length) };
            const auto root{ container_result_root(result) };
            if (!root) { throw vmhook::exception{ "Java Array.newInstance returned null" }; }
            const auto layout{ array_layout(vmhook::klass_from_oop(container_address(root))) };
            if (!layout || layout->element_width != requested_width)
            { throw vmhook::exception{ "Allocated array storage width does not match the requested element type" }; }
            return root;
        }

        template<typename element_type>
        inline constexpr std::string_view primitive_array_descriptor{
            []() consteval -> std::string_view
            {
                if constexpr (std::is_same_v<element_type, bool>) { return "[Z"; }
                else if constexpr (std::is_same_v<element_type, std::int8_t>) { return "[B"; }
                else if constexpr (std::is_same_v<element_type, std::uint16_t>) { return "[C"; }
                else if constexpr (std::is_same_v<element_type, std::int16_t>) { return "[S"; }
                else if constexpr (std::is_same_v<element_type, std::int32_t>) { return "[I"; }
                else if constexpr (std::is_same_v<element_type, std::int64_t>) { return "[J"; }
                else if constexpr (std::is_same_v<element_type, float>) { return "[F"; }
                else if constexpr (std::is_same_v<element_type, double>) { return "[D"; }
                else { return {}; }
            }()
        };
        template<typename element_type>
        concept java_array_element = !primitive_array_descriptor<element_type>.empty()
            || container_wrapper<element_type>;
    }

    /* Typed views retain the array, re-resolve it under every VM operation and
       bounds-check before access. Reference stores invoke Array.set so HotSpot
       performs covariance checks and the current collector's write barriers. */
    // The element constraint is delayed until instantiation so mutually
    // recursive wrappers can declare owning array results using forward types.
    template<typename element_type>
    class array : public vmhook::oop_reflective_base
    {
        static_assert(vmhook::detail::java_array_element<element_type>, "array elements must be Java primitives or wrappers");
        inline static constexpr bool references{ vmhook::detail::container_wrapper<element_type> };
        auto checked_root() const -> vmhook::detail::native_backend::root
        {
            const auto root{ vmhook::detail::container_source_root(*this) };
            if (!root) { throw vmhook::exception{ "Cannot access a Java-null array" }; }
            const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(vmhook::detail::container_address(root))) };
            if (!layout || layout->reference_elements != references
                || (!references && layout->element_width != sizeof(element_type)))
            { throw vmhook::exception{ "Java array storage does not match its C++ element type" }; }
            if constexpr (!references)
            {
                auto* const klass{ vmhook::klass_from_oop(vmhook::detail::container_address(root)) };
                if (klass->get_name()->to_string() != java_contract)
                { throw vmhook::exception{ "Java primitive array descriptor does not match its C++ type" }; }
            }
            return root;
        }
        auto checked_length(const vmhook::detail::native_backend::root& root) const -> std::int32_t
        {
            const auto address{ vmhook::detail::container_address(root) };
            const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(address)) };
            std::int32_t length{};
            if (!layout || !vmhook::os::safe_read(&length,
                static_cast<const std::byte*>(address) + layout->length_offset, sizeof(length)) || length < 0)
            { throw vmhook::exception{ "Java array length is unreadable" }; }
            return length;
        }
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr bool java_array_wrapper{ true };
        inline static constexpr std::string_view java_contract{ references
            ? "[Ljava/lang/Object;" : vmhook::detail::primitive_array_descriptor<element_type> };
        using java_element_type = element_type;
        using value_type = std::conditional_t<references, std::unique_ptr<element_type>, element_type>;
        static auto descriptor() -> std::string
        {
            if constexpr (!references)
            { return std::string{vmhook::detail::primitive_array_descriptor<element_type>}; }
            else if constexpr (requires { element_type::java_array_wrapper; typename element_type::java_element_type; })
            { return "[" + element_type::descriptor(); }
            else
            {
                std::string component{ vmhook::detail::registered_class_name<element_type>() };
                if (component.empty())
                {
                    if constexpr (requires { std::string_view{ element_type::java_contract }; })
                    { component = element_type::java_contract; }
                }
                if (component.empty()) { throw vmhook::exception{ "Java array element wrapper is not registered" }; }
                return "[L" + component + ";";
            }
        }
        auto size() const -> std::int32_t
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array access requires a rooted VM context" }; }
            return checked_length(checked_root());
        }
        auto is_empty() const -> bool { return size() == 0; }
        auto get(const std::int32_t index) const -> value_type
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array access requires a rooted VM context" }; }
            const auto root{ checked_root() };
            if (index < 0 || index >= checked_length(root)) { throw vmhook::exception{ "Java array index is out of bounds" }; }
            if constexpr (references)
            { return vmhook::detail::wrap_container_element<element_type>(vmhook::detail::container_array_element(root, index)); }
            else
            {
                const auto address{ vmhook::detail::container_address(root) };
                const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(address)) };
                element_type result{};
                if (!vmhook::os::safe_read(&result, static_cast<const std::byte*>(address) + layout->body_offset
                    + static_cast<std::size_t>(index) * sizeof(element_type), sizeof(result)))
                { throw vmhook::exception{ "Java array element could not be read" }; }
                return result;
            }
        }
        auto set(const std::int32_t index, const value_type& value) const -> void
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array access requires a rooted VM context" }; }
            const auto root{ checked_root() };
            if (index < 0 || index >= checked_length(root)) { throw vmhook::exception{ "Java array index is out of bounds" }; }
            if constexpr (references)
            {
                vmhook::detail::require_object_argument(value);
                const auto source{ vmhook::detail::materialize_object<vmhook::any_object>(0, root) };
                (void)vmhook::detail::call_bootstrap_method("java/lang/reflect/Array", "set",
                    "(Ljava/lang/Object;ILjava/lang/Object;)V", source, index, value);
            }
            else
            {
                const auto address{ vmhook::detail::container_address(root) };
                const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(address)) };
                if (!vmhook::os::safe_write(static_cast<std::byte*>(address) + layout->body_offset
                    + static_cast<std::size_t>(index) * sizeof(element_type), &value, sizeof(value)))
                { throw vmhook::exception{ "Java array element could not be written" }; }
            }
        }
        auto to_vector() const -> std::vector<value_type>
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array conversion requires a rooted VM context" }; }
            if (!this->get_instance()) { return {}; }
            const auto root{ checked_root() };
            const auto length{ checked_length(root) };
            std::vector<value_type> result;
            result.reserve(static_cast<std::size_t>(length));
            if constexpr (references)
            {
                for (std::int32_t index{}; index < length; ++index)
                { result.push_back(vmhook::detail::wrap_container_element<element_type>(vmhook::detail::container_array_element(root, index))); }
            }
            else if constexpr (std::is_same_v<element_type, bool>)
            {
                for (std::int32_t index{}; index < length; ++index) { result.push_back(get(index)); }
            }
            else
            {
                result.resize(static_cast<std::size_t>(length));
                const auto address{ vmhook::detail::container_address(root) };
                const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(address)) };
                if (length && !vmhook::os::safe_read(result.data(), static_cast<const std::byte*>(address)
                    + layout->body_offset, result.size() * sizeof(element_type)))
                { throw vmhook::exception{ "Java array bulk copy failed" }; }
            }
            return result;
        }
        auto copy_from(const std::unique_ptr<array>& source, const std::int32_t source_offset,
                       const std::int32_t destination_offset, const std::int32_t count) const -> void
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array copy requires a rooted VM context" }; }
            vmhook::detail::require_object_argument(source);
            const auto destination{ vmhook::detail::materialize_object<vmhook::any_object>(0, checked_root()) };
            (void)vmhook::detail::call_bootstrap_method("java/lang/System", "arraycopy",
                "(Ljava/lang/Object;ILjava/lang/Object;II)V", source, source_offset, destination, destination_offset, count);
        }
        auto copy_from(const std::vector<bool>& values, const std::int32_t offset = 0) const -> void
            requires (std::is_same_v<element_type, bool>)
        {
            const auto length{ size() };
            if (offset < 0 || offset > length || values.size() > static_cast<std::size_t>(length - offset))
            { throw vmhook::exception{ "Java boolean array copy is out of bounds" }; }
            for (std::size_t index{}; index < values.size(); ++index)
            { set(offset + static_cast<std::int32_t>(index), values[index]); }
        }
        auto copy_from(const std::span<const element_type> values, const std::int32_t offset = 0) const -> void
            requires (!references && !std::is_same_v<element_type, bool>)
        {
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{ "Java array copy requires a rooted VM context" }; }
            const auto root{ checked_root() };
            const auto length{ checked_length(root) };
            if (offset < 0 || offset > length || values.size() > static_cast<std::size_t>(length - offset))
            { throw vmhook::exception{ "Java array bulk copy is out of bounds" }; }
            const auto address{ vmhook::detail::container_address(root) };
            const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(address)) };
            if (!values.empty() && !vmhook::os::safe_write(static_cast<std::byte*>(address) + layout->body_offset
                + static_cast<std::size_t>(offset) * sizeof(element_type), values.data(), values.size_bytes()))
            { throw vmhook::exception{ "Java array bulk copy failed" }; }
        }
    };

    /* Fault-safe narrow-oop read retained for anchored-reference path walks.
       Readability alone does not provide object lifetime or a VM snapshot. */
    inline auto read_compressed_oop_at_safe(const void* const holder_oop,
                                            const std::size_t offset) noexcept -> std::uint32_t
    {
        std::uint32_t compressed{};
        (void)vmhook::os::safe_read_fast(&compressed,
            reinterpret_cast<const std::uint8_t*>(holder_oop) + offset, sizeof(compressed));
        return compressed;
    }

    template<vmhook::detail::container_wrapper element_type>
    auto field_proxy::value_t::to_vector() const -> std::vector<std::unique_ptr<element_type>>
    {
        this->require_success();
        if (!this->is_reference() || this->signature.empty()
            || (this->signature.front() != 'L' && this->signature.front() != '['))
        { throw vmhook::exception{ "Collection conversion requires a Java object or reference array field" }; }
        if (this->signature.front() == '[' && (this->signature.size() < 2
                || (this->signature[1] != 'L' && this->signature[1] != '[')))
        { throw vmhook::exception{ "Wrapper-vector conversion requires a Java reference array" }; }
        vmhook::detail::native_backend::operation access{};
        const auto source{ vmhook::detail::container_value_root(std::get<std::uint32_t>(this->data), this->native_root) };
        if (!source) { return {}; }
        if (!access) { throw vmhook::exception{ "Collection conversion requires a native-thread or rooted callback context" }; }
        if (this->signature.front() == '[' || vmhook::detail::array_layout(
                vmhook::klass_from_oop(vmhook::detail::container_address(source))))
        { return vmhook::detail::container_array_vector<element_type>(source); }
        collection wrapped{};
        wrapped.set_native_root(source);
        return wrapped.to_vector<element_type>();
    }
    template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
    auto field_proxy::value_t::to_entries() const
        -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>
    {
        this->require_success();
        if (!this->is_reference() || this->signature.empty() || this->signature.front() != 'L')
        { throw vmhook::exception{ "Map conversion requires a Java object field" }; }
        vmhook::detail::native_backend::operation access{};
        const auto source{ vmhook::detail::container_value_root(std::get<std::uint32_t>(this->data), this->native_root) };
        if (!source) { return {}; }
        if (!access) { throw vmhook::exception{ "Map conversion requires a native-thread or rooted callback context" }; }
        map wrapped{};
        wrapped.set_native_root(source);
        return wrapped.to_entries<key_type, mapped_type>();
    }
    template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
    auto field_proxy::value_t::to_vector() const
        -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>
    { return this->to_entries<key_type, mapped_type>(); }
    inline auto field_proxy::value_t::to_vector() const -> vmhook::detail::vector_conversion<value_t>
    { this->require_success(); return vmhook::detail::vector_conversion<value_t>{ *this }; }
    inline auto field_proxy::value_t::to_entries() const -> vmhook::detail::vector_conversion<value_t, true>
    { this->require_success(); return vmhook::detail::vector_conversion<value_t, true>{ *this }; }

    template<vmhook::detail::container_wrapper element_type>
    auto method_proxy::value_t::to_vector() const -> std::vector<std::unique_ptr<element_type>>
    {
        this->require_success();
        if (this->primitive_array_result)
        { throw vmhook::exception{ "Wrapper-vector conversion requires a Java reference array" }; }
        vmhook::detail::native_backend::operation access{};
        const auto source{ vmhook::detail::container_result_root(*this) };
        if (!source) { return {}; }
        if (!access) { throw vmhook::exception{ "Collection conversion requires a native-thread or rooted callback context" }; }
        if (vmhook::detail::array_layout(vmhook::klass_from_oop(vmhook::detail::container_address(source))))
        { return vmhook::detail::container_array_vector<element_type>(source); }
        collection wrapped{};
        wrapped.set_native_root(source);
        return wrapped.to_vector<element_type>();
    }
    template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
    auto method_proxy::value_t::to_entries() const
        -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>
    {
        this->require_success();
        if (this->reference_array_result)
        { throw vmhook::exception{ "Map conversion requires a Java object result" }; }
        vmhook::detail::native_backend::operation access{};
        const auto source{ vmhook::detail::container_result_root(*this) };
        if (!source) { return {}; }
        if (!access) { throw vmhook::exception{ "Map conversion requires a native-thread or rooted callback context" }; }
        map wrapped{};
        wrapped.set_native_root(source);
        return wrapped.to_entries<key_type, mapped_type>();
    }
    template<vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
    auto method_proxy::value_t::to_vector() const
        -> std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>
    { return this->to_entries<key_type, mapped_type>(); }
    inline auto method_proxy::value_t::to_vector() const -> vmhook::detail::vector_conversion<value_t>
    { this->require_success(); return vmhook::detail::vector_conversion<value_t>{ *this }; }
    inline auto method_proxy::value_t::to_entries() const -> vmhook::detail::vector_conversion<value_t, true>
    { this->require_success(); return vmhook::detail::vector_conversion<value_t, true>{ *this }; }

    // --- Helper: read a Java String OOP to std::string ------------------------

    /*
        @brief Decodes a Java String object into a std::string.
        @note Windows memory reads report accessibility failures; they do not
        validate object lifetime, prevent VM mutation, or register a GC root.
    */
    inline auto read_java_string_utf16(void* const string_oop) -> std::u16string
    {
        if (!string_oop)
        { throw vmhook::exception{ "A Java null String cannot be copied to a C++ string", vmhook::error_code::null_reference }; }
        if (!vmhook::detail::reference_reads_supported()
            || vmhook::detail::reference_storage_width() != sizeof(std::uint32_t)
            || !vmhook::hotspot::is_valid_pointer(string_oop))
        { throw vmhook::exception{ "Java String decoding requires a valid reference and verified narrow oops" }; }
        auto* const klass{ vmhook::find_class("java/lang/String") };
        if (!klass || vmhook::klass_from_oop(string_oop) != klass)
        { throw vmhook::exception{ "Java String decoding requires a java.lang.String instance" }; }
        const auto value_field{ klass->find_field("value") };
        if (!value_field) { throw vmhook::exception{ "Java String backing storage metadata is unavailable" }; }
        std::uint32_t narrow{};
        if (!vmhook::os::safe_read(&narrow, static_cast<const std::uint8_t*>(string_oop)
                + value_field->offset, sizeof(narrow)) || !narrow)
        { throw vmhook::exception{ "Java String backing storage is missing or unreadable" }; }
        auto* const array{ static_cast<const std::uint8_t*>(vmhook::hotspot::decode_oop_pointer(narrow)) };
        const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(const_cast<std::uint8_t*>(array))) };
        std::int32_t length{};
        if (!array || !layout || !vmhook::os::safe_read(&length, array + layout->length_offset, sizeof(length))
            || length < 0 || length > 2 * vmhook::read_java_string_max_units)
        { throw vmhook::exception{ "Java String backing array length is invalid or unreadable" }; }
        const auto coder_field{ klass->find_field("coder") };
        std::uint8_t coder{};
        if (coder_field && (!vmhook::os::safe_read(&coder, static_cast<const std::uint8_t*>(string_oop)
                + coder_field->offset, sizeof(coder)) || coder > 1))
        { throw vmhook::exception{ "Java String compact coder is invalid or unreadable" }; }
        if ((coder_field && layout->element_width != 1) || (!coder_field && layout->element_width != 2)
            || (coder_field && coder == 1 && length % 2 != 0))
        { throw vmhook::exception{ "Java String backing array geometry does not match its coder" }; }
        const std::size_t count{ static_cast<std::size_t>(coder_field && coder == 1 ? length / 2 : length) };
        if (count > static_cast<std::size_t>(vmhook::read_java_string_max_units))
        { throw vmhook::exception{ "Java String exceeds the checked copy limit" }; }
        std::u16string result(count, char16_t{});
        if (count == 0) { return result; }
        if (!coder_field || coder == 1)
        {
            if (!vmhook::os::safe_read(result.data(), array + layout->body_offset, count * sizeof(char16_t)))
            { throw vmhook::exception{ "Java String UTF-16 storage is unreadable" }; }
        }
        else
        {
            std::vector<std::uint8_t> bytes(count);
            if (!vmhook::os::safe_read(bytes.data(), array + layout->body_offset, count))
            { throw vmhook::exception{ "Java String Latin1 storage is unreadable" }; }
            for (std::size_t index{}; index < count; ++index) { result[index] = static_cast<char16_t>(bytes[index]); }
        }
        return result;
    }

    inline auto read_java_string(void* const string_oop) -> std::string
    {
        return vmhook::detail::utf16_to_utf8(vmhook::read_java_string_utf16(string_oop));
    }

    /*
        @brief Returns the decoded array or object OOP from a field_proxy.
        @details
        Reads the compressed OOP stored in field via get_compressed_oop() and decodes
        it using decode_array_oop().  Convenience wrapper used by set_str_field(),
        set_bool_array(), set_prim_array(), and set_str_array().

        Complexity: O(1).
        Exception safety: noexcept — returns nullptr if the field OOP is null or invalid.

        @param field  A field_proxy whose underlying field holds a reference or array OOP.
        @return  Decoded 64-bit heap pointer to the array/object, or nullptr on failure.
    */
    inline auto field_oop(const vmhook::field_proxy& field) noexcept
        -> void*
    {
        if (!vmhook::detail::reference_reads_supported()) { return nullptr; }
        return vmhook::decode_array_oop(field.get_compressed_oop());
    }

    /*
        @brief Rebinds a Java String field to a newly allocated String.
        @details Delegates to field_proxy::set; preserves shared and interned
        strings, copies the full UTF-8 input, and obeys reference-store guards.
    */
    inline auto set_str_field(const vmhook::field_proxy& field,
                              const std::string_view value) -> void
    {
        if (field.signature() != "Ljava/lang/String;") { return; }
        field.set(value);
    }

    /*
        @brief Writes a std::vector<bool> into a Java boolean[] field.
        @details
        Decodes the field's array OOP via field_oop(), then writes each element
        as uint8 (0 = false, 1 = true) into the backing boolean[] array.
        Writes only min(array_length, values.size()) elements.

        Complexity: O(N) where N = written element count.
        Exception safety: noexcept — returns silently if the OOP is null.

        @param field   A field_proxy whose field holds a boolean[] reference.
        @param values  Boolean values to write into the array.
    */
    inline auto set_bool_array(const vmhook::field_proxy& field, const std::vector<bool>& values) noexcept
        -> void
    {
        if (field.signature() != "[Z") { return; }
        void* const array_oop{ vmhook::field_oop(field) };
        if (!array_oop)
        {
            return;
        }

        const std::int32_t length{ static_cast<std::int32_t>(std::min<std::size_t>(
            static_cast<std::size_t>(vmhook::array_length(array_oop)), values.size())) };
        for (std::int32_t index{ 0 }; index < length; ++index)
        {
            vmhook::set_array_element<std::uint8_t>(array_oop, index, values[static_cast<std::size_t>(index)] ? 1u : 0u);
        }
    }

    /*
        @brief Writes a std::vector<element_type> into a Java primitive array field.
        @details
        Decodes the field's array OOP, then writes each element into the backing Java
        primitive array.  Special-cases char/uint16 conversion for "[C" (Java char[])
        fields: narrows each char to uint16 to avoid sign-extension issues.
        Writes only min(array_length, values.size()) elements.

        Complexity: O(N) where N = written element count.
        Exception safety: noexcept — returns silently if the OOP is null.

        @tparam element_type  Trivially copyable C++ element type (int, float, etc.).
        @param field   A field_proxy whose field holds a primitive array reference.
        @param values  Values to write into the array.
    */
    template<typename element_type>
    inline auto set_prim_array(const vmhook::field_proxy& field, const std::vector<element_type>& values) noexcept
        -> void
    {
        const std::string_view signature{ field.signature() };
        if (signature.size() != 2 || signature.front() != '['
            || vmhook::detail::jvm_primitive_byte_width(signature.substr(1)) == 0) { return; }
        void* const array_oop{ vmhook::field_oop(field) };
        if (!array_oop)
        {
            return;
        }

        // ELEMENT-WIDTH GUARD (mirrors read_array_value's refusal at 14817 and the
        // scalar field_proxy::set size-mismatch guard at 15601).  set_array_element
        // strides the backing array by sizeof(the C++ element), but the array's ACTUAL
        // element width is fixed by its JVM descriptor ([Z/[B=1, [S/[C=2, [I/[F=4,
        // [J/[D=8).  A wider C++ element (e.g. an int written into a byte[]) would write
        // PAST each element into adjacent heap = CORRUPTION; a narrower one mis-strides.
        // Refuse the write on any mismatch.  The char/"[C" branch below legitimately
        // writes uint16 (width 2), so it is carved out of this numeric comparison.
        if constexpr (!std::is_same_v<element_type, char>)
        {
            if (signature.size() >= 2 && signature.front() == '[')
            {
                const std::size_t field_element_width{
                    vmhook::detail::jvm_primitive_byte_width(signature.substr(1)) };
                if (field_element_width != 0 && sizeof(element_type) != field_element_width)
                {
                    ::vmhook::detail::log_line("{} set_prim_array: element-width mismatch (C++ element={}B, "
                               "JVM array element={}B, sig='{}') - refusing the write to avoid "
                               "corrupting the array data.  Write a std::vector whose element "
                               "matches the array's primitive width.",
                               vmhook::error_tag, sizeof(element_type), field_element_width, signature);
                    return;
                }
            }
        }

        const std::int32_t length{ static_cast<std::int32_t>(std::min<std::size_t>(
            static_cast<std::size_t>(vmhook::array_length(array_oop)), values.size())) };
        for (std::int32_t index{ 0 }; index < length; ++index)
        {
            const element_type& value{ values[static_cast<std::size_t>(index)] };
            if constexpr (std::is_same_v<element_type, char>)
            {
                if (field.signature() == "[C")
                {
                    vmhook::set_array_element<std::uint16_t>(array_oop, index, static_cast<std::uint16_t>(static_cast<unsigned char>(value)));
                }
                else
                {
                    vmhook::set_array_element<char>(array_oop, index, value);
                }
            }
            else
            {
                vmhook::set_array_element<element_type>(array_oop, index, value);
            }
        }
    }

    /*
        @brief Replaces Java String[] elements with freshly allocated Strings.
        @details
        Reuses the existing array, builds an independent String for each input,
        and stores its reference only on a verified write-barrier-free collector.
        Existing String objects and their shared backing arrays remain intact.
        Writes only min(array_length, values.size()) elements.

        Complexity: O(N * S) where N = element count, S = average string length.
        Exception safety: invalid slots return silently; C++ allocation errors propagate.

        @param field   A field_proxy whose field holds a String[] reference.
        @param values  New string contents for each slot.
    */
    inline auto set_str_array(const vmhook::field_proxy& field, const std::vector<std::string>& values)
        -> void
    {
        if (field.signature() != "[Ljava/lang/String;"
            || !vmhook::detail::reference_stores_supported()) { return; }
        void* const array_oop{ vmhook::field_oop(field) };
        if (!array_oop)
        {
            return;
        }

        const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array_oop)) };
        if (!layout || !layout->reference_elements
            || layout->element_width != vmhook::detail::reference_storage_width()) { return; }
        const std::int32_t length{ static_cast<std::int32_t>(std::min<std::size_t>(
            static_cast<std::size_t>(vmhook::array_length(array_oop)), values.size())) };
        for (std::int32_t index{ 0 }; index < length; ++index)
        {
            void* const string_oop{ vmhook::make_java_string(values[static_cast<std::size_t>(index)]) };
            if (!string_oop) { return; }
            if (layout->element_width == sizeof(std::uint32_t))
            {
                const std::uint32_t compressed{ vmhook::hotspot::encode_oop_pointer(string_oop) };
                if (!compressed) { return; }
                vmhook::set_array_element<std::uint32_t>(array_oop, index, compressed);
            }
            else if (layout->element_width == sizeof(void*))
            {
                vmhook::set_array_element<void*>(array_oop, index, string_oop);
            }
            else { return; }
        }
    }

    // --- Helper: decode compressed array OOP ---------------------------------

    /*
        @brief Decodes a 32-bit compressed array OOP into a raw pointer.
        @param compressed  A 32-bit compressed OOP value.
        @return A valid pointer if decoding succeeded, nullptr otherwise.
    */
    inline auto decode_array_oop(const std::uint32_t compressed)
        -> void*
    {
        if (!compressed)
        {
            return nullptr;
        }
        void* const decoded_pointer{ vmhook::hotspot::decode_oop_pointer(compressed) };
        return (decoded_pointer && vmhook::hotspot::is_valid_pointer(decoded_pointer)) ? decoded_pointer : nullptr;
    }

    // -------------------------------------------------------------------------
    // Static field hooks and class notifications. Definitions appear here
    // so their callback types see the complete `vmhook::object_base` type.
    // -------------------------------------------------------------------------

    // The value of a READ starts at zero: observation does not read the heap.
    // set() supplies a read result or changes the pending write; prevent() skips
    // the access. A prevented READ without set() returns its Java zero value.
    namespace detail { struct field_event_transport; }
    template<typename field_type>
    class field_access
    {
        static_assert(!std::is_reference_v<field_type>,"field_access requires a value type.");
        friend struct detail::field_event_transport;
        bool write_{};
        field_type value_{};
        bool prevented_{};
        bool replaced_{};
        explicit field_access(const bool write, const field_type value) noexcept
            : write_{write}, value_{value} {}
    public:
        [[nodiscard]] auto is_read() const noexcept -> bool { return !this->write_; }
        [[nodiscard]] auto is_write() const noexcept -> bool { return this->write_; }
        [[nodiscard]] auto value() const noexcept -> field_type { return this->value_; }
        auto set(const field_type value) noexcept -> void
        { this->value_ = value; this->replaced_ = true; }
        auto prevent() noexcept -> void { this->prevented_ = true; }
    };

    template<class wrapper_type>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    class field_access<std::unique_ptr<wrapper_type>>
    {
        friend struct detail::field_event_transport;
        bool write_{};
        std::unique_ptr<wrapper_type> value_{};
        bool prevented_{};
        bool replaced_{};
        explicit field_access(const bool write, std::unique_ptr<wrapper_type> value)
            : write_{write}, value_{std::move(value)} {}
    public:
        [[nodiscard]] auto is_read() const noexcept -> bool { return !this->write_; }
        [[nodiscard]] auto is_write() const noexcept -> bool { return this->write_; }
        [[nodiscard]] auto value() const noexcept -> const std::unique_ptr<wrapper_type>& { return this->value_; }
        auto set(const std::unique_ptr<wrapper_type>& value) -> void
        {
            vmhook::detail::require_object_argument(value);
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{"Reference field replacement requires a rooted VM operation"}; }
            auto root{value->get_native_root()};
            if (!root && value->get_instance()) { root = vmhook::detail::native_backend::retain_oop(value->get_instance()); }
            if (value->get_instance() && !root) { throw vmhook::exception{"Reference field replacement could not be retained"}; }
            this->value_ = vmhook::detail::materialize_object<wrapper_type>(0, root);
            this->replaced_ = true;
        }
        auto prevent() noexcept -> void { this->prevented_ = true; }
    };

    namespace detail
    {
        template<class wrapper_type, typename field_type, typename callback_type>
        inline auto install_field_hook(std::string_view, callback_type) -> std::uint64_t;
        inline auto remove_field_hook_id(std::uint64_t) noexcept -> bool;
        inline auto shutdown_field_hooks() noexcept -> void;
    }
    template<class wrapper_type, typename field_type, typename callback_type>
    inline auto hook_field(std::string_view field_name, callback_type callback) -> bool;
    template<class wrapper_type>
    inline auto unhook_field(std::string_view field_name) noexcept -> bool;

    // Compatibility observer: one synchronous notification before each write.
    // The first argument is zero; the second is the pending value, before store.
    template<class wrapper_type, typename field_type, typename callback_type>
    inline auto watch_static_field(std::string_view field_name, callback_type on_change) -> watch_handle
    {
        auto block{ std::make_shared<watch_handle::control_block>() };
        const auto id{ detail::install_field_hook<wrapper_type, field_type>(field_name,
            [callback = std::move(on_change)](field_access<field_type>& event) mutable
            {
                if (event.is_write())
                {
                    if constexpr (vmhook::detail::is_java_object_pointer_v<field_type>)
                    {
                        using value_wrapper = typename vmhook::detail::is_unique_ptr<field_type>::value_type_t;
                        const auto previous{std::make_unique<value_wrapper>(nullptr)};
                        callback(previous, event.value());
                    }
                    else { callback(field_type{}, event.value()); }
                }
            }) };
        if (!id) { return {}; }
        block->on_stop = [id]() noexcept { detail::remove_field_hook_id(id); };
        return watch_handle{ std::move(block) };
    }

    using class_observer_id = std::uint64_t;

    enum class class_load_phase : std::uint8_t
    {
        instance_loaded,
        array_created,
        archived_array_restored
    };

    // Borrowed metadata and references, valid only during this notification.
    // The CLD is the actual defining CLD, including weak hidden class holders.
    struct class_load_event final
    {
        vmhook::hotspot::klass* klass{};
        vmhook::hotspot::class_loader_data* defining_loader_data{};
        vmhook::oop_t defining_loader_oop{};
        std::string_view internal_name{};
        class_load_phase phase{};
        // Notification identity, not a retained Klass or class-loader handle.
        std::uint64_t event_id{};
    };

    // Plain copied data is safe after the VM callback returns. The event ID
    // identifies a notification; it deliberately cannot be used to dereference
    // metadata, infer class-loader identity or bind a wrapper.
    struct class_load_snapshot final
    {
        std::uint64_t event_id{};
        std::string internal_name{};
        class_load_phase phase{};
        bool bootstrap_loader{};
    };
    [[nodiscard]] inline auto copy_class_event(const class_load_event& event) -> class_load_snapshot
    {
        return { event.event_id, std::string{ event.internal_name }, event.phase, event.defining_loader_oop == nullptr };
    }

    // Fixed data for allocation-free callback capture. Long names are copied
    // with an explicit truncation flag; they cannot masquerade as exact names.
    struct class_load_record final
    {
        std::uint64_t event_id{};
        class_load_phase phase{};
        bool bootstrap_loader{}, truncated{};
        std::uint16_t name_length{};
        std::array<char, 1024> internal_name{};
        [[nodiscard]] auto name() const noexcept -> std::string_view
        { return { this->internal_name.data(), this->name_length }; }
    };
    [[nodiscard]] inline auto record_class_event(const class_load_event& event) noexcept -> class_load_record
    {
        class_load_record record{};
        record.event_id = event.event_id; record.phase = event.phase;
        record.bootstrap_loader = event.defining_loader_oop == nullptr;
        const auto length{ std::min(event.internal_name.size(), record.internal_name.size()) };
        record.name_length = static_cast<std::uint16_t>(length);
        record.truncated = length != event.internal_name.size();
        if (length) { std::memcpy(record.internal_name.data(), event.internal_name.data(), length); }
        return record;
    }

    // A bounded MPMC transport for copied telemetry, independent of Java calls.
    // Producers allocate nothing and never acquire a mutex. Full or repeatedly
    // contended writes are dropped and counted; a slow exporter cannot block a
    // Java callback. Owning Java wrappers belong in an explicit root transfer,
    // never in this raw-data queue.
    template<class event_type>
        requires std::is_trivially_copyable_v<event_type> && std::is_nothrow_copy_assignable_v<event_type>
    class bounded_event_queue final
    {
        struct slot final
        {
            std::atomic<std::size_t> sequence{};
            event_type value{};
        };
        std::unique_ptr<slot[]> slots_{};
        const std::size_t capacity_{};
        alignas(64) std::atomic<std::size_t> write_position_{};
        alignas(64) std::atomic<std::size_t> read_position_{};
        std::atomic<std::uint64_t> pushed_{}, popped_{}, dropped_{};
    public:
        explicit bounded_event_queue(const std::size_t capacity = 256) : capacity_{ capacity }
        {
            if (capacity < 2 || capacity > (std::size_t{ 1 } << 20) || (capacity & (capacity - 1)) != 0)
            { throw std::invalid_argument{ "An event queue capacity must be a power of two between 2 and 1048576." }; }
            this->slots_ = std::make_unique<slot[]>(capacity);
            for (std::size_t i{}; i < capacity; ++i) { this->slots_[i].sequence.store(i, std::memory_order_relaxed); }
        }
        bounded_event_queue(const bounded_event_queue&) = delete;
        auto operator=(const bounded_event_queue&) -> bounded_event_queue& = delete;
        [[nodiscard]] auto try_push(const event_type& event) noexcept -> bool
        {
            auto position{ this->write_position_.load(std::memory_order_relaxed) };
            for (unsigned attempt{}; attempt < 64; ++attempt)
            {
                auto& entry{ this->slots_[position & (this->capacity_ - 1)] };
                const auto sequence{ entry.sequence.load(std::memory_order_acquire) };
                const auto difference{ static_cast<std::intptr_t>(sequence - position) };
                if (difference == 0)
                {
                    if (!this->write_position_.compare_exchange_weak(position, position + 1, std::memory_order_relaxed)) { continue; }
                    entry.value = event;
                    entry.sequence.store(position + 1, std::memory_order_release);
                    this->pushed_.fetch_add(1, std::memory_order_relaxed);
                    return true;
                }
                if (difference < 0) { break; }
                position = this->write_position_.load(std::memory_order_relaxed);
            }
            this->dropped_.fetch_add(1, std::memory_order_relaxed);
            return false;
        }
        [[nodiscard]] auto try_pop(event_type& event) noexcept -> bool
        {
            auto position{ this->read_position_.load(std::memory_order_relaxed) };
            for (unsigned attempt{}; attempt < 64; ++attempt)
            {
                auto& entry{ this->slots_[position & (this->capacity_ - 1)] };
                const auto sequence{ entry.sequence.load(std::memory_order_acquire) };
                const auto difference{ static_cast<std::intptr_t>(sequence - (position + 1)) };
                if (difference == 0)
                {
                    if (!this->read_position_.compare_exchange_weak(position, position + 1, std::memory_order_relaxed)) { continue; }
                    event = entry.value;
                    entry.sequence.store(position + this->capacity_, std::memory_order_release);
                    this->popped_.fetch_add(1, std::memory_order_relaxed);
                    return true;
                }
                if (difference < 0) { return false; }
                position = this->read_position_.load(std::memory_order_relaxed);
            }
            return false;
        }
        [[nodiscard]] auto capacity() const noexcept -> std::size_t { return this->capacity_; }
        [[nodiscard]] auto pushed() const noexcept -> std::uint64_t { return this->pushed_.load(std::memory_order_relaxed); }
        [[nodiscard]] auto popped() const noexcept -> std::uint64_t { return this->popped_.load(std::memory_order_relaxed); }
        [[nodiscard]] auto dropped() const noexcept -> std::uint64_t { return this->dropped_.load(std::memory_order_relaxed); }
    };
    using class_event_queue = bounded_event_queue<class_load_record>;

    namespace detail
    {
        inline auto add_class_observer(std::function<void(const class_load_event&)> callback)
            -> class_observer_id;
        inline auto erase_class_observer(class_observer_id id) noexcept -> bool;
        inline auto disable_class_observers() noexcept -> void;
        inline auto class_event_notification_active() noexcept -> bool;
        inline auto ensure_class_events_installed() noexcept -> bool;
        inline auto reclaim_class_observers() noexcept -> bool;
        inline auto class_observers_idle() noexcept -> bool;
    }

    // Persistent, synchronous native notification; discarding the returned ID
    // keeps the observer installed. Zero means this exact JVM could not be
    // observed safely. Previously loaded classes are not replayed.
    //
    // Notifications cover successful ordinary, bootstrap and hidden/anonymous
    // definitions, new arrays and archived array restoration on the audited
    // Windows x64 HotSpot images. Failed definitions do not notify.
    //
    // The callback runs in VM state on the class-loading thread and must be
    // short: no blocking, Java calls, VM operations, hook installation or raw
    // reference retention. Callback exceptions are swallowed. Removal disables
    // subsequent callback entries; an already entered callback may complete.
    template<typename callback_type>
    inline auto on_class_loaded(callback_type on_load) -> class_observer_id
    {
        static_assert(std::is_invocable_v<callback_type&, const class_load_event&>
            || std::is_invocable_v<callback_type&, std::string_view>,
            "A class observer accepts const class_load_event& or std::string_view.");
        return detail::add_class_observer(
            [callback = std::move(on_load)](const class_load_event& event) mutable
            {
                if constexpr (std::is_invocable_v<callback_type&, const class_load_event&>)
                { std::invoke(callback, event); }
                else { std::invoke(callback, event.internal_name); }
            });
    }

    inline auto remove_class_observer(const class_observer_id id) noexcept -> bool
    {
        return detail::erase_class_observer(id);
    }

    // Keep the transport alive while notifications can enter it. Explicit
    // remove_class_observer() stops publication; reclaim_class_observers()
    // releases its captured shared owner from a native administrator.
    inline auto on_class_loaded(std::shared_ptr<class_event_queue> events) -> class_observer_id
    {
        if (!events) { throw std::invalid_argument{ "A class event queue cannot be empty." }; }
        return detail::add_class_observer([events = std::move(events)](const class_load_event& event)
        { (void)events->try_push(record_class_event(event)); });
    }
    inline auto reclaim_class_observers() noexcept -> bool { return detail::reclaim_class_observers(); }
    [[nodiscard]] inline auto class_observers_idle() noexcept -> bool { return detail::class_observers_idle(); }


    using deferred_hook_id = std::uint64_t;
    enum class deferred_hook_state : std::uint8_t
    { waiting_for_class, installing, installed, failed, cancelled };
    struct deferred_hook_info final
    {
        deferred_hook_id id{};
        method_hook_id installed_hook{};
        deferred_hook_state state{};
        std::uint64_t attempts{};
    };
    namespace detail
    {
        struct deferred_hook_attempt final { method_hook_id id{}; bool class_bound{}; };
        struct deferred_hook_node final
        {
            deferred_hook_id id{};
            class_observer_id class_observer{};
            std::string class_name{};
            std::function<deferred_hook_attempt()> install{};
            deferred_hook_node* previous{};
            std::atomic<bool> enabled{ true }, pending{ true }, busy{};
            std::atomic<method_hook_id> installed_hook{};
            std::atomic<deferred_hook_state> state{ deferred_hook_state::waiting_for_class };
            std::atomic<std::uint64_t> attempts{};
        };
        inline std::atomic<deferred_hook_node*> deferred_hook_head{};
        inline std::mutex deferred_hook_setup_mutex{};
        inline std::vector<std::unique_ptr<deferred_hook_node>> deferred_hook_nodes{};
        inline deferred_hook_id next_deferred_hook_id{ 1 };
        inline auto deferred_hook_native_owner() noexcept -> bool
        {
            return !hotspot::in_java_detour() && !class_event_notification_active()
                && static_cast<bool>(native_backend::active_context_lifetime());
        }
    }

    // A definition callback only marks readiness. The user's native owner
    // calls process_pending_hooks() after the class can be linked; all lookup,
    // roots, deoptimization and code patching happen outside the VM callback.
    // Ordinary Java calls on native workers never depend on this mechanism.
    template<class wrapper_type, class callback_type>
        requires detail::hook_callback_supported_v<callback_type>
    inline auto hook_when_loaded(std::string_view class_name, std::string_view method_name,
        std::string_view descriptor, callback_type&& callback, hook_options options = {}) -> deferred_hook_id
    {
        if (!detail::deferred_hook_native_owner())
        { throw vmhook::exception{ "Deferred hook registration requires a native_thread_context outside VM callbacks." }; }
        if (class_name.empty() || method_name.empty())
        { throw std::invalid_argument{ "A deferred hook requires its class and method name." }; }
        auto node{ std::make_unique<detail::deferred_hook_node>() };
        node->class_name = std::string{ class_name };
        node->install = [name = node->class_name, method = std::string{ method_name }, signature = std::string{ descriptor },
                         detour = std::forward<callback_type>(callback), options]() mutable -> detail::deferred_hook_attempt
        {
            if (!vmhook::register_class<wrapper_type>(name)) { return {}; }
            return { vmhook::add_hook<wrapper_type>(method, signature, detour, options), true };
        };
        std::lock_guard lock{ detail::deferred_hook_setup_mutex };
        node->id = detail::next_deferred_hook_id++;
        if (!node->id) { throw vmhook::exception{ "Deferred hook IDs exhausted." }; }
        auto* const pointer{ node.get() };
        // The resident node is prepared before observer publication. Failed
        // subscription never publishes a pointer whose storage can disappear.
        detail::deferred_hook_nodes.reserve(detail::deferred_hook_nodes.size() + 1);
        node->class_observer = vmhook::on_class_loaded([pointer](const class_load_event& event)
        {
            if (pointer->enabled.load(std::memory_order_seq_cst) && event.internal_name == pointer->class_name)
            { pointer->pending.store(true, std::memory_order_release); }
        });
        if (!node->class_observer) { return 0; }
        node->previous = detail::deferred_hook_head.load(std::memory_order_relaxed);
        detail::deferred_hook_nodes.push_back(std::move(node));
        detail::deferred_hook_head.store(pointer, std::memory_order_release);
        return pointer->id;
    }
    template<class wrapper_type, class callback_type>
        requires detail::hook_callback_supported_v<callback_type>
    inline auto hook_when_loaded(std::string_view class_name, std::string_view method_name,
        callback_type&& callback, hook_options options = {}) -> deferred_hook_id
    {
        return hook_when_loaded<wrapper_type>(class_name, method_name, std::string_view{},
            std::forward<callback_type>(callback), options);
    }
    // Returns successful installs. A class can have been defined but remain
    // unlinked at the first attempt; retry_deferred_hook() schedules another
    // native attempt without blocking the loading thread or inventing a pump.
    inline auto process_pending_hooks(const std::size_t maximum = 64) -> std::size_t
    {
        if (!detail::deferred_hook_native_owner())
        { throw vmhook::exception{ "Process deferred hooks on a native_thread_context outside VM callbacks." }; }
        std::size_t installed{}, processed{};
        for (auto* node{ detail::deferred_hook_head.load(std::memory_order_acquire) }; node && processed < maximum; node = node->previous)
        {
            if (!node->enabled.load(std::memory_order_seq_cst) || node->installed_hook.load(std::memory_order_seq_cst)
                || !node->pending.exchange(false, std::memory_order_acq_rel)) { continue; }
            if (node->busy.exchange(true, std::memory_order_seq_cst)) { node->pending.store(true, std::memory_order_release); continue; }
            if (!node->enabled.load(std::memory_order_seq_cst)) { node->busy.store(false, std::memory_order_seq_cst); continue; }
            ++processed; node->attempts.fetch_add(1, std::memory_order_relaxed);
            node->state.store(deferred_hook_state::installing, std::memory_order_release);
            detail::deferred_hook_attempt result{};
            try { result = node->install(); }
            catch (...) { result.class_bound = true; }
            node->installed_hook.store(result.id, std::memory_order_seq_cst);
            if (!node->enabled.load(std::memory_order_seq_cst))
            {
                if (result.id) { (void)remove_hook(result.id); }
                node->state.store(deferred_hook_state::cancelled, std::memory_order_release);
            }
            else
            {
                node->state.store(result.id ? deferred_hook_state::installed
                    : result.class_bound ? deferred_hook_state::failed : deferred_hook_state::waiting_for_class,
                    std::memory_order_release);
                if (result.id) { ++installed; }
            }
            node->busy.store(false, std::memory_order_seq_cst);
        }
        return installed;
    }
    inline auto retry_deferred_hook(const deferred_hook_id id) noexcept -> bool
    {
        for (auto* node{ detail::deferred_hook_head.load(std::memory_order_acquire) }; node; node = node->previous)
        {
            if (node->id == id && node->enabled.load(std::memory_order_seq_cst)
                && !node->installed_hook.load(std::memory_order_seq_cst))
            { node->pending.store(true, std::memory_order_release); return true; }
        }
        return false;
    }
    [[nodiscard]] inline auto deferred_hook_status(const deferred_hook_id id) noexcept -> std::optional<deferred_hook_info>
    {
        for (auto* node{ detail::deferred_hook_head.load(std::memory_order_acquire) }; node; node = node->previous)
        {
            if (node->id == id)
            {
                return deferred_hook_info{ id, node->installed_hook.load(std::memory_order_seq_cst),
                    node->enabled.load(std::memory_order_seq_cst) ? node->state.load(std::memory_order_acquire) : deferred_hook_state::cancelled,
                    node->attempts.load(std::memory_order_relaxed) };
            }
        }
        return std::nullopt;
    }
    inline auto remove_deferred_hook(const deferred_hook_id id) noexcept -> bool
    {
        for (auto* node{ detail::deferred_hook_head.load(std::memory_order_acquire) }; node; node = node->previous)
        {
            if (node->id != id || !node->enabled.exchange(false, std::memory_order_seq_cst)) { continue; }
            node->state.store(deferred_hook_state::cancelled, std::memory_order_release);
            (void)remove_class_observer(node->class_observer);
            if (const auto hook{ node->installed_hook.load(std::memory_order_seq_cst) }) { (void)remove_hook(hook); }
            return true;
        }
        return false;
    }
    namespace detail
    {
        inline auto disable_deferred_hooks() noexcept -> void
        {
            for (auto* node{ deferred_hook_head.load(std::memory_order_acquire) }; node; node = node->previous)
            {
                node->enabled.store(false, std::memory_order_seq_cst);
                node->state.store(deferred_hook_state::cancelled, std::memory_order_release);
            }
        }
    }
    inline auto reclaim_deferred_hooks() noexcept -> bool
    {
        if (!detail::deferred_hook_native_owner()) { return false; }
        try
        {
            std::vector<std::function<detail::deferred_hook_attempt()>> captures{};
            std::lock_guard lock{ detail::deferred_hook_setup_mutex };
            captures.reserve(detail::deferred_hook_nodes.size());
            for (auto& node : detail::deferred_hook_nodes)
            {
                if (!node->enabled.load(std::memory_order_seq_cst) && !node->busy.load(std::memory_order_seq_cst) && node->install)
                { captures.push_back(std::move(node->install)); }
            }
            return true;
        }
        catch (...) { return false; }
    }

    /*
        @brief Registry that owns the exception callbacks installed by
               on_exception.
    */
    namespace detail
    {
        using exception_callback_t = std::function<void(const std::string&)>;
        inline std::mutex                                          exception_mutex{};
        inline std::vector<std::shared_ptr<exception_callback_t>>  exception_callbacks{};
        inline bool                                                exception_hook_installed{ false };

        // Internal C++ wrapper for java.lang.Throwable used only by the
        // exception hook.  Not exposed publicly.
        class throwable_wrapper : public vmhook::object<throwable_wrapper>
        {
        public:
            explicit throwable_wrapper(vmhook::oop_t oop) noexcept
                : vmhook::object<throwable_wrapper>{ oop }
            {
            }
        };
    }

    namespace detail
    {
        inline auto reclaim_deferred_hook_captures() noexcept -> bool { return vmhook::reclaim_deferred_hooks(); }
    }

    struct throwable_stack_trace_event final
    {
        std::unique_ptr<vmhook::any_object> throwable{};
        std::string internal_name{};
    };
    // Exact event: entry to Throwable.fillInStackTrace(), including explicit
    // refreshes. This neither reports every construction nor observes throws,
    // rethrows or catches. The returned ID is persistent until remove_hook().
    template<class callback_type>
        requires std::is_invocable_v<callback_type&, const throwable_stack_trace_event&>
    inline auto on_throwable_stack_trace(callback_type&& callback) -> method_hook_id
    {
        if (detail::registered_class_name<detail::throwable_wrapper>().empty()
            && !vmhook::register_class<detail::throwable_wrapper>("java/lang/Throwable")) { return 0; }
        return add_hook<detail::throwable_wrapper>("fillInStackTrace", "()Ljava/lang/Throwable;",
            [observe = std::forward<callback_type>(callback)](return_value&, const std::unique_ptr<detail::throwable_wrapper>& self) mutable
            {
                throwable_stack_trace_event event{};
                event.throwable = std::make_unique<vmhook::any_object>(self->get_instance());
                if (auto* const klass{ vmhook::klass_from_oop(event.throwable->get_instance()) })
                { if (auto* const name{ klass->get_name() }) { event.internal_name = name->to_string(); } }
                if (event.internal_name.empty()) { event.internal_name = "java/lang/Throwable"; }
                std::invoke(observe, static_cast<const throwable_stack_trace_event&>(event));
            });
    }

    /*
        @brief Compatibility observer for Throwable.fillInStackTrace() calls.
        @warning This is not a throw/catch event or a complete construction
                 event. Explicit stack-trace refreshes also notify. Prefer
                 on_throwable_stack_trace() for the precise persistent API.
        @details
        Installs an interpreter hook on
        `java.lang.Throwable::fillInStackTrace()Ljava/lang/Throwable;`,
        which ordinary writable-stack-trace constructors generally call.  When the hook fires we read the dynamic klass off
        the receiver oop's narrow-klass header and dispatch the
        callback with the fully-qualified internal class name (`/`-
        separated).

        This catches NullPointerException, IOException,
        IllegalArgumentException, custom exceptions, and any other
        Throwable whose constructor goes through `fillInStackTrace`.
        It misses:
          - exceptions constructed with `writableStackTrace=false`
            (the protected constructor's writableStackTrace flag),
          - subclasses that override `fillInStackTrace` to a no-op
            for performance (rare; some preallocated VM errors do
            this).

        Event-driven: zero polling, zero idle cost.

        Exception safety: noexcept boundary — callback exceptions are
            caught and logged through log_line().
        Thread safety: the callback runs on the Java thread that
            constructed the throwable.

        @tparam callback_type Callable invoked as
                              `void(const std::string&)`.  The string
                              is the throwable's internal class name
                              (e.g. `"java/lang/NullPointerException"`).
    */
    template<typename callback_type>
    inline auto on_exception(callback_type on_throw) -> watch_handle
    {
        auto cb{ std::make_shared<detail::exception_callback_t>(std::move(on_throw)) };

        {
            std::lock_guard<std::mutex> guard{ detail::exception_mutex };
            detail::exception_callbacks.push_back(cb);

            if (!detail::exception_hook_installed)
            {
                if (vmhook::detail::registered_class_name<detail::throwable_wrapper>().empty())
                {
                    vmhook::register_class<detail::throwable_wrapper>("java/lang/Throwable");
                }

                auto fill_in_stack_trace_detour = [](
                    vmhook::return_value& /*ret*/,
                    const std::unique_ptr<detail::throwable_wrapper>& self)
                {
                    std::string internal_name{};
                    if (self)
                    {
                        if (auto* const dynamic_klass{ vmhook::klass_from_oop(self->get_instance()) })
                        {
                            if (auto* const sym{ dynamic_klass->get_name() })
                            {
                                internal_name = sym->to_string();
                            }
                        }
                    }
                    if (internal_name.empty())
                    {
                        internal_name = "java/lang/Throwable";
                    }

                    std::vector<std::shared_ptr<detail::exception_callback_t>> snapshot;
                    {
                        std::lock_guard<std::mutex> guard2{ detail::exception_mutex };
                        snapshot = detail::exception_callbacks;
                    }
                    for (auto& callback : snapshot)
                    {
                        if (!callback) { continue; }
                        try
                        {
                            (*callback)(internal_name);
                        }
                        catch (const std::exception& ex)
                        {
                            ::vmhook::detail::log_line("{} on_exception callback: {}",
                                       vmhook::error_tag, ex.what());
                        }
                    }
                };

                const bool installed = vmhook::hook<detail::throwable_wrapper>(
                    "fillInStackTrace",
                    "()Ljava/lang/Throwable;",
                    fill_in_stack_trace_detour);

                if (installed)
                {
                    detail::exception_hook_installed = true;
                }
                else
                {
                    ::vmhook::detail::log_line("{} on_exception: Throwable.fillInStackTrace hook installation failed",
                               vmhook::error_tag);
                }
            }
        }

        // Inert-watcher parity (see on_class_loaded): if the fillInStackTrace
        // hook never armed, return an empty handle (running() == false) and
        // drop the optimistically-pushed callback.
        {
            std::lock_guard<std::mutex> guard{ detail::exception_mutex };
            if (!detail::exception_hook_installed)
            {
                detail::exception_callbacks.erase(
                    std::remove(detail::exception_callbacks.begin(),
                                detail::exception_callbacks.end(), cb),
                    detail::exception_callbacks.end());
                return watch_handle{};
            }
        }

        auto block{ std::make_shared<watch_handle::control_block>() };
        block->on_stop = [cb]() noexcept
        {
            try
            {
                std::lock_guard<std::mutex> guard{ detail::exception_mutex };
                detail::exception_callbacks.erase(
                    std::remove(detail::exception_callbacks.begin(),
                                detail::exception_callbacks.end(), cb),
                    detail::exception_callbacks.end());
            }
            catch (const std::exception& ex)
            {
                ::vmhook::detail::log_line("{} on_exception on_stop: failed to erase callback: {} - swallowed.",
                           vmhook::error_tag, ex.what());
            }
            catch (...)
            {
                ::vmhook::detail::log_line("{} on_exception on_stop: unknown exception while erasing callback - "
                           "swallowed.", vmhook::error_tag);
            }
        };

        return watch_handle{ std::move(block) };
    }

    namespace detail
    {
        // Defined here (not next to shutdown_hooks) because it touches the
        // class_load_* / exception_* registries declared just above in this
        // same namespace.  Forward-declared near shutdown_hooks() so that
        // call site can reach it.  Clears both watcher install latches and
        // drops the stale callback lists, so the first on_class_loaded() /
        // on_exception() AFTER a shutdown_hooks() re-installs a live detour
        // instead of trusting a latch left true while the detour was torn down.
        inline auto reset_watcher_latches() noexcept -> void
        {
            vmhook::detail::disable_class_observers();
            {
                std::lock_guard<std::mutex> guard{ exception_mutex };
                exception_hook_installed = false;
                exception_callbacks.clear();
            }
        }
    }

    // Read-only capability and collection sampling. These observations detect
    // some stale addresses; they do not root objects or prevent concurrent GC.

    /*
        @brief The HotSpot collector this VM is actually running.
        @details
        Determined by walking the JVM flag table (`Flag` on JDK 8, `JVMFlag` on
        11+) and reading the `Use*GC` booleans - i.e. by asking the VM what it
        selected, not by guessing from a version number or from which types the
        build happened to compile in.  `unknown` means the detection failed and
        is treated as UNSUPPORTED, never as "probably fine".

        `z` and `shenandoah` are recognised precisely so they can be REFUSED:
        both relocate concurrently, and both bump their collection counters at
        cycle START - phases before any object is copied - so an unchanged
        counter proves nothing there and the detector would itself become
        silent UB.  `epsilon` never moves anything, so it is supported with a
        trivially-always-fresh epoch.
    */
    enum class gc_collector : std::uint8_t
    {
        unknown = 0,
        serial,
        parallel,
        g1,
        z,
        shenandoah,
        epsilon
    };

    /*
        @brief Which spelling of the card-table / barrier-set hierarchy this VM exports, derived from what RESOLVES rather than from a version.
    */
    enum class gc_barrier_shape : std::uint8_t
    {
        unknown = 0,
        card_table_modref_bs,
        card_table_barrier_set
    };

    /*
        @brief Cached, computed-once description of what this JVM supports.
        @details
        Obtain it from vmhook::vm_capabilities().  Every member is derived from
        `gHotSpotVMStructs` / `gHotSpotVMTypes` reads only - nothing here writes
        to the VM, allocates, or takes a lock.  With no JVM in the process every
        field keeps its default, which reads as "unknown / unsupported".

        `supported` is the single gate the relocation detector consults: it is
        true only for Serial, Parallel, G1 (where `_total_collections` provably
        ticks BEFORE any object is copied) and Epsilon (which never copies).
        It is false for ZGC, Shenandoah, an undetermined collector, or when the
        epoch counter itself cannot be resolved.
    */
    struct vm_capabilities_t final
    {
        /* Collector selected by the VM, or `unknown` if it could not be read. */
        vmhook::gc_collector     collector{ vmhook::gc_collector::unknown };
        /* Card-table spelling this VM exports (diagnostics; unused by Layer 1). */
        vmhook::gc_barrier_shape barrier{ vmhook::gc_barrier_shape::unknown };
        /* True when the relocation detector is SOUND on this VM. */
        bool supported{ false };
        /* `-XX:+UseCompressedOops`.  The flag table is the only reliable source. */
        bool compressed_oops{ false };
        /* `-XX:+UseCompactObjectHeaders` (JDK 25+); changes the klass encoding. */
        bool compact_object_headers{ false };
        /* True when the flag walk succeeded; when false, the two booleans above
           are defaults, not observations. */
        bool flags_resolved{ false };
        /* True when Universe::_collectedHeap + CollectedHeap::_total_collections
           + the gc-active flag all resolved. */
        bool epoch_readable{ false };
    };

    /*
        @brief A sample of the VM's collection counter, taken as a PAIR.
        @details
        `collections` is `CollectedHeap::_total_collections`, which counts every
        started collection (young and full) on Serial, Parallel and G1 and is
        incremented BEFORE any object is copied.  `gc_active` is
        `CollectedHeap::_is_gc_active` (renamed `_is_stw_gc_active` at JDK 21;
        both names are probed) and is true only inside a stop-the-world pause.

        `valid` is false whenever the sample could not be trusted - no JVM, the
        offsets did not resolve, the read faulted, or the collector is one on
        which the counter does not mean what we need it to mean.  An invalid
        sample is ALWAYS treated as "stale"; it never degrades to "assume the
        object did not move".
    */
    struct gc_epoch_t final
    {
        std::uint32_t collections{ 0 };
        bool          gc_active{ true };
        bool          valid{ false };
    };

    namespace detail
    {
        /*
            @brief Reads a NUL-terminated C string out of possibly-unmapped memory without ever faulting.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        inline auto safe_read_c_string(const void* const pointer,
                                       char* const out,
                                       const std::size_t capacity) noexcept
            -> bool
        {
            if (!pointer || !out || capacity == 0)
            {
                return false;
            }
            constexpr std::size_t chunk{ 16 };
            std::size_t filled{ 0 };
            while (filled + 1 < capacity)
            {
                const std::size_t want{ std::min<std::size_t>(chunk, capacity - 1 - filled) };
                if (!vmhook::os::safe_read(out + filled,
                                           static_cast<const std::uint8_t*>(pointer) + filled,
                                           want))
                {
                    out[filled] = '\0';
                    return false;
                }
                for (std::size_t i{ 0 }; i < want; ++i)
                {
                    if (out[filled + i] == '\0')
                    {
                        return true;
                    }
                }
                filled += want;
            }
            out[capacity - 1] = '\0';
            return false;
        }

        /*
            @brief Resolved geometry of the HotSpot JVM flag table.
            @details
            `Flag` on JDK 8, renamed `JVMFlag` at JDK 11 (JDK-8211821); the
            entry names and the walk are otherwise identical.  Two rules make
            this robust and both are load-bearing:

              * `stride` comes from `gHotSpotVMTypes[<flag type>].size`, NEVER
                from sizeof - the `_doc` member exists only in non-product
                builds, so a compiled-in struct size is wrong against a product
                VM.
              * `type_is_string` comes from the EXPORTED typeString of the
                `_type` field ("const char*" => JDK 8/11 shape, "int" => the
                17+ ordinal shape).  The table describes its own shape, so no
                JDK version is ever sniffed.
        */
        struct jvm_flag_table_t final
        {
            const std::uint8_t* base{ nullptr };
            std::size_t         count{ 0 };
            std::size_t         stride{ 0 };
            std::uint64_t       name_offset{ 0 };
            std::uint64_t       addr_offset{ 0 };
            std::uint64_t       type_offset{ 0 };
            bool                has_type{ false };
            bool                type_is_string{ false };
            bool                resolved{ false };
        };

        /*
            @brief Reads the flag name at `index` into `out`.
            @details
            Every hop is fault-safe: the record's `_name` slot is read with
            safe_read_pointer and the string itself with safe_read_c_string.
            Complexity: O(1) amortised.  Exception safety: noexcept.
            Thread safety: safe (reads only).
        */
        inline auto read_jvm_flag_name(const vmhook::detail::jvm_flag_table_t& table,
                                       const std::size_t index,
                                       char* const out,
                                       const std::size_t capacity) noexcept
            -> bool
        {
            const std::uint8_t* const record{ table.base + index * table.stride };
            const void* const name_pointer{
                vmhook::hotspot::safe_read_pointer(record + table.name_offset) };
            if (!name_pointer)
            {
                return false;
            }
            return vmhook::detail::safe_read_c_string(name_pointer, out, capacity);
        }

        /*
            @brief Resolves the JVM flag table once, or reports it unusable.
            @details
            `Flag::flags` is an array on JDK 8 and a `JVMFlag*` on 11+, so the
            base is recovered by trying the dereferenced value first and falling
            back to the entry address itself; the winner is the one whose
            record 0 yields a readable flag name.  `numFlags - 1` entries are
            walkable - the last record is an all-null sentinel.

            Every failure path returns an unresolved table rather than guessing,
            so a JVM this code has never seen degrades to "capabilities unknown"
            instead of misreading arbitrary memory.
            Complexity: O(1) (a handful of VMStructs lookups + 2 probe reads).
            Exception safety: noexcept.  Thread safety: safe (reads only).
        */
        auto resolve_jvm_flag_table() noexcept
            -> const vmhook::detail::jvm_flag_table_t&
        {
            static const vmhook::detail::jvm_flag_table_t table{ []() noexcept
                -> vmhook::detail::jvm_flag_table_t
                {
                    vmhook::detail::jvm_flag_table_t result{};

                    const char* const type_name{
                        vmhook::hotspot::iterate_struct_entries("JVMFlag", "flags")
                            ? "JVMFlag"
                            : "Flag" };

                    const auto* const flags_entry{
                        vmhook::hotspot::iterate_struct_entries(type_name, "flags") };
                    const auto* const count_entry{
                        vmhook::hotspot::iterate_struct_entries(type_name, "numFlags") };
                    const auto* const name_entry{
                        vmhook::hotspot::iterate_struct_entries(type_name, "_name") };
                    const auto* const addr_entry{
                        vmhook::hotspot::iterate_struct_entries(type_name, "_addr") };
                    const auto* const type_entry{
                        vmhook::hotspot::iterate_struct_entries(type_name, "_type") };
                    const auto* const type_descriptor{
                        vmhook::hotspot::iterate_type_entries(type_name) };

                    if (!flags_entry || !flags_entry->address
                     || !count_entry || !count_entry->address
                     || !name_entry || !addr_entry
                     || !type_descriptor || type_descriptor->size == 0)
                    {
                        return result;
                    }

                    // Stride from the VM's own type table, never sizeof.
                    // Bound it so a garbage size cannot turn the walk into an
                    // out-of-range stride computation.
                    if (type_descriptor->size > 4096)
                    {
                        return result;
                    }
                    result.stride = static_cast<std::size_t>(type_descriptor->size);

                    std::size_t flag_count{ 0 };
                    if (!vmhook::os::safe_read(&flag_count, count_entry->address, sizeof(flag_count)))
                    {
                        return result;
                    }
                    // A plausible product VM publishes ~1000-2000 flags.  Reject
                    // anything that cannot be a real count so a mis-resolved
                    // static never drives a multi-million-iteration walk.
                    if (flag_count < 2 || flag_count > 100000)
                    {
                        return result;
                    }
                    // The final record is an all-null sentinel (SA does the same).
                    result.count = flag_count - 1;

                    result.name_offset = name_entry->offset;
                    result.addr_offset = addr_entry->offset;
                    if (type_entry)
                    {
                        result.has_type    = true;
                        result.type_offset = type_entry->offset;
                        // The table declares its own shape: "const char*" is the
                        // JDK 8 / 11 string spelling, anything else (int) is the
                        // JDK 17+ ordinal spelling.
                        result.type_is_string = type_entry->type_string
                                             && std::strcmp(type_entry->type_string, "const char*") == 0;
                    }

                    // JDK 8 declares `static Flag flags[]`, JDK 11+ declares
                    // `static JVMFlag* flags`.  Try the pointer reading first,
                    // then the entry address itself, and accept whichever one
                    // produces a readable flag name at record 0.
                    const std::uint8_t* const candidates[]{
                        static_cast<const std::uint8_t*>(
                            vmhook::hotspot::safe_read_pointer(flags_entry->address)),
                        static_cast<const std::uint8_t*>(flags_entry->address)
                    };
                    char probe[64]{};
                    for (const std::uint8_t* const candidate : candidates)
                    {
                        if (!vmhook::hotspot::is_valid_pointer(candidate))
                        {
                            continue;
                        }
                        result.base = candidate;
                        if (vmhook::detail::read_jvm_flag_name(result, 0, probe, sizeof(probe))
                            && probe[0] >= 'A' && probe[0] <= 'z')
                        {
                            result.resolved = true;
                            return result;
                        }
                    }

                    result.base     = nullptr;
                    result.resolved = false;
                    return result;
                }() };
            return table;
        }

        /*
            @brief The `bool` flags Layer 0 cares about, read in one table walk.
        */
        struct gc_flag_values_t final
        {
            bool use_serial{ false };
            bool use_parallel{ false };
            bool use_g1{ false };
            bool use_z{ false };
            bool use_shenandoah{ false };
            bool use_epsilon{ false };
            bool compressed_oops{ false };
            bool compact_object_headers{ false };
            bool compact_object_headers_found{ false };
            bool object_monitor_table{ false };
            bool object_monitor_table_found{ false };
            bool compressed_klass{ false };
            bool compressed_klass_found{ false };
            bool compressed_oops_found{ false };
            bool resolved{ false };
        };

        /*
            @brief Walks the flag table once and reads the nine bools we need.
        */
        auto read_gc_flags() noexcept
            -> vmhook::detail::gc_flag_values_t
        {
            vmhook::detail::gc_flag_values_t values{};
            const vmhook::detail::jvm_flag_table_t& table{ vmhook::detail::resolve_jvm_flag_table() };
            if (!table.resolved || !table.has_type)
            {
                return values;
            }

            struct wanted_t final
            {
                const char* name;
                bool vmhook::detail::gc_flag_values_t::* member;
            };
            static constexpr wanted_t wanted[]{
                { "UseSerialGC",             &vmhook::detail::gc_flag_values_t::use_serial },
                { "UseParallelGC",           &vmhook::detail::gc_flag_values_t::use_parallel },
                { "UseG1GC",                 &vmhook::detail::gc_flag_values_t::use_g1 },
                { "UseZGC",                  &vmhook::detail::gc_flag_values_t::use_z },
                { "UseShenandoahGC",         &vmhook::detail::gc_flag_values_t::use_shenandoah },
                { "UseEpsilonGC",            &vmhook::detail::gc_flag_values_t::use_epsilon },
                { "UseCompressedOops",       &vmhook::detail::gc_flag_values_t::compressed_oops },
                { "UseCompressedClassPointers", &vmhook::detail::gc_flag_values_t::compressed_klass },
                { "UseCompactObjectHeaders", &vmhook::detail::gc_flag_values_t::compact_object_headers },
                { "UseObjectMonitorTable", &vmhook::detail::gc_flag_values_t::object_monitor_table },
            };

            char name[64]{};
            std::size_t matched{ 0 };
            for (std::size_t index{ 0 }; index < table.count; ++index)
            {
                if (!vmhook::detail::read_jvm_flag_name(table, index, name, sizeof(name)))
                {
                    return {}; // Unknown record may contain a required layout flag.
                }
                if (name[0] != 'U')
                {
                    continue;
                }

                const wanted_t* hit{ nullptr };
                for (const wanted_t& candidate : wanted)
                {
                    if (std::strcmp(name, candidate.name) == 0)
                    {
                        hit = &candidate;
                        break;
                    }
                }
                if (!hit)
                {
                    continue;
                }

                const std::uint8_t* const record{ table.base + index * table.stride };

                // Only trust a record the VM itself labels `bool`.
                if (table.has_type)
                {
                    if (table.type_is_string)
                    {
                        const void* const type_pointer{
                            vmhook::hotspot::safe_read_pointer(record + table.type_offset) };
                        char type_name[32]{};
                        if (!vmhook::detail::safe_read_c_string(type_pointer, type_name, sizeof(type_name))
                            || std::strcmp(type_name, "bool") != 0)
                        {
                            return {}; // A present flag with an unreadable type is unknown.
                        }
                    }
                    else
                    {
                        std::int32_t ordinal{ -1 };
                        if (!vmhook::os::safe_read(&ordinal, record + table.type_offset, sizeof(ordinal))
                            || ordinal != 0)   // JVMFlag::TYPE_bool == 0 on every 17+ VM
                        {
                            return {}; // A present flag with an unreadable type is unknown.
                        }
                    }
                }

                const void* const value_address{
                    vmhook::hotspot::safe_read_pointer(record + table.addr_offset) };
                std::uint8_t raw{ 0 };
                if (value_address
                    && vmhook::os::safe_read(&raw, value_address, sizeof(raw)) && raw <= 1)
                {
                    values.*(hit->member) = raw != 0;
                    if (std::strcmp(name, "UseCompressedClassPointers") == 0)
                    {
                        values.compressed_klass_found = true;
                    }
                    if (std::strcmp(name, "UseCompressedOops") == 0)
                    {
                        values.compressed_oops_found = true;
                    }
                    if (std::strcmp(name, "UseCompactObjectHeaders") == 0)
                    {
                        values.compact_object_headers_found = true;
                    }
                    if (std::strcmp(name, "UseObjectMonitorTable") == 0)
                    {
                        values.object_monitor_table_found = true;
                    }
                }

                else
                {
                    return {}; // A failed read must not masquerade as false.
                }

                if (++matched >= (sizeof(wanted) / sizeof(wanted[0])))
                {
                    break;
                }
            }

            values.resolved = true;
            return values;
        }

        auto compressed_klass_mode() noexcept -> std::optional<bool>
        {
            static const auto flags{ vmhook::detail::read_gc_flags() };
            if (!flags.resolved) { return std::nullopt; }
            if (flags.compact_object_headers_found && flags.compact_object_headers)
            {
                if (flags.compressed_klass_found && !flags.compressed_klass) { return std::nullopt; }
                return true; // Compact headers always contain a narrow Klass.
            }
            if (flags.compressed_klass_found) { return flags.compressed_klass; }
            // JDK 27 removed UseCompressedClassPointers and the wide union
            // member. This observed metadata shape proves mandatory narrow
            // Klass storage; an absent flag alone never implies its default.
            static const auto* const narrow{ vmhook::hotspot::iterate_struct_entries("oopDesc", "_compressed_klass") };
            static const auto* const wide{ vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._klass") };
            static constexpr vmhook::hotspot::struct_entry_candidate_t bases[]{
                { "CompressedKlassPointers", "_base" }, { "CompKlass", "_base" } };
            static constexpr vmhook::hotspot::struct_entry_candidate_t shifts[]{
                { "CompressedKlassPointers", "_shift" }, { "CompKlass", "_shift" } };
            return narrow && !wide
                && vmhook::hotspot::resolve_struct_entry(bases, std::size(bases))
                && vmhook::hotspot::resolve_struct_entry(shifts, std::size(shifts))
                ? std::optional{true} : std::nullopt;
        }

        auto compact_object_header_mode() noexcept -> std::optional<bool>
        {
            static const auto flags{ vmhook::detail::read_gc_flags() };
            if (!flags.resolved) { return std::nullopt; }
            if (flags.compact_object_headers_found) { return flags.compact_object_headers; }
            // Older VMs export the ordinary-header union and no compact Klass
            // mark coordinates. Do not guess for an unfamiliar compact layout.
            return vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._klass")
                && !vmhook::detail::vm_long_constant("markWord::klass_shift")
                ? std::optional{false} : std::nullopt;
        }

        struct compact_header_constants_t final
        {
            std::uint32_t klass_shift{};
            std::uint32_t lock_mask{};
            std::uint32_t locked_value{};
            std::uint32_t neutral_value{};
            std::uint32_t monitor_value{};
            std::uint32_t marked_value{};
        };

        inline auto compact_klass_bits(const std::uint64_t mark,
            const compact_header_constants_t& constants, const bool monitor_table) noexcept
            -> std::optional<std::uint32_t>
        {
            if (constants.klass_shift < 32 || constants.klass_shift >= 64
                || constants.lock_mask == 0 || constants.lock_mask > 0xff
                || (constants.locked_value & ~constants.lock_mask) != 0
                || (constants.neutral_value & ~constants.lock_mask) != 0
                || (constants.monitor_value & ~constants.lock_mask) != 0
                || (constants.marked_value & ~constants.lock_mask) != 0
                || constants.locked_value == constants.neutral_value
                || constants.locked_value == constants.monitor_value
                || constants.locked_value == constants.marked_value
                || constants.neutral_value == constants.monitor_value
                || constants.neutral_value == constants.marked_value
                || constants.monitor_value == constants.marked_value) { return std::nullopt; }
            const auto state{ mark & constants.lock_mask };
            if (state != constants.locked_value && state != constants.neutral_value
                && !(monitor_table && state == constants.monitor_value)) { return std::nullopt; }
            const auto narrow{ mark >> constants.klass_shift };
            return narrow != 0 && narrow <= (std::numeric_limits<std::uint32_t>::max)()
                ? std::optional{static_cast<std::uint32_t>(narrow)} : std::nullopt;
        }

        auto compact_klass_from_mark(const std::uint64_t mark) noexcept
            -> std::optional<std::uint32_t>
        {
            const auto constant{ [](const char* first, const char* second = nullptr)
                -> std::optional<std::uint64_t>
            {
                auto value{ vmhook::detail::vm_long_constant(first) };
                return value || !second ? value : vmhook::detail::vm_long_constant(second);
            } };
            struct coordinates_t final
            {
                std::optional<std::uint64_t> shift, mask, locked, neutral, monitor, marked;
            };
            static const coordinates_t coordinates{
                constant("markWord::klass_shift"), constant("markWord::lock_mask_in_place"),
                constant("markWord::fast_locked_value", "markWord::locked_value"),
                constant("markWord::lock_neutral_value", "markWord::unlocked_value"),
                constant("markWord::monitor_value"), constant("markWord::marked_value") };
            if (!coordinates.shift || !coordinates.mask || !coordinates.locked
                || !coordinates.neutral || !coordinates.monitor || !coordinates.marked)
            { return std::nullopt; }
            if (*coordinates.shift >= 64 || *coordinates.mask > 0xff
                || *coordinates.locked > 0xff || *coordinates.neutral > 0xff
                || *coordinates.monitor > 0xff || *coordinates.marked > 0xff)
            { return std::nullopt; }
            static const auto flags{ vmhook::detail::read_gc_flags() };
            if (!flags.resolved || !flags.compact_object_headers_found || !flags.compact_object_headers)
            { return std::nullopt; }
            // On older compact-capable VMs the flag must actually be enabled.
            // Newer VMs removed both it and the wide Klass union after making
            // lightweight locking plus monitor-table storage unconditional.
            static const bool monitor_table{ flags.object_monitor_table_found
                ? flags.object_monitor_table
                : vmhook::hotspot::iterate_struct_entries("oopDesc", "_compressed_klass")
                    && !vmhook::hotspot::iterate_struct_entries("oopDesc", "_metadata._klass")
                    && vmhook::detail::vm_long_constant("markWord::fast_locked_value").has_value()
                    && vmhook::detail::vm_long_constant("markWord::lock_neutral_value").has_value() };
            return compact_klass_bits(mark, compact_header_constants_t{
                static_cast<std::uint32_t>(*coordinates.shift), static_cast<std::uint32_t>(*coordinates.mask),
                static_cast<std::uint32_t>(*coordinates.locked), static_cast<std::uint32_t>(*coordinates.neutral),
                static_cast<std::uint32_t>(*coordinates.monitor), static_cast<std::uint32_t>(*coordinates.marked)
            }, monitor_table);
        }

        /* Read the flag's actual integer width: intx on JDK 8, int on newer VMs. */
        auto java_object_alignment() noexcept -> std::size_t
        {
            static const std::size_t alignment{ []() noexcept -> std::size_t
            {
                const auto& table{ vmhook::detail::resolve_jvm_flag_table() };
                if (!table.resolved || !table.has_type) { return 0; }
                char name[64]{};
                for (std::size_t index{ 0 }; index < table.count; ++index)
                {
                    if (!vmhook::detail::read_jvm_flag_name(table, index, name, sizeof(name))
                        || std::strcmp(name, "ObjectAlignmentInBytes") != 0) { continue; }
                    const auto* const record{ table.base + index * table.stride };
                    std::size_t width{ 0 };
                    if (table.type_is_string)
                    {
                        char type_name[32]{};
                        if (!vmhook::detail::safe_read_c_string(
                                vmhook::hotspot::safe_read_pointer(record + table.type_offset),
                                type_name, sizeof(type_name))) { return 0; }
                        if (std::strcmp(type_name, "int") == 0 || std::strcmp(type_name, "uint") == 0)
                        { width = sizeof(std::uint32_t); }
                        else if (std::strcmp(type_name, "intx") == 0 || std::strcmp(type_name, "uintx") == 0)
                        { width = sizeof(std::uint64_t); }
                    }
                    else
                    {
                        std::int32_t ordinal{ -1 };
                        if (!vmhook::os::safe_read(&ordinal, record + table.type_offset, sizeof(ordinal)))
                        { return 0; }
                        // JVMFlag::TYPE_int/uint == 1/2, TYPE_intx/uintx == 3/4.
                        if (ordinal == 1 || ordinal == 2) { width = sizeof(std::uint32_t); }
                        else if (ordinal == 3 || ordinal == 4) { width = sizeof(std::uint64_t); }
                    }
                    std::size_t value{ 0 };
                    const void* const address{ vmhook::hotspot::safe_read_pointer(record + table.addr_offset) };
                    if (width == 0 || !address || !vmhook::os::safe_read(&value, address, width)
                        || value < 8 || value > 256 || (value & (value - 1)) != 0) { return 0; }
                    return value;
                }
                return 0;
            }() };
            return alignment;
        }

        /*
            @brief Collector fallback for VMs whose flag walk failed.
            @details
            `HeapRegion::GrainBytes` (renamed `G1HeapRegion::GrainBytes` on
            master) and `ShenandoahHeapRegion::RegionSizeBytes` are statics that
            stay ZERO until their collector initialises, so a non-zero value is
            positive evidence the collector is running.  Deliberately NOT used:
            VM_TYPES presence - `declare_type(ZCollectedHeap, ...)` is a
            build-time INCLUDE_ZGC guard that is published even when ZGC is not
            running - and vtable symbols, which jvm.dll does not export.
            Complexity: O(1).  Exception safety: noexcept.
            Thread safety: safe (reads only).
        */
        inline auto infer_collector_without_flags() noexcept
            -> vmhook::gc_collector
        {
            const auto nonzero_static{ [](const char* const type_name,
                                          const char* const field_name) noexcept -> bool
            {
                const auto* const entry{
                    vmhook::hotspot::iterate_struct_entries(type_name, field_name) };
                if (!entry || !entry->address)
                {
                    return false;
                }
                std::size_t value{ 0 };
                return vmhook::os::safe_read(&value, entry->address, sizeof(value)) && value != 0;
            } };

            if (nonzero_static("HeapRegion", "GrainBytes")
             || nonzero_static("G1HeapRegion", "GrainBytes"))
            {
                return vmhook::gc_collector::g1;
            }
            if (nonzero_static("ShenandoahHeapRegion", "RegionSizeBytes"))
            {
                return vmhook::gc_collector::shenandoah;
            }
            return vmhook::gc_collector::unknown;
        }

        /*
            @brief Detects the card-table spelling this VM exports.
            @details
            derived from what RESOLVES, never from a version number:
            `CardTableModRefBS::byte_map_base` (no leading underscore) is the
            JDK 8 shape; `CardTable::_byte_map_base` together with the static
            `BarrierSet::_barrier_set` is the JDK 11+ shape.
            Complexity: O(entries).  Exception safety: noexcept.
            Thread safety: safe (reads only).
        */
        inline auto detect_barrier_shape() noexcept
            -> vmhook::gc_barrier_shape
        {
            if (vmhook::hotspot::iterate_struct_entries("CardTableModRefBS", "byte_map_base"))
            {
                return vmhook::gc_barrier_shape::card_table_modref_bs;
            }
            if (vmhook::hotspot::iterate_struct_entries("CardTable", "_byte_map_base")
             && vmhook::hotspot::iterate_struct_entries("BarrierSet", "_barrier_set"))
            {
                return vmhook::gc_barrier_shape::card_table_barrier_set;
            }
            return vmhook::gc_barrier_shape::unknown;
        }

        /*
            @brief VMStructs coordinates used to sample collection count and activity.
            @details Probes the available collected-heap slot, collection counter, and activity
            flag spellings. Missing coordinates leave the detector unresolved. Samples are
            not a synchronization protocol and cannot prove object lifetime.
        */
        struct gc_epoch_sources_t final
        {
            const void*   heap_slot{ nullptr };
            std::uint64_t total_collections_offset{ 0 };
            std::uint64_t gc_active_offset{ 0 };
            /* Byte span covering BOTH fields, so one fault-safe read fetches
               them together.  Zero when they sit too far apart to be worth
               batching, in which case two separate reads are used. */
            std::uint64_t span_offset{ 0 };
            std::size_t   span_size{ 0 };
            bool          resolved{ false };
        };

        /*
            Bound batched reads; widely separated coordinates use individual reads.
        */
        inline constexpr std::size_t gc_epoch_span_limit{ 256 };

        /*
            @brief Resolves and caches the epoch coordinates.
            Complexity: O(entries) once, O(1) after.
            Exception safety: noexcept.  Thread safety: safe (magic statics).
        */
        auto resolve_gc_epoch_sources() noexcept
            -> const vmhook::detail::gc_epoch_sources_t&
        {
            static const vmhook::detail::gc_epoch_sources_t sources{ []() noexcept
                -> vmhook::detail::gc_epoch_sources_t
                {
                    vmhook::detail::gc_epoch_sources_t result{};

                    const auto* const heap_entry{
                        vmhook::hotspot::iterate_struct_entries("Universe", "_collectedHeap") };
                    const auto* const total_entry{
                        vmhook::hotspot::iterate_struct_entries("CollectedHeap", "_total_collections") };
                    const auto* active_entry{
                        vmhook::hotspot::iterate_struct_entries("CollectedHeap", "_is_stw_gc_active") };
                    if (!active_entry)
                    {
                        active_entry =
                            vmhook::hotspot::iterate_struct_entries("CollectedHeap", "_is_gc_active");
                    }

                    if (!heap_entry || !heap_entry->address || !total_entry || !active_entry)
                    {
                        return result;
                    }

                    result.heap_slot                = heap_entry->address;
                    result.total_collections_offset = total_entry->offset;
                    result.gc_active_offset         = active_entry->offset;

                    // Batch the two reads when the fields sit close together,
                    // which they do on every JDK 8..26.
                    const std::uint64_t low{
                        std::min<std::uint64_t>(result.total_collections_offset,
                                                result.gc_active_offset) };
                    const std::uint64_t high{
                        std::max<std::uint64_t>(result.total_collections_offset + sizeof(std::uint32_t),
                                                result.gc_active_offset + 1u) };
                    if (high > low && (high - low) <= vmhook::detail::gc_epoch_span_limit)
                    {
                        result.span_offset = low;
                        result.span_size   = static_cast<std::size_t>(high - low);
                    }

                    result.resolved = true;
                    return result;
                }() };
            return sources;
        }
    }

/* Cached capability description, defined below after its flag-table walk. */
auto vm_capabilities() noexcept -> const vmhook::vm_capabilities_t&;

namespace hotspot
{
    /*
        HotSpot's native/VM-to-Java transition processes safepoints, handshakes,
        asynchronous exceptions and exit requests. Poll-page or GC-active reads
        cannot substitute for that private protocol. We only verify the state of
        an existing detour and never alter it, its polling word or its VM TLS.
    */
    inline auto enter_java_state(vmhook::hotspot::java_thread* const thread) noexcept -> bool
    {
        return thread && thread == vmhook::hotspot::current_java_thread
            && vmhook::hotspot::in_java_detour();
    }

    inline auto leave_java_state(vmhook::hotspot::java_thread*,
                                 vmhook::hotspot::java_thread_state) noexcept -> void
    {
        // Detours remain in Java state throughout invocation.
    }
}

    /*
        @brief Returns this VM's cached capability description (Layer 0).
        @note Windows memory reads report accessibility failures; they do not
        validate object lifetime, prevent VM mutation, or register a GC root.
    */
    auto vm_capabilities() noexcept
        -> const vmhook::vm_capabilities_t&
    {
        static const vmhook::vm_capabilities_t capabilities{ []() noexcept
            -> vmhook::vm_capabilities_t
            {
                vmhook::vm_capabilities_t result{};

                const vmhook::detail::gc_flag_values_t flags{ vmhook::detail::read_gc_flags() };
                result.flags_resolved = flags.resolved && flags.compressed_oops_found;
                if (flags.resolved)
                {
                    result.compressed_oops        = flags.compressed_oops;
                    result.compact_object_headers = flags.compact_object_headers;

                    // Exactly one Use*GC must be set.  HotSpot's GCConfig always
                    // ergonomically sets precisely one after VM init; zero (read
                    // too early) or two (nonsense) both mean "do not guess".
                    const int selected{ (flags.use_serial     ? 1 : 0)
                                      + (flags.use_parallel   ? 1 : 0)
                                      + (flags.use_g1         ? 1 : 0)
                                      + (flags.use_z          ? 1 : 0)
                                      + (flags.use_shenandoah ? 1 : 0)
                                      + (flags.use_epsilon    ? 1 : 0) };
                    if (selected == 1)
                    {
                        result.collector =
                              flags.use_serial     ? vmhook::gc_collector::serial
                            : flags.use_parallel   ? vmhook::gc_collector::parallel
                            : flags.use_g1         ? vmhook::gc_collector::g1
                            : flags.use_z          ? vmhook::gc_collector::z
                            : flags.use_shenandoah ? vmhook::gc_collector::shenandoah
                                                   : vmhook::gc_collector::epsilon;
                    }
                }

                if (result.collector == vmhook::gc_collector::unknown)
                {
                    result.collector = vmhook::detail::infer_collector_without_flags();
                }

                result.barrier = vmhook::detail::detect_barrier_shape();

                const vmhook::detail::gc_epoch_sources_t& sources{
                    vmhook::detail::resolve_gc_epoch_sources() };
                result.epoch_readable = sources.resolved;

                switch (result.collector)
                {
                    case vmhook::gc_collector::serial:
                    case vmhook::gc_collector::parallel:
                    case vmhook::gc_collector::g1:
                        // _total_collections provably ticks in gc_prologue /
                        // pre_evacuate_collection_set, i.e. BEFORE any copying.
                        result.supported = sources.resolved;
                        break;
                    case vmhook::gc_collector::epsilon:
                        // Never moves anything; the epoch is trivially fresh and
                        // no counter is needed.
                        result.supported = true;
                        break;
                    case vmhook::gc_collector::z:
                    case vmhook::gc_collector::shenandoah:
                    case vmhook::gc_collector::unknown:
                    default:
                        // Concurrent relocation behind load barriers, counters
                        // that tick at cycle start - an unchanged counter proves
                        // nothing.  Refuse.
                        result.supported = false;
                        break;
                }

                return result;
            }() };
        return capabilities;
    }

    /*
        @brief Human-readable name for a collector enumerator (for logs).
        Complexity: O(1).  Exception safety: noexcept.  Thread safety: safe.
    */
    namespace detail
    {
        inline auto reference_storage_width() noexcept -> std::size_t
        {
            const auto& capabilities{ vmhook::vm_capabilities() };
            if (!capabilities.flags_resolved)
            {
                return 0;
            }
            return capabilities.compressed_oops ? sizeof(std::uint32_t) : sizeof(void*);
        }

        inline auto reference_stores_supported() noexcept -> bool
        {
            // Epsilon has no remembered set, SATB, or relocation barriers.
            // A card-byte write alone is insufficient for G1; unknown collector
            // shapes must never fall back to a plain reference memcpy.
            const auto& capabilities{ vmhook::vm_capabilities() };
            return capabilities.flags_resolved
                && capabilities.collector == vmhook::gc_collector::epsilon;
        }

        inline auto reference_reads_supported() noexcept -> bool
        {
            // Direct oop decoding has no collector load-barrier backend.
            // A live Java-state detour excludes STW relocation during these
            // reads. Native-context access holds a VM operation while reading.
            const auto& capabilities{ vmhook::vm_capabilities() };
            return capabilities.flags_resolved && capabilities.supported
                && (vmhook::detail::native_backend::active()
                    || vmhook::hotspot::ensure_current_java_thread());
        }

        inline auto ordinary_object_headers_supported() noexcept -> bool
        {
            const auto& capabilities{ vmhook::vm_capabilities() };
            const auto compact{ vmhook::detail::compact_object_header_mode() };
            return capabilities.flags_resolved && compact && !*compact;
        }
    }

    inline auto gc_collector_name(const vmhook::gc_collector collector) noexcept
        -> std::string_view
    {
        switch (collector)
        {
            case vmhook::gc_collector::serial:     return "Serial";
            case vmhook::gc_collector::parallel:   return "Parallel";
            case vmhook::gc_collector::g1:         return "G1";
            case vmhook::gc_collector::z:          return "ZGC";
            case vmhook::gc_collector::shenandoah: return "Shenandoah";
            case vmhook::gc_collector::epsilon:    return "Epsilon";
            case vmhook::gc_collector::unknown:
            default:                               return "unknown";
        }
    }

    namespace detail
    {
        inline auto java_execution_supported() noexcept -> bool
        {
            const auto& capabilities{ vmhook::vm_capabilities() };
            return capabilities.supported && capabilities.flags_resolved;
        }

        inline auto java_heap_mutation_supported() noexcept -> bool
        {
            const auto& capabilities{ vmhook::vm_capabilities() };
            return capabilities.supported && capabilities.flags_resolved
                && vmhook::detail::ordinary_object_headers_supported()
                && vmhook::detail::compressed_klass_mode().has_value()
                && vmhook::detail::java_object_alignment() != 0;
        }
    }

    /*
        @brief Samples collector identity, collection count, and activity where available.
        @details Unsupported or unreadable coordinates produce an invalid sample.
        The observation is diagnostic: fields can change between reads, counters
        can wrap, and collection can start immediately after the sample.
        Epsilon reports a constant sample because it does not collect. No object
        root, safepoint guard, or access lifetime is created.
    */
    auto gc_epoch() noexcept
        -> vmhook::gc_epoch_t
    {
        const vmhook::vm_capabilities_t& capabilities{ vmhook::vm_capabilities() };
        if (!capabilities.supported)
        {
            return vmhook::gc_epoch_t{};
        }
        if (capabilities.collector == vmhook::gc_collector::epsilon)
        {
            return vmhook::gc_epoch_t{ 0u, false, true };
        }

        const vmhook::detail::gc_epoch_sources_t& sources{
            vmhook::detail::resolve_gc_epoch_sources() };
        if (!sources.resolved)
        {
            return vmhook::gc_epoch_t{};
        }

        // Universe::_collectedHeap is assigned once, during VM init, and never
        // reassigned - so cache it, but only AFTER it validates.  Caching a
        // null (this header can be loaded before the VM finishes booting) would
        // disable the detector for the life of the process, so a null result is
        // simply re-read next time.  safe_read_pointer, never a raw deref.
        static std::atomic<const void*> cached_heap{ nullptr };
        const void* collected_heap{ cached_heap.load(std::memory_order_relaxed) };
        if (!collected_heap)
        {
            collected_heap = vmhook::hotspot::safe_read_pointer(sources.heap_slot);
            if (!vmhook::hotspot::is_valid_pointer(collected_heap))
            {
                return vmhook::gc_epoch_t{};
            }
            cached_heap.store(collected_heap, std::memory_order_relaxed);
        }

        const auto* const heap_bytes{ static_cast<const std::uint8_t*>(collected_heap) };

        std::uint32_t collections{ 0 };
        std::uint8_t  active{ 1 };

        if (sources.span_size != 0)
        {
            // One fault-safe read covering both fields.
            std::uint8_t span[vmhook::detail::gc_epoch_span_limit]{};
            if (!vmhook::os::safe_read(span, heap_bytes + sources.span_offset, sources.span_size))
            {
                return vmhook::gc_epoch_t{};
            }
            std::memcpy(&collections,
                        span + (sources.total_collections_offset - sources.span_offset),
                        sizeof(collections));
            active = span[sources.gc_active_offset - sources.span_offset];
        }
        else
        {
            if (!vmhook::os::safe_read(&collections,
                                       heap_bytes + sources.total_collections_offset,
                                       sizeof(collections))
             || !vmhook::os::safe_read(&active,
                                       heap_bytes + sources.gc_active_offset,
                                       sizeof(active)))
            {
                return vmhook::gc_epoch_t{};
            }
        }

        return vmhook::gc_epoch_t{ collections, active != 0, true };
    }

    /*
        @brief Reports an unavailable or changed collection sample.
        @details True conservatively rejects the old sample. False means only that
        the sampled values matched; it does not prevent GC after the check, establish
        object liveness, or supply a safepoint/lifetime protocol.
    */
    inline auto gc_epoch_changed(const vmhook::gc_epoch_t& recorded) noexcept
        -> bool
    {
        if (!recorded.valid || recorded.gc_active)
        {
            return true;
        }
        const vmhook::gc_epoch_t now{ vmhook::gc_epoch() };
        return !now.valid || now.gc_active || now.collections != recorded.collections;
    }

    // Read JVM memory through the Windows memory API and stop on unreadable data.
    // A successful read does not establish object lifetime or a coherent VM snapshot.

    /*
        @brief Shapes of non-owning Java reference paths.
        @details static_root names a declaring Klass and static-field offset; field_of
        and element_of add hops. Native contexts retain a mirror root for static
        paths; native_root retains an object directly in a VM-scanned slot.
        Ephemeral paths store a non-owning address and a collection sample.
    */
    enum class anchor_kind : std::uint8_t
    {
        empty = 0,
        native_root,
        static_root,
        field_of,
        element_of,
        ephemeral
    };

    /*
        @brief Human-readable name of an anchor kind, for logs and diagnostics.
        @details
        Reflected, so the enum above is the ONLY list.  This was a switch that
        spelled each enumerator back as a string literal -- five lines that said
        nothing the declaration had not already said, and that a sixth anchor
        kind would have left quietly answering "empty" for itself.

        `empty` is the fallback for a value that is not an enumerator at all, and
        that is deliberate: an empty anchor is what an unreadable one means here.

        Complexity: O(1).  Exception safety: noexcept.  Thread safety: safe.
    */
    inline auto anchor_kind_name(const vmhook::anchor_kind kind) noexcept
        -> std::string_view
    {
        const std::string_view name{ vmhook::detail::enum_name(kind) };
        return name.empty() ? std::string_view{ "empty" } : name;
    }

    /*
        @brief Longest anchor chain a ref may describe.
        @details
        Bounds the recursion in detail::resolve_anchor and rejects pathological
        (or maliciously constructed) chains at BUILD time rather than at walk
        time, so resolve() can never blow the stack inside a detour.  Real chains
        are two or three hops; 32 is a ceiling, not a budget.
    */
    inline constexpr std::uint32_t k_max_anchor_depth{ 32 };

    /*
        @brief A 64-bit token for an anchor path or an epoch-stamped address.
        @details This describes reference provenance, not durable Java object identity.
        Different paths can identify the same object, a slot can later contain a different
        object, and different tokens can collide because they are hashes. Equal tokens
        therefore do not prove equal objects. Live-address comparison also needs a valid
        lifetime context. No object is rooted or retained by this value.
    */
    class object_id final
    {
    public:
        constexpr object_id() noexcept = default;

        explicit constexpr object_id(const std::uint64_t token) noexcept
            : token_{ token }
        {
        }

        /* @brief The raw token.  Zero means "no identity" (an empty ref). */
        constexpr auto value() const noexcept
            -> std::uint64_t
        {
            return this->token_;
        }

        /* @brief True when this id came from a non-empty ref. */
        explicit constexpr operator bool() const noexcept
        {
            return this->token_ != 0u;
        }


        auto to_string() const
            -> std::string
        {
            static constexpr char digits[]{ "0123456789abcdef" };
            char buffer[20]{ 'o', 'i', 'd', ':' };
            for (std::size_t nibble{ 0 }; nibble < 16u; ++nibble)
            {
                buffer[4 + nibble] = digits[(this->token_ >> ((15u - nibble) * 4u)) & 0xFull];
            }
            return std::string{ buffer, buffer + 20 };
        }

        friend constexpr auto operator==(const vmhook::object_id left,
                                         const vmhook::object_id right) noexcept
            -> bool
        {
            return left.token_ == right.token_;
        }

        friend constexpr auto operator!=(const vmhook::object_id left,
                                         const vmhook::object_id right) noexcept
            -> bool
        {
            return left.token_ != right.token_;
        }

        /* @brief Total order, so object_id also works in std::map / std::set. */
        friend constexpr auto operator<(const vmhook::object_id left,
                                        const vmhook::object_id right) noexcept
            -> bool
        {
            return left.token_ < right.token_;
        }

    private:
        std::uint64_t token_{ 0 };
    };

    namespace detail
    {
        /*
            @brief One immutable link in an anchor chain.
        */
        struct anchor_node final
        {
            /* Which of the five shapes this link is. */
            vmhook::anchor_kind kind{ vmhook::anchor_kind::empty };
            vmhook::detail::native_backend::root native_root{};
            /* The link this one hangs off; null for static_root / ephemeral. */
            std::shared_ptr<const vmhook::detail::anchor_node> parent{};
            /* static_root: the GC-stable klass whose mirror carries the field. */
            vmhook::hotspot::klass* declaring_klass{ nullptr };
            /* static_root / field_of: byte offset of the reference slot. */
            std::size_t offset{ 0 };
            /* element_of: zero-based index into the Java object array. */
            std::int32_t index{ 0 };
            /* ephemeral: the captured address, valid only for `born`. */
            vmhook::oop_t ephemeral_oop{ nullptr };
            /* ephemeral: the collection epoch the address was captured in. */
            vmhook::gc_epoch_t born{};
            /* Precomputed identity token for this whole path (see object_id). */
            std::uint64_t path_hash{ 0 };
            /* Distance from the root, so build time can reject over-long chains. */
            std::uint32_t depth{ 0 };
        };

        /*
            @brief SplitMix64 finaliser - the mixing step behind object_id.
            @details
            Chosen because it is a well-studied bijection on 64 bits with good
            avalanche, is four instructions, and needs no state.  Only used to
            combine path components into an identity token; it is not a security
            hash and is not required to be one.
            Complexity: O(1).  Exception safety: noexcept.  Thread safety: safe.
        */
        inline constexpr auto mix64(std::uint64_t value) noexcept
            -> std::uint64_t
        {
            value += 0x9E3779B97F4A7C15ull;
            value  = (value ^ (value >> 30)) * 0xBF58476D1CE4E5B9ull;
            value  = (value ^ (value >> 27)) * 0x94D049BB133111EBull;
            return value ^ (value >> 31);
        }

        /*
            @brief True when a JVM field descriptor names a reference or array.
            @details
            'L' (object) and '[' (array) are the only two descriptor leaders that
            put a heap reference in the slot; everything else is a primitive whose
            bytes would decode to garbage if read as an oop.  Mirrors the same
            test field_proxy::is_reference() applies.
            Complexity: O(1).  Exception safety: noexcept.
        */
        inline auto is_reference_descriptor(const std::string_view descriptor) noexcept
            -> bool
        {
            return !descriptor.empty() && (descriptor.front() == 'L' || descriptor.front() == '[');
        }

        /*
            @brief True when this VM stores heap references as 32-bit narrow oops.
            @details
            Sourced from vm_capabilities().compressed_oops, which reads the JVM
            flag table. Unknown flags are not evidence for narrow oops; callers
            inspect reference_slot_width() and refuse its zero/unknown result.
            Complexity: O(1) after the first call.  Exception safety: noexcept.
        */
        inline auto reference_slot_is_narrow() noexcept
            -> bool
        {
            const vmhook::vm_capabilities_t& capabilities{ vmhook::vm_capabilities() };
            return capabilities.flags_resolved && capabilities.compressed_oops;
        }

        /*
            @brief Width in bytes of one heap reference slot on this VM.
        */
        inline auto reference_slot_width() noexcept
            -> std::size_t
        {
            return vmhook::detail::reference_storage_width();
        }

        /*
            @brief Fault-safe read of ONE reference slot at `holder + offset`.
            @note Windows memory reads report accessibility failures; they do not
            validate object lifetime, prevent VM mutation, or register a GC root.
        */
        inline auto read_reference_slot(const void* const holder,
                                        const std::size_t offset) noexcept
            -> vmhook::oop_t
        {
            if (!holder || !vmhook::hotspot::is_valid_pointer(holder))
            {
                return nullptr;
            }
            const std::size_t width{ vmhook::detail::reference_slot_width() };
            if (width == sizeof(std::uint32_t))
            {
                const std::uint32_t narrow{ vmhook::read_compressed_oop_at_safe(holder, offset) };
                if (narrow == 0u)
                {
                    return nullptr;
                }
                void* const decoded{ vmhook::hotspot::decode_oop_pointer(narrow) };
                return vmhook::hotspot::is_valid_pointer(decoded) ? decoded : nullptr;
            }
            if (width != sizeof(void*)) { return nullptr; }
            void* wide{ nullptr };
            if (!vmhook::os::safe_read_fast(&wide,
                                            reinterpret_cast<const std::uint8_t*>(holder) + offset,
                                            sizeof(wide)))
            {
                return nullptr;
            }
            return vmhook::hotspot::is_valid_pointer(wide) ? wide : nullptr;
        }

        /*
            @brief Walks an anchor chain from its root and returns the CURRENT
                   address of the object it names, or nullptr.
            @details
            This is the whole safety argument in one function.  A static_root hop
            re-reads Klass::_java_mirror - metadata the collector never moves,
            through an OopHandle the collector updates in place - so it yields the
            mirror's address as of RIGHT NOW, never a remembered one.  Every
            further hop reads a live reference slot off the address the previous
            hop just produced.  No address is ever carried across a hop from a
            previous walk.

            Recursion is bounded by the `depth` recorded when the chain was built
            (see k_max_anchor_depth), so a corrupted or hostile chain cannot
            recurse without limit inside a detour.

            Complexity: O(chain length), one to three fault-safe reads per hop.
            Exception safety: noexcept.  Thread safety: safe - reads only.
        */
        inline auto resolve_anchor(const vmhook::detail::anchor_node* const node) noexcept
            -> vmhook::oop_t
        {
            if (!node || node->depth > vmhook::k_max_anchor_depth)
            {
                return nullptr;
            }

            switch (node->kind)
            {
            case vmhook::anchor_kind::native_root:
                return node->native_root ? node->native_root->resolve_under_vm() : nullptr;

            case vmhook::anchor_kind::static_root:
            {
                if (!node->declaring_klass
                    || !vmhook::hotspot::is_valid_pointer(node->declaring_klass))
                {
                    return nullptr;
                }
                // Read the mirror through its VM-maintained indirection. The observed address
                // can still become stale before the next heap access.
                void* const mirror{ node->native_root ? node->native_root->resolve_under_vm()
                                                    : node->declaring_klass->get_java_mirror() };
                if (!mirror || !vmhook::hotspot::is_valid_pointer(mirror))
                {
                    return nullptr;
                }
                return vmhook::detail::read_reference_slot(mirror, node->offset);
            }

            case vmhook::anchor_kind::field_of:
            {
                vmhook::oop_t const holder{ vmhook::detail::resolve_anchor(node->parent.get()) };
                if (!holder)
                {
                    return nullptr;
                }
                return vmhook::detail::read_reference_slot(holder, node->offset);
            }

            case vmhook::anchor_kind::element_of:
            {
                vmhook::oop_t const array_oop{ vmhook::detail::resolve_anchor(node->parent.get()) };
                if (!array_oop)
                {
                    return nullptr;
                }
                // array_length() is itself a fault-safe header read and returns 0
                // for anything it cannot trust, so an out-of-range or corrupted
                // length collapses to "no such element" rather than a wild read.
                const std::int32_t length{ vmhook::array_length(array_oop) };
                if (node->index < 0 || node->index >= length)
                {
                    return nullptr;
                }
                const auto layout{ vmhook::detail::array_layout(vmhook::klass_from_oop(array_oop)) };
                if (!layout || !layout->reference_elements
                    || layout->element_width != vmhook::detail::reference_slot_width()) { return nullptr; }
                const std::size_t element_offset{ layout->body_offset
                    + static_cast<std::size_t>(node->index) * layout->element_width };
                return vmhook::detail::read_reference_slot(array_oop, element_offset);
            }

            case vmhook::anchor_kind::ephemeral:
                // Reject an observed collection-epoch change. A matching epoch is only a
                // diagnostic sample; collection can race with later use of the returned address.
                return vmhook::gc_epoch_changed(node->born) ? nullptr : node->ephemeral_oop;

            case vmhook::anchor_kind::empty:
                break;
            }
            return nullptr;
        }

        /*
            @brief Builds a static_root link.  Returns null on a bad klass.
        */
        inline auto make_static_anchor(vmhook::hotspot::klass* const declaring_klass,
                                       const std::size_t offset) noexcept
            -> std::shared_ptr<const vmhook::detail::anchor_node>
        {
            if (!declaring_klass || !vmhook::hotspot::is_valid_pointer(declaring_klass))
            {
                return {};
            }
            try
            {
                auto node{ std::make_shared<vmhook::detail::anchor_node>() };
                node->kind            = vmhook::anchor_kind::static_root;
                node->declaring_klass = declaring_klass;
                vmhook::detail::native_backend::operation access{};
                if (access)
                {
                    node->native_root = vmhook::detail::native_backend::retain_class(declaring_klass);
                    if (!node->native_root) { return {}; }
                }
                node->offset          = offset;
                node->depth           = 0u;
                node->path_hash       = vmhook::detail::mix64(
                    vmhook::detail::mix64(0x5354'4154'4943'0001ull
                                          ^ reinterpret_cast<std::uintptr_t>(declaring_klass))
                    ^ static_cast<std::uint64_t>(offset));
                return node;
            }
            catch (const std::exception&)
            {
                return {};
            }
        }

        /*
            @brief Builds a field_of / element_of link under `parent`.
            @details
            Refuses to extend a chain past k_max_anchor_depth, and refuses to
            build on a null parent, so an over-long or rootless chain is rejected
            at build time and simply produces an empty ref.
        */
        inline auto make_hop_anchor(const std::shared_ptr<const vmhook::detail::anchor_node>& parent,
                                    const vmhook::anchor_kind kind,
                                    const std::size_t offset,
                                    const std::int32_t index) noexcept
            -> std::shared_ptr<const vmhook::detail::anchor_node>
        {
            if (!parent || parent->depth >= vmhook::k_max_anchor_depth)
            {
                return {};
            }
            try
            {
                auto node{ std::make_shared<vmhook::detail::anchor_node>() };
                node->kind   = kind;
                node->parent = parent;
                node->offset = offset;
                node->index  = index;
                node->depth  = parent->depth + 1u;
                node->path_hash = (kind == vmhook::anchor_kind::element_of)
                    ? vmhook::detail::mix64(parent->path_hash
                                            ^ 0x454C'454D'0000'0002ull
                                            ^ static_cast<std::uint64_t>(
                                                  static_cast<std::uint32_t>(index)))
                    : vmhook::detail::mix64(parent->path_hash
                                            ^ 0x4649'454C'0000'0003ull
                                            ^ static_cast<std::uint64_t>(offset));
                return node;
            }
            catch (const std::exception&)
            {
                return {};
            }
        }

        /*
            @brief Identity token for a detour-scoped capture.
            @details
            Mixes the captured ADDRESS with the collection generation it was
            captured in, under a seed disjoint from the anchored-path seeds.
            Within one epoch, address equality IS object identity, so two
            independent captures of one live object agree - which is what lets a
            vmhook::borrowed and the vmhook::ref it was promoted from key the same
            map entry.  Shared by both spellings so the two can never drift apart.
            Complexity: O(1).  Exception safety: noexcept.
        */
        inline auto ephemeral_identity(const vmhook::oop_t address,
                                       const std::uint32_t collections) noexcept
            -> std::uint64_t
        {
            if (!address)
            {
                return 0u;
            }
            return vmhook::detail::mix64(
                vmhook::detail::mix64(0x4550'4845'4D00'0004ull
                                      ^ reinterpret_cast<std::uintptr_t>(address))
                ^ static_cast<std::uint64_t>(collections));
        }

        /*
            @brief Stores a non-owning address and collection sample in an anchor node.
            @details Null input produces no node. Observed changes reject the address,
            but unchanged samples do not prove liveness or stop concurrent collection.
        */
        inline auto make_ephemeral_anchor(const vmhook::oop_t address) noexcept
            -> std::shared_ptr<const vmhook::detail::anchor_node>
        {
            if (!address)
            {
                return {};
            }
            try
            {
                auto node{ std::make_shared<vmhook::detail::anchor_node>() };
                node->kind          = vmhook::anchor_kind::ephemeral;
                node->ephemeral_oop = address;
                node->born          = vmhook::gc_epoch();
                node->depth         = 0u;
                node->path_hash     = vmhook::detail::ephemeral_identity(
                    address, node->born.collections);
                return node;
            }
            catch (const std::exception&)
            {
                return {};
            }
        }

        /*
            @brief Short-lived proxy that binds a wrapper to a CURRENT address.
        */
        template<typename wrapper_type>
        class access final
        {
        public:
            explicit access(const vmhook::oop_t address,
                            vmhook::detail::native_backend::root root = {}) noexcept
                : wrapper_{ address }
            {
                if (!root && this->lifetime_ && address)
                {
                    root = vmhook::detail::native_backend::retain_oop(address);
                }
                this->wrapper_.set_native_root(std::move(root));
            }

            // Axiom: an access binds its wrapper for ONE expression.  Making it
            // immovable is what turns "do not hoist this" from a comment into a
            // compile error -- a hoisted access outlives the resolve that
            // produced it and reads a possibly-relocated object.
            access(const access&) = delete (
                "an access proxy is bound for ONE expression and cannot be stored.  "
                "Keep the ref or borrowed it came from, and re-bind at each use.");
            access(access&&) = delete (
                "an access proxy is bound for ONE expression and cannot be stored.  "
                "Keep the ref or borrowed it came from, and re-bind at each use.");
            auto operator=(const access&) -> access& = delete (
                "an access proxy is bound for ONE expression and cannot be reseated.");
            auto operator=(access&&) -> access& = delete (
                "an access proxy is bound for ONE expression and cannot be reseated.");
            ~access()                                = default;

            auto operator->() noexcept
                -> wrapper_type*
            {
                return &this->wrapper_;
            }

            auto operator->() const noexcept
                -> const wrapper_type*
            {
                return &this->wrapper_;
            }

            auto operator*() noexcept
                -> wrapper_type&
            {
                return this->wrapper_;
            }

            auto operator*() const noexcept
                -> const wrapper_type&
            {
                return this->wrapper_;
            }

        private:
            vmhook::detail::native_backend::operation lifetime_{};
            wrapper_type wrapper_;
        };
    }

    /*
        @brief A copyable non-owning description of a Java reference path.
        @details Anchored refs re-read their path. A native-root anchor retains its
        referent in a VM-scanned slot and guarded traversal excludes relocating GC.
        Java fields can still change concurrently. Native context references require
        the owning OS thread and expire on context closure. Legacy ephemeral and
        static paths do not independently retain an object or prevent concurrent GC.
        @tparam wrapper_type A wrapper constructible from oop_t, or void for untyped access.
    */
    template<typename wrapper_type>
    class ref final
    {
    public:
        using element_type = wrapper_type;

        ref() noexcept = default;
        ref(const ref&) = default;
        ref(ref&&) noexcept = default;
        auto operator=(const ref&) -> ref& = default;
        auto operator=(ref&&) noexcept -> ref& = default;
        ~ref() = default;

        static auto from_native_root(vmhook::detail::native_backend::root root) noexcept -> ref
        {
            if (!root) { return {}; }
            try
            {
                auto node{ std::make_shared<vmhook::detail::anchor_node>() };
                node->kind = vmhook::anchor_kind::native_root;
                node->native_root = std::move(root);
                node->path_hash = vmhook::detail::mix64(
                    reinterpret_cast<std::uintptr_t>(node->native_root->slot));
                ref result{};
                result.anchor_ = std::move(node);
                return result;
            }
            catch (...) { return {}; }
        }

        [[nodiscard]] auto get_native_root() const -> vmhook::detail::native_backend::root
        {
            auto node{ this->anchor_ };
            while (node && node->parent) { node = node->parent; }
            if (!node || !node->native_root) { return {}; }
            const auto root{ node->native_root };
            if (!root->valid()) { return root; }
            vmhook::detail::native_backend::operation access{};
            if (!access) { return root; }
            return vmhook::detail::native_backend::retain_oop(this->resolve());
        }

        /*
            @brief Anchors a ref at a static reference field, given a GC-stable
                   klass and the field's offset inside that class's mirror.
            @details The base case of every chain.  This is the exact pair
            field_proxy's static overload already stores, promoted to a first-class
            value.  [ADV] - prefer the (class_name, field_name) overload.
        */
        static auto at_static(vmhook::hotspot::klass* const declaring_klass,
                              const std::size_t offset) noexcept
            -> ref
        {
            vmhook::detail::native_backend::operation access{};
            ref result{};
            result.anchor_ = vmhook::detail::make_static_anchor(declaring_klass, offset);
            return result;
        }

        /*
            @brief Anchors a ref at `class_name.field_name`, a static reference
                   field, resolving the class and field through the normal
                   find_class / find_field path.
            @details
            Returns an empty ref (never a broken one) when the class is not
            loaded, the field does not exist, the field is not static, or the
            field is a primitive rather than a reference.  Each failure is logged
            once through log_line(), so a typo is observable rather than silent.
        */
        static auto at_static(const std::string_view class_name,
                              const std::string_view field_name) noexcept
            -> ref
        {
            vmhook::detail::native_backend::operation access{};
            try
            {
                vmhook::hotspot::klass* const target{ vmhook::find_class(class_name) };
                if (!target)
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::at_static('{}', '{}'): class not loaded.",
                               vmhook::error_tag, class_name, field_name);
                    return ref{};
                }
                const auto entry{ vmhook::find_field(target, field_name) };
                if (!entry)
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::at_static('{}', '{}'): field not found.",
                               vmhook::error_tag, class_name, field_name);
                    return ref{};
                }
                if (!entry->is_static)
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::at_static('{}', '{}'): field is not static.",
                               vmhook::error_tag, class_name, field_name);
                    return ref{};
                }
                if (!vmhook::detail::is_reference_descriptor(entry->signature))
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::at_static('{}', '{}'): field descriptor '{}' is a "
                               "primitive, not a reference.",
                               vmhook::error_tag, class_name, field_name, entry->signature);
                    return ref{};
                }
                // Statics live on the mirror of the class that DECLARES them, and
                // `offset` only indexes that one - see find_field's field_entry_t
                // note.  Anchoring on the start klass would read a different,
                // differently sized mirror.
                vmhook::hotspot::klass* const mirror_klass{
                    entry->declaring_klass ? entry->declaring_klass : target };
                return ref::at_static(mirror_klass, static_cast<std::size_t>(entry->offset));
            }
            catch (const std::exception& ex)
            {
                ::vmhook::detail::log_line("{} vmhook::ref::at_static('{}', '{}') failed: {}",
                           vmhook::error_tag, class_name, field_name, ex.what());
                return ref{};
            }
        }

        /*
            @brief Stores a non-owning address with a collection sample.
            @details An observed epoch change rejects the address. A hook callback or
            unchanged sample does not itself root the object or prevent concurrent GC.
        */
        static auto ephemeral(const vmhook::oop_t address) noexcept
            -> ref
        {
            ref result{};
            result.anchor_ = vmhook::detail::make_ephemeral_anchor(address);
            return result;
        }

        /*
            @brief Resolves an address from the current path observations, or returns null.
            @details Re-reading avoids permanently cached field values, but the walk is
            not an atomic VM snapshot. Its result can change or become stale immediately
            after the read. Ephemeral references also reject observed epoch changes.
        */
        auto resolve() const noexcept
            -> vmhook::oop_t
        {
            vmhook::detail::native_backend::operation access{};
            if (!this->anchor_)
            {
                return nullptr;
            }

            if (this->anchor_->kind == vmhook::anchor_kind::ephemeral)
            {
                return vmhook::detail::resolve_anchor(this->anchor_.get());
            }

            const vmhook::gc_epoch_t before{ vmhook::gc_epoch() };
            vmhook::oop_t const address{ vmhook::detail::resolve_anchor(this->anchor_.get()) };
            if (!address)
            {
                return nullptr;
            }

            // Only meaningful when the epoch is readable at all; on a collector
            // the detector refuses to vouch for, the freshly re-derived address
            // is returned as-is - precisely as correct as field_proxy's static
            // path is on that same VM, and never worse.
            if (before.valid && !before.gc_active && vmhook::gc_epoch_changed(before))
            {
                return nullptr;
            }
            return address;
        }

        /* @brief True when the ref currently names a live, reachable object. */
        explicit operator bool() const noexcept
        {
            return this->resolve() != nullptr;
        }

        /*
            @brief True when this ref no longer resolves - collected, unreachable,
                   or (for an ephemeral ref) past its epoch.  The A6 liveness
                   state, distinct from "was never set".
        */
        auto expired() const noexcept
            -> bool
        {
            return this->anchor_ != nullptr && this->resolve() == nullptr;
        }

        /* @brief True when this ref was never given an anchor. */
        auto empty() const noexcept
            -> bool
        {
            return this->anchor_ == nullptr;
        }

        /*
            @brief True when the stored path is non-ephemeral.
            @note This is a path classification, not proof of current validity or GC retention.
        */
        auto anchored() const noexcept
            -> bool
        {
            return this->anchor_ != nullptr
                && this->anchor_->kind != vmhook::anchor_kind::ephemeral;
        }

        /* @brief Which shape of anchor this ref carries. */
        auto kind() const noexcept
            -> vmhook::anchor_kind
        {
            return this->anchor_ ? this->anchor_->kind : vmhook::anchor_kind::empty;
        }

        /* @brief Number of hops from the root; 0 for a root or an ephemeral. */
        auto depth() const noexcept
            -> std::uint32_t
        {
            return this->anchor_ ? this->anchor_->depth : 0u;
        }

        /*
            @brief Returns the path token described by object_id; not durable Java object identity.
        */
        auto id() const noexcept
            -> vmhook::object_id
        {
            return this->anchor_ ? vmhook::object_id{ this->anchor_->path_hash }
                                 : vmhook::object_id{};
        }

        /*
            @brief Revalidates and hands back a wrapper bound to the CURRENT
                   address, for the duration of this expression only.
            @details
            `player->pos_x()` resolves, binds, calls, and discards.  See
            detail::access for why the proxy cannot be hoisted into a variable.
            When the ref does not resolve, the proxy binds a null instance and
            the wrapper's own accessors degrade the way they always have - so
            check the ref (`if (!player) { ... }`) exactly once, as A6 intends,
            rather than after every field.
        */
        auto operator->() const noexcept
            -> vmhook::detail::access<wrapper_type>
            requires (!std::is_void_v<wrapper_type>
                      && std::is_constructible_v<wrapper_type, vmhook::oop_t>)
        {
            vmhook::detail::native_backend::operation access{};
            const auto address{ this->resolve() };
            return vmhook::detail::access<wrapper_type>{ address,
                address ? vmhook::detail::native_backend::root{} : this->invalid_native_root() };
        }

        /* @brief Same as operator->, spelled for `(*ref).member`. */
        auto operator*() const noexcept
            -> vmhook::detail::access<wrapper_type>
            requires (!std::is_void_v<wrapper_type>
                      && std::is_constructible_v<wrapper_type, vmhook::oop_t>)
        {
            vmhook::detail::native_backend::operation access{};
            const auto address{ this->resolve() };
            return vmhook::detail::access<wrapper_type>{ address,
                address ? vmhook::detail::native_backend::root{} : this->invalid_native_root() };
        }

        /*
            @brief The UNTYPED ref navigates too, through any_object.
            @details
            Same revalidate-then-bind contract as the typed overload — the
            anchor walk runs first, so a ref that no longer resolves binds a
            null any_object.  See borrowed's twin for why the untyped case
            deserves a `->` at all.
        */
        auto operator->() const noexcept
            -> vmhook::detail::access<vmhook::any_object>
            requires (std::is_void_v<wrapper_type>)
        {
            vmhook::detail::native_backend::operation access{};
            const auto address{ this->resolve() };
            return vmhook::detail::access<vmhook::any_object>{ address,
                address ? vmhook::detail::native_backend::root{} : this->invalid_native_root() };
        }

        /* @brief Same as operator->, spelled for `(*ref).member`. */
        auto operator*() const noexcept
            -> vmhook::detail::access<vmhook::any_object>
            requires (std::is_void_v<wrapper_type>)
        {
            vmhook::detail::native_backend::operation access{};
            const auto address{ this->resolve() };
            return vmhook::detail::access<vmhook::any_object>{ address,
                address ? vmhook::detail::native_backend::root{} : this->invalid_native_root() };
        }

        /*
            @brief Resolves once and runs a visitor over a non-owning wrapper.
            @details Returns false when the path does not resolve. The visitor
            receives an address observed at entry. Avoid Java calls or allocation
            that can safepoint; this C++ binding does not prevent concurrent GC
            and creates no VM lifetime guarantee. Visitor exceptions propagate.
        */
        template<typename visitor_type>
        auto read(visitor_type&& visitor) const
            -> bool
            requires (!std::is_void_v<wrapper_type>
                      && std::is_constructible_v<wrapper_type, vmhook::oop_t>)
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::oop_t const address{ this->resolve() };
            if (!address)
            {
                return false;
            }
            wrapper_type bound{ address };
            if (access) { bound.set_native_root(vmhook::detail::native_backend::retain_oop(address)); }
            std::forward<visitor_type>(visitor)(bound);
            return true;
        }

        /*
            @brief Anchors a child ref at a reference field of THIS object, by
                   byte offset.  [ADV] - prefer the by-name overload.
        */
        template<typename field_wrapper = void>
        auto field_at(const std::size_t offset) const noexcept
            -> vmhook::ref<field_wrapper>
        {
            vmhook::ref<field_wrapper> result{};
            result.anchor_ = vmhook::detail::make_hop_anchor(
                this->anchor_, vmhook::anchor_kind::field_of, offset, 0);
            return result;
        }

        /*
            @brief Adds a named reference-field hop to a non-owning path.
            @details Looks up and caches the observed field offset on the runtime
            class, falling back to the wrapper registration when unavailable.
            A static field binds its declaring class directly. Resolution reads
            the path again, but neither the offset nor the path protects class
            metadata or Java objects against unloading, mutation, or collection.
            Returns empty on lookup failure.
        */
        template<typename field_wrapper = void>
        auto field(const std::string_view name) const noexcept
            -> vmhook::ref<field_wrapper>
        {
            vmhook::detail::native_backend::operation access{};
            // A failed native ticket must not fall back to a registered class
            // and bind a static field in a different context or OS thread.
            if (this->invalid_native_root()) { return {}; }
            try
            {
                vmhook::hotspot::klass* holder_klass{ nullptr };
                if (vmhook::oop_t const address{ this->resolve() })
                {
                    holder_klass = vmhook::klass_from_oop(address);
                }
                if (!holder_klass)
                {
                    const std::string registered{ vmhook::detail::registered_class_name<wrapper_type>() };
                    if (!registered.empty())
                    {
                        holder_klass = vmhook::find_class(registered);
                    }
                }
                if (!holder_klass)
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::field('{}'): holder class could not be resolved "
                               "(ref did not resolve and the wrapper type is not registered).",
                               vmhook::error_tag, name);
                    return vmhook::ref<field_wrapper>{};
                }

                const auto entry{ vmhook::find_field(holder_klass, name) };
                if (!entry)
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::field('{}'): field not found in class hierarchy.",
                               vmhook::error_tag, name);
                    return vmhook::ref<field_wrapper>{};
                }
                if (!vmhook::detail::is_reference_descriptor(entry->signature))
                {
                    ::vmhook::detail::log_line("{} vmhook::ref::field('{}'): descriptor '{}' is a primitive - a ref "
                               "can only anchor on a reference field.",
                               vmhook::error_tag, name, entry->signature);
                    return vmhook::ref<field_wrapper>{};
                }
                if (entry->is_static)
                {
                    vmhook::hotspot::klass* const mirror_klass{
                        entry->declaring_klass ? entry->declaring_klass : holder_klass };
                    return vmhook::ref<field_wrapper>::at_static(
                        mirror_klass, static_cast<std::size_t>(entry->offset));
                }

                vmhook::ref<field_wrapper> result{};
                result.anchor_ = vmhook::detail::make_hop_anchor(
                    this->anchor_,
                    vmhook::anchor_kind::field_of,
                    static_cast<std::size_t>(entry->offset),
                    0);
                return result;
            }
            catch (const std::exception& ex)
            {
                ::vmhook::detail::log_line("{} vmhook::ref::field('{}') failed: {}", vmhook::error_tag, name, ex.what());
                return vmhook::ref<field_wrapper>{};
            }
        }

        /*
            @brief Adds an indexed Java reference-array hop to a non-owning path.
            @details Stores the index and checks the observed length at resolution.
            Reading the parent again can detect replacement or relocation, but
            does not root the array or make the later element read atomic with GC.
            An invalid index or unresolved parent yields no object.
        */
        template<typename element_wrapper = void>
        auto element(const std::int32_t index) const noexcept
            -> vmhook::ref<element_wrapper>
        {
            vmhook::ref<element_wrapper> result{};
            if (index < 0)
            {
                return result;
            }
            result.anchor_ = vmhook::detail::make_hop_anchor(
                this->anchor_, vmhook::anchor_kind::element_of, 0, index);
            return result;
        }

        /*
            @brief Re-types this ref without re-anchoring it.  Yields an EMPTY ref
                   when the object is not an instance of `other_wrapper`.
            @details The instance test goes through the wrapper type's REGISTERED
            class name, so it honours whatever name-resolution scheme the consumer
            registered with (obfuscated / mapped names included) instead of a
            hard-coded string.
        */
        template<typename other_wrapper>
        auto as() const
            -> vmhook::ref<other_wrapper>
        {
            if (!this->is<other_wrapper>())
            {
                return vmhook::ref<other_wrapper>{};
            }
            vmhook::ref<other_wrapper> result{};
            result.anchor_ = this->anchor_;
            return result;
        }

        /* @brief Untyped view of the same anchor - the erasure direction, which
           always succeeds. */
        auto erased() const noexcept
            -> vmhook::ref<void>
        {
            vmhook::ref<void> result{};
            result.anchor_ = this->anchor_;
            return result;
        }

        /* @brief Tests the exact registered class identity, including interfaces. */
        template<typename other_wrapper>
        auto is() const -> bool
        {
            vmhook::detail::native_backend::operation access{};
            if (this->invalid_native_root())
            { throw vmhook::exception{"Reference belongs to a closed or different native context"}; }
            auto* const address{this->resolve()};
            if (!address) { return false; }
            const auto root{this->get_native_root()};
            if (!access || !root || !root->valid())
            { throw vmhook::exception{"A typed reference test requires a live VM-scanned reference"}; }
            auto* const expected{vmhook::detail::registered_class_klass<other_wrapper>()};
            if (!expected) { throw vmhook::exception{"Typed reference wrapper is not bound to a loaded Java class"}; }
            return vmhook::detail::container_class_assignable(vmhook::klass_from_oop(address), expected);
        }

        /* @brief Tests the superclass chain by internal ('/'-separated) class name. */
        auto instance_of(const std::string_view class_name) const
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::oop_t const address{ this->resolve() };
            return address != nullptr && vmhook::is_instance_of(address, class_name);
        }

        /*
            @brief Internal name of the object's RUNTIME class, or an empty string.
            Exception safety: strong - returns empty on any failure.
        */
        auto class_name() const
            -> std::string
        {
            vmhook::detail::native_backend::operation access{};
            try
            {
                vmhook::oop_t const address{ this->resolve() };
                if (!address)
                {
                    return std::string{};
                }
                vmhook::hotspot::klass* const runtime_klass{ vmhook::klass_from_oop(address) };
                if (!runtime_klass)
                {
                    return std::string{};
                }
                const vmhook::hotspot::symbol* const name_symbol{ runtime_klass->get_name() };
                if (!vmhook::hotspot::is_valid_pointer(name_symbol))
                {
                    return std::string{};
                }
                return name_symbol->to_string();
            }
            catch (const std::exception&)
            {
                return std::string{};
            }
        }

        /*
            @brief Point-in-time object identity: do these two refs resolve to the
                   same live object RIGHT NOW?
            @details
            Exact, but deliberately NOT the basis of operator== / std::hash: the
            answer is an address comparison and therefore changes across a
            collection, which would break every hashed container it was used in.
            Two refs that both fail to resolve are NOT the same object.
        */
        template<typename other_wrapper>
        auto same_object_as(const vmhook::ref<other_wrapper>& other) const noexcept
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::oop_t const mine{ this->resolve() };
            return mine != nullptr && mine == other.resolve();
        }

        /* @brief Drops the anchor; the ref becomes empty.  Releases nothing
           VM-side, because nothing was ever registered there. */
        auto reset() noexcept
            -> void
        {
            this->anchor_.reset();
        }

        /*
            @brief The captured address of an EPHEMERAL ref with NO staleness
                   check; nullptr for an anchored ref, which never stores one.
                   Diagnostics and logging only - never dereference it.
        */
        auto raw_unsafe() const noexcept
            -> vmhook::oop_t
        {
            if (this->anchor_ && this->anchor_->kind == vmhook::anchor_kind::ephemeral)
            {
                return this->anchor_->ephemeral_oop;
            }
            return nullptr;
        }

        /* @brief Reference identity - see object_id.  Consistent with
           std::hash<vmhook::ref<T>>, which hashes the same token. */
        friend auto operator==(const ref& left, const ref& right) noexcept
            -> bool
        {
            return left.id() == right.id();
        }

        friend auto operator!=(const ref& left, const ref& right) noexcept
            -> bool
        {
            return !(left == right);
        }

    private:
        template<typename> friend class vmhook::ref;
        template<typename> friend class vmhook::root;
        template<typename> friend class vmhook::borrowed;

        auto invalid_native_root() const noexcept -> vmhook::detail::native_backend::root
        {
            auto base{ this->anchor_ };
            while (base && base->parent) { base = base->parent; }
            return base && base->native_root && !base->native_root->valid()
                ? base->native_root : vmhook::detail::native_backend::root{};
        }

        /* The ONLY member.  Immutable once built and shared by refcount, which
           is what makes a ref cheap to copy, safe to dereference concurrently
           from any number of threads, and destructible on any thread with
           nothing to release. */
        std::shared_ptr<const vmhook::detail::anchor_node> anchor_{};
    };

    /*
        @brief A lazy, non-owning binding to a static reference field.
        @details get() returns an anchor path and resolves its field again at use.
        The binding mutex protects C++ binding state only; it does not synchronize
        with Java field mutation, GC, or class unloading. This type does not
        register a GC root or guarantee a consistent object snapshot.
    */
    template<typename wrapper_type>
    class root final
    {
    public:
        root() noexcept = default;

        /*
            @brief Names a static field by its declaring class and field name.
            @param declaring_class Internal ('/'-separated) JVM class name.
            @param field_name      Exact Java field name.
        */
        root(const std::string_view declaring_class, const std::string_view field_name)
            : class_name_{ declaring_class }
            , field_name_{ field_name }
        {
        }

        /*
            @brief Names a static field on the wrapper type's OWN registered class
                   - the singleton case (`Minecraft.theMinecraft`).
            @details The class name is looked up through register_class<T>() at
            bind time, so registration may happen after construction.
        */
        explicit root(const std::string_view field_name)
            requires (!std::is_void_v<wrapper_type>)
            : field_name_{ field_name }
        {
        }

        root(const root&) = delete (
            "a root IS the anchor every ref beneath it resolves through, so it has "
            "to stay put.  Hold it where it lives (a static, a member) and hand out "
            "refs anchored on it.");
        root(root&&) = delete (
            "a root IS the anchor every ref beneath it resolves through, so it has "
            "to stay put.  Hold it where it lives and hand out refs anchored on it.");
        auto operator=(const root&) -> root& = delete (
            "a root cannot be reseated; construct the one you want.");
        auto operator=(root&&) -> root& = delete (
            "a root cannot be reseated; construct the one you want.");
        ~root()                              = default;

        using element_type = std::conditional_t<std::is_void_v<wrapper_type>, vmhook::any_object, wrapper_type>;

        /* Read the current static reference as an owning C++ wrapper. Java null
           creates an allocated wrapper; lookup and lifetime failures throw. */
        auto get() const -> std::unique_ptr<element_type>
        {
            vmhook::detail::native_backend::operation access{};
            if (!access)
            { throw vmhook::exception{ "Static object access requires a native-thread or callback context" }; }
            std::string owner{ this->class_name_ };
            if (owner.empty()) { owner = vmhook::detail::registered_class_name<element_type>(); }
            if (owner.empty() || this->field_name_.empty())
            { throw vmhook::exception{ "Static object field owner and name are required" }; }
            auto* const owner_class{ owner == vmhook::detail::registered_class_name<element_type>()
                ? vmhook::detail::registered_class_klass<element_type>() : vmhook::find_class(owner) };
            if (!owner_class) { throw vmhook::exception{ "Static object field owner class is not loaded" }; }
            const auto entry{ vmhook::find_field(owner_class, this->field_name_) };
            if (!entry || !entry->is_static || entry->signature.empty() || entry->signature.front() != 'L')
            { throw vmhook::exception{ "Static object accessor requires an existing static Java object field" }; }
            auto* const declaring{ entry->declaring_klass ? entry->declaring_klass : owner_class };
            vmhook::field_proxy field{ nullptr, entry->signature, true, declaring, entry->offset };
            return static_cast<std::unique_ptr<element_type>>(field.get());
        }

        /* @brief The static field's current value address, or nullptr. */
        auto resolve() const noexcept
            -> vmhook::oop_t
        {
            return this->anchor_ref().resolve();
        }

        /* @brief True when the root binds AND currently holds a live object. */
        explicit operator bool() const noexcept
        {
            return this->resolve() != nullptr;
        }

        /* @brief True once the (class, field) pair has resolved to a real
           static reference field.  False before the class is loaded. */
        auto bound() const noexcept
            -> bool
        {
            return !this->anchor_ref().empty();
        }

        /* Checked navigation uses the same owning object result as get(). */
        auto operator->() const -> std::unique_ptr<element_type>
        { return this->get(); }

        /* @brief The declaring class name this root was given, if any (empty when
           the root defers to the wrapper type's registered name). */
        auto declaring_class() const noexcept
            -> std::string_view
        {
            return this->class_name_;
        }

        /* @brief The static field name this root was given. */
        auto field_name() const noexcept
            -> std::string_view
        {
            return this->field_name_;
        }

    private:
        auto anchor_ref() const noexcept
            -> vmhook::ref<wrapper_type>
        {
            try
            {
                if (vmhook::detail::native_backend::active())
                {
                    std::string owner{ this->class_name_ };
                    if (owner.empty()) { owner = vmhook::detail::registered_class_name<wrapper_type>(); }
                    if (owner.empty() || this->field_name_.empty()) { return {}; }
                    // Each native context owns its own mirror root. Do not cache a
                    // context ticket in a process-wide singleton or block in VM state.
                    return vmhook::ref<wrapper_type>::at_static(owner, this->field_name_);
                }
                std::lock_guard<std::mutex> lock{ this->bind_mutex_ };
                if (this->bound_.empty())
                {
                    std::string owner{ this->class_name_ };
                    if (owner.empty())
                    {
                        owner = vmhook::detail::registered_class_name<wrapper_type>();
                    }
                    if (owner.empty() || this->field_name_.empty())
                    {
                        return vmhook::ref<wrapper_type>{};
                    }
                    this->bound_ = vmhook::ref<wrapper_type>::at_static(owner, this->field_name_);
                }
                return this->bound_;
            }
            catch (const std::exception&)
            {
                return vmhook::ref<wrapper_type>{};
            }
        }


        std::string class_name_{};
        std::string field_name_{};
        mutable std::mutex                 bind_mutex_{};
        mutable vmhook::ref<wrapper_type>  bound_{};
    };

    /*
        @brief A Java object reference with an optional native-context root ticket.
        @details Native results share a VM-scanned root and pin() preserves that root
        in a ref. They require the context's OS thread and expire on closure. Raw
        borrows retain only an epoch sample; an unchanged sample is not proof of
        liveness and does not prevent collection after the check.
    */
    template<typename wrapper_type>
    class borrowed final
    {
    public:
        borrowed() noexcept = default;

        explicit borrowed(const vmhook::oop_t address) noexcept
            : address_{ address }
            , born_{ vmhook::gc_epoch() }
        {
        }

        borrowed(const vmhook::oop_t address, vmhook::detail::native_backend::root root) noexcept
            : address_{ address }, born_{ vmhook::gc_epoch() }, native_root_{ std::move(root) }
        {
        }

        [[nodiscard]] auto get_native_root() const noexcept -> vmhook::detail::native_backend::root
        {
            return this->native_root_;
        }

        /* @brief The address, or nullptr once the epoch has moved. */
        auto resolve() const noexcept
            -> vmhook::oop_t
        {
            if (this->native_root_) { return this->native_root_->resolve(); }
            if (!this->address_)
            {
                return nullptr;
            }
            return vmhook::gc_epoch_changed(this->born_) ? nullptr : this->address_;
        }

        explicit operator bool() const noexcept
        {
            return this->resolve() != nullptr;
        }

        /* @brief True when this borrow was taken but has since expired. */
        auto expired() const noexcept
            -> bool
        {
            return (this->native_root_ || this->address_ != nullptr) && this->resolve() == nullptr;
        }

        /* @brief The captured address with NO staleness check - diagnostics only. */
        auto raw_unsafe() const noexcept
            -> vmhook::oop_t
        {
            return this->address_;
        }

        /* @brief Reference identity for the current epoch - see object_id.  Two
           borrows of the SAME live object in the same epoch share an id. */
        auto id() const noexcept
            -> vmhook::object_id
        {
            if (!this->address_)
            {
                return vmhook::object_id{};
            }
            if (this->native_root_)
            {
                return vmhook::object_id{ vmhook::detail::mix64(
                    reinterpret_cast<std::uintptr_t>(this->native_root_->slot)) };
            }
            return vmhook::object_id{ vmhook::detail::ephemeral_identity(
                this->address_, this->born_.collections) };
        }

        auto operator->() const noexcept
            -> vmhook::detail::access<wrapper_type>
            requires (!std::is_void_v<wrapper_type>
                      && std::is_constructible_v<wrapper_type, vmhook::oop_t>)
        {
            vmhook::detail::native_backend::operation access{};
            return vmhook::detail::access<wrapper_type>{ this->resolve(), this->native_root_ };
        }

        auto operator*() const noexcept
            -> vmhook::detail::access<wrapper_type>
            requires (!std::is_void_v<wrapper_type>
                      && std::is_constructible_v<wrapper_type, vmhook::oop_t>)
        {
            vmhook::detail::native_backend::operation access{};
            return vmhook::detail::access<wrapper_type>{ this->resolve(), this->native_root_ };
        }

        /*
            @brief The UNTYPED borrow navigates too, through any_object.
            @details
            borrowed<> is what every read hands back when no wrapper was named,
            and it used to be a dead end: no `->`, so the caller had to go and
            invent a wrapper type before they could read one field.  Now the
            object's own klass supplies the members, and the revalidation is
            identical — the address is resolved through the epoch check first,
            so an expired borrow binds a null any_object rather than the
            address it used to have.
        */
        auto operator->() const noexcept
            -> vmhook::detail::access<vmhook::any_object>
            requires (std::is_void_v<wrapper_type>)
        {
            vmhook::detail::native_backend::operation access{};
            return vmhook::detail::access<vmhook::any_object>{ this->resolve(), this->native_root_ };
        }

        /* @brief Same as operator->, spelled for `(*handle).member`. */
        auto operator*() const noexcept
            -> vmhook::detail::access<vmhook::any_object>
            requires (std::is_void_v<wrapper_type>)
        {
            vmhook::detail::native_backend::operation access{};
            return vmhook::detail::access<vmhook::any_object>{ this->resolve(), this->native_root_ };
        }

        /*
            @brief Promotes the borrow to a vmhook::ref.
            @details The result is an EPHEMERAL ref - same expiry, now chainable.
            It does NOT become durable, because no GC root exists to make it so;
            anchor it off a vmhook::root for that.
        */
        auto pin() const noexcept
            -> vmhook::ref<wrapper_type>
        {
            return this->native_root_ ? vmhook::ref<wrapper_type>::from_native_root(this->native_root_)
                                      : vmhook::ref<wrapper_type>::ephemeral(this->resolve());
        }

        /* @brief Anchors a child ref at the named reference field of this object. */
        template<typename field_wrapper = void>
        auto field(const std::string_view name) const noexcept
            -> vmhook::ref<field_wrapper>
        {
            return this->pin().template field<field_wrapper>(name);
        }

        template<typename other_wrapper>
        auto is() const -> bool
        {
            vmhook::detail::native_backend::operation access{};
            if (native_root_ && !native_root_->valid())
            { throw vmhook::exception{"Borrowed reference belongs to a closed or different native context"}; }
            auto* const address{this->resolve()};
            if (!address) { return false; }
            if (!access || !native_root_ || !native_root_->valid())
            { throw vmhook::exception{"A typed borrow test requires a live VM-scanned reference"}; }
            auto* const expected{vmhook::detail::registered_class_klass<other_wrapper>()};
            if (!expected) { throw vmhook::exception{"Typed borrow wrapper is not bound to a loaded Java class"}; }
            return vmhook::detail::container_class_assignable(vmhook::klass_from_oop(address), expected);
        }

        auto instance_of(const std::string_view class_name) const
            -> bool
        {
            vmhook::detail::native_backend::operation access{};
            vmhook::oop_t const address{ this->resolve() };
            return address != nullptr && vmhook::is_instance_of(address, class_name);
        }

        friend auto operator==(const borrowed& left, const borrowed& right) noexcept
            -> bool
        {
            return left.id() == right.id();
        }

        friend auto operator!=(const borrowed& left, const borrowed& right) noexcept
            -> bool
        {
            return !(left == right);
        }

    private:
        vmhook::oop_t      address_{ nullptr };
        vmhook::gc_epoch_t born_{};
        vmhook::detail::native_backend::root native_root_{};
    };

    /* A move-only GC root resource, independent of the creating native context.
       acquire() creates a fresh unique_ptr wrapper in the receiving context.
       Its parked root keeper never executes Java calls on the caller's behalf. */
    template<typename wrapper_type = vmhook::any_object>
        requires vmhook::detail::container_wrapper<wrapper_type>
    class retained_object final
    {
        std::shared_ptr<void> root_{};
        bool initialized_{};
        template<typename other_type>
            requires vmhook::detail::container_wrapper<other_type>
        friend auto retain(const std::unique_ptr<other_type>&) -> retained_object<other_type>;
        retained_object(std::shared_ptr<void> root, bool initialized) noexcept
            : root_{std::move(root)}, initialized_{initialized} {}
    public:
        retained_object() noexcept = default;
        retained_object(const retained_object&) = delete;
        auto operator=(const retained_object&) -> retained_object& = delete;
        retained_object(retained_object&& other) noexcept
            : root_{std::move(other.root_)}, initialized_{std::exchange(other.initialized_, false)} {}
        auto operator=(retained_object&& other) noexcept -> retained_object&
        {
            if (this != &other)
            { root_ = std::move(other.root_); initialized_ = std::exchange(other.initialized_, false); }
            return *this;
        }
        [[nodiscard]] auto valid() const noexcept -> bool { return initialized_; }
        explicit operator bool() const noexcept { return valid(); }
        auto reset() noexcept -> void { root_.reset(); initialized_ = false; }
        template<typename other_type>
            requires vmhook::detail::container_wrapper<other_type>
        [[nodiscard]] auto is_same_object(const std::unique_ptr<other_type>& other) const -> bool
        {
            if (!initialized_ || !other)
            { throw vmhook::exception{"Object identity requires a retained resource and an allocated wrapper"}; }
            vmhook::detail::native_backend::operation access{};
            auto* const current{other->get_instance()};
            if (!root_) { return current == nullptr; }
            if (!access)
            { throw vmhook::exception{"Retained object identity requires the receiving VM context"}; }
            if (current && (!other->get_native_root() || !other->get_native_root()->valid()))
            { throw vmhook::exception{"Object identity requires a live VM-scanned comparison reference"}; }
            auto* const held{vmhook::detail::resolve_durable_oop(root_)};
            if (!held) { throw vmhook::exception{"Retained object identity is unavailable in this JVM"}; }
            return held == current;
        }
        [[nodiscard]] auto acquire() const -> std::unique_ptr<wrapper_type>
        {
            if (!initialized_) { throw vmhook::exception{"Retained Java reference is empty or released"}; }
            if (!root_) { return vmhook::detail::wrap_object<wrapper_type>(nullptr); }
            vmhook::detail::native_backend::operation access{};
            if (!access) { throw vmhook::exception{"Acquiring a retained Java reference requires a VM context"}; }
            auto* const current{vmhook::detail::resolve_durable_oop(root_)};
            if (!current) { throw vmhook::exception{"Retained Java reference cannot be resolved in this JVM"}; }
            const auto local{vmhook::detail::native_backend::retain_oop(current)};
            if (!local) { throw vmhook::exception{"Retained Java reference cannot be acquired by this context"}; }
            return vmhook::detail::materialize_object<wrapper_type>(0, local);
        }
    };

    template<typename wrapper_type>
        requires vmhook::detail::container_wrapper<wrapper_type>
    [[nodiscard]] auto retain(const std::unique_ptr<wrapper_type>& value) -> retained_object<wrapper_type>
    {
        if (!value) { throw vmhook::exception{"Retaining a Java object requires an allocated C++ wrapper"}; }
        // A rooted non-null wrapper must remain on its owner thread/context.
        // Initialize the parked keeper before entering VM state and waiting.
        const bool prepared{vmhook::detail::prepare_durable_roots()};
        vmhook::detail::native_backend::operation access{};
        auto* const current{value->get_instance()};
        if (!current) { return retained_object<wrapper_type>{{}, true}; }
        if (!access || !prepared)
        { throw vmhook::exception{"Durable Java roots are unavailable for this VM profile or context"}; }
        if (!value->get_native_root() || !value->get_native_root()->valid())
        { throw vmhook::exception{"Durable retention requires an existing live VM-scanned reference"}; }
        const auto rooted{vmhook::detail::retain_durable_oop(current)};
        if (!rooted) { throw vmhook::exception{"Java object could not be retained independently of its context"}; }
        return retained_object<wrapper_type>{rooted, true};
    }

    template<typename loader_type>
    auto native_thread_context::set_context_class_loader(const std::unique_ptr<loader_type>& loader) -> void
    {
        if (!valid() || !loader) { throw vmhook::exception{"Context class loader requires its owner context and an allocated wrapper"}; }
        vmhook::detail::native_backend::operation access{};
        (void)loader->get_instance();
        auto* const thread_class{vmhook::find_class("java/lang/Thread")};
        if (!access || !thread_class) { throw vmhook::exception{"Java Thread metadata is unavailable"}; }
        auto* const methods{thread_class->get_methods_ptr()};
        const auto count{thread_class->get_methods_count()};
        vmhook::hotspot::method* getter{};
        vmhook::hotspot::method* setter{};
        for (std::int32_t index{}; methods && index < count; ++index)
        {
            auto* const candidate{methods[index]};
            if (candidate && candidate->get_name() == "currentThread" && candidate->get_signature() == "()Ljava/lang/Thread;")
            { getter = candidate; }
            if (candidate && candidate->get_name() == "setContextClassLoader"
                && candidate->get_signature() == "(Ljava/lang/ClassLoader;)V") { setter = candidate; }
        }
        if (!getter || !setter) { throw vmhook::exception{"Java Thread context class loader methods are unavailable"}; }
        const std::unique_ptr<vmhook::any_object> thread = vmhook::method_proxy{nullptr, getter, getter->get_signature(), true}.call();
        if (!thread || !thread->get_instance()) { throw vmhook::exception{"Current Java Thread object is unavailable"}; }
        const auto result{vmhook::method_proxy{thread->get_instance(), setter, setter->get_signature(), false,
            nullptr, thread->get_native_root()}.call(loader)};
        if (!result.was_invoked() || result.threw())
        { throw vmhook::exception{"Java context class loader setter failed"}; }
    }

    /*
        @brief Out-of-line definition of object<derived>::self().
        @details Clones the C++ view, retaining the same context-scanned Java
        reference. Java null still produces an allocated C++ wrapper.
    */
    template<typename derived>
    auto object<derived>::self() const
        -> std::unique_ptr<std::conditional_t<std::is_void_v<derived>, vmhook::any_object, derived>>
    {
        using wrapper_type = std::conditional_t<std::is_void_v<derived>, vmhook::any_object, derived>;
        vmhook::detail::native_backend::operation access{};
        auto root{ this->get_native_root() };
        if (root) { return vmhook::detail::materialize_object<wrapper_type>(0, root); }
        vmhook::oop_t const held{ this->get_instance() };
        if (!held) { return vmhook::detail::wrap_object<wrapper_type>(nullptr); }
        if (!access)
        { throw vmhook::exception{ "Copying a Java reference requires its native-thread or callback context" }; }
        root = vmhook::detail::native_backend::retain_oop(held);
        if (!root) { throw vmhook::exception{ "Java reference could not be retained for the wrapper copy" }; }
        return vmhook::detail::materialize_object<wrapper_type>(0, root);
    }

    /*
        @brief Out-of-line definition of vmhook::make_unique<W>(args...).
        @details
        Deferred to here because the allocation and invocation machinery it
        needs is only complete at this point.

        Failed allocation, refused invocation, a thrown Java constructor, or
        lost result bookkeeping throws vmhook::exception and abandons the Java
        allocation. A half-built instance is never represented as Java null.
        Successful construction returns an allocated wrapper and a rooted Java
        object. C++ allocation failure propagates std::bad_alloc.
    */
    namespace detail
    {
        /*
            A retired/exhausted TLAB needs the VM's real allocation path. Invoke
            the already-loaded Java Unsafe.allocateInstance method through the
            same validated Java-call machinery. This does not resolve or call an
            invocation API, function table or native allocation export.

            This backend may safepoint. It belongs to make_unique only: raw
            array/String assembly retains its allocation-only no-safepoint path.
        */
        inline auto allocate_instance_through_java(vmhook::hotspot::klass* const target) noexcept -> void*
        {
            if (!target || !vmhook::hotspot::in_java_detour()
                || !vmhook::detail::java_execution_supported()
                || vmhook::detail::reference_storage_width() != sizeof(std::uint32_t))
            { return nullptr; }
            try
            {
                void* const mirror{ target->get_java_mirror() };
                if (!mirror) { return nullptr; }
                constexpr std::string_view signature{ "(Ljava/lang/Class;)Ljava/lang/Object;" };
                for (const std::string_view class_name : { "jdk/internal/misc/Unsafe", "sun/misc/Unsafe" })
                {
                    auto* const unsafe_class{ vmhook::find_class(class_name) };
                    if (!unsafe_class || !vmhook::detail::class_initialized(unsafe_class)) { continue; }
                    const auto singleton_field{ vmhook::find_field(unsafe_class, "theUnsafe") };
                    if (!singleton_field || !singleton_field->is_static) { continue; }
                    void* const singleton{ vmhook::hotspot::decode_oop_pointer(
                        vmhook::get_field<std::uint32_t>(nullptr, unsafe_class, "theUnsafe")) };
                    if (!singleton || vmhook::klass_from_oop(singleton) != unsafe_class) { continue; }
                    auto** const methods{ unsafe_class->get_methods_ptr() };
                    const auto count{ unsafe_class->get_methods_count() };
                    if (!methods || count < 1 || count > 65535) { continue; }
                    for (std::int32_t index{ 0 }; index < count; ++index)
                    {
                        auto* const method{ methods[index] };
                        if (!method || method->get_name() != "allocateInstance"
                            || method->get_signature() != signature) { continue; }
                        const vmhook::method_proxy allocation{ singleton, method, std::string{signature},
                                                               /*signature_pinned=*/true };
                        auto mirror_wrapper{ vmhook::detail::wrap_object<vmhook::any_object>(mirror) };
                        const auto result{ allocation.call(mirror_wrapper) };
                        if (!result.was_invoked() || result.threw() || result.result_failed)
                        { return nullptr; }
                        const std::unique_ptr<vmhook::any_object> allocated = result;
                        return allocated->get_instance();
                    }
                }
            }
            catch (const std::exception& error)
            {
                ::vmhook::detail::log_line("{} Java allocation backend: {}", vmhook::error_tag, error.what());
            }
            return nullptr;
        }
    }

    template<typename wrapper_type, typename... args_t>
        requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
            && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
            && (vmhook::detail::supported_java_argument_v<args_t> && ...))
    inline auto make_unique(args_t&&... args)
        -> std::unique_ptr<wrapper_type>
    { return vmhook::make_unique_with_descriptor<wrapper_type>({}, std::forward<args_t>(args)...); }

    template<typename wrapper_type, typename... args_t>
        requires (vmhook::detail::is_java_wrapper_v<wrapper_type>
            && std::is_same_v<wrapper_type, std::remove_cv_t<wrapper_type>>
            && (vmhook::detail::supported_java_argument_v<args_t> && ...))
    inline auto make_unique_with_descriptor(const std::string_view constructor_signature,
                                           args_t&&... args)
        -> std::unique_ptr<wrapper_type>
    {
        vmhook::detail::native_backend::operation native_operation{};
        const bool native_call{ vmhook::detail::native_backend::active() };
        if (native_call && !native_operation)
        { throw vmhook::exception{ "Java object construction requires an active VM context" }; }
        std::string class_name{ vmhook::detail::registered_class_name<wrapper_type>() };
        if (class_name.empty())
        {
            if constexpr (requires { std::string_view{ wrapper_type::java_contract }; })
            { class_name = wrapper_type::java_contract; }
        }
        if (class_name.empty())
        {
            ::vmhook::detail::log_line("{} make_unique(): type '{}' is not registered - call "
                       "register_class<T>(\"java/lang/Name\") before constructing it.",
                       vmhook::error_tag, vmhook::detail::type_name<wrapper_type>());
            throw vmhook::exception{ "Java object wrapper is not registered" };
        }

        vmhook::hotspot::klass* target_klass{ vmhook::detail::registered_class_klass<wrapper_type>() };
        vmhook::detail::native_backend::root builtin_class_root{};
        if (!target_klass)
        {
            if constexpr (requires { std::string_view{ wrapper_type::java_contract }; })
            {
                if (std::string_view{wrapper_type::java_contract}.starts_with("java/"))
                {
                    const auto resolved{ vmhook::detail::ensure_bootstrap_class(class_name) };
                    target_klass = resolved.first;
                    builtin_class_root = resolved.second;
                }
            }
        }
        if (!target_klass || !vmhook::hotspot::is_valid_pointer(target_klass))
        {
            ::vmhook::detail::log_line("{} make_unique(): class '{}' is not loaded in this VM.",
                       vmhook::error_tag, class_name);
            throw vmhook::exception{ "Java object wrapper class is not loaded" };
        }

        // A zero instance size means non-instantiable (interface / abstract /
        // array).  `new` on one of those is a Java error, and allocating it here
        // would produce an object whose klass says it cannot exist.
        const std::size_t instance_size{ target_klass->get_instance_size() };
        if (instance_size == 0 || (!native_call && !vmhook::detail::class_initialized(target_klass)))
        {
            ::vmhook::detail::log_line("{} make_unique(): '{}' is not instantiable (interface, "
                       "abstract, or its instance size could not be read).",
                       vmhook::error_tag, class_name);
            throw vmhook::exception{ "Java object wrapper class is not instantiable or initialized" };
        }

        // Locate ANY <init> on the class first.  The exact overload is chosen
        // from the C++ argument types by method_proxy::call() itself (its
        // resolve_compatible_method walks the receiver's klass for same-name
        // candidates), so this only has to find a starting point - and finding
        // NONE means there is no constructor to run, which must be discovered
        // BEFORE anything is allocated.
        vmhook::hotspot::method* initializer{ nullptr };
        {
            const std::int32_t method_count{ target_klass->get_methods_count() };
            vmhook::hotspot::method** const methods_array{ target_klass->get_methods_ptr() };
            if (methods_array)
            {
                for (std::int32_t index{ 0 }; index < method_count; ++index)
                {
                    vmhook::hotspot::method* const candidate{ methods_array[index] };
                    // <init> is spelled <init> under every mapping: the JVM
                    // reserves the name, so no obfuscator or remapper touches it.
                    if (candidate && vmhook::hotspot::is_valid_pointer(candidate)
                        && candidate->get_name() == "<init>"
                        && (constructor_signature.empty() || candidate->get_signature() == constructor_signature))
                    {
                        initializer = candidate;
                        break;
                    }
                }
            }
        }
        if (!initializer)
        {
            ::vmhook::detail::log_line("{} make_unique(): '{}' declares no <init> this library can "
                       "reach - nothing was allocated.",
                       vmhook::error_tag, class_name);
            throw vmhook::exception{ "Java constructor metadata cannot be resolved" };
        }

        // Check known backend prerequisites before reserving Java heap space.
        // Later constructor overload selection and invocation can still refuse;
        // was_invoked() distinguishes that refusal from a successful void return.
        if (!native_call && !vmhook::detail::find_call_stub_entry())
        {
            ::vmhook::detail::log_line("{} make_unique(): no call stub could be derived on this VM, "
                       "so '{}' cannot be constructed - nothing was allocated.",
                       vmhook::error_tag, class_name);
            throw vmhook::exception{ "Java construction call backend is unavailable" };
        }
        if (!native_call && !vmhook::hotspot::ensure_current_java_thread())
        {
            ::vmhook::detail::log_line("{} make_unique(): this thread is outside a validated Java detour, "
                       "so the constructor of '{}' cannot run - nothing "
                       "was allocated.",
                       vmhook::error_tag, class_name);
            throw vmhook::exception{ "Java constructor requires a validated thread context" };
        }

        static_assert(sizeof...(args_t) <= 255,
                      "make_unique: JVM constructors allow at most 254 explicit parameter slots");

        std::array<vmhook::detail::native_backend::root, sizeof...(args_t)> native_argument_roots{};
        if (native_call)
        {
            std::size_t index{};
            bool failed{};
            [[maybe_unused]] auto retain_argument = [&](auto&& argument)
            {
                bool required{};
                auto& root{ native_argument_roots[index++] };
                root = vmhook::method_proxy::retain_native_argument(argument, required);
                if ((required && !root) || (root && !root->valid())) { failed = true; }
            };
            (retain_argument(args), ...);
            if (failed) { throw vmhook::exception{ "Java constructor arguments cannot be retained in this context" }; }
        }
        vmhook::detail::native_backend::root allocated_root{};
        if (native_call) { allocated_root = vmhook::detail::native_backend::allocate(target_klass); }
        void* allocated{ native_call
            ? (allocated_root ? allocated_root->resolve_under_vm() : nullptr)
            : vmhook::make_java_object(target_klass, instance_size) };
        if (!native_call && !allocated)
        { allocated = vmhook::detail::allocate_instance_through_java(target_klass); }
        if (!allocated)
        {
            ::vmhook::detail::log_line("{} make_unique(): allocation of {} bytes for '{}' failed.",
                       vmhook::warning_tag, instance_size, class_name);
            throw vmhook::exception{ "Java object allocation failed" };
        }

        if (native_call)
        {
            // Allocation and class initialization may have safepointed. Locate
            // current constructor metadata again before using a Method pointer.
            initializer = nullptr;
            auto** const methods{ target_klass->get_methods_ptr() };
            const auto count{ target_klass->get_methods_count() };
            if (methods && count > 0 && count <= 65535)
            {
                for (std::int32_t index{ 0 }; index < count; ++index)
                {
                    auto* const method{ methods[index] };
                    if (method && method->get_name() == "<init>"
                        && (constructor_signature.empty() || method->get_signature() == constructor_signature))
                    { initializer = method; break; }
                }
            }
            if (!initializer) { throw vmhook::exception{ "Java constructor metadata became unavailable after allocation" }; }
        }
        vmhook::method_proxy constructor{ allocated, initializer, initializer->get_signature(),
            !constructor_signature.empty(), native_call ? &allocated : nullptr, allocated_root };
        if (native_call) { constructor.native_constructor_arguments = native_argument_roots; }
        const auto call_result{ constructor.call(std::forward<args_t>(args)...) };
        if (!call_result.was_invoked())
        {
            ::vmhook::detail::log_line("{} make_unique(): constructor invocation was refused.", vmhook::error_tag);
            throw vmhook::exception{ "Java constructor invocation was refused" };
        }
        if (call_result.threw())
        {
            ::vmhook::detail::log_line("{} make_unique(): the constructor of '{}' threw {} - the "
                       "instance is abandoned.",
                       vmhook::error_tag, class_name,
                       call_result.exception_class.empty()
                           ? "an exception" : call_result.exception_class.c_str());
            throw vmhook::exception{ "Java constructor threw an exception" };
        }

        if (call_result.result_failed || !call_result.receiver_address)
        { throw vmhook::exception{ "Java constructor result could not be retained" }; }
        auto receiver_root{ call_result.native_receiver_root };
        if (!receiver_root)
        { receiver_root = vmhook::detail::native_backend::retain_oop(call_result.receiver_address); }
        if (!receiver_root)
        { throw vmhook::exception{ "Constructed Java object requires a retained reference" }; }
        auto result{ vmhook::detail::materialize_object<wrapper_type>(0, receiver_root) };

        // OPTIONAL C++-side hook.  It runs AFTER the Java constructor, so a
        // wrapper that wants to stamp extra state can, and one that does not
        // need it (the common case) declares nothing.
        if constexpr (requires(wrapper_type& wrapper, args_t&&... hook_args)
                      { wrapper.construct(std::forward<args_t>(hook_args)...); })
        {
            result->construct(std::forward<args_t>(args)...);
        }
        return result;
    }

    /* Allocation-only helpers return rooted owning C++ wrappers. They never
       convert a refused allocation into a Java-null success. make_unique runs
       Java constructors; new_object deliberately performs allocation only. */

    template<typename wrapper_type = vmhook::any_object>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    [[nodiscard]] inline auto new_object(vmhook::hotspot::klass* const klass,
                                        const std::size_t requested_size)
        -> std::unique_ptr<wrapper_type>
    {
        vmhook::detail::native_backend::operation access{};
        if (!access)
        { throw vmhook::exception{ "Java object allocation requires a native-thread or callback context" }; }
        if (!klass || !vmhook::hotspot::is_valid_pointer(klass) || requested_size == 0
            || klass->get_instance_size() != requested_size)
        { throw vmhook::exception{ "Java object allocation requires a concrete class with its exact instance size" }; }
        const auto root{ vmhook::detail::native_backend::allocate(klass) };
        if (!root) { throw vmhook::exception{ "Java object allocation failed" }; }
        return vmhook::detail::materialize_object<wrapper_type>(0, root);
    }

    /* Uses Java Array.newInstance through private JavaCalls on the active
       native worker or validated callback. HotSpot owns allocation and barriers;
       length, geometry, Java exceptions and root failures are explicit errors. */
    template<typename wrapper_type = vmhook::any_object>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    [[nodiscard]] inline auto new_array(const std::string_view class_name,
                                       const std::int32_t length,
                                       const std::size_t element_size)
        -> std::unique_ptr<wrapper_type>
    {
        vmhook::detail::native_backend::operation access{};
        if (!access)
        { throw vmhook::exception{ "Java array allocation requires a native-thread or rooted callback context" }; }
        const auto root{ vmhook::detail::allocate_array_through_java(class_name, length, element_size) };
        return vmhook::detail::materialize_object<wrapper_type>(0, root);
    }

    template<vmhook::detail::java_array_element element_type>
    [[nodiscard]] inline auto make_array(const std::int32_t length)
        -> std::unique_ptr<vmhook::array<element_type>>
    {
        vmhook::detail::native_backend::operation access{};
        if (!access) { throw vmhook::exception{ "Java array construction requires a rooted VM context" }; }
        const auto descriptor{ vmhook::array<element_type>::descriptor() };
        vmhook::detail::native_backend::root component_array{};
        vmhook::detail::native_backend::root component_mirror{};
        if constexpr (requires { element_type::java_array_wrapper; typename element_type::java_element_type; })
        {
            // Construct a zero-length component array first when Java has not
            // created its ArrayKlass yet; this uses the same collector-aware
            // allocation path and preserves the exact nested wrapper type.
            const auto component{ vmhook::make_array<typename element_type::java_element_type>(0) };
            component_array = vmhook::detail::container_source_root(*component);
            component_mirror = vmhook::detail::native_backend::retain_class(vmhook::klass_from_oop(
                vmhook::detail::container_address(component_array)));
            if (!component_mirror) { throw vmhook::exception{ "Nested Java array class could not be retained" }; }
        }
        else if constexpr (vmhook::detail::container_wrapper<element_type>)
        {
            // An ordinary wrapper can bind one of several same-named classes.
            // Use its exact retained class instead of a name-only Class.forName.
            auto* const component_class{vmhook::detail::registered_class_klass<element_type>()};
            if (component_class)
            {
                component_mirror = vmhook::detail::native_backend::retain_class(component_class);
                if (!component_mirror) { throw vmhook::exception{"Java array component class could not be retained"}; }
            }
            else if constexpr (!requires { std::string_view{element_type::java_contract}; })
            { throw vmhook::exception{"Java array component wrapper has no resolved class binding"}; }
        }
        constexpr auto width{ vmhook::detail::container_wrapper<element_type>
            ? sizeof(std::uint32_t) : sizeof(element_type) };
        const auto result{ vmhook::detail::allocate_array_through_java(descriptor, length, width, component_mirror) };
        return vmhook::detail::materialize_object<vmhook::array<element_type>>(0, result);
    }

    template<typename wrapper_type = vmhook::any_object>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    [[nodiscard]] inline auto new_string(const std::string_view value)
        -> std::unique_ptr<wrapper_type>
    {
        vmhook::detail::native_backend::operation access{};
        if (!access)
        { throw vmhook::exception{ "Java String allocation requires a native-thread or callback context" }; }
        const auto root{ vmhook::detail::native_backend::make_string(value) };
        if (!root) { throw vmhook::exception{ "Java String allocation failed" }; }
        return vmhook::detail::materialize_object<wrapper_type>(0, root);
    }

    template<typename wrapper_type = vmhook::any_object>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    [[nodiscard]] inline auto new_string(const std::u16string_view value)
        -> std::unique_ptr<wrapper_type>
    {
        vmhook::detail::native_backend::operation access{};
        if (!access)
        { throw vmhook::exception{ "Java String allocation requires a native-thread or callback context" }; }
        const auto root{ vmhook::detail::native_backend::make_string_utf16(value) };
        if (!root) { throw vmhook::exception{ "Java String allocation failed" }; }
        return vmhook::detail::materialize_object<wrapper_type>(0, root);
    }

    // Optional interface callbacks use an ordinary application-loaded Java
    // InvocationHandler. The JDK creates and owns its ordinary Proxy class.
    class reflection_method final : public vmhook::oop_reflective_base
    {
    public:
        using vmhook::oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/reflect/Method" };
        auto name() const -> std::string
        {
            detail::native_backend::operation access{};
            if (!access) { throw exception{"Java Method inspection requires its owning VM context"}; }
            return detail::call_container_method(get_native_root(), "getName", "()Ljava/lang/String;").as_string();
        }
        auto declaring_class_name() const -> std::string
        {
            detail::native_backend::operation access{};
            if (!access) { throw exception{"Java Method inspection requires its owning VM context"}; }
            const std::unique_ptr<any_object> declaring = detail::call_container_method(
                get_native_root(), "getDeclaringClass", "()Ljava/lang/Class;");
            if (!declaring->get_instance()) { throw exception{"Java Method has no declaring class"}; }
            return declaring->get_method("getName", "()Ljava/lang/String;")->call().as_string();
        }
        auto parameter_types() const -> std::unique_ptr<array<any_object>>
        {
            detail::native_backend::operation access{};
            if (!access) { throw exception{"Java Method inspection requires its owning VM context"}; }
            return detail::call_container_method(get_native_root(), "getParameterTypes", "()[Ljava/lang/Class;");
        }
        auto return_type() const -> std::unique_ptr<any_object>
        {
            detail::native_backend::operation access{};
            if (!access) { throw exception{"Java Method inspection requires its owning VM context"}; }
            return detail::call_container_method(get_native_root(), "getReturnType", "()Ljava/lang/Class;");
        }
    };

    namespace detail
    {
        class interface_handler_binding : public vmhook::object<interface_handler_binding>
        { public: using vmhook::object<interface_handler_binding>::object; };
        inline std::mutex interface_binding_mutex{};

        template<container_wrapper interface_type>
        struct interface_proxy_control
        {
            retained_object<any_object> handler{};
            retained_object<interface_type> proxy{};
            std::atomic<bool> ready{};
            std::atomic<bool> closed{};
            method_hook_id observer{};
            virtual ~interface_proxy_control() = default;
        };
        template<container_wrapper interface_type, typename callback_type>
        struct interface_callback_control final : interface_proxy_control<interface_type>
        {
            callback_type callback;
            explicit interface_callback_control(callback_type callback)
                : callback{std::move(callback)} {}
        };

        inline auto forward_interface_failure(return_value& result,
            const std::unique_ptr<any_object>& receiver, const std::int32_t kind,
            const std::string_view message) noexcept -> void
        {
            // If even error transport is unavailable, leave the ordinary Java
            // handler body to raise its explicit unavailable/closed exception.
            try
            {
                const auto factory{receiver->get_method("new_failure", "(ILjava/lang/String;)Ljava/lang/Throwable;")};
                if (!factory) { return; }
                const std::unique_ptr<any_object> error = factory->call(kind, message);
                result.throw_exception(error);
            }
            catch (...) {}
        }
    }

    // A move-only resource. close() prevents new user callbacks; an invocation
    // already selected may finish with its own roots and shared control. The
    // embedding DLL follows the existing hook engine's resident-code lifetime.
    template<detail::container_wrapper interface_type>
    class interface_proxy final
    {
        std::atomic<std::shared_ptr<detail::interface_proxy_control<interface_type>>> control_{};
    public:
        interface_proxy() noexcept = default;
        explicit interface_proxy(std::shared_ptr<detail::interface_proxy_control<interface_type>> control) noexcept
            : control_{std::move(control)} {}
        interface_proxy(const interface_proxy&) = delete;
        auto operator=(const interface_proxy&) -> interface_proxy& = delete;
        interface_proxy(interface_proxy&& other) noexcept
            : control_{other.control_.exchange({})} {}
        auto operator=(interface_proxy&& other) noexcept -> interface_proxy&
        {
            if (this != &other) { close(); control_.store(other.control_.exchange({})); }
            return *this;
        }
        ~interface_proxy() { close(); }
        [[nodiscard]] auto valid() const noexcept -> bool
        {
            const auto state{control_.load()};
            return state && state->ready.load(std::memory_order_acquire)
                && !state->closed.load(std::memory_order_acquire);
        }
        explicit operator bool() const noexcept { return valid(); }
        [[nodiscard]] auto acquire() const -> std::unique_ptr<interface_type>
        {
            const auto state{control_.load()};
            if (!state || !state->ready.load(std::memory_order_acquire)
                || state->closed.load(std::memory_order_acquire))
            { throw exception{"Java interface callback resource is closed"}; }
            return state->proxy.acquire();
        }
        auto close() noexcept -> bool
        {
            const auto state{control_.exchange({})};
            if (!state) { return false; }
            state->closed.store(true, std::memory_order_release);
            (void)remove_hook(state->observer);
            // The hook captures only a weak reference. Active callbacks keep a
            // strong reference; handler/proxy roots release after the last one.
            return true;
        }
    };

    /* Create one ordinary Java Proxy for a registered Java interface. Supply a
       rooted instance of java/vmhook/callback_handler.java, loaded through the
       application's normal ClassLoader, or an equivalent declared handler
       exposing create_proxy(Class) and new_failure(int,String).

       The C++ callable receives owning Method and Object[] wrappers by const
       reference and returns an allocated unique_ptr to any Java wrapper. For
       zero arguments, Object[] has a null Java instance. Java void uses an
       allocated Java-null result. Primitive interface returns use ordinary
       Java boxed objects; Proxy performs its normal cast/unboxing checks.
       Construction requires a native administrator context, outside callbacks.
       Callbacks run synchronously and may occur concurrently on Java threads. */
    template<detail::container_wrapper interface_type, detail::container_wrapper handler_type, typename callback_type>
        requires std::invocable<std::decay_t<callback_type>&,
            const std::unique_ptr<reflection_method>&, const std::unique_ptr<array<any_object>>&>
    [[nodiscard]] auto make_interface_proxy(const std::unique_ptr<handler_type>& handler,
        callback_type&& callback, const hook_options options = {}) -> interface_proxy<interface_type>
    {
        using callback_result = std::invoke_result_t<std::decay_t<callback_type>&,
            const std::unique_ptr<reflection_method>&, const std::unique_ptr<array<any_object>>&>;
        static_assert(detail::is_java_object_pointer_v<callback_result>,
            "An interface callback must return an allocated unique_ptr to a Java wrapper.");
        if (hotspot::in_java_detour() || detail::class_event_notification_active()
            || !detail::native_backend::active())
        { throw exception{"Create interface callbacks from a native administrator context"}; }
        if (!handler) { throw exception{"An interface callback requires an allocated handler wrapper"}; }
        if (!detail::prepare_durable_roots())
        { throw exception{"Persistent Java callback roots are unavailable for this VM profile"}; }

        std::unique_ptr<any_object> receiver;
        std::unique_ptr<any_object> interface_mirror;
        std::shared_ptr<detail::class_binding> declaring_binding;
        constexpr std::string_view invoke_descriptor{
            "(Ljava/lang/Object;Ljava/lang/reflect/Method;[Ljava/lang/Object;)Ljava/lang/Object;"};
        {
            detail::native_backend::operation access{};
            if (!access || !handler->get_instance())
            { throw exception{"Java null cannot be an interface callback handler", error_code::null_reference}; }
            if (!handler->get_native_root() || !handler->get_native_root()->valid())
            { throw exception{"An interface callback handler requires a live VM-scanned root"}; }
            detail::require_object_wrapper_type<handler_type>(handler->get_instance());
            receiver = detail::materialize_object<any_object>(0, handler->get_native_root());
            const auto invoke{receiver->get_method("invoke", invoke_descriptor)};
            auto* const method{invoke ? invoke->raw_method() : nullptr};
            auto* const declaring{method ? detail::callback_declaring_class(method) : nullptr};
            if (!declaring || !declaring->get_name())
            { throw exception{"The supplied handler has no ordinary Java invoke method"}; }
            detail::require_reference_argument(receiver->get_instance(),
                "Ljava/lang/reflect/InvocationHandler;", declaring);
            // Preserve the actual declaring Method holder, including inherited
            // handlers whose parent class has a different defining loader.
            declaring_binding = std::make_shared<detail::class_binding>();
            declaring_binding->name = declaring->get_name()->to_string();
            declaring_binding->identity = declaring;
            declaring_binding->mirror = detail::retain_durable_oop(declaring->get_java_mirror());
            if (!declaring_binding->mirror)
            { throw exception{"The exact Java handler class could not be retained"}; }
            auto* const interface_class{detail::registered_class_klass<interface_type>()};
            if (!interface_class)
            { throw exception{"Register the exact Java interface before creating its proxy"}; }
            const auto mirror_root{detail::native_backend::retain_class(interface_class)};
            if (!mirror_root) { throw exception{"The Java interface mirror could not be retained"}; }
            interface_mirror = detail::materialize_object<any_object>(0, mirror_root);
            const bool is_interface = interface_mirror->get_method("isInterface", "()Z")->call();
            if (!is_interface)
            { throw exception{"Register a Java interface before creating its proxy"}; }
        }
        const auto factory{receiver->get_method("create_proxy", "(Ljava/lang/Class;)Ljava/lang/Object;")};
        if (!factory) { throw exception{"The handler does not expose create_proxy(Class)"}; }
        using control_type = detail::interface_callback_control<interface_type, std::decay_t<callback_type>>;
        auto state{std::make_shared<control_type>(std::forward<callback_type>(callback))};
        state->handler = retain(receiver);
        const std::weak_ptr<control_type> weak{state};
        {
            std::lock_guard install_lock{detail::interface_binding_mutex};
            detail::install_class_binding(std::type_index{typeid(detail::interface_handler_binding)},
                std::move(declaring_binding));
            try
            {
                state->observer = add_hook<detail::interface_handler_binding>("invoke", invoke_descriptor,
                    [weak](return_value& result, const std::unique_ptr<any_object>& self,
                        const std::unique_ptr<any_object>& proxy, const std::unique_ptr<reflection_method>& method,
                        const std::unique_ptr<array<any_object>>& arguments)
                    {
                        const auto current{weak.lock()};
                        if (!current || !current->ready.load(std::memory_order_acquire)
                            || current->closed.load(std::memory_order_acquire)) { return; }
                        try
                        {
                            if (!current->handler.is_same_object(self)
                                || !current->proxy.is_same_object(proxy)) { return; }
                            const auto name{method->name()};
                            if ((name == "equals" || name == "hashCode" || name == "toString")
                                && method->declaring_class_name() == "java.lang.Object") { return; }
                            const auto value{std::invoke(current->callback, method, arguments)};
                            result.set(value);
                        }
                        catch (const std::bad_alloc&)
                        { detail::forward_interface_failure(result, self, 1, "Native C++ allocation failed"); }
                        catch (const exception& error)
                        {
                            if (error.has_throwable())
                            {
                                try { result.throw_exception(error.get_throwable()); return; }
                                catch (...) {}
                            }
                            detail::forward_interface_failure(result, self, 0, error.what());
                        }
                        catch (const std::exception& error)
                        { detail::forward_interface_failure(result, self, 0, error.what()); }
                        catch (...)
                        { detail::forward_interface_failure(result, self, 0, "Unknown native callback failure"); }
                    }, options);
                unregister_class<detail::interface_handler_binding>();
            }
            catch (...) { unregister_class<detail::interface_handler_binding>(); throw; }
        }
        if (!state->observer) { throw exception{"The handler's ordinary Java invoke hook was refused"}; }
        try
        {
            const std::unique_ptr<interface_type> proxy = factory->call(interface_mirror);
            if (!proxy->get_instance()) { throw exception{"The normal Java proxy factory returned Java null"}; }
            state->proxy = retain(proxy);
            state->ready.store(true, std::memory_order_release);
        }
        catch (...)
        {
            state->closed.store(true, std::memory_order_release);
            (void)remove_hook(state->observer);
            throw;
        }
        return interface_proxy<interface_type>{std::move(state)};
    }

    inline auto exception::get_throwable() const -> std::unique_ptr<vmhook::any_object>
    {
        if (!this->throwable_)
        { throw vmhook::exception{ "This failure has no retained Java Throwable", vmhook::error_code::result_unavailable }; }
        vmhook::detail::native_backend::operation access{};
        return vmhook::detail::materialize_object<vmhook::any_object>(0, this->throwable_);
    }

    inline auto method_proxy::value_t::get_throwable() const -> std::unique_ptr<vmhook::any_object>
    {
        if (this->failure) { return this->failure->get_throwable(); }
        if (!this->exception_thrown || !this->native_exception_root)
        { throw vmhook::exception{ "This result has no retained Java Throwable", vmhook::error_code::result_unavailable }; }
        vmhook::detail::native_backend::operation access{};
        return vmhook::detail::materialize_object<vmhook::any_object>(0, this->native_exception_root);
    }
    template<vmhook::detail::container_wrapper collection_type = vmhook::array_list,
             vmhook::detail::container_wrapper element_type>
        requires std::is_base_of_v<vmhook::collection, collection_type>
    [[nodiscard]] inline auto make_collection(const std::vector<std::unique_ptr<element_type>>& elements)
        -> std::unique_ptr<collection_type>
    {
        auto result{ vmhook::make_unique<collection_type>() };
        for (const auto& element : elements) { (void)result->add(element); }
        return result;
    }

    template<vmhook::detail::container_wrapper map_type = vmhook::hash_map,
             vmhook::detail::container_wrapper key_type, vmhook::detail::container_wrapper mapped_type>
        requires std::is_base_of_v<vmhook::map, map_type>
    [[nodiscard]] inline auto make_map(
        const std::vector<std::pair<std::unique_ptr<key_type>, std::unique_ptr<mapped_type>>>& entries)
        -> std::unique_ptr<map_type>
    {
        auto result{ vmhook::make_unique<map_type>() };
        for (const auto& entry : entries) { (void)result->put(entry.first, entry.second); }
        return result;
    }

    class java_string : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/String" };
        auto length() const -> std::int32_t
        { return vmhook::detail::invoke_container(*this, java_contract, "length", "()I"); }
        auto is_empty() const -> bool { return length() == 0; }
        auto char_at(const std::int32_t index) const -> std::uint16_t
        { return vmhook::detail::invoke_container(*this, java_contract, "charAt", "(I)C", index); }
        auto to_string() const -> std::string
        { return vmhook::detail::invoke_container(*this, java_contract, "toString", "()Ljava/lang/String;"); }
        auto to_utf16() const -> std::u16string
        {
            const std::unique_ptr<vmhook::array<std::uint16_t>> characters =
                vmhook::detail::invoke_container(*this, java_contract, "toCharArray", "()[C");
            const auto values{ characters->to_vector() };
            std::u16string result(values.size(), u'\0');
            std::transform(values.begin(), values.end(), result.begin(),
                [](const std::uint16_t value) { return static_cast<char16_t>(value); });
            return result;
        }
        auto substring(const std::int32_t begin, const std::int32_t end) const -> std::unique_ptr<java_string>
        { return vmhook::detail::invoke_container(*this, java_contract, "substring", "(II)Ljava/lang/String;", begin, end); }
        auto starts_with(const std::string_view prefix) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "startsWith", "(Ljava/lang/String;)Z", prefix); }
        auto ends_with(const std::string_view suffix) const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "endsWith", "(Ljava/lang/String;)Z", suffix); }
    };

    class class_loader : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/ClassLoader" };
        auto load_class(const std::string_view binary_name) const -> vmhook::method_proxy::value_t
        { return vmhook::detail::invoke_container(*this, java_contract, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;", binary_name); }
        auto parent() const -> std::unique_ptr<class_loader>
        { return vmhook::detail::invoke_container(*this, java_contract, "getParent", "()Ljava/lang/ClassLoader;"); }
    };

    class class_object : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/Class" };
        auto name() const -> std::string
        { return vmhook::detail::invoke_container(*this, java_contract, "getName", "()Ljava/lang/String;"); }
        auto is_array() const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "isArray", "()Z"); }
        auto is_primitive() const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "isPrimitive", "()Z"); }
        auto is_interface() const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "isInterface", "()Z"); }
        auto loader() const -> std::unique_ptr<class_loader>
        { return vmhook::detail::invoke_container(*this, java_contract, "getClassLoader", "()Ljava/lang/ClassLoader;"); }
        auto super_class() const -> std::unique_ptr<class_object>
        { return vmhook::detail::invoke_container(*this, java_contract, "getSuperclass", "()Ljava/lang/Class;"); }
        auto component_type() const -> std::unique_ptr<class_object>
        { return vmhook::detail::invoke_container(*this, java_contract, "getComponentType", "()Ljava/lang/Class;"); }
        static auto for_name(const std::string_view binary_name, const std::unique_ptr<class_loader>& loader,
                             const bool initialize = false) -> std::unique_ptr<class_object>
        { return vmhook::detail::call_bootstrap_method(java_contract, "forName",
            "(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;", binary_name, initialize, loader); }
    };

    class throwable : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/Throwable" };
        auto message() const -> std::unique_ptr<java_string>
        { return vmhook::detail::invoke_container(*this, java_contract, "getMessage", "()Ljava/lang/String;"); }
        auto cause() const -> std::unique_ptr<throwable>
        { return vmhook::detail::invoke_container(*this, java_contract, "getCause", "()Ljava/lang/Throwable;"); }
        auto to_string() const -> std::string
        { return vmhook::detail::invoke_container(*this, java_contract, "toString", "()Ljava/lang/String;"); }
        auto stack_trace() const -> vmhook::method_proxy::value_t
        { return vmhook::detail::invoke_container(*this, java_contract, "getStackTrace", "()[Ljava/lang/StackTraceElement;"); }
    };

    class java_enum : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/lang/Enum" };
        auto name() const -> std::string
        { return vmhook::detail::invoke_container(*this, java_contract, "name", "()Ljava/lang/String;"); }
        auto ordinal() const -> std::int32_t
        { return vmhook::detail::invoke_container(*this, java_contract, "ordinal", "()I"); }
    };

    template<typename primitive_type>
        requires (!vmhook::detail::primitive_array_descriptor<primitive_type>.empty())
    class boxed : public vmhook::oop_reflective_base
    {
        inline static constexpr std::size_t index{
            std::string_view{ "ZBCSIJFD" }.find(vmhook::detail::primitive_array_descriptor<primitive_type>[1]) };
        inline static constexpr std::array<std::string_view, 8> contracts{
            "java/lang/Boolean", "java/lang/Byte", "java/lang/Character", "java/lang/Short",
            "java/lang/Integer", "java/lang/Long", "java/lang/Float", "java/lang/Double" };
        inline static constexpr std::array<std::string_view, 8> accessors{
            "booleanValue", "byteValue", "charValue", "shortValue", "intValue", "longValue", "floatValue", "doubleValue" };
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ contracts[index] };
        auto value() const -> primitive_type
        {
            const std::string signature{ "()" + std::string{vmhook::detail::primitive_array_descriptor<primitive_type>.substr(1)} };
            return vmhook::detail::invoke_container(*this, java_contract, accessors[index], signature);
        }
        static auto value_of(const primitive_type value) -> std::unique_ptr<boxed>
        {
            const std::string signature{ "(" + std::string{vmhook::detail::primitive_array_descriptor<primitive_type>.substr(1)}
                + ")L" + std::string{java_contract} + ";" };
            return vmhook::detail::call_bootstrap_method(java_contract, "valueOf", signature, value);
        }
    };
    using java_boolean = boxed<bool>;
    using java_byte = boxed<std::int8_t>;
    using java_char = boxed<std::uint16_t>;
    using java_short = boxed<std::int16_t>;
    using java_integer = boxed<std::int32_t>;
    using java_long = boxed<std::int64_t>;
    using java_float = boxed<float>;
    using java_double = boxed<double>;

    class optional : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/util/Optional" };
        auto is_present() const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "isPresent", "()Z"); }
        auto is_empty() const -> bool { return !is_present(); }
        auto get() const -> vmhook::method_proxy::value_t
        { return vmhook::detail::invoke_container(*this, java_contract, "get", "()Ljava/lang/Object;"); }
        template<vmhook::detail::container_wrapper wrapper_type>
        auto or_else(const std::unique_ptr<wrapper_type>& fallback) const -> vmhook::method_proxy::value_t
        { return vmhook::detail::invoke_container(*this, java_contract, "orElse", "(Ljava/lang/Object;)Ljava/lang/Object;", fallback); }
        static auto empty() -> std::unique_ptr<optional>
        { return vmhook::detail::call_bootstrap_method(java_contract, "empty", "()Ljava/util/Optional;"); }
        template<vmhook::detail::container_wrapper wrapper_type>
        static auto of_nullable(const std::unique_ptr<wrapper_type>& value) -> std::unique_ptr<optional>
        { return vmhook::detail::call_bootstrap_method(java_contract, "ofNullable", "(Ljava/lang/Object;)Ljava/util/Optional;", value); }
    };

    /* Buffer transfers copy bytes and preserve VM ownership. A direct buffer's
       native storage remains owned by its Java Cleaner; no unrooted C++ span
       escapes the context. to_vector observes remaining bytes without advancing
       the original buffer, while put advances its position as Java does. */
    class byte_buffer : public vmhook::oop_reflective_base
    {
    public:
        using oop_reflective_base::oop_reflective_base;
        inline static constexpr std::string_view java_contract{ "java/nio/ByteBuffer" };
        static auto allocate(const std::int32_t capacity) -> std::unique_ptr<byte_buffer>
        { return vmhook::detail::call_bootstrap_method(java_contract, "allocate", "(I)Ljava/nio/ByteBuffer;", capacity); }
        static auto allocate_direct(const std::int32_t capacity) -> std::unique_ptr<byte_buffer>
        { return vmhook::detail::call_bootstrap_method(java_contract, "allocateDirect", "(I)Ljava/nio/ByteBuffer;", capacity); }
        auto is_direct() const -> bool
        { return vmhook::detail::invoke_container(*this, java_contract, "isDirect", "()Z"); }
        auto capacity() const -> std::int32_t
        { return vmhook::detail::invoke_container(*this, java_contract, "capacity", "()I"); }
        auto position() const -> std::int32_t
        { return vmhook::detail::invoke_container(*this, java_contract, "position", "()I"); }
        auto position(const std::int32_t next) const -> void
        { (void)vmhook::detail::invoke_container(*this, java_contract, "position", "(I)Ljava/nio/Buffer;", next); }
        auto remaining() const -> std::int32_t
        { return vmhook::detail::invoke_container(*this, java_contract, "remaining", "()I"); }
        auto get(const std::int32_t index) const -> std::int8_t
        { return vmhook::detail::invoke_container(*this, java_contract, "get", "(I)B", index); }
        auto put(const std::int32_t index, const std::int8_t value) const -> void
        { (void)vmhook::detail::invoke_container(*this, java_contract, "put", "(IB)Ljava/nio/ByteBuffer;", index, value); }
        auto put(const std::span<const std::int8_t> bytes) const -> void
        {
            if (bytes.size() > static_cast<std::size_t>((std::numeric_limits<std::int32_t>::max)()))
            { throw vmhook::exception{ "ByteBuffer copy exceeds the Java array length limit" }; }
            const auto source{ vmhook::make_array<std::int8_t>(static_cast<std::int32_t>(bytes.size())) };
            source->copy_from(bytes);
            (void)vmhook::detail::invoke_container(*this, java_contract, "put", "([B)Ljava/nio/ByteBuffer;", source);
        }
        auto to_vector() const -> std::vector<std::int8_t>
        {
            const std::unique_ptr<byte_buffer> copy = vmhook::detail::invoke_container(*this, java_contract,
                "duplicate", "()Ljava/nio/ByteBuffer;");
            const auto destination{ vmhook::make_array<std::int8_t>(copy->remaining()) };
            (void)vmhook::detail::invoke_container(*copy, java_contract, "get", "([B)Ljava/nio/ByteBuffer;", destination);
            return destination->to_vector();
        }
    };

    inline auto field_proxy::value_t::operator->() const -> std::unique_ptr<vmhook::any_object>
    {
        return static_cast<std::unique_ptr<vmhook::any_object>>(*this);
    }

    inline auto method_proxy::value_t::operator->() const -> std::unique_ptr<vmhook::any_object>
    {
        return static_cast<std::unique_ptr<vmhook::any_object>>(*this);
    }

    /*
        @brief A container of anchor-path references.
        @details append accepts refs and elements_of builds indexed paths. No operation
        registers a GC root or guarantees a coherent collection snapshot. Concurrent
        slot mutation and GC can invalidate traversal even when the paths remain unchanged.
        Complexity: amortized O(1) append; O(N) traversal.
    */
    template<typename wrapper_type>
    class ref_vector final
    {
    public:
        using value_type     = vmhook::ref<wrapper_type>;
        using container_type = std::vector<value_type>;
        using const_iterator = typename container_type::const_iterator;
        using iterator       = const_iterator;
        using size_type      = typename container_type::size_type;

        ref_vector() = default;

        /* @brief Appends an ALREADY-ROOTED ref.  Returns false (and appends
           nothing) for an empty one, so a broken walk cannot smuggle a hole in. */
        auto append(const value_type& element)
            -> bool
        {
            if (element.empty())
            {
                return false;
            }
            this->elements_.push_back(element);
            return true;
        }

        auto begin() const noexcept -> const_iterator { return this->elements_.begin(); }
        auto end()   const noexcept -> const_iterator { return this->elements_.end(); }
        auto cbegin() const noexcept -> const_iterator { return this->elements_.cbegin(); }
        auto cend()   const noexcept -> const_iterator { return this->elements_.cend(); }

        auto size() const noexcept
            -> size_type
        {
            return this->elements_.size();
        }

        auto empty() const noexcept
            -> bool
        {
            return this->elements_.empty();
        }

        auto operator[](const size_type index) const
            -> const value_type&
        {
            return this->elements_[index];
        }

        /* Bounds-checked diagnostic path access; out-of-range yields an empty
           path. This does not describe owning object values or checked Java calls. */
        auto at(const size_type index) const
            -> value_type
        {
            return index < this->elements_.size() ? this->elements_[index] : value_type{};
        }

        auto clear() noexcept
            -> void
        {
            this->elements_.clear();
        }

        auto reserve(const size_type capacity)
            -> void
        {
            this->elements_.reserve(capacity);
        }

        /* @brief A plain std::vector copy of the (still anchored) elements. */
        auto to_vector() const
            -> container_type
        {
            return this->elements_;
        }

    private:
        container_type elements_{};
    };

    /*
        @brief Builds indexed reference paths from an observed Java array length.
        @details max_elements bounds allocation. Paths can be resolved again but
        do not root the array/elements or make traversal atomic against slot
        mutation and collection. No live moving-GC correctness is implied.
    */
    template<typename element_wrapper, typename array_wrapper>
    inline auto elements_of(const vmhook::ref<array_wrapper>& array_ref,
                            const std::size_t max_elements = vmhook::k_max_safe_container_elems) noexcept
        -> vmhook::ref_vector<element_wrapper>
    {
        vmhook::ref_vector<element_wrapper> result{};
        try
        {
            vmhook::oop_t const array_oop{ array_ref.resolve() };
            if (!array_oop)
            {
                return result;
            }
            const std::int32_t length{ vmhook::clamp_safe_container_count(
                vmhook::array_length(array_oop)) };
            if (length <= 0)
            {
                return result;
            }
            const std::size_t count{ std::min<std::size_t>(static_cast<std::size_t>(length),
                                                           max_elements) };
            result.reserve(count);
            for (std::size_t index{ 0 }; index < count; ++index)
            {
                // Anchored, not decoded: the element ref names a SLOT, so the
                // address is derived at use time and there is nothing here that
                // could go stale between now and then.
                result.append(array_ref.template element<element_wrapper>(
                    static_cast<std::int32_t>(index)));
            }
            return result;
        }
        catch (const std::exception&)
        {
            return vmhook::ref_vector<element_wrapper>{};
        }
    }

    /*
        @brief Free-function spelling of vmhook::ref<T>::at_static.
    */
    template<typename wrapper_type>
    inline auto static_ref(const std::string_view class_name,
                           const std::string_view field_name) noexcept
        -> vmhook::ref<wrapper_type>
    {
        return vmhook::ref<wrapper_type>::at_static(class_name, field_name);
    }

    /*
        @brief Free-function spelling of vmhook::ref<T>::ephemeral - wraps a bare
               detour-scoped address.
    */
    template<typename wrapper_type>
    inline auto ephemeral_ref(const vmhook::oop_t address) noexcept
        -> vmhook::ref<wrapper_type>
    {
        return vmhook::ref<wrapper_type>::ephemeral(address);
    }

    /*
        @brief Free-function spelling of the vmhook::borrowed constructor.
    */
    template<typename wrapper_type>
    inline auto borrow(const vmhook::oop_t address) noexcept
        -> vmhook::borrowed<wrapper_type>
    {
        return vmhook::borrowed<wrapper_type>{ address };
    }

    // Diagnostic object snapshots. These do not register roots, pin objects, or
    // make a raw address safe across a collection or concurrent access.
    /*
        @brief Move-only diagnostic snapshot of a raw object address and collection epoch.
        @details This is not a GC root or object pin. Resolution rejects an observed
        collection change or unavailable detector. A matching sample does not prove liveness,
        and GC can begin after the check. raw_unsafe returns the captured address for
        diagnostics only. Moving transfers the snapshot; no VM resource is registered.
    */
    class oop_pin final
    {
    public:
        oop_pin() noexcept = default;

        explicit oop_pin(vmhook::oop_t const raw_oop) noexcept
            : oop_{ raw_oop }
            , epoch_{ vmhook::gc_epoch() }
        {
        }

        ~oop_pin() noexcept = default;

        oop_pin(const oop_pin&) = delete (
            "an oop_pin carries the collection epoch its address was captured in.  "
            "Copying it would duplicate that stamp and let a stale copy outlive the "
            "check.  Move it, or take a fresh pin.");
        auto operator=(const oop_pin&) -> oop_pin& = delete (
            "an oop_pin carries the collection epoch its address was captured in; "
            "copying it would duplicate that stamp.  Move it instead.");

        oop_pin(oop_pin&& other) noexcept
            : oop_{ other.oop_ }
            , epoch_{ other.epoch_ }
        {
            other.oop_   = nullptr;
            other.epoch_ = vmhook::gc_epoch_t{};
        }

        auto operator=(oop_pin&& other) noexcept -> oop_pin&
        {
            if (this != &other)
            {
                this->oop_   = other.oop_;
                this->epoch_ = other.epoch_;
                other.oop_   = nullptr;
                other.epoch_ = vmhook::gc_epoch_t{};
            }
            return *this;
        }

        /*
            @brief True when the captured address must not be used.
            @details
            Re-samples the collection epoch and compares it with the one
            recorded at construction (see vmhook::gc_epoch_changed).  A
            default-constructed or reset() holder is stale, and so is one
            built on a VM where the detector cannot vouch for anything — an
            unreadable epoch NEVER degrades to "assume it did not move".
            Complexity: O(1) (three fault-safe reads).
            Exception safety: noexcept.  Thread safety: safe.
        */
        auto is_stale() const noexcept -> bool
        {
            return vmhook::gc_epoch_changed(this->epoch_);
        }

        /*
            @brief The stored heap OOP, or nullptr if empty OR stale.
            @details
            Returns the captured address only while the collection epoch is
            unchanged; otherwise nullptr.  It is still not a liveness
            guarantee — a non-relocating collector can reclaim the object
            without bumping anything this can observe, and the holder is not
            a root — but it will never hand back an address a relocating
            collection may have invalidated.
            Complexity: O(1).  Exception safety: noexcept.
            Thread safety: safe.
        */
        auto oop() const noexcept -> vmhook::oop_t
        {
            return this->is_stale() ? nullptr : this->oop_;
        }

        /*
            @brief The captured address with NO staleness check.  May be
            stale, may be dangling — for diagnostics and logging only.
            @details
            Exists so a log line can say which address went stale.  Never
            dereference it and never pass it to anything that will.
        */
        auto raw_unsafe() const noexcept -> vmhook::oop_t
        {
            return this->oop_;
        }

        /*
            @brief Clears the stored OOP and its epoch (idempotent).  oop()
            and raw_unsafe() return nullptr after.  Nothing is released —
            there was no VM-side registration to release.
        */
        auto reset() noexcept -> void
        {
            this->oop_   = nullptr;
            this->epoch_ = vmhook::gc_epoch_t{};
        }

        /*
            @brief The usable OOP (retained for API compatibility).  Applies
            the same staleness check as oop(); null when empty or stale.
        */
        auto handle() const noexcept -> void*
        {
            return this->oop();
        }

        explicit operator bool() const noexcept
        {
            return this->oop() != nullptr;
        }

    private:
        vmhook::oop_t     oop_{ nullptr };
        vmhook::gc_epoch_t epoch_{};
    };

    /*
        @brief Wraps a raw OOP in a vmhook::oop_pin holder.
        @details One-liner for the `oop_pin{ oop }` pattern.  This does NOT
        protect the object from GC and is NOT a root — it records the current
        collection epoch so the holder reports stale (oop() == nullptr) after
        the next collection instead of handing back a moved address.  See the
        oop_pin class doc for the full contract.
    */
    inline auto pin(vmhook::oop_t const oop) noexcept
        -> vmhook::oop_pin
    {
        return vmhook::oop_pin{ oop };
    }

    /*
        @brief Wraps the Java object behind a wrapper unique_ptr in a holder.
        @details `pin(wrapper)` instead of `vmhook::oop_pin{ wrapper->get_instance() }`.
        An empty C++ pointer or invalid context throws. A Java null wrapper
        creates an empty diagnostic holder. This holder supplies no GC root:
        retain the owning wrapper for its actual context-scanned lifetime.
    */
    template<typename wrapper_type>
        requires vmhook::detail::is_java_object_pointer_v<std::unique_ptr<wrapper_type>>
    inline auto pin(const std::unique_ptr<wrapper_type>& wrapper)
        -> vmhook::oop_pin
    {
        vmhook::detail::require_object_argument(wrapper);
        return vmhook::oop_pin{ wrapper->vmhook::object_base::get_instance() };
    }

    /*
        @brief Wraps the object behind a vmhook::borrowed in a holder.
        @details
        The bridge from the handle model back to the address model, for code
        that still needs an address (a raw callback, a C ABI, a log line).
        Resolves the borrow FIRST, so an already-expired borrow yields an empty
        holder rather than pinning an address that is known to be stale — a pin
        built on a stale address is exactly the bug the pin exists to catch.

        Note this is a DOWNGRADE in every respect except address availability:
        the borrow's epoch is discarded and re-sampled, and the result still
        keeps nothing alive.  Prefer borrowed::pin(), which promotes to a
        vmhook::ref and stays in the model.
    */
    template<typename wrapper_type>
    inline auto pin(const vmhook::borrowed<wrapper_type>& handle) noexcept
        -> vmhook::oop_pin
    {
        vmhook::oop_t const address{ handle.resolve() };
        return address ? vmhook::oop_pin{ address } : vmhook::oop_pin{};
    }
}

// ---------------------------------------------------------------------------
// std::hash support for the anchored-reference identity types.
//
// These live outside `namespace vmhook` because a specialisation of a standard
// template has to.  Both hash the SAME token vmhook::ref::operator== compares,
// so the hash / equality pair an unordered container needs is consistent by
// construction: equal keys always hash equal.
//
// The token is relocation-proof (see vmhook::object_id), which is the whole
// point - a raw heap address used as a map key silently changes meaning after a
// collection, and that is a documented source of cross-thread races downstream.
// ---------------------------------------------------------------------------
namespace std
{
    template<>
    struct hash<vmhook::object_id>
    {
        auto operator()(const vmhook::object_id id) const noexcept
            -> std::size_t
        {
            return static_cast<std::size_t>(id.value());
        }
    };

    template<typename wrapper_type>
    struct hash<vmhook::ref<wrapper_type>>
    {
        auto operator()(const vmhook::ref<wrapper_type>& value) const noexcept
            -> std::size_t
        {
            return static_cast<std::size_t>(value.id().value());
        }
    };

    template<typename wrapper_type>
    struct hash<vmhook::borrowed<wrapper_type>>
    {
        auto operator()(const vmhook::borrowed<wrapper_type>& value) const noexcept
            -> std::size_t
        {
            return static_cast<std::size_t>(value.id().value());
        }
    };
}

// Native class observation: resident detours and immutable callbacks.
export namespace vmhook::detail {
    auto prepare_class_hooks(vmhook::hotspot::klass* klass) noexcept -> bool;
    auto finish_class_hooks(vmhook::hotspot::klass* klass,bool success) noexcept -> void;
}
export namespace vmhook::detail::class_events {
// Executable memory, function table and the containing DLL remain resident.
// Removing a subscription never removes an entry detour or frees its code.
class native_entry_hook {
    std::byte* target_{};
    std::byte* code_{};
    std::size_t stolen_{};
    std::array<std::byte, 32> original_{};
    std::array<std::byte, 32> patch_{};
    vmhook::windows::RUNTIME_FUNCTION* table_{};
    struct unwind_operation { unsigned char end{}, kind{}, info{}; std::uint32_t extra{}; bool large{}; };

    static auto prefix_unwind(std::span<const std::byte> input,
        std::span<std::byte> unwind,std::array<std::size_t,2>& calls,std::size_t& call_count) noexcept -> std::size_t {
        std::array<unwind_operation, 12> ops{};
        std::size_t cursor{}, count{}, stack{}, anchor_stack{};bool anchor_valid{}, rbp_saved{};
        struct saved { std::size_t op; std::int64_t displacement; };
        std::array<saved, 8> saves{}; std::size_t save_count{};
        const auto byte=[&](std::size_t i){return std::to_integer<unsigned>(input[i]);};
        const auto nonvolatile=[](unsigned reg){return reg==3 || reg==5 || reg==6 || reg==7 || reg>=12;};
        while(cursor<5 && cursor+5<=input.size()) {
            const auto start=cursor;
            unsigned reg{};
            if(byte(cursor)==0x4c && byte(cursor+1)==0x8b && byte(cursor+2)==0xdc) {
                cursor+=3;
            } else if(byte(cursor)==0x49 && byte(cursor+1)==0x8d && byte(cursor+2)==0x6b && rbp_saved) {
                // MSVC's 26/27 scanner sets RBP from the saved entry RSP.
                // It still uses an RSP-based unwind record (FrameRegister=0).
                // The preceding PUSH_NONVOL restores RBP even after this LEA.
                cursor+=4;
            } else if(byte(cursor)==0x48 && byte(cursor+1)==0x8b && byte(cursor+2)==0xc4) {
                anchor_stack=stack;anchor_valid=true;cursor+=3;
            } else if((byte(cursor)==0x48 || byte(cursor)==0x4c) && byte(cursor+1)==0x89 && (byte(cursor+2)&0xc7)==0x40 && anchor_valid) {
                reg=((byte(cursor+2)>>3)&7)+(byte(cursor)==0x4c?8:0);
                const auto displacement=static_cast<std::int8_t>(byte(cursor+3));cursor+=4;
                if(nonvolatile(reg)) {
                    saves[save_count++]={count,static_cast<std::int64_t>(displacement)-static_cast<std::int64_t>(anchor_stack)};
                    ops[count++]={static_cast<unsigned char>(cursor),4,static_cast<unsigned char>(reg),0,true};
                }
            } else if(byte(cursor)==0x40 && byte(cursor+1)>=0x50 && byte(cursor+1)<=0x57) {
                reg=byte(cursor+1)-0x50;if(!nonvolatile(reg))return 0;cursor+=2;
                ops[count++]={static_cast<unsigned char>(cursor),0,static_cast<unsigned char>(reg)};stack+=8;
            } else if(byte(cursor)==0x41 && byte(cursor+1)>=0x50 && byte(cursor+1)<=0x57) {
                reg=8+byte(cursor+1)-0x50;if(!nonvolatile(reg))return 0;cursor+=2;
                ops[count++]={static_cast<unsigned char>(cursor),0,static_cast<unsigned char>(reg)};stack+=8;
            } else if(byte(cursor)>=0x50 && byte(cursor)<=0x57) {
                reg=byte(cursor)-0x50;if(!nonvolatile(reg))return 0;cursor+=1;
                if(reg==5)rbp_saved=true;
                ops[count++]={static_cast<unsigned char>(cursor),0,static_cast<unsigned char>(reg)};stack+=8;
            } else if(byte(cursor)==0x48 && byte(cursor+1)==0x83 && byte(cursor+2)==0xec) {
                const auto amount=byte(cursor+3);
                if(!amount || amount>=128 || amount%8)return 0;
                cursor+=4;stack+=amount;
                ops[count++]={static_cast<unsigned char>(cursor),2,static_cast<unsigned char>(amount/8-1)};
            } else if(byte(cursor)==0x48 && byte(cursor+1)==0x81 && byte(cursor+2)==0xec) {
                std::uint32_t amount{};std::memcpy(&amount,input.data()+cursor+3,4);
                if(!amount || amount%8 || amount>0x100000)return 0;
                cursor+=7;stack+=amount;
                if(amount<=524280)ops[count++]={static_cast<unsigned char>(cursor),1,0,amount/8,true};
                else ops[count++]={static_cast<unsigned char>(cursor),1,1,amount,true};
            } else if((byte(cursor)==0x48 || byte(cursor)==0x4c) && byte(cursor+1)==0x89
                      && (byte(cursor+2)&0xc7)==0x44 && byte(cursor+3)==0x24) {
                reg=((byte(cursor+2)>>3)&7)+(byte(cursor)==0x4c?8:0);
                const auto displacement=static_cast<std::int8_t>(byte(cursor+4));cursor+=5;
                if(nonvolatile(reg)) {
                    saves[save_count++]={count,static_cast<std::int64_t>(displacement)-static_cast<std::int64_t>(stack)};
                    ops[count++]={static_cast<unsigned char>(cursor),4,static_cast<unsigned char>(reg),0,true};
                }
            } else if((byte(cursor)==0xe8 || byte(cursor)==0xe9) && call_count<calls.size()) {
                calls[call_count++]=cursor;cursor+=5;
            } else return 0;
            if(cursor==start || count==ops.size())return 0;
        }
        if(cursor<5)return 0;
        for(std::size_t i{};i<save_count;++i) {
            // RSP-relative stores precede stack growth in the accepted prefix.
            const auto offset=saves[i].displacement+static_cast<std::int64_t>(stack);
            if(offset<0 || offset%8 || offset/8>65535)return 0;
            ops[saves[i].op].extra=static_cast<unsigned short>(offset/8);
        }
        std::size_t slots{};for(std::size_t i{};i<count;++i)slots+=ops[i].large ? (ops[i].kind==1 && ops[i].info==1?3:2) : 1;
        if(4+slots*2>unwind.size())return 0;
        unwind[0]=std::byte{1};unwind[1]=static_cast<std::byte>(cursor);
        unwind[2]=static_cast<std::byte>(slots);unwind[3]=std::byte{};
        std::size_t out=4;
        for(std::size_t i=count;i>0;--i) {
            const auto& op=ops[i-1];unwind[out++]=static_cast<std::byte>(op.end);
            unwind[out++]=static_cast<std::byte>((op.info<<4)|op.kind);
            if(op.large){const auto bytes=op.kind==1 && op.info==1?4u:2u;std::memcpy(unwind.data()+out,&op.extra,bytes);out+=bytes;}
        }
        return cursor;
    }
    static auto continuation_jump(std::byte* destination, const void* address) noexcept -> void {
        destination[0]=std::byte{0x49};destination[1]=std::byte{0xba};
        std::memcpy(destination+2,&address,8);
        destination[10]=std::byte{0x41};destination[11]=std::byte{0xff};destination[12]=std::byte{0xe2};
    }
    static auto absolute_jump(std::byte* destination, const void* address) noexcept -> void {
        const std::array<unsigned char,6> opcode{0xff,0x25,0,0,0,0};
        std::memcpy(destination,opcode.data(),6);std::memcpy(destination+6,&address,8);
    }
    static auto exchange(std::byte* target, std::span<const std::byte> expected,
        std::span<const std::byte> replacement) noexcept -> bool {
        if(expected.size()!=replacement.size() || expected.empty() || expected.size()>32)return false;
        std::lock_guard lock{vmhook::hotspot::g_code_patch_mutex};
        vmhook::hotspot::code_patch_threads paused{};
        if(!paused.permits(target,replacement.size()))return false;
        std::array<std::byte,32> current{};
        if(!vmhook::os::safe_read(current.data(),target,expected.size())
           || std::memcmp(current.data(),expected.data(),expected.size()))return false;
        vmhook::windows::DWORD old{};
        if(!vmhook::windows::VirtualProtect(target,replacement.size(),vmhook::windows::page_execute_readwrite,&old))return false;
        vmhook::windows::SIZE_T written{};
        const bool changed=vmhook::windows::WriteProcessMemory(vmhook::windows::GetCurrentProcess(),target,replacement.data(),replacement.size(),&written)
                            && written==replacement.size();
        if(!changed) {
            vmhook::windows::SIZE_T restored{};
            if(!vmhook::windows::WriteProcessMemory(vmhook::windows::GetCurrentProcess(),target,expected.data(),expected.size(),&restored)
               || restored!=expected.size())vmhook::windows::TerminateProcess(vmhook::windows::GetCurrentProcess(),vmhook::windows::error_write_fault);
        }
        vmhook::windows::FlushInstructionCache(vmhook::windows::GetCurrentProcess(),target,replacement.size());
        vmhook::windows::DWORD ignored{};vmhook::windows::VirtualProtect(target,replacement.size(),old,&ignored);
        return changed;
    }
public:
    static auto audited_prefix_length(std::span<const std::byte> bytes) noexcept -> std::size_t {
        if(bytes.size()<16)return 0;
        std::array<std::byte,64> unwind{};std::array<std::size_t,2> calls{};std::size_t count{};
        return prefix_unwind(bytes,unwind,calls,count);
    }
    native_entry_hook()=default;
    native_entry_hook(const native_entry_hook&)=delete;
    auto operator=(const native_entry_hook&)->native_entry_hook& = delete;
    // expected is exact-image evidence, validated by the caller's DLL identity.
    auto install(void* target, const void* detour, std::span<const std::byte> expected) noexcept -> bool {
        if(code_ || !target || !detour || expected.size()<5 || expected.size()>original_.size())return false;
        std::array<std::byte,64> unwind{};
        std::array<std::byte,32> prefix{};std::memcpy(prefix.data(),expected.data(),expected.size());
        std::array<std::size_t,2> calls{};std::size_t call_count{};
        const auto stolen=prefix_unwind(prefix,unwind,calls,call_count);
        if(stolen!=expected.size())return false;
        std::array<std::byte,32> actual{};
        if(!vmhook::os::safe_read(actual.data(),target,stolen) || std::memcmp(actual.data(),expected.data(),stolen))return false;
        auto* memory=reinterpret_cast<std::byte*>(vmhook::hotspot::allocate_nearby_memory(reinterpret_cast<unsigned char*>(target),4096));
        if(!memory)return false;
        const auto delta=reinterpret_cast<std::intptr_t>(memory+32)-(reinterpret_cast<std::intptr_t>(target)+5);
        if(delta<std::numeric_limits<std::int32_t>::min() || delta>std::numeric_limits<std::int32_t>::max()){vmhook::os::release(memory,4096);return false;}
        std::memcpy(memory,expected.data(),stolen);
        for(std::size_t i{};i<call_count;++i) {
            const auto offset=calls[i];std::int32_t relative{};std::memcpy(&relative,expected.data()+offset+1,4);
            const auto callee=reinterpret_cast<std::intptr_t>(target)+static_cast<std::intptr_t>(offset)+5+relative;
            const auto moved=callee-(reinterpret_cast<std::intptr_t>(memory)+static_cast<std::intptr_t>(offset)+5);
            if(moved<std::numeric_limits<std::int32_t>::min() || moved>std::numeric_limits<std::int32_t>::max()){vmhook::os::release(memory,4096);return false;}
            relative=static_cast<std::int32_t>(moved);std::memcpy(memory+offset+1,&relative,4);
        }
        continuation_jump(memory+stolen,static_cast<std::byte*>(target)+stolen);
        absolute_jump(memory+32,detour);
        std::memcpy(memory+64,unwind.data(),unwind.size());
        auto* table=reinterpret_cast<vmhook::windows::RUNTIME_FUNCTION*>(memory+128);
        *table={0,static_cast<vmhook::windows::DWORD>(stolen+13),64};
        // The relay contains no stack effects; include an empty unwind entry.
        memory[192]=std::byte{1};*reinterpret_cast<vmhook::windows::RUNTIME_FUNCTION*>(memory+140)={32,46,192};
        if(!vmhook::windows::RtlAddFunctionTable(table,2,reinterpret_cast<vmhook::windows::DWORD64>(memory))){vmhook::os::release(memory,4096);return false;}
        vmhook::windows::DWORD ignored{};
        if(!vmhook::windows::VirtualProtect(memory,4096,vmhook::windows::page_execute_read,&ignored)
           || !vmhook::windows::FlushInstructionCache(vmhook::windows::GetCurrentProcess(),memory,4096)){
            vmhook::windows::RtlDeleteFunctionTable(table);vmhook::os::release(memory,4096);return false;
        }
        std::memcpy(original_.data(),expected.data(),stolen);
        patch_.fill(std::byte{0x90});patch_[0]=std::byte{0xe9};const auto rel=static_cast<std::int32_t>(delta);
        std::memcpy(patch_.data()+1,&rel,4);
        // Publish the original before the entry can execute the detour.
        target_=static_cast<std::byte*>(target);code_=memory;stolen_=stolen;table_=table;
        if(!exchange(target_,{original_.data(),stolen_},{patch_.data(),stolen_})) {
            code_=nullptr;target_=nullptr;stolen_=0;table_=nullptr;
            vmhook::windows::RtlDeleteFunctionTable(table);vmhook::os::release(memory,4096);return false;
        }
        return true;
    }
    [[nodiscard]] auto original()const noexcept -> void* {return code_;}
    [[nodiscard]] auto matches()const noexcept -> bool {
        std::array<std::byte,32> current{};
        return code_ && vmhook::os::safe_read(current.data(),target_,stolen_)
               && !std::memcmp(current.data(),patch_.data(),stolen_);
    }
};
}

// A synthetic areturn starts at the intercepted method's BCI0. HotSpot's
// ordinary BCI0 oop map describes its arguments, but no expression-stack oop.
// Extend the genuine frame scan only while its real return codelet has pushed
// the synthetic TOS. The closure visits the actual stack cell, so a moving GC
// both retains the object and rewrites the address the epilogue will pop.
export namespace vmhook::detail::callback_return_roots {
namespace pn = vmhook::detail::private_native;
using entry_hook = vmhook::detail::class_events::native_entry_hook;
struct marker final {
    void* const fp;
    std::atomic<void*> method{};
    marker* const local_previous;
    marker* global_previous{};
    marker(void* frame, marker* previous) noexcept : fp{frame}, local_previous{previous} {}
};
inline std::atomic<marker*> markers{};
static_assert(std::atomic<marker*>::is_always_lock_free && std::atomic<void*>::is_always_lock_free);
thread_local marker* local_markers{};
inline std::atomic<std::uint64_t> scanned_slots{};
struct configuration final {
    std::size_t sp_offset{}, pc_offset{}, fp_offset{}, heap_offset{}, wide_slot{}, const_method_offset{}, const_method_size{};
    std::ptrdiff_t method_word{}, bcp_word{}, monitor_word{}, last_sp_word{};
    std::uintptr_t return_begin{}, return_end{};
    bool has_heap{}, legacy{}, small_maps{}, relative_stack_slots{};
};
inline configuration layout{};
inline std::atomic_bool ready{};
inline std::mutex setup_mutex{};
inline std::array<entry_hook, 3> hooks{};

inline auto scan(void* frame, void* closure) noexcept -> void {
    if (!ready.load(std::memory_order_acquire) || !frame || !closure) { return; }
    const auto& c = layout;
    if (c.has_heap && pn::load<bool>(frame, c.heap_offset)) { return; }
    const auto pc = pn::load<std::uintptr_t>(frame, c.pc_offset);
    if (pc < c.return_begin || pc >= c.return_end) { return; }
    auto* const fp = pn::load<std::uintptr_t*>(frame, c.fp_offset);
    if (!fp) { return; }
    void* const method = reinterpret_cast<void*>(fp[c.method_word]);
    bool found{};
    for (auto* node = markers.load(std::memory_order_seq_cst); node; node = node->global_previous) {
        if (node->fp == fp && node->method.load(std::memory_order_seq_cst) == method) { found = true; break; }
    }
    if (!found || !method) { return; }
    const auto* cm = pn::load<std::byte*>(method, c.const_method_offset);
    const auto bcp = fp[c.bcp_word];
    // Java 8's Parallel full-GC prologue temporarily converts physical BCPs
    // to integer BCIs. Encoded zero and code_base both denote this BCI0.
    if (!cm || (bcp != 0 && bcp != reinterpret_cast<std::uintptr_t>(cm + c.const_method_size))) { return; }
    const auto fp_address = reinterpret_cast<std::uintptr_t>(fp);
    const auto monitor = fp[c.monitor_word];
    const auto end = c.relative_stack_slots ? fp_address + monitor * sizeof(void*) : monitor;
    if (!end || end % alignof(void*) || end >= reinterpret_cast<std::uintptr_t>(fp)) { return; }
    const auto slot = end - sizeof(void*);
    const auto last_sp = fp[c.last_sp_word];
    const auto tos = last_sp ? c.relative_stack_slots ? fp_address + last_sp * sizeof(void*) : last_sp
        : pn::load<std::uintptr_t>(frame, c.sp_offset);
    // Match HotSpot's in_stack bound. Paths that throw without preserving TOS
    // leave an empty stack and must not scan an old word below monitor_end.
    if (!tos || tos > slot) { return; }
    auto** vtable = pn::load<void**>(closure, 0);
    reinterpret_cast<void(*)(void*, void**)>(vtable[c.wide_slot])(closure, reinterpret_cast<void**>(slot));
    scanned_slots.fetch_add(1, std::memory_order_relaxed);
}
inline auto legacy_scan(void* frame, void* closure, void* cld, void* map, bool cache) -> void {
    scan(frame, closure);
    // Verified Java bytecode starts with an empty operand stack. An invoke at
    // BCI0 therefore has no arguments/receiver; the ordinary argument walker
    // cannot visit our synthetic TOS a second time.
    reinterpret_cast<void(*)(void*, void*, void*, void*, bool)>(hooks[0].original())(frame, closure, cld, map, cache);
}
template<std::size_t Index>
inline auto modern_scan(void* frame, void* closure, void* map, bool cache) -> void {
    scan(frame, closure);
    reinterpret_cast<void(*)(void*, void*, void*, bool)>(hooks[Index].original())(frame, closure, map, cache);
}
inline auto install_at_safepoint(void* opaque) noexcept -> void {
    auto& okay = *static_cast<bool*>(opaque);
    auto& runtime = pn::rt();
    const std::array<std::string_view, 3> aliases{"frame_oops_interpreted", "frame_oops_interpreted_small0", "frame_oops_interpreted_small1"};
    const std::array<const void*, 3> detours{
        layout.legacy ? reinterpret_cast<const void*>(&legacy_scan) : reinterpret_cast<const void*>(&modern_scan<0>),
        reinterpret_cast<const void*>(&modern_scan<1>), reinterpret_cast<const void*>(&modern_scan<2>)};
    for (std::size_t index{}; index < (layout.small_maps ? 3u : 1u); ++index) {
        if (hooks[index].original()) { if (!hooks[index].matches()) { return; } continue; }
        void* const target = runtime.function(aliases[index]);
        std::array<std::byte, 32> expected{};
        if (!vmhook::os::safe_read(expected.data(), target, expected.size())) { return; }
        const auto length = entry_hook::audited_prefix_length(expected);
        if (!length) { return; }
        // These twenty scanner prologues contain no relative CALL/JMP. Refuse
        // an existing entry redirect rather than chaining a foreign detour.
        for (std::size_t i{}; i < length; ++i) {
            if (expected[i] == std::byte{0xe8} || expected[i] == std::byte{0xe9}) { return; }
        }
        if (!hooks[index].install(target, detours[index], {expected.data(), length})) { return; }
    }
    ready.store(true, std::memory_order_release);
    okay = true;
}
inline auto prepare() noexcept -> bool {
    try {
        if (ready.load(std::memory_order_acquire)) { return true; }
        auto& vm = pn::rt();
        if (!vm.ready || vm.uses_external_symbols()) { return false; }
        std::lock_guard lock{setup_mutex};
        if (ready.load(std::memory_order_acquire)) { return true; }
        configuration c{};
        c.sp_offset = vm.off("frame", "_sp"); c.pc_offset = vm.off("frame", "_pc"); c.fp_offset = vm.off("frame", "_fp");
        c.has_heap = vm.has_field("frame", "_on_heap");
        if (c.has_heap) { c.heap_offset = vm.off("frame", "_on_heap"); }
        c.method_word = vm.enum_value("frame", "interpreter_frame_method_offset");
        c.bcp_word = vm.enum_value("frame", "interpreter_frame_bcp_offset");
        c.monitor_word = vm.enum_value("frame", "interpreter_frame_monitor_block_top_offset");
        c.last_sp_word = vm.enum_value("frame", "interpreter_frame_last_sp_offset");
        c.wide_slot = vm.enum_value("OopClosure", "vtable_do_oop_wide");
        c.legacy = vm.enum_value("ObservationABI", "frame_scan_legacy_cld_arg") != 0;
        c.small_maps = vm.enum_value("ObservationABI", "frame_scan_small_maps") != 0;
        c.relative_stack_slots = vm.enum_value("ObservationABI", "frame_stack_slots_relative") != 0;
        c.const_method_offset = vm.off("Method", "_constMethod"); c.const_method_size = vm.size("ConstMethod");
        if (c.wide_slot != 1 || c.method_word != -3 || c.last_sp_word != -2
            || (c.bcp_word != -7 && c.bcp_word != -8) || c.monitor_word != c.bcp_word - 1
            || c.sp_offset != 0 || c.pc_offset != 8 || (c.fp_offset != 32 && c.fp_offset != 40)) { return false; }
        auto* queue = pn::load<void*>(vm.function("interpreter_code"), 0);
        if (!queue) { return false; }
        auto* buffer = pn::load<std::byte*>(queue, vm.off("StubQueue", "_stub_buffer"));
        const auto limit = pn::load<int>(queue, vm.off("StubQueue", "_buffer_limit"));
        const auto count = pn::load<int>(queue, vm.off("StubQueue", "_number_of_stubs"));
        const auto end = pn::load<int>(queue, vm.off("StubQueue", "_queue_end"));
        auto index = pn::load<int>(queue, vm.off("StubQueue", "_queue_begin"));
        if (!buffer || limit <= 0 || limit > 64 * 1024 * 1024 || count <= 0 || count > 4096) { return false; }
        for (int visited{}; visited < count; ++visited) {
            if (index < 0 || index >= limit) { return false; }
            auto* stub = buffer + index;
            const auto size = pn::load<int>(stub, vm.off("InterpreterCodelet", "_size"));
            if (size < static_cast<int>(vm.size("InterpreterCodelet")) || size > limit - index) { return false; }
            if (pn::load<int>(stub, vm.off("InterpreterCodelet", "_bytecode")) == 176) {
                if (c.return_begin) { return false; }
                c.return_begin = reinterpret_cast<std::uintptr_t>(stub); c.return_end = c.return_begin + size;
            }
            index += size; if (index == limit && index != end) { index = 0; }
        }
        const auto target = reinterpret_cast<std::uintptr_t>(vmhook::detail::jit_backend::config().return_entries[12]);
        if (!c.return_begin || target < c.return_begin || target >= c.return_end) { return false; }
        vmhook::windows::HMODULE resident{};
        if (!vmhook::windows::GetModuleHandleExW(vmhook::windows::module_handle_from_address | vmhook::windows::module_handle_pin,
            reinterpret_cast<const wchar_t*>(&modern_scan<0>), &resident)) { return false; }
        layout = c;
        bool okay{};
        return vmhook::detail::jit_backend::at_safepoint(&install_at_safepoint, &okay) && okay;
    } catch (...) { return false; }
}
inline auto mark(void* fp, void* method) noexcept -> bool {
    if (!fp || !method || !ready.load(std::memory_order_acquire)) { return false; }
    try {
        // Called under the callback's VM-state operation. Allocation and these
        // publications cannot overlap a stop-the-world root scan. Retain one
        // node per observed frame address, preserving nested return markers.
        marker* node = local_markers;
        while (node && node->fp != fp) { node = node->local_previous; }
        if (!node) {
            node = new marker{fp, local_markers};
            auto* head = markers.load(std::memory_order_seq_cst);
            do { node->global_previous = head; }
            while (!markers.compare_exchange_weak(head, node, std::memory_order_seq_cst));
            local_markers = node;
        }
        node->method.store(method, std::memory_order_seq_cst);
        return true;
    } catch (...) { return false; }
}
}
export namespace vmhook::detail {
inline auto prepare_callback_return_roots() noexcept -> bool { return callback_return_roots::prepare(); }
inline auto mark_callback_return_root(void* fp, vmhook::hotspot::method* method) noexcept -> bool { return callback_return_roots::mark(fp, method); }
}

export namespace vmhook::detail::class_events {
using phase=vmhook::class_load_phase;
using event=vmhook::class_load_event;
using class_observer_id=vmhook::class_observer_id;
struct observer_profile {int feature{};bool hidden_helper{};std::size_t hidden_offset{},anonymous_host_offset{};};
class observer {
public:
    struct callback_node {
        std::function<void(const event&)> callback;
        class_observer_id id{};
        callback_node* previous{};
        std::atomic_bool enabled{true};
        std::atomic<std::size_t> active{};
        std::atomic<std::uint64_t> calls{}, failures{};
    };
private:
    inline static std::atomic<callback_node*> callbacks_{};
    inline static std::atomic<std::size_t> active_notifications_{};
    inline static std::atomic<std::uint64_t> next_event_id_{1};
    inline static std::mutex setup_mutex_{};
    inline static std::vector<std::unique_ptr<callback_node>> retained_callbacks_{};
    inline static std::array<native_entry_hook,4> hooks_{};
    inline static bool installed_{};
    inline static class_observer_id next_id_{1};
    inline static observer_profile profile_storage_{};
    inline static const observer_profile* selected_profile_{&profile_storage_};
    struct archived_slot {std::atomic<void*> klass;std::atomic_bool delivered;};
    inline static std::array<archived_slot,65536> archived_{};
    inline static std::atomic_bool archive_table_full_{};
    static auto archive_slot(void* klass,bool create) noexcept -> archived_slot* {
        const auto hash=(reinterpret_cast<std::uintptr_t>(klass)>>3)*0x9e3779b97f4a7c15ull;
        for(std::size_t n{};n<archived_.size();++n) {
            auto& slot=archived_[(hash+n)&(archived_.size()-1)];
            auto* value=slot.klass.load(std::memory_order_acquire);
            if(value==klass)return &slot;
            if(!value) {
                if(!create)return nullptr;
                if(slot.klass.compare_exchange_strong(value,klass,std::memory_order_acq_rel))return &slot;
                if(value==klass)return &slot;
            }
        }
        archive_table_full_.store(true,std::memory_order_release);return nullptr;
    }
    inline static std::size_t name_offset_{},loader_offset_{},cld_loader_offset_{},mirror_offset_{},symbol_body_{},symbol_length_{};
    inline static bool combined_symbol_length_{};
    inline static thread_local unsigned callback_depth_{};
    template<class value_type> static auto read(const void* base,std::size_t offset) noexcept -> value_type {
        value_type result{};std::memcpy(&result,static_cast<const std::byte*>(base)+offset,sizeof result);return result;
    }
    static auto emit(void* klass,phase point) noexcept -> void {
        if(!klass || callback_depth_)return;
        auto* const symbol=read<void*>(klass,name_offset_);
        auto* const cld=read<void*>(klass,loader_offset_);
        if(!symbol || !cld)return;
        const auto length=combined_symbol_length_ ? read<std::uint32_t>(symbol,symbol_length_)>>16
                                                  : read<std::uint16_t>(symbol,symbol_length_);
        if(!length)return;
        void* loader{};
        if(selected_profile_->feature<10)loader=read<void*>(cld,cld_loader_offset_);
        else {auto* const slot=read<void**>(cld,cld_loader_offset_);loader=slot?*slot:nullptr;}
        const event value{static_cast<vmhook::hotspot::klass*>(klass),static_cast<vmhook::hotspot::class_loader_data*>(cld),loader,
                          {static_cast<const char*>(symbol)+symbol_body_,length},point,
                          next_event_id_.fetch_add(1,std::memory_order_relaxed)};
        ++callback_depth_;
        active_notifications_.fetch_add(1,std::memory_order_seq_cst);
        // No registry mutex, shared_ptr lock, allocation, snapshot copy or VM call.
        // Nodes remain resident; stop merely disables one atomic flag.
        for(auto* node=callbacks_.load(std::memory_order_acquire);node;node=node->previous) {
            node->active.fetch_add(1,std::memory_order_seq_cst);
            if(node->enabled.load(std::memory_order_seq_cst)) {
                node->calls.fetch_add(1,std::memory_order_relaxed);
                try{node->callback(value);}catch(...){node->failures.fetch_add(1,std::memory_order_relaxed);}
            }
            node->active.fetch_sub(1,std::memory_order_seq_cst);
        }
        active_notifications_.fetch_sub(1,std::memory_order_seq_cst);
        --callback_depth_;
    }
    static auto instance_define(void* klass,void* loader,void* thread) -> void {
        const vmhook::detail::jit_backend::class_definition_guard defining{};
        if(!vmhook::detail::prepare_class_hooks(static_cast<vmhook::hotspot::klass*>(klass))) {
            vmhook::detail::fail_class_hook_preparation(thread);
            vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),false);return;
        }
        reinterpret_cast<void(*)(void*,void*,void*)>(hooks_[0].original())(klass,loader,thread);
        const bool success=!vmhook::detail::private_native::pending_exception(thread);
        vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),success);
        if(success && !vmhook::detail::private_native::pending_exception(thread))emit(klass,phase::instance_loaded);
    }
    static auto hidden_stream(void* stream,void* name,void* loader,const void* info,void* thread) -> void* {
        const vmhook::detail::jit_backend::class_definition_guard defining{};
        const bool hidden=selected_profile_->hidden_helper || read<bool>(info,selected_profile_->hidden_offset);
        auto* klass=reinterpret_cast<void*(*)(void*,void*,void*,const void*,void*)>(hooks_[1].original())(stream,name,loader,info,thread);
        if(hidden && klass && !vmhook::detail::private_native::pending_exception(thread)) {
            if(!vmhook::detail::prepare_class_hooks(static_cast<vmhook::hotspot::klass*>(klass))) {
                vmhook::detail::fail_class_hook_preparation(thread);
                vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),false);return nullptr;
            }
            vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),true);
            emit(klass,phase::instance_loaded);
        }
        return klass;
    }
    static auto instance_define_legacy(void* klass,void* thread) -> void {
        const vmhook::detail::jit_backend::class_definition_guard defining{};
        if(!vmhook::detail::prepare_class_hooks(static_cast<vmhook::hotspot::klass*>(klass))) {
            vmhook::detail::fail_class_hook_preparation(thread);
            vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),false);return;
        }
        reinterpret_cast<void(*)(void*,void*)>(hooks_[0].original())(klass,thread);
        const bool success=!vmhook::detail::private_native::pending_exception(thread);
        vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),success);
        if(success && !vmhook::detail::private_native::pending_exception(thread))emit(klass,phase::instance_loaded);
    }
    static auto anonymous_parse(void* name,void* loader,void* protection,void* stream,void* host,void* patches,void* thread) -> void* {
        const vmhook::detail::jit_backend::class_definition_guard defining{};
        auto* klass=reinterpret_cast<void*(*)(void*,void*,void*,void*,void*,void*,void*)>(hooks_[1].original())(name,loader,protection,stream,host,patches,thread);
        if(host && klass && !vmhook::detail::private_native::pending_exception(thread)) {
            if(!vmhook::detail::prepare_class_hooks(static_cast<vmhook::hotspot::klass*>(klass))) {
                vmhook::detail::fail_class_hook_preparation(thread);
                vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),false);return nullptr;
            }
            vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),true);
            emit(klass,phase::instance_loaded);
        }
        return klass;
    }
    static auto hidden_parse_info(void* name,void* loader,void* stream,const void* info,void* thread) -> void* {
        const vmhook::detail::jit_backend::class_definition_guard defining{};
        const bool hidden=read<bool>(info,selected_profile_->hidden_offset)
                          || read<void*>(info,selected_profile_->anonymous_host_offset)!=nullptr;
        auto* klass=reinterpret_cast<void*(*)(void*,void*,void*,const void*,void*)>(hooks_[1].original())(name,loader,stream,info,thread);
        if(hidden && klass && !vmhook::detail::private_native::pending_exception(thread)) {
            if(!vmhook::detail::prepare_class_hooks(static_cast<vmhook::hotspot::klass*>(klass))) {
                vmhook::detail::fail_class_hook_preparation(thread);
                vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),false);return nullptr;
            }
            vmhook::detail::finish_class_hooks(static_cast<vmhook::hotspot::klass*>(klass),true);
            emit(klass,phase::instance_loaded);
        }
        return klass;
    }
    static auto array_complete_legacy(void* klass,void* super,void* thread) -> void {
        reinterpret_cast<void(*)(void*,void*,void*)>(hooks_[2].original())(klass,super,thread);
        if(!vmhook::detail::private_native::pending_exception(thread))emit(klass,phase::array_created);
    }
    static auto array_complete(void* klass,void* super,void* module,void* thread) -> void {
        reinterpret_cast<void(*)(void*,void*,void*,void*)>(hooks_[2].original())(klass,super,module,thread);
        if(!vmhook::detail::private_native::pending_exception(thread))emit(klass,phase::array_created);
    }
    static auto array_restore(void* klass,void* cld,void* protection_domain,void* thread) -> void {
        const auto mirror=[&]{
            auto* value=read<void*>(klass,mirror_offset_);
            return selected_profile_->feature<10?value:(value?*static_cast<void**>(value):nullptr);
        };
        const bool had_mirror=mirror()!=nullptr;
        auto* slot=archive_slot(klass,!had_mirror);
        reinterpret_cast<void(*)(void*,void*,void*,void*)>(hooks_[3].original())(klass,cld,protection_domain,thread);
        if(slot && !vmhook::detail::private_native::pending_exception(thread) && mirror()!=nullptr
           && !slot->delivered.exchange(true,std::memory_order_acq_rel))emit(klass,phase::archived_array_restored);
    }
public:
    // Call setup from a native thread, outside any notification. The supplied
    // profile is only accepted with a matching built-in exact DLL identity.
    // A matching external PDB alone is not sufficient observer ABI evidence.
    static auto ensure_installed() -> bool {
        if(callback_depth_)return false;
        auto& runtime=vmhook::detail::private_native::rt();
        if(!runtime.ready || runtime.uses_external_symbols() || !vmhook::vm_capabilities().supported)return false;
        vmhook::windows::HMODULE pinned{};
        if(!vmhook::windows::GetModuleHandleExW(vmhook::windows::module_handle_from_address|vmhook::windows::module_handle_pin,
                              reinterpret_cast<const wchar_t*>(&instance_define),&pinned))return false;
        observer_profile candidate{};candidate.feature=runtime.profile->java_feature;
        candidate.hidden_helper=runtime.has_function("class_resolve_hidden");
        const std::string_view secondary=candidate.feature<=16?"class_parse":
            candidate.hidden_helper?"class_resolve_hidden":"class_resolve_stream";
        const std::array<std::string_view,4> aliases{"class_define",secondary,"array_complete","array_restore"};
        for(const auto name:aliases)if(!runtime.has_function(name))return false;
        if(candidate.feature>=15 && !candidate.hidden_helper) {
            candidate.hidden_offset=runtime.off("ClassLoadInfo","_is_hidden");
            if(candidate.feature<=16)candidate.anonymous_host_offset=runtime.off("ClassLoadInfo","_unsafe_anonymous_host");
        }
        const auto* profile=&candidate;
        std::lock_guard lock{setup_mutex_};
        if(!installed_) {
            profile_storage_=candidate;selected_profile_=&profile_storage_;
            name_offset_=runtime.field_offset("Klass","_name");
            const auto loader_field=runtime.try_field_offset("Klass","_class_loader_data");
            loader_offset_=loader_field.first?loader_field.second:runtime.field_offset("InstanceKlass","_class_loader_data");
            mirror_offset_=runtime.field_offset("Klass","_java_mirror");
            cld_loader_offset_=runtime.field_offset("ClassLoaderData","_class_loader");
            symbol_body_=runtime.off("Symbol","_body");
            combined_symbol_length_=runtime.has_field("Symbol","_length_and_refcount");
            symbol_length_=runtime.off("Symbol",combined_symbol_length_?"_length_and_refcount":"_length");
            const std::array<const void*,4> detours{
                profile->feature<=16?reinterpret_cast<const void*>(&instance_define_legacy):reinterpret_cast<const void*>(&instance_define),
                profile->feature<=14?reinterpret_cast<const void*>(&anonymous_parse):
                    profile->feature<=16?reinterpret_cast<const void*>(&hidden_parse_info):reinterpret_cast<const void*>(&hidden_stream),
                profile->feature==8?reinterpret_cast<const void*>(&array_complete_legacy):reinterpret_cast<const void*>(&array_complete),
                reinterpret_cast<const void*>(&array_restore)};
            for(std::size_t i{};i<4;++i) {
                if(hooks_[i].original())continue;
                auto* target=runtime.function(aliases[i]);
                std::array<std::byte,32> expected{};
                if(!vmhook::os::safe_read(expected.data(),target,expected.size()))return false;
                const auto length=native_entry_hook::audited_prefix_length(expected);
                if(!length)return false;
                // Audited relative CALL/tail-JMP thunks must stay in this JVM.
                // This also refuses a competing foreign entry redirect.
                for(std::size_t offset{};offset<length;) {
                    const auto opcode=std::to_integer<unsigned>(expected[offset]);
                    if(opcode==0xe8 || opcode==0xe9) {
                        std::int32_t displacement{};std::memcpy(&displacement,expected.data()+offset+1,4);
                        const auto destination=reinterpret_cast<std::intptr_t>(target)+static_cast<std::intptr_t>(offset)+5+displacement;
                        if(destination<static_cast<std::intptr_t>(runtime.base)
                           || destination>=static_cast<std::intptr_t>(runtime.base+runtime.image_size))return false;
                        offset+=5;
                    } else if(opcode==0x48 && std::to_integer<unsigned>(expected[offset+1])==0x81)offset+=7;
                    else if(opcode==0x48 && std::to_integer<unsigned>(expected[offset+1])==0x83)offset+=4;
                    else if(opcode==0x48 && std::to_integer<unsigned>(expected[offset+1])==0x8b)offset+=3;
                    else if(opcode==0x4c && std::to_integer<unsigned>(expected[offset+1])==0x8b)offset+=3;
                    else if((opcode==0x48 || opcode==0x4c) && std::to_integer<unsigned>(expected[offset+1])==0x89)
                        offset+=std::to_integer<unsigned>(expected[offset+3])==0x24?5:4;
                    else offset+=opcode==0x40 || opcode==0x41?2:1;
                }
                if(!hooks_[i].install(target,detours[i],{expected.data(),length}))return false;
            }
            installed_=true;
        }
        return true;
    }
    static auto subscribe(std::function<void(const event&)> callback) -> class_observer_id {
        if(!callback || !ensure_installed())return 0;
        std::lock_guard lock{setup_mutex_};
        auto node=std::make_unique<callback_node>();node->callback=std::move(callback);
        node->id=next_id_++;node->previous=callbacks_.load(std::memory_order_relaxed);auto* result=node.get();
        retained_callbacks_.push_back(std::move(node));callbacks_.store(result,std::memory_order_release);
        return result->id;
    }
    static auto remove(class_observer_id id) noexcept -> bool {
        for(auto* node=callbacks_.load(std::memory_order_acquire);node;node=node->previous) {
            if(node->id==id)return node->enabled.exchange(false,std::memory_order_seq_cst);
        }
        return false;
    }
    static auto remove_all() noexcept -> void {
        for(auto* node=callbacks_.load(std::memory_order_acquire);node;node=node->previous)
            node->enabled.store(false,std::memory_order_seq_cst);
    }
    static auto reclaim() noexcept -> bool {
        if(callback_depth_ || vmhook::hotspot::in_java_detour())return false;
        try {
            std::vector<std::function<void(const event&)>> captures;
            std::lock_guard lock{setup_mutex_};
            captures.reserve(retained_callbacks_.size());
            for(auto& node:retained_callbacks_) {
                if(!node->enabled.load(std::memory_order_seq_cst)
                   && node->active.load(std::memory_order_seq_cst)==0 && node->callback)
                    captures.push_back(std::move(node->callback));
            }
            return true;
        } catch(...) {return false;}
    }
    static auto idle() noexcept -> bool {return active_notifications_.load(std::memory_order_seq_cst)==0;}
    static auto archive_capacity_exceeded() noexcept -> bool {return archive_table_full_.load(std::memory_order_acquire);}
    static auto notifying() noexcept -> bool {return callback_depth_!=0;}
};
}

export namespace vmhook::detail {
    inline auto add_class_observer(std::function<void(const vmhook::class_load_event&)> callback)
        -> vmhook::class_observer_id {
        try{return class_events::observer::subscribe(std::move(callback));}catch(...){return 0;}
    }
    inline auto erase_class_observer(vmhook::class_observer_id id) noexcept -> bool {
        return class_events::observer::remove(id);
    }
    inline auto disable_class_observers() noexcept -> void {class_events::observer::remove_all();}
    inline auto class_event_notification_active() noexcept -> bool {return class_events::observer::notifying();}
    inline auto ensure_class_events_installed() noexcept -> bool {
        try{return class_events::observer::ensure_installed();}catch(...){return false;}
    }
    inline auto reclaim_class_observers() noexcept -> bool {return class_events::observer::reclaim();}
    inline auto class_observers_idle() noexcept -> bool {return class_events::observer::idle();}
}

// Synchronous static getstatic/putstatic interception. Code and registry readers
// remain resident while a JVM thread may still be inside a generated stub.
export namespace vmhook::detail
{
    using borrowed_callback = void(*)(void*);
    inline auto borrowed_callback_supported() noexcept -> bool;
    inline auto execute_borrowed_callback(hotspot::java_thread*, hotspot::detour_java_anchor_t,
                                         borrowed_callback, void*) noexcept -> bool;
    inline auto retain_hook_klass(hotspot::klass*) noexcept -> std::shared_ptr<void>;
    inline auto prepare_hook_roots() noexcept -> bool;
}
export namespace vmhook::detail::jit_backend
{
    inline auto at_safepoint(void (*)(void*) noexcept, void*) noexcept -> bool;
    inline auto acquire_field_interpretation() noexcept -> bool;
    inline auto release_field_interpretation() noexcept -> void;
}
export namespace vmhook::detail::field_backend
{
    namespace pn = vmhook::detail::private_native;
    enum class action : std::uint64_t { allow, read_result, skip_write, replace_write, throw_pending };
    struct packet
    {
        bool write{};
        char descriptor{};
        std::uint64_t bits{};
        action result{action::allow};
        void* incoming_slot{};
        hotspot::klass* holder{};
        std::string_view signature{};
    };
    struct scratch_frame
    {
        std::uint64_t result{}, bits{}, width{}, reserved{};
        std::array<std::byte,96> vectors{};
        std::uint64_t rbp{}, r11{}, r10{}, r9{}, r8{}, rdx{}, rcx{}, rax{}, flags{};
    };
    static_assert(sizeof(scratch_frame)==200);
    struct site
    {
        std::uint8_t* patch{};
        std::uint8_t* dispatch{};
        std::uint8_t* generated{};
        bool write{};
        std::array<std::uint8_t,8> original{};
        std::array<std::uint8_t,8> replacement{};
        std::size_t patch_size{};
        std::uint8_t bcp_displacement{}, locals_displacement{};
        bool relative_locals{};
    };
    struct binding
    {
        std::uint64_t id{};
        hotspot::klass* holder{};
        std::uint32_t offset{};
        char descriptor{};
        std::string signature{};
        std::type_index wrapper{typeid(void)};
        std::string name{};
        std::shared_ptr<void> metadata_root{};
        std::function<void(packet&)> invoke{};
    };
    struct snapshot { std::vector<std::shared_ptr<binding>> fields{}; };
    inline std::mutex writer_mutex{};
    inline std::atomic<const snapshot*> published{};
    inline std::atomic<std::size_t> readers{};
    inline std::atomic<bool> retired_possible{};
    inline std::vector<std::unique_ptr<snapshot>> snapshots{};
    inline std::uint64_t next_id{1};
    inline site read_site{}, write_site{};
    inline bool installed{}, interpretation_owned{}, resolved_entries{};
    inline std::size_t cache_size{}, holder_offset{}, offset_offset{}, pending_offset{};
    inline void* throw_entry{};

    struct reader final
    {
        const snapshot* view{};
        bool held{true};
        reader() noexcept
        { readers.fetch_add(1,std::memory_order_seq_cst); this->view=published.load(std::memory_order_seq_cst); }
        auto release() noexcept -> void
        { if(this->held) { this->held=false; readers.fetch_sub(1,std::memory_order_seq_cst); } }
        ~reader() { this->release(); }
        reader(const reader&)=delete;
        auto operator=(const reader&) -> reader& = delete;
    };
    // Retired callbacks/root tokens are destroyed outside the registry mutex.
    inline auto collect_locked(std::vector<std::unique_ptr<snapshot>>& retired) noexcept -> void
    {
        if(readers.load(std::memory_order_seq_cst)!=0) { return; }
        const auto* current=published.load(std::memory_order_seq_cst);
        for(auto& old:snapshots) { if(old.get()!=current) { retired.push_back(std::move(old)); } }
        std::erase_if(snapshots,[](const auto& old){return !old;});
        retired_possible.store(false,std::memory_order_release);
    }
    inline auto publish_locked(std::unique_ptr<snapshot> next) noexcept -> void
    {
        const auto* current=next.get();
        if(next) { snapshots.push_back(std::move(next)); }
        published.store(current,std::memory_order_seq_cst);
        retired_possible.store(true,std::memory_order_release);
    }
    inline auto collect_native() noexcept -> void
    {
        if(!retired_possible.load(std::memory_order_acquire)) { return; }
        try
        {
            std::vector<std::unique_ptr<snapshot>> retired{};
            {
                std::lock_guard lock{writer_mutex};
                retired.reserve(snapshots.size());
                collect_locked(retired);
            }
            retired.clear();
            vmhook::detail::flush_hook_roots();
        }
        catch(...) {}
    }
    struct invocation { const std::shared_ptr<binding>* selected{}; reader* hazard{}; packet event{}; };
    inline auto invoke_user(void* opaque) -> void
    {
        auto& call=*static_cast<invocation*>(opaque);
        // Copy ownership only after entering native state. Registry mutations
        // may now reclaim the snapshot; captured objects retire in native state.
        const auto selected=*call.selected;
        call.hazard->release();
        collect_native();
        selected->invoke(call.event);
    }
    inline auto bridge(void* frame, void* thread, scratch_frame* scratch, site* current) noexcept -> void
    {
        scratch->result=static_cast<std::uint64_t>(action::allow);
        reader selected_view{};
        if(!selected_view.view) { return; }
        const auto* entry=reinterpret_cast<const std::byte*>(scratch->rcx)
            +(resolved_entries?0:cache_size+scratch->rdx*8);
        const auto holder=pn::load<void*>(entry,holder_offset);
        const auto offset=resolved_entries?pn::load<std::uint32_t>(entry,offset_offset)
            :pn::load<std::uint64_t>(entry,offset_offset);
        const std::shared_ptr<binding>* selected{};
        for(const auto& candidate:selected_view.view->fields)
        { if(candidate->holder==holder&&candidate->offset==offset) { selected=&candidate; break; } }
        if(!selected) { return; }
        const auto descriptor=(*selected)->descriptor;
        invocation call{selected,&selected_view,{current->write,descriptor}};
        auto* java_sp=reinterpret_cast<std::byte*>(scratch)+sizeof(*scratch);
        call.event.incoming_slot = current->write ? java_sp : nullptr;
        call.event.holder = (*selected)->holder;
        call.event.signature = (*selected)->signature;
        if(current->write) { std::memcpy(&call.event.bits,java_sp,sizeof(call.event.bits)); }
        const hotspot::detour_java_anchor_t anchor{java_sp,frame,current->patch,true};
        if(vmhook::detail::execute_borrowed_callback(static_cast<hotspot::java_thread*>(thread),
            anchor,&invoke_user,&call))
        {
            scratch->result=static_cast<std::uint64_t>(call.event.result);
            scratch->bits=call.event.bits;
            scratch->width=descriptor=='J'||descriptor=='D'?16:8;
        }
        // VM->Java may itself deliver an asynchronous exception. The original
        // operand stack is still intact; the throw path consumes no field value.
        if(pn::load<void*>(thread,pending_offset))
        { scratch->result=static_cast<std::uint64_t>(action::throw_pending); }
    }
    struct assembler
    {
        std::vector<std::uint8_t> data{};
        auto emit(std::initializer_list<std::uint8_t> bytes) -> void
        { this->data.insert(this->data.end(),bytes); }
        template<class value_type> auto value(const value_type value) -> void
        { const auto* bytes=reinterpret_cast<const std::uint8_t*>(&value); this->data.insert(this->data.end(),bytes,bytes+sizeof value); }
        auto branch(std::initializer_list<std::uint8_t> operation) -> std::size_t
        { this->emit(operation); const auto at=this->data.size(); this->value<std::int32_t>(0); return at; }
        auto label(const std::size_t at) -> void
        { const auto displacement=static_cast<std::int32_t>(this->data.size()-at-4); std::memcpy(this->data.data()+at,&displacement,4); }
        auto jump(const void* target) -> void
        { this->emit({0xff,0x25,0,0,0,0}); this->value(target); }
    };
    inline auto restore(assembler& code,const site& current) -> void
    {
        code.emit({0x48,0x83,0xc4,0x20});
        for(std::uint8_t index{};index<6;++index)
        { code.emit({0xf3,0x0f,0x6f,static_cast<std::uint8_t>(0x44+index*8),0x24,static_cast<std::uint8_t>(index*16)}); }
        code.emit({0x48,0x83,0xc4,0x60,0x5d,0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5a,0x59,0x58,0x9d});
        code.emit({0x4c,0x8b,0x6d,current.bcp_displacement,0x4c,0x8b,0x75,current.locals_displacement});
        if(current.relative_locals) { code.emit({0x4e,0x8d,0x74,0xf5,0}); }
    }
    inline auto prepare_stub(site& current) -> void
    {
        using namespace vmhook::windows;
        assembler code{};
        code.emit({0x4c,0x89,0x6d,current.bcp_displacement});
        code.emit({0x9c,0x50,0x51,0x52,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,0x55,0x48,0x83,0xec,0x60});
        for(std::uint8_t index{};index<6;++index)
        { code.emit({0xf3,0x0f,0x7f,static_cast<std::uint8_t>(0x44+index*8),0x24,static_cast<std::uint8_t>(index*16)}); }
        code.emit({0x48,0x83,0xec,0x20});
        code.emit({0x48,0x89,0xe9,0x4c,0x89,0xfa,0x4c,0x8d,0x04,0x24,0x49,0xb9}); code.value(&current);
        code.emit({0x48,0x89,0xe5,0x48,0x83,0xe4,0xf0,0x48,0x83,0xec,0x20,0x48,0xb8}); code.value(&bridge);
        code.emit({0xff,0xd0,0x48,0x89,0xec});
        code.emit({0x48,0x83,0x3c,0x24,0x04}); const auto pending=code.branch({0x0f,0x84});
        if(current.write)
        {
            code.emit({0x48,0x83,0x3c,0x24,0x03}); const auto unchanged=code.branch({0x0f,0x85});
            // Replacement occupies the existing Java stack slot. The
            // original field template applies truncation and collector barriers.
            code.emit({0x48,0x8b,0x44,0x24,0x08,0x48,0x89,0x84,0x24,0xc8,0,0,0});
            code.emit({0x48,0xc7,0x04,0x24,0,0,0,0}); code.label(unchanged);
        }
        code.emit({0x48,0x83,0x3c,0x24,0}); const auto handled=code.branch({0x0f,0x85});
        restore(code,current);
        code.data.insert(code.data.end(),current.original.begin(),current.original.begin()+current.patch_size);
        code.jump(current.patch+current.patch_size);
        code.label(handled);
        code.emit({0x48,0x83,0x7c,0x24,0x10,0x10}); const auto wide=code.branch({0x0f,0x84});
        if(current.write)
        {
            restore(code,current); code.emit({0x48,0x83,0xc4,0x08});
            code.emit({0xf0,0x83,0x04,0x24,0}); code.jump(current.dispatch);
        }
        else
        {
            code.emit({0x48,0x8b,0x44,0x24,0x08,0x48,0x89,0x84,0x24,0xb8,0,0,0});
            restore(code,current); code.emit({0x50}); code.jump(current.dispatch);
        }
        code.label(wide);
        if(current.write)
        {
            restore(code,current); code.emit({0x48,0x83,0xc4,0x10});
            code.emit({0xf0,0x83,0x04,0x24,0}); code.jump(current.dispatch);
        }
        else
        {
            code.emit({0x48,0x8b,0x44,0x24,0x08,0x48,0x89,0x84,0x24,0xb8,0,0,0});
            restore(code,current); code.emit({0x48,0x83,0xec,0x10,0x48,0x89,0x04,0x24,0x48,0xc7,0x44,0x24,0x08,0,0,0,0});
            code.jump(current.dispatch);
        }
        code.label(pending); restore(code,current);
        code.emit({0x49,0x8b,0x87}); code.value(static_cast<std::uint32_t>(pending_offset));
        code.emit({0x49,0xc7,0x87}); code.value(static_cast<std::uint32_t>(pending_offset)); code.value<std::uint32_t>(0);
        code.jump(throw_entry);
        current.generated=hotspot::allocate_nearby_memory(current.patch,code.data.size());
        if(!current.generated) { throw std::runtime_error("Static field ASM allocation failed"); }
        std::memcpy(current.generated,code.data.data(),code.data.size());
        DWORD protection{};
        if(!VirtualProtect(current.generated,code.data.size(),page_execute_read,&protection)
            ||!FlushInstructionCache(GetCurrentProcess(),current.generated,code.data.size()))
        { throw std::runtime_error("Static field ASM publication failed"); }
        const auto distance=reinterpret_cast<std::intptr_t>(current.generated)-reinterpret_cast<std::intptr_t>(current.patch+5);
        if(distance<std::numeric_limits<std::int32_t>::min()||distance>std::numeric_limits<std::int32_t>::max())
        { throw std::runtime_error("Static field ASM branch out of range"); }
        current.replacement={0xe9,0,0,0,0,0x90,0x90,0x90};
        const auto displacement=static_cast<std::int32_t>(distance);
        std::memcpy(current.replacement.data()+1,&displacement,4);
    }
    struct patch_transaction { bool success{}; };
    inline auto patch_at_safepoint(void* opaque) noexcept -> void
    {
        using namespace vmhook::windows;
        auto& transaction=*static_cast<patch_transaction*>(opaque);
        const std::array<site*,2> targets{&read_site,&write_site};
        std::array<DWORD,2> protections{};
        for(const auto* target:targets)
        { if(std::memcmp(target->patch,target->original.data(),target->patch_size)) { return; } }
        std::size_t writable{};
        for(;writable<targets.size();++writable)
        {
            const auto* target=targets[writable];
            if(!VirtualProtect(target->patch,target->patch_size,page_execute_readwrite,&protections[writable])) { break; }
        }
        if(writable==targets.size())
        {
            for(const auto* target:targets) { std::memcpy(target->patch,target->replacement.data(),target->patch_size); }
            transaction.success=true;
            for(const auto* target:targets)
            { if(!FlushInstructionCache(GetCurrentProcess(),target->patch,target->patch_size)) { transaction.success=false; } }
            if(!transaction.success)
            {
                for(const auto* target:targets)
                {
                    std::memcpy(target->patch,target->original.data(),target->patch_size);
                    FlushInstructionCache(GetCurrentProcess(),target->patch,target->patch_size);
                }
            }
        }
        while(writable)
        {
            const auto index=--writable; const auto* target=targets[index]; DWORD ignored{};
            VirtualProtect(target->patch,target->patch_size,protections[index],&ignored);
        }
    }
    inline auto vm_offset(const char* owner,const char* member) -> std::size_t
    {
        auto& runtime=pn::rt();
        const auto* entry=hotspot::iterate_struct_entries(owner,member);
        if(entry)
        {
            if(runtime.has_field(owner,member)&&runtime.off(owner,member)!=entry->offset)
            { throw std::runtime_error("Static field VMStruct/PDB layout disagreement"); }
            return entry->offset;
        }
        return runtime.off(owner,member);
    }
    inline auto find_site(unsigned opcode,bool write) -> site {
      const auto* code=vmhook::hotspot::iterate_struct_entries("AbstractInterpreter","_code");
      if (!code||!code->address)throw std::runtime_error("Interpreter code queue missing");
      auto* queue=pn::load<void*>(code->address,0);
      auto* buffer=pn::load<std::uint8_t*>(queue,vm_offset("StubQueue","_stub_buffer"));
      const int limit=pn::load<int>(queue,vm_offset("StubQueue","_buffer_limit"));
      const int end=pn::load<int>(queue,vm_offset("StubQueue","_queue_end"));
      int index=pn::load<int>(queue,vm_offset("StubQueue","_queue_begin"));
      const int count=pn::load<int>(queue,vm_offset("StubQueue","_number_of_stubs"));
      if (!buffer||limit<=0||limit>16*1024*1024||count<=0||count>4096)throw std::runtime_error("Interpreter queue bounds invalid");
      for(int visited=0;visited<count;++visited) {
        if(index<0||index>=limit)throw std::runtime_error("Interpreter codelet index invalid");
        auto* stub=buffer+index;
        const int size=pn::load<int>(stub,vm_offset("InterpreterCodelet","_size"));
        if(size<16||size>limit-index)throw std::runtime_error("Interpreter codelet size invalid");
        if(pn::load<int>(stub,vm_offset("InterpreterCodelet","_bytecode"))==static_cast<int>(opcode)) {
          site found;found.write=write;
          std::array<std::uint8_t, 9> signature{};
          std::size_t signature_size{};
          if(!resolved_entries) {
            const auto f2=cache_size+offset_offset;
            const auto flags=cache_size+vm_offset("ConstantPoolCacheEntry","_flags");
            if(f2>127||flags>127)throw std::runtime_error("CP cache displacement unsupported");
            signature={0x48,0x8b,0x5c,0xd1,static_cast<std::uint8_t>(f2),0x8b,0x44,0xd1,static_cast<std::uint8_t>(flags)};
            signature_size=9;
            found.patch_size=5;
          } else {
            const auto flags=vm_offset("ResolvedFieldEntry","_flags");
            if(offset_offset>127||flags>127)throw std::runtime_error("Resolved field displacement unsupported");
            signature={0x8b,0x59,static_cast<std::uint8_t>(offset_offset),0x0f,0xb6,static_cast<std::uint8_t>(write?0x41:0x51),static_cast<std::uint8_t>(flags)};
            signature_size=7;
            found.patch_size=7;
          }
          for(int at=static_cast<int>(pn::rt().size("InterpreterCodelet"));at+static_cast<int>(signature_size)<=size;++at) {
            if(!std::memcmp(stub+at,signature.data(),signature_size)) {
              if(found.patch)throw std::runtime_error("Ambiguous static-field metadata injection");
              found.patch=stub+at;
              std::memcpy(found.original.data(),found.patch,found.patch_size);
            }
          }
          if(!found.patch&&resolved_entries) {
            const auto flags=vm_offset("ResolvedFieldEntry","_flags");
            signature={0x48,0x63,0x59,static_cast<std::uint8_t>(offset_offset),0x0f,0xb6,static_cast<std::uint8_t>(write?0x41:0x51),static_cast<std::uint8_t>(flags)};
            signature_size=8;
            found.patch_size=8;
            for(int at=static_cast<int>(pn::rt().size("InterpreterCodelet"));at+static_cast<int>(signature_size)<=size;++at) {
              if(!std::memcmp(stub+at,signature.data(),signature_size)) {
                if(found.patch)throw std::runtime_error("Ambiguous static-field metadata injection");
                found.patch=stub+at;std::memcpy(found.original.data(),found.patch,found.patch_size);
              }
            }
