    inline auto prepare_sites() -> void
    {
        auto& runtime=pn::rt();
        if(!runtime.ready||!vmhook::detail::borrowed_callback_supported())
        { throw std::runtime_error("Static field callback lifecycle unavailable"); }
        resolved_entries=runtime.profile->java_feature>=22;
        if(resolved_entries)
        {
            holder_offset=vm_offset("ResolvedFieldEntry","_field_holder");
            offset_offset=vm_offset("ResolvedFieldEntry","_field_offset");
        }
        else
        {
            cache_size=runtime.type_size("ConstantPoolCache");
            if(runtime.has_type("ConstantPoolCache")&&runtime.size("ConstantPoolCache")!=cache_size)
            { throw std::runtime_error("Constant pool cache size disagreement"); }
            holder_offset=vm_offset("ConstantPoolCacheEntry","_f1");
            offset_offset=vm_offset("ConstantPoolCacheEntry","_f2");
        }
        if(runtime.size("InterpreterCodelet")<16||runtime.size("InterpreterCodelet")>256)
        { throw std::runtime_error("Unsupported interpreter codelet header"); }
        pending_offset=runtime.off("JavaThread","_pending_exception");
        if(pending_offset>std::numeric_limits<std::int32_t>::max())
        { throw std::runtime_error("Unsupported pending exception displacement"); }
        throw_entry=pn::load<void*>(runtime.function("field_throw_exception_entry"),0);
        const auto* code=hotspot::iterate_struct_entries("AbstractInterpreter","_code");
        if(!code||!code->address) { throw std::runtime_error("Interpreter code queue missing"); }
        auto* queue=pn::load<void*>(code->address,0);
        const auto begin=pn::load<std::uintptr_t>(queue,vm_offset("StubQueue","_stub_buffer"));
        const auto limit=pn::load<int>(queue,vm_offset("StubQueue","_buffer_limit"));
        const auto target=reinterpret_cast<std::uintptr_t>(throw_entry);
        if(limit<=0||limit>16*1024*1024||target<begin||target-begin>=static_cast<std::size_t>(limit))
        { throw std::runtime_error("Interpreter throw continuation outside verified code queue"); }
        read_site=find_site(178,false); write_site=find_site(179,true);
        prepare_stub(read_site); prepare_stub(write_site);
    }
    inline auto add(std::shared_ptr<binding> added) -> std::uint64_t
    {
        auto* caller=pn::rt().current_thread();
        if(caller&&pn::thread_state(caller)!=4)
        { throw std::runtime_error("Static field hook administration requires native thread state"); }
        std::vector<std::unique_ptr<snapshot>> retired{};
        std::lock_guard lock{writer_mutex};
        if(hotspot::g_shutdown_requested.load(std::memory_order_acquire)) { return 0; }
        const auto* current=published.load(std::memory_order_seq_cst);
        if(current)
        {
            for(const auto& previous:current->fields)
            { if(previous->holder==added->holder&&previous->offset==added->offset) { return 0; } }
        }
        auto next=std::make_unique<snapshot>();
        if(current) { next->fields=current->fields; }
        added->id=next_id++;
        next->fields.push_back(added);
        snapshots.reserve(snapshots.size()+1);
        retired.reserve(snapshots.size()+1);
        const bool first=!current||current->fields.empty();
        if(installed&&(std::memcmp(read_site.patch,read_site.replacement.data(),read_site.patch_size)
            ||std::memcmp(write_site.patch,write_site.replacement.data(),write_site.patch_size)))
        { throw std::runtime_error("Installed static field ASM was changed by another writer"); }
        if(!installed) { prepare_sites(); }
        if(first)
        {
            if(!jit_backend::acquire_field_interpretation()) { return 0; }
            interpretation_owned=true;
        }
        if(!installed)
        {
            patch_transaction transaction{};
            if(!jit_backend::at_safepoint(&patch_at_safepoint,&transaction)||!transaction.success)
            {
                if(first) { jit_backend::release_field_interpretation(); interpretation_owned=false; }
                return 0;
            }
            installed=true;
        }
        publish_locked(std::move(next));
        collect_locked(retired);
        return added->id;
    }
    template<typename predicate_type>
    inline auto remove(predicate_type predicate) noexcept -> bool
    {
        try
        {
            if(!published.load(std::memory_order_seq_cst)) { return false; }
            auto* caller=pn::rt().current_thread();
            if(caller&&pn::thread_state(caller)!=4) { return false; }
            std::vector<std::unique_ptr<snapshot>> retired{};
            bool removed{};
            {
                std::lock_guard lock{writer_mutex};
                const auto* current=published.load(std::memory_order_seq_cst);
                if(!current) { return false; }
                auto next=std::make_unique<snapshot>();
                next->fields.reserve(current->fields.size());
                for(const auto& existing:current->fields)
                {
                    if(predicate(*existing)) { removed=true; }
                    else { next->fields.push_back(existing); }
                }
                if(!removed) { return false; }
                snapshots.reserve(snapshots.size()+1);
                retired.reserve(snapshots.size()+1);
                const bool last=next->fields.empty();
                publish_locked(last?nullptr:std::move(next));
                collect_locked(retired);
                if(last&&interpretation_owned)
                { jit_backend::release_field_interpretation(); interpretation_owned=false; }
            }
            retired.clear();
            vmhook::detail::flush_hook_roots();
            return removed;
        }
        catch(const std::exception& error)
        { vmhook::detail::log_line("{} static field hook removal: {}",vmhook::error_tag,error.what()); return false; }
        catch(...) { return false; }
    }
}
export namespace vmhook::detail
{
    struct field_event_transport
    {
        template<typename value_type,typename callback_type>
        static auto deliver(callback_type& callback,field_backend::packet& packet) -> void
        {
            if constexpr(vmhook::detail::is_java_object_pointer_v<value_type>)
            {
                using wrapper_type = typename vmhook::detail::is_unique_ptr<value_type>::value_type_t;
                value_type incoming{};
                {
                    native_backend::operation access{};
                    if (!access) { throw vmhook::exception{"Reference field event requires a rooted VM operation"}; }
                    void* object{};
                    if (packet.write)
                    {
                        if (!packet.incoming_slot) { throw vmhook::exception{"Reference field write has no Java operand slot"}; }
                        std::memcpy(&object, packet.incoming_slot, sizeof object);
                    }
                    auto root{object ? native_backend::retain_oop(object) : native_backend::root{}};
                    if (object && !root) { throw vmhook::exception{"Reference field input could not be retained"}; }
                    incoming = materialize_object<wrapper_type>(0, root);
                }
                field_access<value_type> event{packet.write,std::move(incoming)};
                callback(event);
                packet.result = packet.write
                    ? event.prevented_ ? field_backend::action::skip_write
                        : event.replaced_ ? field_backend::action::replace_write : field_backend::action::allow
                    : event.prevented_ || event.replaced_ ? field_backend::action::read_result : field_backend::action::allow;
                if (packet.result == field_backend::action::read_result || packet.result == field_backend::action::replace_write)
                {
                    native_backend::operation access{};
                    if (!access) { throw vmhook::exception{"Reference field output requires a rooted VM operation"}; }
                    auto root{event.replaced_ ? event.value_->get_native_root() : native_backend::root{}};
                    void* const value{root ? root->resolve_under_vm() : nullptr};
                    require_reference_argument(value, packet.signature, packet.holder);
                    auto* const context{callback_backend::current};
                    if (!context || !context->reference_transport(std::move(root), &packet.bits))
                    { throw vmhook::exception{"Reference field output transport is unavailable"}; }
                }
            }
            else
            {
            value_type incoming{};
            if(packet.write)
            {
                if constexpr(std::is_same_v<value_type,bool>) { incoming=(packet.bits&1)!=0; }
                else { std::memcpy(&incoming,&packet.bits,sizeof incoming); }
            }
            field_access<value_type> event{packet.write,incoming};
            callback(event);
            if(packet.write)
            {
                packet.result=event.prevented_?field_backend::action::skip_write
                    :event.replaced_?field_backend::action::replace_write:field_backend::action::allow;
            }
            else
            { packet.result=event.prevented_||event.replaced_?field_backend::action::read_result:field_backend::action::allow; }
            if(packet.result==field_backend::action::read_result||packet.result==field_backend::action::replace_write)
            {
                const auto result=event.replaced_?event.value_:value_type{};
                packet.bits=0;
                if constexpr(std::is_integral_v<value_type>&&sizeof(value_type)<4)
                {
                    if(packet.descriptor=='B') { packet.bits=static_cast<std::uint64_t>(static_cast<std::int8_t>(result)); }
                    else if(packet.descriptor=='S') { packet.bits=static_cast<std::uint64_t>(static_cast<std::int16_t>(result)); }
                    else { packet.bits=static_cast<std::uint64_t>(result); }
                }
                else { std::memcpy(&packet.bits,&result,sizeof result); }
            }
            }
        }
    };
    template<class wrapper_type,typename field_type,typename callback_type>
    inline auto install_field_hook(std::string_view name,callback_type callback) -> std::uint64_t
    {
        if constexpr((!vmhook::detail::is_java_object_pointer_v<field_type>
            && (!std::is_arithmetic_v<field_type>
                ||(sizeof(field_type)!=1&&sizeof(field_type)!=2&&sizeof(field_type)!=4&&sizeof(field_type)!=8)))
            ||!std::is_same_v<field_type,std::remove_cvref_t<field_type>>)
        { return 0; }
        else
        {
            static_assert(std::is_invocable_v<callback_type&,field_access<field_type>&>,
                "hook_field callback must accept field_access<FieldType>&.");
            try
            {
                std::unique_ptr<native_thread_context> installer{};
                if(!native_backend::active())
                {
                    installer=std::make_unique<native_thread_context>("VMHook-field-install");
                    if(!installer->valid()) { return 0; }
                }
                auto* caller=private_native::rt().current_thread();
                if(!caller||private_native::thread_state(caller)!=4) { return 0; }
                if(!prepare_hook_roots()) { return 0; }
                auto added=std::make_shared<field_backend::binding>();
                added->wrapper=std::type_index{typeid(wrapper_type)};
                added->name=name;
                added->invoke=[callback=std::make_shared<callback_type>(std::move(callback))]
                    (field_backend::packet& event) mutable
                { field_event_transport::deliver<field_type>(*callback,event); };
                {
                    native_backend::operation access{};
                    if(!access) { return 0; }
                    auto* klass=registered_class_klass<wrapper_type>();
                    if(!klass) { return 0; }
                    const auto field=vmhook::find_field(klass,name);
                    if(!field||!field->is_static||field->signature!=jvm_descriptor_for_arg<field_type>()) { return 0; }
                    added->holder=field->declaring_klass?field->declaring_klass:klass;
                    added->offset=field->offset;
                    added->descriptor=field->signature.front();
                    added->signature=field->signature;
                    added->metadata_root=retain_hook_klass(added->holder);
                    if(!added->metadata_root) { return 0; }
                }
                const auto id=field_backend::add(std::move(added));
                flush_hook_roots();
                return id;
            }
            catch(const std::exception& error)
            { vmhook::detail::log_line("{} hook_field('{}'): {}",vmhook::error_tag,name,error.what()); return 0; }
            catch(...) { return 0; }
        }
    }
    inline auto remove_field_hook_id(const std::uint64_t id) noexcept -> bool
    { return field_backend::remove([id](const auto& candidate){return candidate.id==id;}); }
    inline auto shutdown_field_hooks() noexcept -> void
    {
        std::vector<std::unique_ptr<field_backend::snapshot>> retired{};
        try
        {
            auto* caller=private_native::rt().current_thread();
            if(caller&&private_native::thread_state(caller)!=4) { return; }
            std::lock_guard lock{field_backend::writer_mutex};
            field_backend::published.store(nullptr,std::memory_order_seq_cst);
            field_backend::retired_possible.store(true,std::memory_order_release);
            if(field_backend::readers.load(std::memory_order_seq_cst)==0)
            { retired.swap(field_backend::snapshots); field_backend::retired_possible.store(false,std::memory_order_release); }
            if(field_backend::interpretation_owned)
            { jit_backend::release_field_interpretation(); field_backend::interpretation_owned=false; }
        }
        catch(...) {}
        retired.clear();
        flush_hook_roots();
    }
}
export namespace vmhook
{
    // Covers Java getstatic/putstatic bytecodes, including previously compiled
    // and inlined accessors after the JIT installation transaction. Compile-time
    // constants, reflection, Unsafe and VM-native accesses have no such bytecode.
    // Callback runs synchronously on the executing JavaThread, in native state;
    // Java wrappers may reenter with a temporary rooted context. Reference
    // events use unique_ptr wrappers and transfer replacements through the
    // VM-scanned thread result across the callback's return transition.
    template<class wrapper_type,typename field_type,typename callback_type>
    inline auto hook_field(std::string_view name,callback_type callback) -> bool
    { return detail::install_field_hook<wrapper_type,field_type>(name,std::move(callback))!=0; }
    template<class wrapper_type>
    inline auto unhook_field(std::string_view name) noexcept -> bool
    {
        const auto wrapper=std::type_index{typeid(wrapper_type)};
        return detail::field_backend::remove([&](const auto& candidate)
            {return candidate.wrapper==wrapper&&candidate.name==name;});
    }
}


// VMHOOK_PERSISTENT_ROOTS_BEGIN
export namespace vmhook::detail::persistent_hook_roots {
namespace pn = vmhook::detail::private_native;
inline bool is_java_thread(void* current) noexcept {
    if (!current) { return false; }
    try {
        const auto& runtime = pn::rt();
        if (!runtime.ready || runtime.uses_external_symbols()) { return false; }
        const auto slot = runtime.enum_value("ObservationABI", "thread_is_java_slot");
        if (slot < 0 || slot > 128) { return false; }
        const auto table = reinterpret_cast<std::uintptr_t>(pn::load<void*>(current, 0));
        const auto displacement = static_cast<std::size_t>(slot) * sizeof(void*);
        if (table < runtime.base || table - runtime.base > runtime.image_size
            || displacement + sizeof(void*) > runtime.image_size - (table - runtime.base)) { return false; }
        const auto entry = pn::load<std::uintptr_t>(reinterpret_cast<void*>(table), displacement);
        if (entry < runtime.base || entry - runtime.base >= runtime.image_size) { return false; }
        // This exact virtual predicate is audited as a non-safepoint getter.
        return reinterpret_cast<bool(*)(void*)>(entry)(current);
    } catch (...) { return false; }
}
class keeper;
inline std::atomic<keeper*> prepared_keeper{};
struct keeper_resources final {
    std::size_t allocated_slots{}, leases{}, occupied_slots{}, reusable_slots{}, pending_releases{};
    bool ready{};
};
struct ticket {
    keeper* owner{};
    void** slot{};
    ~ticket();
};

// The parked daemon owns a permanent, scanned HandleArea. Other mutators may
// change that area only while in VM state and within a non-safepoint critical
// section. A stop-the-world root scan therefore cannot overlap these writes.
class keeper final {
    std::mutex initialization_mutex_;
    std::condition_variable initialized_;
    std::atomic<unsigned> status_{};
    void* thread_{};
    void** failure_exception_root_{};
    std::mutex slots_mutex_;
    std::vector<void**> released_;
    std::vector<void**> free_;
    std::size_t allocated_slots_{}, leased_slots_{}, occupied_slots_{};

    void run() noexcept {
        try {
            pn::scoped_attachment attachment{"VMHook-persistent-roots"};
            if (!attachment.valid()) { throw std::runtime_error("Root keeper attachment failed"); }
            pn::java_session permanent_roots{attachment.get()};
            {
                pn::vm_state_guard access{attachment.get()};
                auto* const klass = vmhook::find_class("java/lang/OutOfMemoryError");
                vmhook::hotspot::method** methods{};
                std::int32_t count{};
                vmhook::hotspot::method* constructor{};
                if (klass && vmhook::hotspot::safe_klass_methods(klass, methods, count)) {
                    for (std::int32_t index{}; index < count; ++index) {
                        auto* const candidate = methods[index];
                        if (candidate && candidate->get_name() == "<init>"
                            && candidate->get_signature() == "()V") { constructor = candidate; break; }
                    }
                }
                failure_exception_root_ = permanent_roots.construct(klass, constructor);
                if (!failure_exception_root_ || pn::pending_exception(attachment.get())) {
                    throw std::runtime_error("Cannot prepare the rooted class-policy failure exception");
                }
            }
            {
                std::lock_guard lock{initialization_mutex_};
                thread_ = attachment.get();
                status_.store(1, std::memory_order_release);
            }
            initialized_.notify_all();
            // After preparing its failure exception, this daemon stays parked.
            // It never services Java-call requests.
            // Both its attachment and permanent HandleMark live until process exit.
            std::unique_lock lock{initialization_mutex_};
            initialized_.wait(lock, [] { return false; });
        } catch (...) {
            { std::lock_guard lock{initialization_mutex_}; status_.store(2, std::memory_order_release); }
            initialized_.notify_all();
        }
    }
    bool writer_in_vm() const noexcept {
        try {
            auto* current = pn::rt().current_thread();
            return status_.load(std::memory_order_acquire) == 1 && is_java_thread(current)
                && pn::thread_state(current) == 6;
        } catch (...) { return false; }
    }
    void drain_locked() {
        while (!released_.empty()) {
            auto** slot = released_.back();
            free_.push_back(slot);
            pn::store<void*>(slot, 0, nullptr);
            --occupied_slots_;
            released_.pop_back();
        }
    }
public:
    keeper() {
        vmhook::windows::HMODULE resident{};
        if (!vmhook::windows::GetModuleHandleExW(
                vmhook::windows::module_handle_from_address | vmhook::windows::module_handle_pin,
                reinterpret_cast<const wchar_t*>(&instance), &resident)) {
            status_.store(2, std::memory_order_release);
            return;
        }
        std::thread([this] { run(); }).detach();
    }
    static keeper& instance() {
        // The parked thread and the injecting DLL intentionally remain resident.
        static keeper* value = new keeper;
        return *value;
    }
    bool ready() const noexcept { return status_.load(std::memory_order_acquire) == 1; }
    auto statistics() -> keeper_resources {
        std::lock_guard lock{slots_mutex_};
        return {allocated_slots_, leased_slots_, occupied_slots_, free_.size(), released_.size(), ready()};
    }
    void fail_class_preparation(void* thread) const noexcept {
        try {
            if (!ready() || !thread || thread != pn::rt().current_thread()
                || !is_java_thread(thread) || pn::thread_state(thread) != 6
                || pn::pending_exception(thread)) { return; }
            // Both threads' HandleAreas are GC-scanned. The current VM-state
            // mutator cannot cross a safepoint between resolving and publishing
            // this oop. This failure path allocates nothing and calls no Java.
            auto* const exception = pn::load<void*>(failure_exception_root_, 0);
            pn::store(thread, pn::rt().off("JavaThread", "_pending_exception"), exception);
            const auto origin = std::source_location::current();
            pn::store(thread, pn::rt().off("ThreadShadow", "_exception_file"), origin.file_name());
            pn::store(thread, pn::rt().off("ThreadShadow", "_exception_line"),
                static_cast<std::int32_t>(origin.line()));
        } catch (...) {}
    }
    bool await_ready() {
        std::unique_lock lock{initialization_mutex_};
        initialized_.wait(lock, [this] { return status_.load(std::memory_order_acquire) != 0; });
        return ready();
    }
    std::shared_ptr<void> retain(void* oop) {
        if (!oop || !writer_in_vm()) { return {}; }
        try {
            auto result = std::make_shared<ticket>();
            // Arena::grow is OS allocation, not Java allocation; the whole
            // mutation must stay in VM state without a safepoint or Java call.
            std::lock_guard lock{slots_mutex_};
            drain_locked();
            void** slot{};
            if (!free_.empty()) { slot = free_.back(); free_.pop_back(); pn::store(slot, 0, oop); }
            else { slot = pn::detail::root_oop(thread_, oop); if (slot) { ++allocated_slots_; } }
            if (!slot) { return {}; }
            result->owner = this;
            result->slot = slot;
            ++leased_slots_;
            ++occupied_slots_;
            return result;
        } catch (const std::bad_alloc&) { throw; }
        catch (...) { return {}; }
    }
    void* resolve(const std::shared_ptr<void>& root) const noexcept {
        if (!root || !writer_in_vm()) { return nullptr; }
        try {
            auto& runtime = pn::rt();
            if (runtime.has_function("vm_exited") && pn::load<bool>(runtime.function("vm_exited"), 0)) { return nullptr; }
            const auto* value = static_cast<const ticket*>(root.get());
            return value->owner == this && value->slot ? pn::detail::resolve_root(value->slot) : nullptr;
        } catch (...) { return nullptr; }
    }
    void release(void** slot) noexcept {
        if (!slot) { return; }
        try {
            std::lock_guard lock{slots_mutex_};
            --leased_slots_;
            if (writer_in_vm()) {
                pn::store<void*>(slot, 0, nullptr);
                --occupied_slots_;
                free_.push_back(slot);
            }
            else { released_.push_back(slot); }
        } catch (...) { /* Retain the root if C++ bookkeeping cannot grow. */ }
    }
    void drain() noexcept {
        if (!writer_in_vm()) { return; }
        try { std::lock_guard lock{slots_mutex_}; drain_locked(); } catch (...) {}
    }
};
inline ticket::~ticket() { if (owner) { owner->release(slot); } }

inline bool prepare_checked() {
    try {
        auto& runtime = pn::rt();
        if (!runtime.ready || runtime.uses_external_symbols() || !vmhook::vm_capabilities().supported) { return false; }
        const auto flags = vmhook::detail::read_gc_flags();
        if (!flags.resolved || flags.use_z || flags.use_shenandoah || flags.use_epsilon
            || flags.use_serial || (runtime.profile->java_feature == 8 ? !flags.use_parallel : !flags.use_g1)) { return false; }
        if (auto* current = runtime.current_thread(); current && (!is_java_thread(current) || pn::thread_state(current) != 4)) { return false; }
        auto& pool = keeper::instance();
        if (!pool.await_ready()) { return false; }
        prepared_keeper.store(&pool, std::memory_order_release);
        return true;
    } catch (const std::bad_alloc&) { throw; }
    catch (...) { return false; }
}
inline bool prepare() noexcept {
    try { return prepare_checked(); } catch (...) { return false; }
}
inline std::shared_ptr<void> retain_klass(vmhook::hotspot::klass* klass) noexcept {
    if (!klass) { return {}; }
    try {
        auto* current = pn::rt().current_thread();
        auto* pool = prepared_keeper.load(std::memory_order_acquire);
        if (!pool || !is_java_thread(current) || pn::thread_state(current) != 6) { return {}; }
        return pool->retain(klass->get_java_mirror());
    } catch (...) { return {}; }
}
inline void drain() noexcept {
    if (auto* pool = prepared_keeper.load(std::memory_order_acquire)) { pool->drain(); }
}
}

export namespace vmhook::detail {
    inline auto fail_class_hook_preparation(void* thread) noexcept -> void {
        if (auto* pool = persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)) {
            pool->fail_class_preparation(thread);
        }
    }
    inline auto prepare_hook_roots() noexcept -> bool {
        return persistent_hook_roots::prepare();
    }
    inline auto retain_hook_klass(vmhook::hotspot::klass* klass) noexcept -> std::shared_ptr<void> {
        return persistent_hook_roots::retain_klass(klass);
    }
    inline auto flush_hook_roots() noexcept -> void {
        if (!persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)) { return; }
        try {
            auto& runtime = private_native::rt();
            if (runtime.has_function("vm_exited") && private_native::load<bool>(runtime.function("vm_exited"),0)) { return; }
            std::unique_ptr<private_native::scoped_attachment> attachment;
            auto* thread = runtime.current_thread();
            if (!thread) {
                attachment = std::make_unique<private_native::scoped_attachment>("VMHook-root-release");
                if (!attachment->valid()) { return; }
                thread = attachment->get();
            }
            if (!persistent_hook_roots::is_java_thread(thread)) { return; }
            const auto state = private_native::thread_state(thread);
            if (state != 4 && state != 6) { return; }
            private_native::vm_state_guard access{thread};
            persistent_hook_roots::drain();
        } catch (...) {}
    }
}
export namespace vmhook::detail
{
    inline auto prepare_durable_roots() -> bool
    {
        if (auto* pool{persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)})
        { return pool->ready(); }
        return persistent_hook_roots::prepare_checked();
    }
    inline auto retain_durable_oop(void* oop) -> std::shared_ptr<void>
    {
        auto* const pool{persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)};
        return pool ? pool->retain(oop) : std::shared_ptr<void>{};
    }
    inline auto resolve_durable_oop(const std::shared_ptr<void>& root) noexcept -> void*
    {
        auto* const pool{persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)};
        return pool ? pool->resolve(root) : nullptr;
    }
    inline auto make_class_binding(std::string_view name, void* anchor) -> std::shared_ptr<class_binding>
    {
        if (name.empty()) { return {}; }
        const bool durable{prepare_durable_roots()};
        std::unique_ptr<vmhook::native_thread_context> temporary{};
        if (!native_backend::active_context_lifetime())
        {
            temporary = std::make_unique<vmhook::native_thread_context>("VMHook-class-binding");
            if (!temporary->valid()) { return {}; }
        }
        native_backend::operation access{};
        if (!access) { return {}; }
        auto* const identity{anchor ? vmhook::find_class_via_oop(anchor, name) : vmhook::find_class(name)};
        if (!identity) { return {}; }
        auto result{std::make_shared<class_binding>()};
        result->name = name;
        if (durable)
        {
            result->mirror = retain_durable_oop(identity->get_java_mirror());
            if (!result->mirror) { return {}; }
            result->identity = identity;
        }
        // Unsupported keeper collectors still permit unambiguous name bindings.
        // They are resolved afresh inside each local VM context; no raw metadata
        // is cached as a class-lifetime guarantee.
        return result;
    }
    inline auto registered_class_klass(std::type_index type,
        const std::shared_ptr<class_binding>& binding) -> vmhook::hotspot::klass*
    {
        if (binding && binding->mirror)
        {
            native_backend::operation access{};
            auto& runtime{private_native::rt()};
            if (runtime.has_function("vm_exited") && private_native::load<bool>(runtime.function("vm_exited"), 0))
            { return nullptr; }
            if (access && !resolve_durable_oop(binding->mirror)) { return nullptr; }
            // Preserve the mirror in this context even if another thread rebinds
            // or unregisters the wrapper immediately after this snapshot.
            if (access && !native_backend::retain_class(binding->identity)) { return nullptr; }
            return binding->identity;
        }
        const auto name{registered_class_name(type)};
        return name.empty() ? nullptr : vmhook::find_class(name);
    }
    inline auto registered_class_klass(std::type_index type) -> vmhook::hotspot::klass*
    { return registered_class_klass(type, registered_class_binding(type)); }
}
// VMHOOK_PERSISTENT_ROOTS_END

// VMHOOK_RUNTIME_DIAGNOSTICS_BEGIN
export namespace vmhook::detail
{
    inline auto verified_heap_iteration_available() noexcept -> bool;
    inline auto verified_monitor_locks_available() noexcept -> bool;
}
export namespace vmhook
{
    enum class feature_state : std::uint8_t { unavailable, conditional, supported };

    enum class runtime_feature : std::uint8_t
    {
        native_calls, object_construction, rooted_object_access, reference_field_writes,
        persistent_references, method_entry_hooks, static_primitive_field_hooks,
        class_definition_events, original_method_exit_events, exact_heap_iteration,
        mixed_stack_sampling, virtual_thread_hooks, java_monitors,
        static_reference_field_hooks, count
    };

    struct feature_support final
    {
        runtime_feature feature{};
        feature_state state{ feature_state::unavailable };
        std::string_view reason{};
    };

    struct runtime_capability_report final
    {
        bool jvm_found{};
        bool private_abi_verified{};
        bool external_symbols{};
        int java_feature{};
        std::array<unsigned char, 16> codeview_guid{};
        std::uint32_t codeview_age{}, pe_timestamp{};
        std::size_t image_size{};
        gc_collector collector{ gc_collector::unknown };
        bool gc_flags_resolved{}, compressed_oops{}, compact_object_headers{};
        std::string_view reason{ "JVM not found" };
        std::array<feature_support, static_cast<std::size_t>(runtime_feature::count)> features{};

        [[nodiscard]] auto support(const runtime_feature feature) const noexcept -> feature_support
        {
            const auto index{ static_cast<std::size_t>(feature) };
            if (index >= features.size())
            { return { feature, feature_state::unavailable, "Unknown feature" }; }
            return features[index];
        }
    };

    // Passive preflight. This resolves metadata and private ABI coordinates; it
    // never attaches a thread, starts the root keeper, or installs a hook.
    // A conditional feature still needs the stated target-specific validation.
    [[nodiscard]] inline auto runtime_capabilities() -> runtime_capability_report
    {
        runtime_capability_report report{};
        auto& runtime{ detail::private_native::rt() };
        report.jvm_found = runtime.base != 0;
        report.private_abi_verified = runtime.ready;
        report.external_symbols = runtime.uses_external_symbols();
        report.image_size = runtime.image_size;
        report.reason = runtime.reason;
        if (runtime.profile)
        {
            report.java_feature = runtime.profile->java_feature;
            report.codeview_guid = runtime.profile->guid;
            report.codeview_age = runtime.profile->age;
            report.pe_timestamp = runtime.profile->pe_timestamp;
        }
        for (std::size_t index{}; index < report.features.size(); ++index)
        { report.features[index] = { static_cast<runtime_feature>(index), feature_state::unavailable,
                                    runtime.ready ? "Backend unavailable" : runtime.reason }; }
        if (!runtime.ready) { return report; }
        const auto& gc{ vm_capabilities() };
        report.collector = gc.collector;
        report.gc_flags_resolved = gc.flags_resolved;
        report.compressed_oops = gc.compressed_oops;
        report.compact_object_headers = gc.compact_object_headers;
        const auto set = [&](runtime_feature feature, feature_state state, std::string_view reason)
        { report.features[static_cast<std::size_t>(feature)] = { feature, state, reason }; };
        if (!gc.flags_resolved || !gc.supported)
        {
            report.reason = "Collector layout or relocation backend is not verified";
            for (auto& feature : report.features) { feature.reason = report.reason; }
            return report;
        }
        set(runtime_feature::native_calls, feature_state::supported,
            "Requires a live native_thread_context on the calling OS thread");
        set(runtime_feature::object_construction, feature_state::supported,
            "Private JavaCalls and rooted HotSpot instance allocation");
        set(runtime_feature::rooted_object_access, feature_state::supported,
            "Live context-owned roots; foreign and expired roots are refused");
        set(runtime_feature::reference_field_writes,
            detail::reference_stores_supported() ? feature_state::supported : feature_state::conditional,
            "Metadata-bound stores require the collector-aware field backend; raw stores are Epsilon-only");
        const bool persistent_collector{ report.java_feature == 8
            ? gc.collector == gc_collector::parallel : gc.collector == gc_collector::g1 };
        if (!report.external_symbols && persistent_collector)
        {
            set(runtime_feature::persistent_references, feature_state::conditional,
                "Requires successful root-keeper preparation on this exact profile");
            if (detail::borrowed_callback_supported() && detail::jit_backend::config().ready)
            {
                set(runtime_feature::method_entry_hooks, feature_state::conditional,
                    "Target signature and JIT preparation must pass before publication");
                set(runtime_feature::static_primitive_field_hooks, feature_state::conditional,
                    "Interpreter getstatic/putstatic routes only; each field and template is verified");
                set(runtime_feature::static_reference_field_hooks, feature_state::conditional,
                    "Verified getstatic/putstatic routes with VM-scanned object transport; each field requires preparation");
                set(runtime_feature::class_definition_events, feature_state::conditional,
                    "Exact private definition routes; observer preparation must pass");
            }
        }
        set(runtime_feature::original_method_exit_events, feature_state::unavailable,
            "Entry callbacks and forced returns do not observe an original method exit");
        set(runtime_feature::exact_heap_iteration,
            detail::verified_heap_iteration_available() ? feature_state::conditional : feature_state::unavailable,
            "Verified G1/Parallel VM heap walk; requires a standalone native context and bounded rooted snapshot");
        set(runtime_feature::mixed_stack_sampling, feature_state::unavailable,
            "No verified Windows mixed-stack sampling backend");
        set(runtime_feature::virtual_thread_hooks, feature_state::unavailable,
            "Carrier, continuation and virtual-thread root transitions are not verified");
        set(runtime_feature::java_monitors,
            detail::verified_monitor_locks_available() ? feature_state::conditional : feature_state::unavailable,
            "Verified ObjectLocker ABI; requires a rooted non-null object and an owner-stack native context");
        return report;
    }
}
// VMHOOK_RUNTIME_DIAGNOSTICS_END

// VMHOOK_MANAGEMENT_OBSERVATIONS_BEGIN
export namespace vmhook
{
    // These are copied C++ observations, not Java object wrappers. They remain
    // usable after the originating native_thread_context has closed.
    struct memory_usage_snapshot final
    {
        std::int64_t initial_bytes{}, used_bytes{}, committed_bytes{};
        std::optional<std::int64_t> maximum_bytes{};
    };

    struct garbage_collector_snapshot final
    {
        std::string name{};
        bool valid{};
        std::optional<std::int64_t> collection_count{}, collection_time_ms{};
    };

    struct memory_pool_snapshot final
    {
        std::string name{}, type{};
        bool valid{};
        std::optional<memory_usage_snapshot> usage{}, peak_usage{}, collection_usage{};
        std::optional<std::int64_t> usage_threshold_count{}, collection_threshold_count{};
    };

    struct thread_allocation_sample final
    {
        std::int64_t thread_id{};
        std::optional<std::int64_t> allocated_bytes{};
    };

    struct thread_allocation_snapshot final
    {
        std::chrono::steady_clock::time_point capture_started{}, capture_finished{};
        bool supported{}, enabled{};
        std::vector<thread_allocation_sample> threads{};
    };

    struct runtime_snapshot final
    {
        std::chrono::steady_clock::time_point capture_started{}, capture_finished{};
        std::int64_t started_unix_ms{}, uptime_ms{}, total_loaded_classes{}, unloaded_classes{};
        std::int32_t loaded_classes{}, live_threads{}, daemon_threads{}, peak_threads{};
        std::int64_t total_started_threads{};
        std::optional<std::int64_t> compilation_time_ms{};
        memory_usage_snapshot heap{}, non_heap{};
        std::vector<garbage_collector_snapshot> garbage_collectors{};
    };

    struct java_stack_frame_snapshot final
    {
        std::string class_name{}, method_name{};
        std::int32_t line_number{};
        bool native_method{};
    };

    struct java_thread_snapshot final
    {
        std::int64_t id{};
        bool alive{};
        std::string name{}, state{};
        bool suspended{}, in_native{};
        std::int64_t blocked_count{}, waited_count{};
        std::optional<std::int64_t> blocked_time_ms{}, waited_time_ms{}, cpu_time_ns{};
        std::vector<java_stack_frame_snapshot> stack{};
    };

    namespace detail
    {
        template<typename... argument_types>
        inline auto management_call(const std::unique_ptr<any_object>& receiver,
            const std::string_view contract, const std::string_view name,
            const std::string_view signature, argument_types&&... arguments)
            -> method_proxy::value_t
        {
            if (!receiver) { throw exception{ "Management operation requires an allocated C++ owner" }; }
            return invoke_container(*receiver, contract, name, signature,
                                    std::forward<argument_types>(arguments)...);
        }

        inline auto management_bean(const std::string_view name, const std::string_view signature)
            -> std::unique_ptr<any_object>
        { return call_bootstrap_method("java/lang/management/ManagementFactory", name, signature); }

        inline auto observed_nonnegative(const std::int64_t value) noexcept -> std::optional<std::int64_t>
        { return value < 0 ? std::nullopt : std::optional<std::int64_t>{ value }; }

        inline auto observe_memory_usage(const std::unique_ptr<any_object>& usage) -> memory_usage_snapshot
        {
            constexpr std::string_view contract{ "java/lang/management/MemoryUsage" };
            memory_usage_snapshot result{};
            result.initial_bytes = management_call(usage, contract, "getInit", "()J");
            result.used_bytes = management_call(usage, contract, "getUsed", "()J");
            result.committed_bytes = management_call(usage, contract, "getCommitted", "()J");
            const std::int64_t maximum{ management_call(usage, contract, "getMax", "()J") };
            result.maximum_bytes = observed_nonnegative(maximum);
            return result;
        }

        inline auto observe_optional_memory_usage(const std::unique_ptr<any_object>& usage)
            -> std::optional<memory_usage_snapshot>
        {
            if (!usage) { throw exception{"Memory usage requires an allocated C++ owner"}; }
            if (!usage->get_instance()) { return std::nullopt; }
            return observe_memory_usage(usage);
        }
    }

    [[nodiscard]] inline auto observe_memory_pools(const std::size_t max_pools = 128)
        -> std::vector<memory_pool_snapshot>
    {
        if (max_pools == 0 || max_pools > 65536)
        { throw exception{ "Java memory pool snapshot limit is out of range" }; }
        const std::vector<std::unique_ptr<any_object>> pools{
            detail::call_bootstrap_method("java/lang/management/ManagementFactory", "getMemoryPoolMXBeans",
                                          "()Ljava/util/List;").to_vector() };
        if (pools.size() > max_pools)
        { throw exception{ "Java memory pool snapshot exceeds the requested pool limit" }; }
        std::vector<memory_pool_snapshot> result{};
        result.reserve(pools.size());
        for (const auto& pool : pools)
        {
            constexpr std::string_view contract{ "java/lang/management/MemoryPoolMXBean" };
            memory_pool_snapshot snapshot{};
            snapshot.name = static_cast<std::string>(detail::management_call(pool, contract, "getName", "()Ljava/lang/String;"));
            const std::unique_ptr<any_object> type{
                detail::management_call(pool, contract, "getType", "()Ljava/lang/management/MemoryType;") };
            snapshot.type = static_cast<std::string>(detail::management_call(type, "java/lang/Enum", "name", "()Ljava/lang/String;"));
            snapshot.valid = detail::management_call(pool, contract, "isValid", "()Z");
            for (const auto& [method_name, destination] : std::array{
                std::pair{std::string_view{"getUsage"}, &snapshot.usage},
                std::pair{std::string_view{"getPeakUsage"}, &snapshot.peak_usage},
                std::pair{std::string_view{"getCollectionUsage"}, &snapshot.collection_usage}})
            {
                const std::unique_ptr<any_object> usage{
                    detail::management_call(pool, contract, method_name, "()Ljava/lang/management/MemoryUsage;") };
                *destination = detail::observe_optional_memory_usage(usage);
            }
            const bool usage_supported{
                detail::management_call(pool, contract, "isUsageThresholdSupported", "()Z") };
            const bool collection_supported{
                detail::management_call(pool, contract, "isCollectionUsageThresholdSupported", "()Z") };
            if (usage_supported)
            {
                const std::int64_t count{detail::management_call(pool, contract, "getUsageThresholdCount", "()J")};
                snapshot.usage_threshold_count = detail::observed_nonnegative(count);
            }
            if (collection_supported)
            {
                const std::int64_t count{detail::management_call(pool, contract, "getCollectionUsageThresholdCount", "()J")};
                snapshot.collection_threshold_count = detail::observed_nonnegative(count);
            }
            result.push_back(std::move(snapshot));
        }
        return result;
    }

    // The optional HotSpot management extension counts allocated bytes. It is
    // queried on its real receiver and never enabled by VMHook. A sample is a
    // cumulative counter, not an allocation notification or retained size.
    [[nodiscard]] inline auto observe_thread_allocations(const std::size_t max_threads = 4096)
        -> thread_allocation_snapshot
    {
        if (max_threads == 0 || max_threads > 65536)
        { throw exception{ "Java thread allocation snapshot limit is out of range" }; }
        thread_allocation_snapshot result{};
        result.capture_started = std::chrono::steady_clock::now();
        const auto bean{detail::management_bean("getThreadMXBean", "()Ljava/lang/management/ThreadMXBean;")};
        const auto supported{bean->get_method("isThreadAllocatedMemorySupported", "()Z")};
        if (!supported)
        { result.capture_finished = std::chrono::steady_clock::now(); return result; }
        result.supported = supported->call();
        if (result.supported)
        {
            const auto enabled{bean->get_method("isThreadAllocatedMemoryEnabled", "()Z")};
            const auto allocated{bean->get_method("getThreadAllocatedBytes", "(J)J")};
            if (!enabled || !allocated)
            { throw exception{"Java allocation management extension has an inconsistent method contract"}; }
            result.enabled = enabled->call();
            if (result.enabled)
            {
                const std::unique_ptr<array<std::int64_t>> ids{
                    detail::management_call(bean, "java/lang/management/ThreadMXBean", "getAllThreadIds", "()[J")};
                if (static_cast<std::size_t>(ids->size()) > max_threads)
                { throw exception{"Java thread allocation snapshot exceeds the requested thread limit"}; }
                const auto copied_ids{ids->to_vector()};
                result.threads.reserve(copied_ids.size());
                for (const auto id : copied_ids)
                {
                    const std::int64_t bytes{allocated->call(id)};
                    result.threads.push_back({id, detail::observed_nonnegative(bytes)});
                }
            }
        }
        result.capture_finished = std::chrono::steady_clock::now();
        return result;
    }

    // Ordinary Java management calls on the current native context. Counters
    // are read sequentially, not atomically; the interval is included. No
    // monitoring setting, JVM launch argument or JNI/JVMTI API is required.
    [[nodiscard]] inline auto observe_runtime() -> runtime_snapshot
    {
        runtime_snapshot result{};
        result.capture_started = std::chrono::steady_clock::now();
        const auto runtime{ detail::management_bean("getRuntimeMXBean", "()Ljava/lang/management/RuntimeMXBean;") };
        constexpr std::string_view runtime_contract{ "java/lang/management/RuntimeMXBean" };
        result.started_unix_ms = detail::management_call(runtime, runtime_contract, "getStartTime", "()J");
        result.uptime_ms = detail::management_call(runtime, runtime_contract, "getUptime", "()J");
        const auto memory{ detail::management_bean("getMemoryMXBean", "()Ljava/lang/management/MemoryMXBean;") };
        const std::unique_ptr<any_object> heap{
            detail::management_call(memory, "java/lang/management/MemoryMXBean", "getHeapMemoryUsage", "()Ljava/lang/management/MemoryUsage;") };
        const std::unique_ptr<any_object> non_heap{
            detail::management_call(memory, "java/lang/management/MemoryMXBean", "getNonHeapMemoryUsage", "()Ljava/lang/management/MemoryUsage;") };
        result.heap = detail::observe_memory_usage(heap);
        result.non_heap = detail::observe_memory_usage(non_heap);
        const auto classes{ detail::management_bean("getClassLoadingMXBean", "()Ljava/lang/management/ClassLoadingMXBean;") };
        constexpr std::string_view class_contract{ "java/lang/management/ClassLoadingMXBean" };
        result.loaded_classes = detail::management_call(classes, class_contract, "getLoadedClassCount", "()I");
        result.total_loaded_classes = detail::management_call(classes, class_contract, "getTotalLoadedClassCount", "()J");
        result.unloaded_classes = detail::management_call(classes, class_contract, "getUnloadedClassCount", "()J");
        const auto threads{ detail::management_bean("getThreadMXBean", "()Ljava/lang/management/ThreadMXBean;") };
        constexpr std::string_view thread_contract{ "java/lang/management/ThreadMXBean" };
        result.live_threads = detail::management_call(threads, thread_contract, "getThreadCount", "()I");
        result.daemon_threads = detail::management_call(threads, thread_contract, "getDaemonThreadCount", "()I");
        result.peak_threads = detail::management_call(threads, thread_contract, "getPeakThreadCount", "()I");
        result.total_started_threads = detail::management_call(threads, thread_contract, "getTotalStartedThreadCount", "()J");
        const auto compiler{ detail::management_bean("getCompilationMXBean", "()Ljava/lang/management/CompilationMXBean;") };
        if (compiler->get_instance())
        {
            const bool supported{ detail::management_call(compiler, "java/lang/management/CompilationMXBean",
                                                          "isCompilationTimeMonitoringSupported", "()Z") };
            if (supported)
            {
                const std::int64_t elapsed{ detail::management_call(compiler, "java/lang/management/CompilationMXBean",
                                                                   "getTotalCompilationTime", "()J") };
                result.compilation_time_ms = detail::observed_nonnegative(elapsed);
            }
        }
        const std::vector<std::unique_ptr<any_object>> collectors{
            detail::call_bootstrap_method("java/lang/management/ManagementFactory", "getGarbageCollectorMXBeans", "()Ljava/util/List;").to_vector() };
        result.garbage_collectors.reserve(collectors.size());
        for (const auto& collector : collectors)
        {
            constexpr std::string_view contract{ "java/lang/management/GarbageCollectorMXBean" };
            garbage_collector_snapshot snapshot{};
            snapshot.name = static_cast<std::string>(detail::management_call(collector, contract, "getName", "()Ljava/lang/String;"));
            snapshot.valid = detail::management_call(collector, contract, "isValid", "()Z");
            const std::int64_t count{ detail::management_call(collector, contract, "getCollectionCount", "()J") };
            const std::int64_t elapsed{ detail::management_call(collector, contract, "getCollectionTime", "()J") };
            snapshot.collection_count = detail::observed_nonnegative(count);
            snapshot.collection_time_ms = detail::observed_nonnegative(elapsed);
            result.garbage_collectors.push_back(std::move(snapshot));
        }
        result.capture_finished = std::chrono::steady_clock::now();
        return result;
    }

    // Java ThreadMXBean snapshots include interpreted and compiled Java
    // frames, subject to the JVM's ordinary stack-trace precision. They are
    // synchronous observations, not asynchronous mixed-stack CPU samples.
    [[nodiscard]] inline auto observe_java_threads(const std::int32_t max_depth = 64,
        const std::size_t max_threads = 4096) -> std::vector<java_thread_snapshot>
    {
        if (max_depth < 0 || max_depth > 1024 || max_threads == 0 || max_threads > 65536)
        { throw exception{ "Java thread snapshot limits are out of range" }; }
        const auto bean{ detail::management_bean("getThreadMXBean", "()Ljava/lang/management/ThreadMXBean;") };
        constexpr std::string_view contract{ "java/lang/management/ThreadMXBean" };
        const std::unique_ptr<array<std::int64_t>> ids{ detail::management_call(bean, contract, "getAllThreadIds", "()[J") };
        if (static_cast<std::size_t>(ids->size()) > max_threads)
        { throw exception{ "Java thread snapshot exceeds the requested thread limit" }; }
        const auto copied_ids{ ids->to_vector() };
        const std::vector<std::unique_ptr<any_object>> infos{
            detail::management_call(bean, contract, "getThreadInfo", "([JI)[Ljava/lang/management/ThreadInfo;", ids, max_depth).to_vector() };
        if (infos.size() != copied_ids.size())
        { throw exception{ "Java thread snapshot returned an inconsistent result length" }; }
        const bool cpu_supported{ detail::management_call(bean, contract, "isThreadCpuTimeSupported", "()Z") };
        std::vector<java_thread_snapshot> result{};
        result.reserve(infos.size());
        for (std::size_t index{}; index < infos.size(); ++index)
        {
            java_thread_snapshot snapshot{};
            snapshot.id = copied_ids[index];
            const auto& info{ infos[index] };
            if (!info->get_instance()) { result.push_back(std::move(snapshot)); continue; }
            snapshot.alive = true;
            constexpr std::string_view info_contract{ "java/lang/management/ThreadInfo" };
            snapshot.name = static_cast<std::string>(detail::management_call(info, info_contract, "getThreadName", "()Ljava/lang/String;"));
            const std::unique_ptr<any_object> state{ detail::management_call(info, info_contract, "getThreadState", "()Ljava/lang/Thread$State;") };
            snapshot.state = static_cast<std::string>(detail::management_call(state, "java/lang/Enum", "name", "()Ljava/lang/String;"));
            snapshot.suspended = detail::management_call(info, info_contract, "isSuspended", "()Z");
            snapshot.in_native = detail::management_call(info, info_contract, "isInNative", "()Z");
            snapshot.blocked_count = detail::management_call(info, info_contract, "getBlockedCount", "()J");
            snapshot.waited_count = detail::management_call(info, info_contract, "getWaitedCount", "()J");
            const std::int64_t blocked{ detail::management_call(info, info_contract, "getBlockedTime", "()J") };
            const std::int64_t waited{ detail::management_call(info, info_contract, "getWaitedTime", "()J") };
            snapshot.blocked_time_ms = detail::observed_nonnegative(blocked);
            snapshot.waited_time_ms = detail::observed_nonnegative(waited);
            if (cpu_supported)
            {
                const std::int64_t cpu{ detail::management_call(bean, contract, "getThreadCpuTime", "(J)J", snapshot.id) };
                snapshot.cpu_time_ns = detail::observed_nonnegative(cpu);
            }
            const std::vector<std::unique_ptr<any_object>> frames{
                detail::management_call(info, info_contract, "getStackTrace", "()[Ljava/lang/StackTraceElement;").to_vector() };
            snapshot.stack.reserve(frames.size());
            for (const auto& frame : frames)
            {
                constexpr std::string_view frame_contract{ "java/lang/StackTraceElement" };
                java_stack_frame_snapshot copied{};
                copied.class_name = static_cast<std::string>(detail::management_call(frame, frame_contract, "getClassName", "()Ljava/lang/String;"));
                copied.method_name = static_cast<std::string>(detail::management_call(frame, frame_contract, "getMethodName", "()Ljava/lang/String;"));
                copied.line_number = detail::management_call(frame, frame_contract, "getLineNumber", "()I");
                copied.native_method = detail::management_call(frame, frame_contract, "isNativeMethod", "()Z");
                snapshot.stack.push_back(std::move(copied));
            }
            result.push_back(std::move(snapshot));
        }
        return result;
    }
}
// VMHOOK_MANAGEMENT_OBSERVATIONS_END
// VMHOOK_HEAP_ITERATION_BEGIN
export namespace vmhook::detail::heap_iteration
{
    namespace pn = vmhook::detail::private_native;
    namespace nb = vmhook::detail::native_backend;
    using heap_prepare = void(*)(void*, bool);
    using heap_walk = void(*)(void*, void*);
    struct configuration final
    {
        bool ready{};
        void* heap{};
        heap_prepare prepare{};
        heap_walk iterate{};
        std::size_t callback_slot{}, callback_slots{}, closure_size{};
    };
    auto config() noexcept -> const configuration&
    {
        static const configuration value = []() noexcept
        {
            configuration result{};
            try
            {
                auto& runtime{ pn::rt() };
                if (!runtime.ready || runtime.uses_external_symbols()
                    || !vmhook::detail::java_execution_supported()) { return result; }
                const auto collector{ vmhook::vm_capabilities().collector };
                if (collector != vmhook::gc_collector::g1 && collector != vmhook::gc_collector::parallel)
                { return result; }
                result.closure_size = runtime.size("ObjectClosure");
                const auto slot{ runtime.enum_value("ObjectClosure", "vtable_do_object") };
                const auto count{ runtime.enum_value("ObjectClosure", "vtable_count") };
                if ((result.closure_size != 8 && result.closure_size != 16)
                    || slot < 0 || slot >= count || count > 64) { return result; }
                result.callback_slot = static_cast<std::size_t>(slot);
                result.callback_slots = static_cast<std::size_t>(count);
                const auto* const heap_entry{ vmhook::hotspot::iterate_struct_entries("Universe", "_collectedHeap") };
                if (!heap_entry || !heap_entry->address
                    || !vmhook::os::safe_read(&result.heap, heap_entry->address, sizeof(result.heap))
                    || !vmhook::hotspot::is_valid_pointer(result.heap)) { return configuration{}; }
                const bool parallel{ collector == vmhook::gc_collector::parallel };
                result.prepare = runtime.fn<heap_prepare>(parallel ? "heap_ensure_parallel" : "heap_ensure_g1");
                result.iterate = runtime.fn<heap_walk>(parallel ? "heap_iterate_parallel" : "heap_iterate_g1");
                result.ready = result.prepare && result.iterate && vmhook::detail::jit_backend::config().ready;
            }
            catch (...) { return configuration{}; }
            return result;
        }();
        return value;
    }

    struct walk_payload final
    {
        // The private ObjectClosure layout is 8 bytes (modern) or 16 bytes
        // (Java 8's zero-initialized inherited abort flag). Its callback slot
        // and argument type are independently verified from the matching PDB
        // or the exact tagged source and audited PE callback instruction.
        alignas(8) std::array<std::byte, 16> closure{};
        std::array<void*, 64> vtable{};
        const configuration* runtime{};
        vmhook::hotspot::klass* target{};
        const nb::root* slots{};
        std::size_t capacity{}, matches{};
        bool executed{};
    };

    inline auto do_object(void* const closure, void* const object) noexcept -> void
    {
        auto& payload{ *reinterpret_cast<walk_payload*>(closure) };
        if (vmhook::klass_from_oop(object) != payload.target) { return; }
        const auto index{ payload.matches++ };
        if (index < payload.capacity)
        {
            // These HandleArea slots were allocated by the caller before
            // entering the VM operation. The owner JavaThread is blocked and
            // all mutators are stopped; no root scan can race this publication.
            pn::store<void*>(payload.slots[index]->slot, 0, object);
        }
    }

    inline auto walk_at_safepoint(void* const opaque) noexcept -> void
    {
        auto& payload{ *static_cast<walk_payload*>(opaque) };
        // Filling unused TLAB tails is necessary for an exact VM object walk.
        // No Java allocation, user callback, C++ allocation or root creation
        // takes place in this stop-the-world region.
        payload.runtime->prepare(payload.runtime->heap, false);
        payload.runtime->iterate(payload.runtime->heap, payload.closure.data());
        payload.executed = true;
    }

    inline auto walk(walk_payload& payload) -> void
    {
        payload.vtable[payload.runtime->callback_slot] = reinterpret_cast<void*>(&do_object);
        pn::store<void*>(payload.closure.data(), 0, payload.vtable.data());
        if (!vmhook::detail::jit_backend::at_safepoint(&walk_at_safepoint, &payload) || !payload.executed)
        { throw vmhook::exception{ "The verified heap VM operation could not run at a safepoint" }; }
    }

    inline auto capture(vmhook::hotspot::klass* const target, const std::size_t max_visits)
        -> std::vector<nb::root>
    {
        if (max_visits == 0) { return {}; }
        nb::operation access{};
        if (!access || !nb::active() || vmhook::hotspot::in_java_detour())
        { throw vmhook::exception{ "Heap snapshots require a standalone native_thread_context" }; }
        const auto& runtime{ config() };
        if (!runtime.ready)
        { throw vmhook::exception{ "This exact VM profile and collector have no verified heap iterator" }; }
        if (!target) { throw vmhook::exception{ "Heap snapshot class could not be resolved" }; }
        const auto metadata{ nb::retain_class(target) };
        if (!metadata) { throw vmhook::exception{ "Heap snapshot class mirror could not be retained" }; }
        walk_payload counted{};
        counted.runtime = &runtime;
        counted.target = target;
        walk(counted);
        if (counted.matches == 0) { return {}; }
        const auto requested{ std::min(max_visits, counted.matches) };
        // Allow modest class-instance growth between the count and capture
        // safepoints. Overflow is reported, rather than silently losing objects.
        const auto extra{ std::min(max_visits - requested, std::max<std::size_t>(64, requested / 4)) };
        std::vector<nb::root> roots{};
        roots.reserve(requested + extra);
        for (std::size_t index{}; index < requested + extra; ++index)
        {
            auto slot{ nb::reserve_result_root(target) };
            if (!slot) { throw vmhook::exception{ "Heap snapshot result roots could not be reserved" }; }
            roots.push_back(std::move(slot));
        }
        walk_payload captured{};
        captured.runtime = &runtime;
        captured.target = target;
        captured.slots = roots.data();
        captured.capacity = roots.size();
        walk(captured);
        if (captured.matches > roots.size() && roots.size() < max_visits)
        { throw vmhook::exception{ "Class instance count grew beyond the reserved snapshot; retry the heap snapshot" }; }
        roots.resize(std::min(captured.matches, roots.size()));
        return roots;
    }
}

export namespace vmhook
{
    template<typename value_type>
    [[nodiscard]] inline auto get_instances(const std::size_t max_visits)
        -> std::vector<std::unique_ptr<value_type>>
    {
        static_assert(vmhook::detail::is_java_wrapper_v<value_type>);
        vmhook::detail::native_backend::operation access{};
        auto* const target{ vmhook::detail::registered_class_klass<value_type>() };
        auto roots{ vmhook::detail::heap_iteration::capture(target, max_visits) };
        std::vector<std::unique_ptr<value_type>> result{};
        result.reserve(roots.size());
        for (auto& root : roots)
        { result.push_back(vmhook::detail::materialize_object<value_type>(0, root)); }
        return result;
    }

    template<typename value_type, typename visitor_type>
    inline auto for_each_instance(visitor_type&& visit, const std::size_t max_visits) -> std::size_t
    {
        auto objects{ vmhook::get_instances<value_type>(max_visits) };
        const auto count{ objects.size() };
        for (auto& object : objects) { std::invoke(visit, std::move(object)); }
        return count;
    }

    template<typename visitor_type>
    inline auto for_each_instance_of(vmhook::hotspot::klass* const target, visitor_type&& visit,
                                     const std::size_t max_visits) -> std::size_t
    {
        auto roots{ vmhook::detail::heap_iteration::capture(target, max_visits) };
        const auto count{ roots.size() };
        for (auto& root : roots)
        { std::invoke(visit, vmhook::detail::materialize_object<vmhook::any_object>(0, root)); }
        return count;
    }
}
export namespace vmhook::detail
{
    inline auto verified_heap_iteration_available() noexcept -> bool
    { return heap_iteration::config().ready; }
}
// VMHOOK_HEAP_ITERATION_END
// VMHOOK_NATIVE_EXECUTOR_BEGIN
export namespace vmhook::detail
{
    template<typename value_type> struct native_transferable_type : std::bool_constant<
        std::is_arithmetic_v<value_type> || std::is_enum_v<value_type>
        || std::is_same_v<value_type, std::string> || std::is_same_v<value_type, std::u16string>> {};
    template<> struct native_transferable_type<void> : std::true_type {};
    template<typename wrapper_type>
    struct native_transferable_type<vmhook::retained_object<wrapper_type>> : std::true_type {};
    template<typename value_type, typename allocator_type>
    struct native_transferable_type<std::vector<value_type, allocator_type>> : std::bool_constant<
        std::is_same_v<allocator_type, std::allocator<value_type>>
        && native_transferable_type<value_type>::value> {};
    template<typename value_type, std::size_t length>
    struct native_transferable_type<std::array<value_type, length>> : native_transferable_type<value_type> {};
    template<typename value_type>
    struct native_transferable_type<std::optional<value_type>> : native_transferable_type<value_type> {};
    template<typename first_type, typename second_type>
    struct native_transferable_type<std::pair<first_type, second_type>> : std::bool_constant<
        native_transferable_type<first_type>::value && native_transferable_type<second_type>::value> {};
    template<typename... value_types>
    struct native_transferable_type<std::tuple<value_types...>> : std::bool_constant<
        (native_transferable_type<value_types>::value && ...)> {};
    template<typename value_type>
    concept native_transferable = !std::is_reference_v<value_type>
        && native_transferable_type<std::remove_cv_t<value_type>>::value;
    inline thread_local const void* native_executor_worker{};
    inline auto native_executor_can_wait() noexcept -> bool
    {
        try
        {
            auto& runtime{private_native::rt()};
            auto* const current{runtime.ready ? runtime.current_thread() : nullptr};
            return !current || private_native::thread_state(current) == 4;
        }
        catch (...) { return false; }
    }
    struct native_task_base;
    struct native_task_state final
    {
        std::atomic<unsigned> phase{}; // 0 queued, 1 executing, 2 completed
        std::atomic<bool> cancel_requested{};
        std::chrono::steady_clock::time_point deadline{std::chrono::steady_clock::time_point::max()};
        const void* executor{};
        std::weak_ptr<native_task_base> task{};
    };
}
export namespace vmhook
{
    class native_task_control final
    {
        std::shared_ptr<detail::native_task_state> state_;
    public:
        explicit native_task_control(std::shared_ptr<detail::native_task_state> state) noexcept
            : state_{std::move(state)} {}
        [[nodiscard]] auto stop_requested() const noexcept -> bool
        { return state_->cancel_requested.load(std::memory_order_acquire)
            || std::chrono::steady_clock::now() >= state_->deadline; }
        auto throw_if_cancelled() const -> void
        {
            if (state_->cancel_requested.load(std::memory_order_acquire))
            { throw vmhook::exception{"Native Java task was cancelled"}; }
            if (std::chrono::steady_clock::now() >= state_->deadline)
            { throw vmhook::exception{"Native Java task deadline expired"}; }
        }
    };
}
export namespace vmhook::detail
{
    struct native_task_base
    {
        std::shared_ptr<native_task_state> state{};
        virtual ~native_task_base() = default;
        virtual auto execute() noexcept -> void = 0;
        virtual auto cancel_queued() noexcept -> void = 0;
    };
    template<bool with_control, typename function_type, typename... argument_types>
    struct native_task_result;
    template<typename function_type, typename... argument_types>
    struct native_task_result<true, function_type, argument_types...>
    { using type = std::invoke_result_t<function_type&, const vmhook::native_task_control&, argument_types&&...>; };
    template<typename function_type, typename... argument_types>
    struct native_task_result<false, function_type, argument_types...>
    { using type = std::invoke_result_t<function_type&, argument_types&&...>; };
    template<typename function_type, typename... argument_types>
    inline constexpr bool native_task_with_control = std::is_invocable_v<function_type&,
        const vmhook::native_task_control&, argument_types&&...>;
    template<typename function_type, typename... argument_types>
    using native_task_result_t = typename native_task_result<
        native_task_with_control<function_type, argument_types...>, function_type, argument_types...>::type;
    template<typename function_type, typename... argument_types>
    concept native_task_callable = (std::is_empty_v<function_type> || std::is_pointer_v<function_type>)
        && (native_task_with_control<function_type, argument_types...>
            || std::is_invocable_v<function_type&, argument_types&&...>)
        && native_transferable<native_task_result_t<function_type, argument_types...>>;

    template<typename function_type, typename... argument_types>
    class native_task_model final : public native_task_base
    {
        using result_type = native_task_result_t<function_type, argument_types...>;
        function_type callable_;
        std::tuple<argument_types...> arguments_;
        std::promise<result_type> promise_{};
        auto cancel_error() noexcept -> void
        {
            try { vmhook::native_task_control{state}.throw_if_cancelled();
                throw vmhook::exception{"Native Java task was cancelled before execution"}; }
            catch (...) { try { promise_.set_exception(std::current_exception()); } catch (...) {} }
        }
    public:
        template<typename function_arg, typename... value_args>
        native_task_model(std::shared_ptr<native_task_state> control,
            function_arg&& function, value_args&&... values)
            : callable_{std::forward<function_arg>(function)}, arguments_{std::forward<value_args>(values)...}
        { state = std::move(control); }
        auto future() -> std::future<result_type> { return promise_.get_future(); }
        auto cancel_queued() noexcept -> void override
        {
            state->cancel_requested.store(true, std::memory_order_release);
            unsigned expected{};
            if (state->phase.compare_exchange_strong(expected, 2, std::memory_order_acq_rel)) { cancel_error(); }
        }
        auto execute() noexcept -> void override
        {
            unsigned expected{};
            if (!state->phase.compare_exchange_strong(expected, 1, std::memory_order_acq_rel)) { return; }
            try
            {
                const vmhook::native_task_control control{state};
                control.throw_if_cancelled();
                const auto invoke = [&]() -> result_type
                {
                    return std::apply([&](auto&... values) -> result_type
                    {
                        if constexpr (native_task_with_control<function_type, argument_types...>)
                        { return std::invoke(callable_, control, std::move(values)...); }
                        else { return std::invoke(callable_, std::move(values)...); }
                    }, arguments_);
                };
                if constexpr (std::is_void_v<result_type>)
                { invoke(); control.throw_if_cancelled(); promise_.set_value(); }
                else
                { auto result = invoke(); control.throw_if_cancelled(); promise_.set_value(std::move(result)); }
            }
            catch (...) { try { promise_.set_exception(std::current_exception()); } catch (...) {} }
            state->phase.store(2, std::memory_order_release);
        }
    };
}
export namespace vmhook
{
    template<typename result_type>
        requires detail::native_transferable<result_type>
    class native_task final
    {
        std::future<result_type> future_{};
        std::shared_ptr<detail::native_task_state> state_{};
        auto check_wait() const -> void
        {
            if (!future_.valid()) { throw vmhook::exception{"Native Java task has no future"}; }
            if (future_.wait_for(std::chrono::seconds{0}) != std::future_status::ready
                && ((!detail::native_executor_can_wait())
                    || detail::native_executor_worker))
            { throw vmhook::exception{"Waiting here would block a VM callback or a native executor worker"}; }
        }
        friend class native_executor;
        native_task(std::future<result_type> future, std::shared_ptr<detail::native_task_state> state)
            : future_{std::move(future)}, state_{std::move(state)} {}
    public:
        native_task() noexcept = default;
        native_task(native_task&&) noexcept = default;
        auto operator=(native_task&&) noexcept -> native_task& = default;
        native_task(const native_task&) = delete;
        auto operator=(const native_task&) -> native_task& = delete;
        [[nodiscard]] auto valid() const noexcept -> bool { return future_.valid(); }
        [[nodiscard]] auto ready() const -> bool
        {
            if (!future_.valid()) { throw vmhook::exception{"Native Java task has no future"}; }
            return future_.wait_for(std::chrono::seconds{0}) == std::future_status::ready;
        }
        auto cancel() noexcept -> bool
        {
            if (!state_ || state_->phase.load(std::memory_order_acquire) == 2) { return false; }
            state_->cancel_requested.store(true, std::memory_order_release);
            if (auto task{state_->task.lock()}) { task->cancel_queued(); }
            return true;
        }
        auto wait() const -> void { check_wait(); future_.wait(); }
        template<typename rep_type, typename period_type>
        auto wait_for(std::chrono::duration<rep_type, period_type> timeout) const -> std::future_status
        {
            if (timeout <= timeout.zero())
            {
                if (!future_.valid()) { throw vmhook::exception{"Native Java task has no future"}; }
                return future_.wait_for(timeout.zero());
            }
            check_wait();
            return future_.wait_for(timeout);
        }
        auto get() -> result_type { check_wait(); return future_.get(); }
    };
    struct native_executor_options final
    {
        std::size_t worker_count{1};
        std::size_t queue_capacity{64};
    };
    struct native_executor_stats final
    {
        std::size_t queued{};
        std::size_t executing{};
        std::size_t workers{};
        bool accepting{};
    };
    class native_executor final
    {
        struct shared_state final
        {
            std::mutex mutex{};
            std::condition_variable work{};
            std::condition_variable initialized{};
            std::vector<std::shared_ptr<detail::native_task_base>> queue{};
            std::vector<std::weak_ptr<detail::native_task_state>> active{};
            std::size_t head{}, count{}, reserved{}, started{}, executing{};
            bool accepting{true}, stopping{}, cancel_pending{};
            std::exception_ptr error{};
            explicit shared_state(std::size_t capacity, std::size_t worker_count)
                : queue(capacity), active(worker_count) {}
        };
        std::shared_ptr<shared_state> state_{};
        std::vector<std::thread> workers_{};
        std::mutex close_mutex_{};
        static auto worker(std::shared_ptr<shared_state> state, std::size_t index) noexcept -> void
        {
            bool announced{};
            try
            {
                vmhook::native_thread_context context{"VMHook-executor-" + std::to_string(index)};
                if (!context.valid()) { throw vmhook::exception{context.error()}; }
                detail::native_executor_worker = state.get();
                {
                    std::lock_guard lock{state->mutex};
                    ++state->started;
                    announced = true;
                }
                state->initialized.notify_all();
                for (;;)
                {
                    std::shared_ptr<detail::native_task_base> task{};
                    {
                        std::unique_lock lock{state->mutex};
                        state->work.wait(lock, [&] { return state->count != 0 || (state->stopping && state->reserved == 0); });
                        if (state->count == 0) { break; }
                        task = std::move(state->queue[state->head]);
                        state->head = (state->head + 1) % state->queue.size();
                        --state->count;
                        ++state->executing;
                        state->active[index] = task->state;
                    }
                    task->execute();
                    task.reset();
                    {
                        std::lock_guard lock{state->mutex};
                        --state->executing;
                        state->active[index].reset();
                    }
                }
                detail::native_executor_worker = nullptr;
                if (!context.close()) { throw vmhook::exception{context.error()}; }
            }
            catch (...)
            {
                detail::native_executor_worker = nullptr;
                {
                    std::lock_guard lock{state->mutex};
                    if (!state->error) { state->error = std::current_exception(); }
                    if (!announced) { ++state->started; }
                    state->accepting = false;
                    state->stopping = true;
                    state->cancel_pending = true;
                    for (auto& task : state->queue) { if (task) { task->cancel_queued(); } }
                    for (auto& active : state->active)
                    { if (auto running{active.lock()}) { running->cancel_requested.store(true, std::memory_order_release); } }
                }
                state->initialized.notify_all();
                state->work.notify_all();
            }
        }
        auto request_stop(bool drain) noexcept -> void
        {
            if (!state_) { return; }
            {
                std::lock_guard lock{state_->mutex};
                state_->accepting = false;
                state_->stopping = true;
                if (!drain)
                {
                    state_->cancel_pending = true;
                    for (auto& task : state_->queue) { if (task) { task->cancel_queued(); } }
                    for (auto& active : state_->active)
                    { if (auto running{active.lock()}) { running->cancel_requested.store(true, std::memory_order_release); } }
                }
            }
            state_->work.notify_all();
        }
        template<typename function_type, typename... argument_types>
        auto submit_at(std::chrono::steady_clock::time_point deadline,
            function_type&& function, argument_types&&... arguments)
            -> native_task<detail::native_task_result_t<std::decay_t<function_type>, std::decay_t<argument_types>...>>
        {
            using result_type = detail::native_task_result_t<std::decay_t<function_type>, std::decay_t<argument_types>...>;
            if constexpr (std::is_pointer_v<std::decay_t<function_type>>)
            {
                if (!function) { throw vmhook::exception{"Native executor callable pointer is null"}; }
            }
            // Reserve admission before moving resources from the caller. A
            // full/closed queue therefore does not consume retained arguments.
            {
                std::lock_guard lock{state_->mutex};
                if (!state_->accepting) { throw vmhook::exception{"Native Java executor is closed"}; }
                if (state_->count + state_->reserved == state_->queue.size())
                { throw vmhook::exception{"Native Java executor queue is full"}; }
                ++state_->reserved;
            }
            std::shared_ptr<detail::native_task_state> control{};
            std::shared_ptr<detail::native_task_model<std::decay_t<function_type>, std::decay_t<argument_types>...>> task{};
            std::future<result_type> future{};
            try
            {
                control = std::make_shared<detail::native_task_state>();
                control->executor = state_.get();
                control->deadline = deadline;
                task = std::make_shared<detail::native_task_model<std::decay_t<function_type>,
                    std::decay_t<argument_types>...>>(control, std::forward<function_type>(function),
                        std::forward<argument_types>(arguments)...);
                control->task = task;
                future = task->future();
            }
            catch (...)
            {
                { std::lock_guard lock{state_->mutex}; --state_->reserved; }
                state_->work.notify_all();
                throw;
            }
            {
                std::lock_guard lock{state_->mutex};
                --state_->reserved;
                if (state_->cancel_pending) { task->cancel_queued(); }
                state_->queue[(state_->head + state_->count) % state_->queue.size()] = std::move(task);
                ++state_->count;
            }
            state_->work.notify_one();
            return native_task<result_type>{std::move(future), std::move(control)};
        }
    public:
        explicit native_executor(native_executor_options options = {})
        {
            if (!detail::native_executor_can_wait() || detail::native_executor_worker)
            { throw vmhook::exception{"Create a native executor outside VM callbacks and worker tasks"}; }
            if (options.worker_count == 0 || options.worker_count > 64
                || options.queue_capacity == 0 || options.queue_capacity > 1048576)
            { throw vmhook::exception{"Native executor worker count or queue capacity is invalid"}; }
            state_ = std::make_shared<shared_state>(options.queue_capacity, options.worker_count);
            workers_.reserve(options.worker_count);
            try
            {
                for (std::size_t index{}; index < options.worker_count; ++index)
                { workers_.emplace_back(&worker, state_, index); }
                std::unique_lock lock{state_->mutex};
                state_->initialized.wait(lock, [&] { return state_->started >= options.worker_count; });
                if (state_->error) { std::rethrow_exception(state_->error); }
            }
            catch (...)
            {
                request_stop(false);
                for (auto& thread : workers_) { if (thread.joinable()) { thread.join(); } }
                throw;
            }
        }
        native_executor(const native_executor&) = delete;
        native_executor(native_executor&&) = delete;
        auto operator=(const native_executor&) -> native_executor& = delete;
        auto operator=(native_executor&&) -> native_executor& = delete;
        ~native_executor()
        {
            request_stop(false);
            if (detail::native_executor_can_wait() && !detail::native_executor_worker)
            { for (auto& thread : workers_) { if (thread.joinable()) { thread.join(); } } }
            else
            {
                // A callback cannot wait for Java work. Workers own shared state
                // and close their contexts themselves after cooperative completion.
                for (auto& thread : workers_) { if (thread.joinable()) { thread.detach(); } }
            }
        }
        auto close(bool drain = true) -> void
        {
            if (!detail::native_executor_can_wait() || detail::native_executor_worker)
            { throw vmhook::exception{"Close and join the executor outside VM callbacks and worker tasks"}; }
            std::lock_guard shutdown_lock{close_mutex_};
            request_stop(drain);
            for (auto& thread : workers_) { if (thread.joinable()) { thread.join(); } }
            std::exception_ptr failure{};
            { std::lock_guard lock{state_->mutex}; failure = state_->error; }
            if (failure) { std::rethrow_exception(failure); }
        }
        [[nodiscard]] auto stats() const -> native_executor_stats
        {
            std::lock_guard lock{state_->mutex};
            return {state_->count + state_->reserved, state_->executing, workers_.size(), state_->accepting};
        }
        template<typename function_type, typename... argument_types>
            requires ((detail::native_transferable<std::decay_t<argument_types>> && ...)
                && detail::native_task_callable<std::decay_t<function_type>, std::decay_t<argument_types>...>
                && (std::is_constructible_v<std::decay_t<argument_types>, argument_types&&> && ...))
        [[nodiscard]] auto submit(function_type&& function, argument_types&&... arguments)
        {
            return submit_at(std::chrono::steady_clock::time_point::max(),
                std::forward<function_type>(function), std::forward<argument_types>(arguments)...);
        }
        template<typename function_type, typename... argument_types>
            requires ((detail::native_transferable<std::decay_t<argument_types>> && ...)
                && detail::native_task_callable<std::decay_t<function_type>, std::decay_t<argument_types>...>
                && (std::is_constructible_v<std::decay_t<argument_types>, argument_types&&> && ...))
        [[nodiscard]] auto submit_before(std::chrono::steady_clock::time_point deadline,
            function_type&& function, argument_types&&... arguments)
        {
            return submit_at(deadline, std::forward<function_type>(function),
                std::forward<argument_types>(arguments)...);
        }
    };
}
// VMHOOK_NATIVE_EXECUTOR_END
// VMHOOK_ROOT_RESOURCES_BEGIN
export namespace vmhook
{
    struct root_resource_snapshot final
    {
        bool durable_ready{};
        std::size_t durable_allocated_slots{};
        std::size_t durable_leases{};
        std::size_t durable_occupied_slots{};
        std::size_t durable_reusable_slots{};
        std::size_t durable_pending_releases{};
        std::size_t durable_unreclaimed_slots{};
        std::size_t durable_internal_slots{};
        bool context_active{};
        std::size_t context_allocated_slots{};
        std::size_t context_live_ticket_slots{};
        std::size_t context_occupied_ticket_slots{};
        std::size_t context_reusable_slots{};
        std::size_t context_pending_releases{};
    };

    [[nodiscard]] inline auto root_resources() -> root_resource_snapshot
    {
        root_resource_snapshot result{};
        if (auto* const keeper{detail::persistent_hook_roots::prepared_keeper.load(std::memory_order_acquire)})
        {
            const auto durable{keeper->statistics()};
            result.durable_ready = durable.ready;
            result.durable_allocated_slots = durable.allocated_slots;
            result.durable_leases = durable.leases;
            result.durable_occupied_slots = durable.occupied_slots;
            result.durable_reusable_slots = durable.reusable_slots;
            result.durable_pending_releases = durable.pending_releases;
            result.durable_unreclaimed_slots = durable.occupied_slots - durable.leases - durable.pending_releases;
            result.durable_internal_slots = durable.ready ? 1 : 0;
        }
        const auto context{detail::native_backend::active_context_lifetime()};
        if (!context || context->temporary_depth != 0) { return result; }
        auto& runtime{detail::private_native::rt()};
        if (runtime.has_function("vm_exited")
            && detail::private_native::load<bool>(runtime.function("vm_exited"), 0))
        { return result; }
        // The owner alone modifies this map/reuse list. Resolve slot contents
        // only while in VM state; remote destructors only enqueue releases.
        detail::private_native::vm_state_guard access{context->thread};
        result.context_active = true;
        result.context_allocated_slots = context->allocated_slots;
        result.context_reusable_slots = context->reusable.size();
        for (const auto& [slot, ticket] : context->tickets)
        {
            if (!ticket.expired()) { ++result.context_live_ticket_slots; }
            if (detail::private_native::detail::resolve_root(slot)) { ++result.context_occupied_ticket_slots; }
        }
        {
            std::lock_guard lock{context->releases_mutex};
            result.context_pending_releases = context->releases.size();
        }
        return result;
    }
}
// VMHOOK_ROOT_RESOURCES_END

// VMHOOK_MONITOR_LOCKS_BEGIN
export namespace vmhook::detail::monitor_backend
{
    namespace pn = vmhook::detail::private_native;
    namespace nb = vmhook::detail::native_backend;
    using construct = void(*)(void*, void**, void*);
    using construct_bool = void(*)(void*, void**, void*, bool);
    using destroy = void(*)(void*);
    struct configuration final
    {
        bool ready{}, boolean_argument{};
        std::size_t size{};
        construct create{};
        construct_bool create_with_flag{};
        destroy release{};
    };
    auto config() noexcept -> const configuration&
    {
        static const configuration value = []() noexcept
        {
            configuration result{};
            try
            {
                auto& runtime{ pn::rt() };
                if (!runtime.ready || runtime.uses_external_symbols()
                    || !vmhook::detail::java_execution_supported()) { return result; }
                const auto collector{ vmhook::vm_capabilities().collector };
                if (collector != vmhook::gc_collector::g1 && collector != vmhook::gc_collector::parallel)
                { return result; }
                result.size = runtime.size("ObjectLocker");
                if (result.size != 24 && result.size != 32 && result.size != 40 && result.size != 48)
                { return result; }
                for (const auto member : {"_thread", "_obj", "_lock"})
                {
                    if (runtime.enum_value("ObjectLocker", std::string{"storage_size_"} + member) != 8
                        || runtime.off("ObjectLocker", member) + 8 > result.size) { return configuration{}; }
                }
                result.boolean_argument = runtime.has_function("monitor_lock_construct_bool");
                if (result.boolean_argument)
                { result.create_with_flag = runtime.fn<construct_bool>("monitor_lock_construct_bool"); }
                else { result.create = runtime.fn<construct>("monitor_lock_construct"); }
                result.release = runtime.fn<destroy>("monitor_lock_destroy");
                result.ready = result.release && (result.create || result.create_with_flag);
            }
            catch (...) { return configuration{}; }
            return result;
        }();
        return value;
    }

    inline auto on_owner_stack(void* const thread, const void* const record, const std::size_t size) -> bool
    {
        auto& runtime{ pn::rt() };
        const auto top{ pn::load<std::uintptr_t>(thread, runtime.off("JavaThread", "_stack_base")) };
        const auto extent{ pn::load<std::size_t>(thread, runtime.off("JavaThread", "_stack_size")) };
        const auto position{ reinterpret_cast<std::uintptr_t>(record) };
        return extent <= top && position >= top - extent && position <= top && size <= top - position;
    }
}

export namespace vmhook
{
    /* The lock participates in Java synchronized/Thread.holdsLock semantics.
       It must remain on its owner's stack inside a live native_thread_context.
       C++ code between acquisition and release stays in native state so GC can
       proceed. Copy, move, heap storage and cross-thread release are refused. */
    class monitor_lock final
    {
        alignas(8) std::array<std::byte, 64> record_{};
        std::shared_ptr<vmhook::detail::native_backend::context_lifetime> context_{};
        vmhook::detail::native_backend::root object_{};
        const vmhook::detail::monitor_backend::configuration* runtime_{};
        bool locked_{};

    public:
        template<typename wrapper_type>
        explicit monitor_lock(const std::unique_ptr<wrapper_type>& object)
        {
            static_assert(vmhook::detail::is_java_wrapper_v<wrapper_type>);
            namespace nb = vmhook::detail::native_backend;
            namespace pn = vmhook::detail::private_native;
            nb::operation access{};
            this->context_ = nb::active_context_lifetime();
            if (!access || !this->context_ || vmhook::hotspot::in_java_detour())
            { throw vmhook::exception{"Monitor locking requires a standalone native_thread_context"}; }
            this->runtime_ = &vmhook::detail::monitor_backend::config();
            if (!this->runtime_->ready)
            { throw vmhook::exception{"This exact VM profile has no verified ObjectLocker ABI"}; }
            if (!object) { throw vmhook::exception{"Monitor locking requires an allocated C++ wrapper"}; }
            void* const instance{ object->get_instance() };
            if (!instance)
            { throw vmhook::exception{"A Java null has no monitor", vmhook::error_code::null_reference}; }
            if (!object->get_native_root() || !object->get_native_root()->valid())
            { throw vmhook::exception{"Monitor locking requires a rooted Java object"}; }
            if (!vmhook::detail::monitor_backend::on_owner_stack(
                    this->context_->thread, this->record_.data(), this->runtime_->size))
            { throw vmhook::exception{"A monitor_lock must reside on the owning native thread's stack"}; }
            if (pn::pending_exception(this->context_->thread))
            { throw vmhook::exception{"Handle the pending Java exception before acquiring a monitor"}; }
            this->object_ = nb::retain_oop(instance);
            if (!this->object_) { throw vmhook::exception{"The monitor object could not be rooted"}; }
            if (this->runtime_->boolean_argument)
            { this->runtime_->create_with_flag(this->record_.data(), this->object_->slot, this->context_->thread, true); }
            else { this->runtime_->create(this->record_.data(), this->object_->slot, this->context_->thread); }
            this->locked_ = true;
            // This lease forbids context close/detach without keeping the thread
            // in VM state across arbitrary C++ work or a native blocking call.
            ++this->context_->operation_depth;
            try
            {
                if (void* const pending{ pn::pending_exception(this->context_->thread) })
                {
                    auto throwable{ nb::retain_oop(pending) };
                    std::string name{};
                    if (auto* const klass{ vmhook::klass_from_oop(pending) }; klass && klass->get_name())
                    { name = klass->get_name()->to_string(); }
                    pn::clear_pending_exception(this->context_->thread);
                    this->unlock();
                    throw vmhook::exception{"Java monitor acquisition threw", vmhook::error_code::java_exception,
                                            std::move(name), std::move(throwable)};
                }
            }
            catch (...) { if (this->locked_) { this->unlock(); } throw; }
        }
        ~monitor_lock() noexcept
        {
            if (!this->locked_) { return; }
            try { this->unlock(); }
            catch (...) { std::terminate(); }
        }
        monitor_lock(const monitor_lock&) = delete;
        monitor_lock(monitor_lock&&) = delete;
        auto operator=(const monitor_lock&) -> monitor_lock& = delete;
        auto operator=(monitor_lock&&) -> monitor_lock& = delete;
        static auto operator new(std::size_t) -> void* = delete;
        static auto operator new[](std::size_t) -> void* = delete;
        [[nodiscard]] auto owns_lock() const noexcept -> bool { return this->locked_; }
        auto unlock() -> void
        {
            if (!this->locked_) { return; }
            namespace nb = vmhook::detail::native_backend;
            namespace pn = vmhook::detail::private_native;
            if (nb::active_context_lifetime() != this->context_
                || pn::rt().current_thread() != this->context_->thread)
            { throw vmhook::exception{"A monitor must be released by its owning native OS thread"}; }
            nb::operation access{};
            if (!access) { throw vmhook::exception{"The monitor owner's native context is no longer usable"}; }
            this->runtime_->release(this->record_.data());
            this->locked_ = false;
            --this->context_->operation_depth;
        }
    };

    template<typename wrapper_type, typename function_type>
    inline decltype(auto) with_monitor(const std::unique_ptr<wrapper_type>& object, function_type&& function)
    {
        vmhook::monitor_lock lock{object};
        return std::invoke(std::forward<function_type>(function));
    }

    [[nodiscard]] inline auto monitor_locks_supported() noexcept -> bool
    { return vmhook::detail::monitor_backend::config().ready; }
}
// VMHOOK_MONITOR_LOCKS_END
export namespace vmhook::detail
{
    inline auto verified_monitor_locks_available() noexcept -> bool
    { return monitor_backend::config().ready; }
}
